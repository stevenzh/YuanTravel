@using Lvy.Web.Common
@using Arch.Common
@{
    string picroot = AppSetting.Get("UploadFileRoot");
}
@model Lvy.VModels.Site.BannerVModel
@if (Model.BannerList.Count > 0)
{
    <table class="table table-striped table-bordered table-sm">
        <thead>
            <tr>
                <td>#</td>
                <td style="width:200px;">图片</td>
                <td>景区描述</td>
                <td>链接</td>
                <td>权重</td>
                <td>类型</td>
                <td style="width:200px;">操作</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.BannerList)
            {
                <tr>
                    <td> @item.BannerID</td>
                    <td><img class="img-fluid" src="@(picroot + item.PicturePath)" /></td>
                    <td>@item.Subject</td>
                    <td>@item.LinkUrl</td>
                    <td>@item.SortOrder</td>
                    <td>@DictionaryTools.GetEnumValue(Enums.SiteBannerEnum, item.Type)</td>
                    <td class="project-actions">
                        <button type="button" onclick="popEdit('@item.BannerID');" class="btn btn-info btn-sm"><i class="fas fa-edit"></i>编辑</button>
                        <button type="button" onclick="popEdit('@item.BannerID');" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i>删除</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

}
else
{
    <div style="color: red; text-align: center; font-weight: bold; font-size: 14px;">
        <br />
        对不起，没有查找到数据！请重新输入查询条件 ！
    </div>
}

