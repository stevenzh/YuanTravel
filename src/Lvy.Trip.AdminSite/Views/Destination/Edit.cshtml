@model Lvy.Models.BaseDB.BaseDestinationModel
@{
    ViewBag.Title = "修改目的地";
    Layout = "~/Views/Shared/_Single.cshtml";
}

<div class="content">
    <div class="card">
        <form id="editform" method="post" class="form-horizontal" role="form">
            @Html.HiddenFor(model => model.Id)
            @Html.HiddenFor(model => model.ParentId)
            <div class="card-body">
                <div class="form-group row">
                    <label class="col-sm-2 control-label">
                        <span class="point">*</span>目的地：
                    </label>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(model => model.Name, new { @class = "form-control", @onblur = "CheckDesName(this);" })
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-sm-2 control-label">拼音：</label>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(model => model.PinYin, new { @class = "form-control" })
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-sm-2 control-label">简拼：</label>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(model => model.JPinYin, new { @class = "form-control" })
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-sm-2 control-label">是否是国内：</label>
                    <div class="radio col-sm-10">
                        <label>
                            @Html.RadioButtonFor(model => model.IsChina, 1, new { @checked = "checked" })
                            是
                        </label>
                        <label>
                            @Html.RadioButtonFor(model => model.IsChina, 0)否
                        </label>
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-sm-2 control-label">行政区码：</label>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(model => model.RegionCode, new { @class = "form-control" })
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-sm-2 control-label"> 等级</label>
                    <div class="col-sm-10">
                        @Html.DropDownListFor(model => model.Level, ViewBag.LevelList as IEnumerable<SelectListItem>, new { @class = "form-control" })
                    </div>
                </div>
            </div>

            <div class="card-footer clearfix">
                <input class="btn btn-primary btn-sm float-right" id="btnSave" type="button" value="保存" />
            </div>
        </form>
    </div>
</div>
<script type="text/javascript">

$(function () {
    $("#Name").focus().select();

    $("#btnSave").click(function () {
        if ($.trim($("#Name").val()).length == 0) {
            Utils.alert("目的地不得为空！", 1500);
            $("#Name").select().focus();
            return;
        }

        var params = decodeURIComponent($("#editform").formSerialize());

        $.ajax({
            url: "/Destination/UpdateDest",
            type: 'post',
            dataType: 'json',
            data: params,
            success: function (data) {
                Utils.alert(data.Message);
                parent.pageselectCallback(0);
                var index = parent.layer.getFrameIndex(window.name); //获取窗口索引
                parent.layer.close(index);
            },
            error: function (data) {
                Utils.alert("请求异常");
            }
        });

    });
});

//验证目的地是否存在
function CheckDesName(e) {
    var oldName = '@Model.Name';
    var newName = $.trim($(e).val());
    if (oldName != newName) {
        var params = { name: newName, id: @Model.Id, parentId: @Model.ParentId};
        $.post('/Destination/CheckDesName', params, function (data) {
            if (data == "1") {
                Utils.alert("改目的地已存在！", 1500);
                $("#Name").focus().select();
            }
        });
    }
}

</script>
