@using Lvy.Web.Common
@model Lvy.VModels.Base.BasePlaceVModel
@if (Model.PagedList.Items.Count > 0)
{
    <table class="table table-striped table-bordered table-sm">
        <thead>
            <tr>
                <td>景区编号</td>
                <td>景区名称</td>
                <td>景区描述</td>
                <td>开放时间</td>
                <td>景区星级</td>
                <td align="center">操作</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.PagedList.Items)
            {
                <tr>
                    <td style="text-align: center;">@item.PlaceCode</td>
                    <td>@item.PlaceName</td>
                    <td title="@item.SimpleDesc.ToNoHTML()">@item.SimpleDesc.ToNoHTML().TrimWithElipsis(32)</td>
                    <td title="@item.OpenTime.ToNoHTML()">@item.OpenTime.ToNoHTML().TrimWithElipsis(18)</td>
                    <td>@DictionaryTools.GetEnumValue(Enums.PlaceLevelEnum, item.PlaceLevel.ToString())</td>
                    <td class="project-actions">
                        <a href="@Url.Action("Edit", "Place", new { placeId = item.PlaceId })" class="btn btn-info btn-sm">
                            <i class="fas fa-edit"></i>编辑
                        </a>
                        <a href="@Url.Action("Delete", "Place", new { placeId = item.PlaceId })" onclick="return confirm('确定要删除嘛？')" class="btn btn-info btn-sm">
                            <i class="fas fa-trash"></i>删除
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @Html.HiddenFor(a => a.PagedList.PageIndex)
    <div id="Pagination" class="digg"></div>
}
else
{
    <div style="color: red; text-align: center; font-weight: bold; font-size: 14px;">
        <br />
        对不起，没有查找到数据！请重新输入查询条件 ！
    </div>
}
<script type="text/javascript">

    //分页控件 begin
    $(function () {
        $("#Pagination").pagination(
            Number('@Model.PagedList.TotalCount'), {
                callback: pageselectCallback,
                items_per_page: Number('@Model.PagedList.PageSize'),
                current_page: @Model.PagedList.PageIndex-1
            });
    });

    //回调方法
    function pageselectCallback(page_id, jq) {

        var load_iii = Utils.layerLoad();

        $("#Customers_PageIndex").val(page_id + 1);
        var params = $("#theForm").formSerialize();

        $.post('@Url.Action("Search")', params, function (data) {
            if (data.length < 1) {
                Utils.alert("查询出错，请稍后查询！");
                return false;
            }
            $('#divSearch').html(data);
            Utils.layerClose(load_iii);
        });
    }
</script>
