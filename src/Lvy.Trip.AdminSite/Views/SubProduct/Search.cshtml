@model Lvy.VModels.Product.ProductVModel
@{
    ViewBag.Title = "子产品管理";
}
@section AdditionalResources { }
<form id="theForm" action="@Url.Action("Search")" method="POST">
    <div class="xbox">
        <div align="center" class="xboxcontent clear">
            <div class="sotable_tit">
                子产品列表查询
            </div>
            <table align="center" class="sotable" style="width:80%;">
                <tr>
                    <td class="label">部门：</td>
                    <td>@Html.DropDownListFor(a => a.ProductModel.TeamCode, ViewBag.Teams as List<SelectListItem>, new { @class = "text150" })</td>
                    <td class="label">名称：</td>
                    <td>@Html.TextBoxFor(a => a.ProductModel.ProductName, new { @class = "text150" })</td>
                    <td class="label">供应商：</td>
                    <td>@Html.TextBoxFor(a => a.ProductModel.SupplierCode, new { @class = "text150" })</td>
                </tr>
            </table>
            <input class="btn btn1" id="btnSearch" type="submit" value="搜索" />
            <input class="btn btn1" id="btnClear" type="button" value="清空" />
        </div>
    </div>

    <div class="xbox clear">
        <div id="divSearch">
            @Html.Partial("UCSearch", Model)
        </div>
    </div>
</form>
<script type="text/javascript">

    //重置
    $("#btnClear").click(function () {
        $(".sotable td input[type=text]").val("");
        $(".sotable td input[type=hidden]").val("");
    });
</script>
