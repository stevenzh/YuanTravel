@model Lvy.VModels.Ticket.BookingVModel
@{
    ViewBag.Title = "商品预订";
    Layout = "~/Views/Shared/_Single.cshtml";
    string CDNServerUrl = Arch.Common.AppSetting.Get("CDNServerUrl");
}
@section AdditionalResources
{
    <!-- Tempusdominus Bootstrap 4 -->
    <link rel="stylesheet" href="@CDNServerUrl/tempusdominus-bootstrap-4/css/tempusdominus-bootstrap-4.min.css">
    <!-- Select2 -->
    <link rel="stylesheet" href="@CDNServerUrl/select2/css/select2.min.css" />
    <link href="@CDNServerUrl/fullcalendar/main.min.css" rel="stylesheet" />
    <style>
        .fc .fc-toolbar.fc-header-toolbar { margin-bottom: .5em; }
        .fc .fc-daygrid-body-unbalanced .fc-daygrid-day-events { min-height: 1em; }
        .fc .fc-daygrid-body-natural .fc-daygrid-day-events { margin-bottom: .3em; }
        .fc-h-event .fc-event-title { font-size: .65em; }
    </style>
}

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Home/Index">Home</a></li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <form id="theForm">
            <input type="hidden" name="ProductIds" value="@Model.Product.ProductId" />
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">商品列表</h4>
                    @*<div class="card-tools">
                            <button type="button" class="btn btn-info">添加商品</button>
                        </div>*@
                </div>
                <div id="divProducts" class="card-body">
                    <div class="card card-info card-outline" id="product-@Model.Product.Id">
                        <div class="card-header">
                            <h5 class="card-title">@Model.Product.ProductName</h5>
                            @*<div class="card-tools">
                                    <a href="javascript:;" class="btn btn-sm btn-danger" onclick="delProduct(@Model.Product.Id);">删除</a>
                                </div>*@
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <table class="table table-sm">
                                        <tr>
                                            <td><b>预定须知</b></td>
                                            <td>@Model.Product.BookingDesc</td>
                                        </tr>
                                        <tr>
                                            <td><b>游玩时间</b></td>
                                            <td>
                                                <input type="text" class="form-control datetimepicker-input" id="datetimepicker1" name="OutDates" />
                                            </td>
                                        </tr>
                                    </table>
                                    <div id="divPrices-@Model.Product.Id" class="price_table">
                                    </div>

                                    <input type="hidden" name="ProductIds" value="@Model.Product.ProductId" />
                                </div>
                                <div class="col-md-6">
                                    <div id='calendar'></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">订单信息</h4>
                </div>
                <div class="card-body">
                    <table class="table table-sm table-borderless">
                        <tr>
                            <td>客户：</td>
                            <td>
                                <select id="mySelect2" class="form-control " name="Order.AgentCode">
                                </select>
                            </td>
                        </tr>
                        <tr>
                            <td><span class="some_tips">*</span>联系人姓名：</td>
                            <td>@Html.TextBoxFor(a => a.Order.ContactName, new { @Id = "Managers", @class = "form-control" })</td>
                            <td><span class="some_tips">*</span>联系人电话：</td>
                            <td>@Html.TextBoxFor(a => a.Order.ContactPhone, new { @Id = "ManagerPhone", @class = "form-control" })</td>

                        </tr>
                        <tr>
                            <td><span class="text-danger">*</span>销售部门：</td>
                            <td>
                                @Html.DropDownListFor(m => m.Order.SalesTeamId, ViewData["Teams"] as List<SelectListItem>, new { @class = "form-control form-control-sm" })
                            </td>
                            <td><span class="text-danger">*</span>销售员：</td>
                            <td>
                                @Html.DropDownListFor(m => m.Order.SalerCode, ViewData["Salers"] as IEnumerable<SelectListItem>, new { @class = "form-control form-control-sm" })
                            </td>
                        </tr>
                        <tr>
                            <td><span class="some_tips ">*</span>导游：</td>
                            <td>
                                @Html.TextBoxFor(a => a.Order.GuideName, new { @Id = "GuideName", @class = "form-control" })
                            </td>
                            <td><span class="some_tips">*</span>导游电话：</td>
                            <td>@Html.TextBoxFor(a => a.Order.GuidePhone, new { @Id = "GuidePhone", @class = "form-control" })</td>
                        </tr>
                        <tr>
                            <td>备注：</td>
                            <td>
                                @Html.TextAreaFor(a => a.Order.Remarks, new { @Id = "Remarks", @class = "form-control" })
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td></td>
                            <td>总计：</td>
                            <td>
                                <table>
                                    <tr>
                                        <td>景区现付 </td>
                                        <td><span id="tdTaskPay">0</span>元</td>
                                    </tr>
                                    <tr>
                                        <td>返利 </td>
                                        <td><span id="tdTaskFanli">0</span>元</td>
                                    </tr>
                                    <tr>
                                        <td>签单 </td>
                                        <td><span id="tdQiandanPay">0</span>元</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" align='center'>
                                <button type="button" id="btnSaveOrder" class="btn btn-success">提交订单</button>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </form>
    </div>
</section>


@section PageScripts
{
    <script src="@CDNServerUrl/moment/moment.min.js"></script>
    <script src="@CDNServerUrl/moment/locale/zh-cn.js"></script>
    <!-- Tempusdominus Bootstrap 4 -->
    <script src="@CDNServerUrl/tempusdominus-bootstrap-4/js/tempusdominus-bootstrap-4.min.js"></script>
    <!-- Select2 -->
    <script src="@CDNServerUrl/select2/js/select2.full.min.js"></script>
    <script src="@CDNServerUrl/select2/js/i18n/zh-CN.js"></script>
    <!-- Jquery Form -->
    <script src="@CDNServerUrl/jquery-form/jquery.form.min.js"></script>
    <!-- Full Calendar -->
    <script src="@CDNServerUrl/fullcalendar/main.min.js"></script>
    <script src="@CDNServerUrl/fullcalendar/locales/zh-cn.js"></script>
    <script type="text/javascript">

        $(function () {

            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                header: { left: 'prev', center: 'title', right: 'next' },
                locale: 'zh-cn',
                height: 'auto',
                defaultView: 'dayGridMonth',//默认视图
                buttonText: { today: '今天', dayGridMonth: '月', dayGridWeek: '周', },
                events: function (info, successCallback, failureCallback) {
                    $.ajax({
                        type: "post",
                        url: '/TktManage/GetCalendar/@Model.Product.ProductId',
                        data: { start: moment(info.start).format('YYYY-MM-DD'), end: moment(info.end).format('YYYY-MM-DD') },
                        dataType: "json",
                        success: function (result) {
                            successCallback(result);
                        }
                    });
                },
                eventClick: function (info) {
                    $("#datetimepicker1").val(moment(info.event.start).format('YYYY-MM-DD'));
                    getPricesCallBack(moment(info.event.start).format('YYYY-MM-DD'));
                }
            });
            calendar.render();

            // 保存订单
            $("#btnSaveOrder").click(function () {
                if (!CheckControls()) {
                    return false;
                }

                var params = decodeURIComponent($("#theForm").formSerialize());
                var load_iii = Utils.layerLoad();
                $.post("/TktBooking/AddOrder", params, function (data) {
                    if (data.State == "0") {
                        Utils.alert(data.Msg);
                    } else {
                        layer.confirm('订单成功选择继续预订或跳转到订单列表？', {
                            btn: ['继续预订', '订单列表'] //按钮
                        }, function () {
                            location.href = '/TktBooking/Search';
                        }, function () {
                            parent.openTabPage('/TktOrder/Search', '订单管理');
                            location.href = '/TktBooking/Search';
                        });

                        return;
                    }

                    Utils.layerClose(load_iii);
                });

            });

            $('#mySelect2').select2({
                ajax: {
                    url: '/Customer/GetCustomerSelect2',
                    dataType: 'json',
                    data: function (params) {
                        return {
                            team: '',
                            keyword: params.term, // search term 请求参数 ， 请求框中输入的参数
                            page: params.page || 0,
                            size: 10,
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 0;
                        return {
                            results: data.rows,
                            pagination: {
                                more: (params.page * 10) < data.total
                            }
                        };
                    },
                    cache: true,
                },
                language: "zh-CN",
                placeholder: '请选择',//默认文字提示
                allowClear: true,
                //templateResult: formatState
            });
        });

        // 删除产品
        function delProduct(productId) {
            if (!confirm("确定要删除吗？")) {
                return false;
            }
            $("#divProducts").find("#product-" + productId).remove();
            CalcOneYsPrice();
        }

        // 获取报价数据的回调函数
        function getPricesCallBack(theDay) {
            var params = { selectDate: theDay, productId: '@Model.Product.ProductId' };
            var d = layer.load(1, { shade: [0.1, '#fff'] });

            $.post('/TktBooking/GetCurrentPrices', params, function (html) {
                layer.close(d);
                $("#divPrices-@Model.Product.Id").html(html);
                // 过滤 只能输入数字
                $("form input[input-limit='number']").keypress(function () {
                    InputLimitNumber();
                });
                CalcOneYsPrice();
            });
        }

        //检查人数
        var readyPost = true;
        function checkPeopleNum(_this, productId) {
            var $this = $(_this);
            var peopleCount = Number($this.val());
            var param = { ProductId: productId, PeopleCount: peopleCount };
            if (readyPost) {
                readyPost = false;
                $.post('/TktBooking/CheckQuota', param, function (data) {
                    if (data) {
                        if (data.State == 1) {
                            CalcOneYsPrice(_this);
                        } else {
                            Utils.alert(data.Msg);
                            $this.val('');
                            CalcOneYsPrice(_this);
                            $this.focus().select();
                        }
                    } else {
                        Utils.alert('系统出现异常，请联系管理员。');
                    }
                }).always(function () { readyPost = true; });
            }
        }

        // 计算结算金额
        function CalcOneYsPrice(_this) {
            $("#tdTaskPay").html(0);
            $("#tdTaskFanli").html(0);
            $("#tdQiandanPay").html(0);
            $(".price_table input[name='PeopleNum']").each(function () {
                _this = this;
                var model = new Object();
                var obj = $(_this).parents("tr");
                if (Utils.Trim($(_this).val()) == "") {
                    model.Num = 0;
                } else {
                    model.Num = parseInt($(_this).val());
                }

                model.TktType = parseInt(Utils.Trim(obj.find("td[name='tdTktType']").html()));
                model.SettlePrice = parseInt(Utils.Trim(obj.find("td[name='tdSettlePrice']").html()));
                model.SysPrice = parseInt(Utils.Trim(obj.find("td[name='tdSysPrice']").html()));


                if (model.TktType == 1 || model.TktType == 2) { // 签单
                    model.OneYsPrice = model.SysPrice * model.Num;
                } else {
                    model.OneYsPrice = (model.SettlePrice - model.SysPrice) * model.Num;
                }
                // 显示一个报价类型的结算价
                obj.find("td[name='tdOneYsPrice']").html(model.OneYsPrice);


                // 景区先付  任务单
                var taskPay = parseInt(Utils.Trim($("#tdTaskPay").html()));
                // 任务单 返利
                var taskFanli = parseInt(Utils.Trim($("#tdTaskFanli").html()));
                // 签单
                var qiandanPay = parseInt(Utils.Trim($("#tdQiandanPay").html()));
                if (model.TktType == 1 || model.TktType == 2) { // 签单
                    qiandanPay = qiandanPay + model.SysPrice * model.Num;
                } else {
                    taskPay = taskPay + model.SettlePrice * model.Num;
                    taskFanli = taskFanli + model.SysPrice * model.Num;
                }
                $("#tdTaskPay").html(taskPay);
                $("#tdTaskFanli").html(taskFanli);
                $("#tdQiandanPay").html(qiandanPay);
            });
        }

        // 验证控件
        function CheckControls() {

            var num = 0;
            $(".price_table input[name='PeopleNum']").each(function () {
                var _this = this;

                if (Utils.Trim($(_this).val()) == "") {
                    num = num + 0;
                } else {
                    num = num + parseInt($(_this).val());
                }
            });

            if (num <= 0) {
                Utils.alert("必须输入人数！");
                return false;
            }

            if (Utils.Trim($("#GuideName").val()) == "") {
                Utils.alert("必须输入导游姓名！");
                $("#GuideName").focus().select();
                return false;
            }
            if (Utils.Trim($("#GuidePhone").val()) == "") {
                Utils.alert("必须输入导游电话！");
                $("#GuidePhone").focus().select();
                return false;
            }

            if (Utils.Trim($("#Managers").val()) == "") {
                Utils.alert("必须输入联系人姓名！");
                $("#Managers").focus().select();
                return false;
            }
            if (Utils.Trim($("#ManagerPhone").val()) == "") {
                Utils.alert("必须输入联系人电话！");
                $("#ManagerPhone").focus().select();
                return false;
            }

            return true;
        }


    </script>

}

