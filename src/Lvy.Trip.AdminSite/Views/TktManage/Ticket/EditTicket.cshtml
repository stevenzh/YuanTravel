    //  END ********************门票部分********************

    // START********************库存部分********************

    //库存初始化
    function initialQuota() {
        $('#planQuotaTxt,#holdQuotaTxt,#limitQuotaTxt').keydown(function () {
            InputLimitNumber();
        });
        $('#planQuotaTxt,#holdQuotaTxt').keyup(function () {
            var $plan = $('#planQuotaTxt'), $hold = $('#holdQuotaTxt'), $used = $('#usedQuotaSpan'), $use = $('#useQuotaSpan');
            var plan = Number($plan.val()), hold = Number($hold.val()), used = Number($used.text()), use = Number($use.text());   //计划，预留，已用，剩余
            $use.text(plan - hold - used);
        });

        $(':radio[name="TicketProduct.TuiJianType"]').change(function () {
            if ($(this).val() == '2') {  // 固定库存
                $('.editQuotaA').show();
            }
            else {
                $('.editQuotaA').hide();
            }
        });
        var tj = '@Model.TicketProduct.TuiJianType';
        if (tj != '2')
            $('.editQuotaA').hide();
    }

    //验证库存
    function validQuota() {
        var $plan = $('#planQuotaTxt'), $hold = $('#holdQuotaTxt'), $used = $('#usedQuotaSpan'), $use = $('#useQuotaSpan'), $limit = $('#limitQuotaTxt');
        var plan = Number($plan.val()), hold = Number($hold.val()), used = Number($used.text()), use = Number($use.text()), limit = Number($limit.val());
        if (plan < 0 || hold < 0 || used < 0 || use < 0) {
            Utils.alert('库存数据不能小于零。');
            return false;
        }
        if (plan == 0) {
            Utils.alert('总库存需大于零。');
            return false;
        }
        if (limit < 0 || limit > use) {
            Utils.alert('限额需不能大于剩余库存。');
            return false;
        }
        return true;
    }

    //  END ********************库存部分********************

    //提交验证
    function submitValidate() {
        var $pName = $('#productNameTxt');
        if ($.IsEmpty( $pName)) {
            Utils.alert('商品名称不能为空。');
            $pName.focus().select();
            return false;
        }

        //if ($.IsEmpty($('#mySelect1'))) {
        //    Utils.alert('景区不能为空。');
        //    $('#mySelect1').focus().select();
        //    return false;
        //}

        if ($.IsEmpty($('#mySelect2'))) {
            Utils.alert('目的地不能为空。');
            $('#mySelect2').focus().select();
            return false;
        }
        var $tktType = $('#tktTypeDp');
        if ($.IsEmpty($tktType)) {
            Utils.alert('购买方式不能为空。');
            $tktType.focus().select();
            return false;
        }
        var $theme = $('#themeListTxt');
        if ($.IsEmpty($theme)) {
            Utils.alert('主题不能为空。');
            $theme.focus().select();
            return false;
        }

        var $tuiJianType = $(':radio[name="TicketProduct.TuiJianType"]:checked');
        if ($tuiJianType.val() == 2) {
            if (!validQuota()) {
                openQuotaDialog();
                return false;
            }
        }

        return true;
    }

    // 图片列表
    function photoView() {
       $.get("/TktManage/PhotoView", { productId: '@Model.TicketProduct.ProductId' }, function(html) {

            $("#photoView").html(html);

            $('.delimg').click(function () {
                var param = { "Id": $(this).attr("data-bind") }
                 layer.confirm('确定删除图片吗?', { btn: ['是', '否'] }, function () {
                    $.post("/TktManage/DeletePicture/", param, function (data) {
                        if (data.Code == "1") {
                            layer.close(layer.index);
                            photoView();
                        } else {
                            toastr.warning(data);
                        }
                    });
                }, function () {
                    //console.log("选择的否");
                });
            });
        });
        }

    function SetPrimaryPic(Id, LineId) {
        $.ajax({
            url: '@Url.Action("SetPrimaryImage")',
            type: 'POST',
            data: { id: Id, ProductID: LineId },
            success: function (data) {
                $('#photoView').html(data);
            }
        });
    }

    function elfinderDialog(editor) {
        var myCommands = elFinder.prototype._options.commands;
        var disabled = ['extract', 'archive', 'resize', 'help', 'select', 'upload']; // Not yet implemented commands in ElFinder.Net
        $.each(disabled, function (i, cmd)
        {
            (idx = $.inArray(cmd, myCommands)) !== -1 && myCommands.splice(idx, 1);
        });

        var fm = $('<div />').dialogelfinder({
            url: '@(picroot+"connector")', // change with the url of your connector
            customData: { folder: 'Files/ticket/@Model.TicketProduct.ProductId', subFolder: '' }, // customData passed in every request to the connector as query strings. These values are used in FileController's Index method.
            commands: myCommands,
            rememberLastDir: false,
            lang: 'zh_CN',
            uiOptions: { // UI buttons available to the user
                toolbar: [
                    ['back', 'forward'],
                    ['reload'],
                    ['home', 'up'],
                   // ['mkdir', 'mkfile', 'upload'],
                    ['open', 'download'],
                    ['info'],
                    ['quicklook'],
                    ['copy', 'cut', 'paste'],
                    ['rm'],
                    ['duplicate', 'rename', 'edit'],
                    ['view', 'sort']
                ],
                navbar: {
                    minWidth: 150,
                    maxWidth: 500
                }
            },
            width: 840,
            height: 450,
            destroyOnClose: true,
            getFileCallback: function (files, fm) {
                console.log(files);
                $(editor).summernote('editor.insertImage', files.url, function ($image) {
                    $image.addClass("img-fluid");
                });
            },
            commandsOptions: {
                getfile: {
                    oncomplete: 'close',
                    folders: false
                }
            }
        }).dialogelfinder('instance');
        }

    </script>

