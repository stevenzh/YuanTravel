@model IEnumerable<Lvy.Models.ProductDB.TpTourPlanModel>
<div id="divShowTour" title="共享查看">
    <table class="listtbl" style="width:300px;">
        <thead>
            <tr>
                <td style="text-align: center;">团计划编号</td>
                <td style="text-align: center;">团计划名称</td>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count() == 0)
            {
                <tr>
                    <td colspan="2" style="text-align: center;">无数据</td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td style="text-align: center;">@item.Id</td>
                        <td style="text-align: center;">@item.LineName</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
