@model Lvy.VModels.Product.SearchShareQuotaVModel
@{
    ViewBag.Title = "查询共享库存";
}
@section AdditionalResources { }
<form id="theForm">
    <div id="divSearch" class="xbox">
        @Html.HiddenFor(m => m.PagedQuota.PageIndex, new { id = "hiddenIndex" })
        @Html.Partial("Quota/UCSearchShareQuota", Model)
    </div>
    <div id="divContent" class="xbox">
        @Html.Partial("Quota/UCShareQuotaList", Model)
    </div>
</form>
