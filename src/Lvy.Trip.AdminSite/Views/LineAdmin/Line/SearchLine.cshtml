@model Lvy.VModels.Product.TpLineVModel
@{
    ViewBag.Title = "线路查询";
}
@section AdditionalResources
{
    <style>
        .select2-container--default .select2-selection--single { border-radius: 0; }
    </style>
}
<form id="theForm" action="">
    @Html.HiddenFor(m => m.FirstTime)
    <div id="lineSearchContainer" class="xbox">
        <div align="center" class="xboxcontent clear">
            <div class="sotable_tit">
                线路查询
            </div>
            <table id="searchTable" class="sotable" align="center" style="width:80%;">
                <tr>
                    <td class="label">产品部门：</td>
                    <td>
                        @Html.DropDownListFor(a => a.CrmTeamId, ViewBag.AccountTeamBeans as IEnumerable<SelectListItem>, new { @Class = "text150" })
                    </td>
                    <td class="label">线路编号：</td>
                    <td>@Html.TextBoxFor(m => m.LineId, new { @class = "text150" })</td>
                    <td class="label">线路名称：</td>
                    <td>@Html.TextBoxFor(m => m.LineName, new { @class = "text150" })</td>
                </tr>
                <tr>
                    <td class="label">区域划分：</td>
                    <td>
                        @Html.DropDownListFor(m => m.LineScope, ViewBag.LineScopeSelectItems as IEnumerable<SelectListItem>, new { @class = "text150" })
                    </td>
                    <td class="label">目的地：</td>
                    <td>
                        <select id="mySelect1" name="ArriveDest" class="text150">
                            <option></option>
                        </select>
                    </td>
                    <td class="label">线路类型：</td>
                    <td>
                        @Html.DropDownListFor(m => m.LineType, ViewBag.LineTypeSelectItems as IEnumerable<SelectListItem>, new { @class = "text150" })
                    </td>
                    @*<td class="label">行程天数：</td>
                        <td>
                            @Html.TextBoxFor(m => m.TravelDays, new { @class = "text70", contentlimit = "number" })&nbsp;天
                        </td>*@
                </tr>
                <tr>
                    <td class="label">供应商：</td>
                    <td>@Html.TextBoxFor(m => m.CustomerName, new { @class = "text150" })</td>
                    <td class="label">产品来源：</td>
                    <td>
                        @Html.DropDownListFor(a => a.IsImport, ViewData["ImportType"] as IEnumerable<SelectListItem>, new { @Class = "text150" })
                    </td>
                </tr>
                <tr>
                    <td colspan="6" align="center">
                        <input class="btn btn1" id="searchBtn" type="button" value="搜索" />
                        <input class="btn btn1" id="resetBtn" type="button" value="清空" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div id="lineListContent" class="xbox">
        @Html.Partial("Line/UCLineList", Model)
    </div>
</form>
<script type="text/javascript">

    $(function () {

        // 限制输入数字
        $('form input[contentlimit="number"]').keypress(function () {
            if ((event.keyCode < 48 || event.keyCode > 57) && event.keyCode != 46)
                event.returnValue = false;
        });

        //目的地
        $('#mySelect1').select2({
            ajax: {
                url: function (params) {
                    return ApiServerUrl + '/Dest/GetDestSelect2';
                },
                dataType: 'json',
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    var itemList = [];//当数据对象不是{id:0,text:'ANTS'}这种形式的时候，可以使用类似此方法创建新的数组对象
                    var arr = data.items
                    for (item in arr) {
                        itemList.push({ id: arr[item].ParentStr, text: arr[item].Name, pinyin: arr[item].JPinYin })
                    }
                    return {
                        results: itemList,
                        pagination: {
                            more: (params.page * 30) < data.total_count
                        }
                    };
                },
                cache: true,
            },
            placeholderOption: "first",
            allowClear: true,
            language: "zh-CN",
            placeholder: '请选择',//默认文字提示
            //templateResult: formatState
        });

        //查询
        $("#searchBtn").click(function () {
            pageselectCallback(0);
        });

    });
</script>