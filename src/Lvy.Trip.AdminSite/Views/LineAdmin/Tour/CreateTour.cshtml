@using System.Globalization
@using Lvy.Models
@model Lvy.VModels.Product.AddTourVModel
@{
    ViewBag.Title = "添加团期";
    Layout = "~/Views/Shared/_Single.cshtml";
    string CDNServerUrl = Arch.Common.AppSetting.Get("CDNServerUrl");
}
@section AdditionalResources
{
    <link href="@CDNServerUrl/fullcalendar/main.min.css" rel="stylesheet" />
    <link href="~/WebRes/scripts/My97DatePicker/skin/default/datepicker.css" rel="stylesheet" />
    <link href="~/WebRes/css/calendarchange.css" rel="stylesheet" />

    <script src="@CDNServerUrl/moment/moment.min.js"></script>
    <script src="@CDNServerUrl/fullcalendar/main.min.js"></script>
    <script src="@CDNServerUrl/fullcalendar/locales/zh-cn.js"></script>
    <script src="~/WebRes/scripts/My97DatePicker/WdatePicker.js"></script>
}
<style>
    .fc-toolbar.fc-header-toolbar { font-size: 0.7em; }
    .fc-toolbar, .fc-toolbar.fc-header-toolbar { padding: 0.3em; }
    .fc-ltr .fc-dayGrid-view .fc-day-top .fc-day-number { font-size: 1.6em; }
    .fc .fc-daygrid-body-unbalanced .fc-daygrid-day-events { min-height: 1.5em; }
    .fc .fc-daygrid-body-natural .fc-daygrid-day-events { margin-bottom: 0.4em; }
    .text150 { width: 150px; }
    .text70 { width: 70px; }
</style>
<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>@ViewBag.Title</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("SearchLine")">产品列表</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("UCTourStore",new { lineId = Model.LineId})">团期库存</a></li>
                        <li class="breadcrumb-item active">@ViewBag.Title</li>
                    </ol>
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="container-fluid">
            @using (Html.BeginForm("AddTour", "LineAdmin", FormMethod.Post, new { id = "theForm", @onkeydown = "if(event.keyCode==13)return false;" }))
            {
                @Html.HiddenFor(m => m.LineId)

                <div class="card">
                    <div class="card-body">
                        <div class="form-group row">
                            <label class="col-md-2">线路名称：</label>
                            <div class="col-md-10">
                                @Html.DisplayTextFor(m => m.Line.LineName)
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-md-2">团标注：</label>
                            <div class="col-md-10">
                                @Html.TextBoxFor(m => m.TourPlan.TourNo, new { @class = "form-control", @maxlength = "50" })
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-md-2">出发日期：</label>
                            <input id="SelectedDays" name="SelectedDays" type="hidden" />
                            <div class="col-md-6">
                                <div id='calendar'></div>
                            </div>
                            <div class="col-md-4" style="border: 1px solid #57baff">
                                <ul id="dateList" class="todo-list" data-widget="todo-list" style="height:350px;">
                                </ul>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-md-2"><span class="point">*</span>总库存：</label>
                            <div class="col-md-4">
                                @Html.TextBoxFor(m => m.Quota.PlanQuota, new { @class = "form-control", contentlimit = "number" })
                                @*@if (Model.Line.TrafficType == 1)
                                    {
                                        <input type="button" id="showBusSeat" value="显示车位" />
                                    }*@
                            </div>
                            <label class="col-md-2">预留库存：</label>
                            <div class="col-md-4">
                                @Html.TextBoxFor(m => m.Quota.HoldQuota, new { id = "planQuota", @class = "form-control", contentlimit = "number" })
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-md-2"><span class="point">*</span>最小成团数：</label>
                            <div class="col-md-4">
                                @Html.TextBoxFor(m => m.TourPlan.MixedNum, new { @class = "form-control", contentlimit = "number" })
                            </div>
                            <label class="col-md-2">团队性质：</label>
                            <div class="col-md-4">
                                @Html.DropDownListFor(m => m.TourPlan.TourType, DictionaryTools.GetEnumsBy(Enums.TourTypeEnum).ToSelectListForNoDefualt(Model.TourPlan.TourType.ToString()), new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="form-group" style="display:none;">
                            <label class="col-md-2">选择巴士：</label>
                            <div class="col-md-10">
                                <div id="busSeatContainer">
                                </div>
                            </div>
                        </div>
                        <div style="display:none;">
                            <label class="col-md-2">推荐类型：</label>
                            <div class="col-md-10">
                                @Html.DropDownListFor(m => m.TourPlan.TuiJianType, new List<SelectListItem> { new SelectListItem { Text = "常规团", Value = "0", Selected = Convert.ToBoolean(Model.TourPlan.TuiJianType) }, new SelectListItem { Text = "特价团", Value = "1", Selected = Convert.ToBoolean(Model.TourPlan.TuiJianType) } })
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-md-2">是否销售：</label>
                            <div class="col-md-10">
                                @Html.RadioGroup("TourPlan.TourState", new List<KeyValueBean> { new KeyValueBean { Key = "2", Value = "否" }, new KeyValueBean { Key = "3", Value = "是" } }, Model.TourPlan.TourState.ToString(CultureInfo.InvariantCulture))
                            </div>
                        </div>
                        <div class="form-group row" style="display:none;">
                            <label class="col-md-2">附加信息：</label>
                            <div class="col-md-10">
                                <span style="color: red;">主要描述航班信息、行程变化等。</span>
                                <br />
                                @Html.TextAreaFor(m => m.TourPlan.AdditionInfo, new { @class = "form-control", @row = "4" })
                            </div>
                        </div>
                        <div class="form-group row" style="display:none;">
                            <label class="col-md-2">备注：</label>
                            <div class="col-md-10">
                                @Html.TextAreaFor(m => m.TourPlan.Remarks, new { @class = "form-control", @row = "4" })
                            </div>
                        </div>
                    </div>
                </div>

                if (Model.Line.TrafficType == 3)
                {
                    <input type="hidden" name="TourFlightListCount" id="TourFlightListCount" value="@Model.TourFlightList.Count" />

                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title"> 航班信息</h4>
                            <div class="card-tools">
                                <button type="button" id="AddTourFlight" name="AddTourFlight" class="btn btn-sm btn-success" onclick="AddTourFlightRow()">增加航班</button>
                            </div>
                        </div>
                        <div class="card-body">
                            <table id="flightTable" class="table table-sm">
                                <thead>
                                    <tr>
                                        <td>序号</td>
                                        <td>航班类型</td>
                                        <td>航空公司</td>
                                        <td>航班号</td>
                                        <td>出发时间</td>
                                        <td>抵达时间</td>
                                        @*<td>飞行时间</td>*@
                                        <td>操作</td>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr id="rowidx_0">
                                        <td>
                                            <input type="hidden" name="TourFlightList[0].TourId" id="TourFlightList[0].TourId" value="0" />
                                            <label id="index_0" name="lblIndex">1</label>
                                        </td>
                                        <td class="data" valign="top">
                                            <select name="TourFlightList[0].FlightType" id="TourFlightList[0].FlightType" style="width:70px;">
                                                <option value="G" selected="selected">去程</option>
                                                <option value="C">途中</option>
                                                <option value="R">返程</option>
                                            </select>
                                        </td>
                                        <td name="FlightCompany" valign="top">
                                            <select name="TourFlightList[0].AirlineCode" id="TourFlightList[0].AirlineCode" style="width:100%">
                                                <option value=""></option>
                                                @foreach (var item in Model.AirlineList)
                                                {
                                                    <option value="@item.Code">@item.Code  @item.ShortName</option>
                                                }
                                            </select>
                                        </td>
                                        <td class="data" valign="top">
                                            <input type="text" name="TourFlightList[0].FlightNum" size="6" maxlength="6" value="" id="TourFlightList[0].FlightNum" style="width:80px;">
                                        </td>
                                        <td class="data" valign="top">
                                            <input type="text" name="TourFlightList[0].StartingTime" class="Wdate" onfocus="WdatePicker({ dateFmt: 'HH:mm' })" value="" id="TourFlightList[0].StartingTime" style="width:80px;">
                                        </td>
                                        <td class="data" valign="top">
                                            <input type="text" name="TourFlightList[0].ArrivaTime" class="Wdate" onfocus="WdatePicker({ dateFmt: 'HH:mm' })" value="" id="TourFlightList[0].ArrivaTime" style="width:80px;">
                                        </td>
                                        @*<td class="data" valign="top">
                                                <input type="text" name="TourFlightList[0].TotalTravelTime" size="5" maxlength="5" value="" id="TourFlightList[0].TotalTravelTime">小时
                                            </td>*@
                                        <td class="data" valign="top"><a href="javascript:SubmitDeleteFlight('0')">删除</a></td>
                                    </tr>
                                    <tr id="rowidx_1">
                                        <td>
                                            <input type="hidden" name="TourFlightList[1].TourId" id="TourFlightList[1].TourId" value="0" />
                                            <label id="index_1" name="lblIndex">2</label>
                                        </td>
                                        <td class="data" valign="top">
                                            <select name="TourFlightList[1].FlightType" id="TourFlightList[1].FlightType" style="width:70px;">
                                                <option value="G">去程</option>
                                                <option value="C">途中</option>
                                                <option value="R" selected="selected">返程</option>
                                            </select>
                                        </td>
                                        <td name="FlightCompany" valign="top">
                                            <select name="TourFlightList[1].AirlineCode" id="TourFlightList[1].AirlineCode" style="width:100%">
                                                <option value=""></option>
                                                @foreach (var item in Model.AirlineList)
                                                {
                                                    <option value="@item.Code">@item.Code    @item.ShortName</option>
                                                }
                                            </select>
                                        </td>
                                        <td class="data" valign="top">
                                            <input type="text" name="TourFlightList[1].FlightNum" size="6" maxlength="6" value="" id="TourFlightList[1].FlightNum" style="width:80px;">
                                        </td>
                                        <td class="data" valign="top">
                                            <input type="text" name="TourFlightList[1].StartingTime" class="Wdate" onfocus="WdatePicker({ dateFmt: 'HH:mm' })" value="" id="TourFlightList[1].StartingTime" style="width:80px;">
                                        </td>
                                        <td class="data" valign="top">
                                            <input type="text" name="TourFlightList[1].ArrivaTime" class="Wdate" onfocus="WdatePicker({ dateFmt: 'HH:mm' })" value="" id="TourFlightList[1].ArrivaTime" style="width:80px;">
                                        </td>
                                        @*<td class="data" valign="top">
                                                <input type="text" name="TourFlightList[1].TotalTravelTime" size="5" maxlength="5" value="" id="TourFlightList[1].TotalTravelTime">小时
                                            </td>*@
                                        <td class="data" valign="top"><a href="javascript:SubmitDeleteFlight('1')">删除</a></td>
                                    </tr>
                                </tbody>

                            </table>
                        </div>

                    </div>
                }

                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">添加报价</h3>
                        <div class="card-tools">
                            <button id="addPrice" type="button" class="btn btn-sm btn-success">添加报价</button>
                        </div>
                    </div>
                    <div id="priceContainer" class="card-body">
                        @Html.Partial("Tour/UCAddPrice", Model.PriceList)
                    </div>
                    <div class="card-footer">
                        单房差：@Html.TextBoxFor(m => m.SingleRoom, new { @class = "text70", contentlimit = "number" })
                        小费：@Html.TextBoxFor(m => m.Tips, new { @class = "text70", contentlimit = "number" })
                        自费： @Html.TextBoxFor(m => m.ZeiFei, new { @class = "text70", contentlimit = "number" })
                        <hr />

                        <button type="button" class="btn btn-success" id="submitBtn">保存</button>
                        <button type="button" class="btn btn-secondary" onclick="window.history.go(-1);">返回</button>

                    </div>
                </div>
            }

            <div style="display:none">
                <table id="tempTb">
                    <tbody>
                        <tr id="rowidx_0">
                            <td>
                                <input type="hidden" name="TourFlightList[0].TourId" id="TourFlightList[0].TourId" value="0" />
                                <label id="index_0" name="lblIndex">0</label>
                            </td>
                            <td class="data" valign="top">
                                <select name="TourFlightList[0].FlightType" id="TourFlightList[0].FlightType" style="width:70px;">
                                    <option value="G">去程</option>
                                    <option value="C" selected="selected">途中</option>
                                    <option value="R">返程</option>
                                </select>
                            </td>
                            <td name="FlightCompany" valign="top">
                                <select name="TourFlightList[0].AirlineCode" id="TourFlightList[0].AirlineCode" style="width:100%">
                                    <option value=""></option>
                                    @foreach (var item in Model.AirlineList)
                                    {
                                        <option value="@item.Id">@item.Code   @item.ShortName</option>
                                    }
                                </select>
                            </td>
                            <td class="data" valign="top">
                                <input type="text" name="TourFlightList[0].FlightNum" size="6" maxlength="6" value="" id="TourFlightList[0].FlightNum" style="width:80px;">
                            </td>
                            <td class="data" valign="top">
                                <input type="text" name="TourFlightList[0].StartingTime" class="Wdate" onfocus="WdatePicker({ dateFmt: 'HH:mm' })" value="" id="TourFlightList[0].StartingTime" style="width:80px;">
                            </td>
                            <td class="data" valign="top">
                                <input type="text" name="TourFlightList[0].ArrivaTime" class="Wdate" onfocus="WdatePicker({ dateFmt: 'HH:mm' })" value="" id="TourFlightList[0].ArrivaTime" style="width:80px;">
                            </td>
                            @*<td class="data" valign="top">
                                    <input type="text" name="TourFlightList[0].TotalTravelTime" size="5" maxlength="5" value="" id="TourFlightList[0].TotalTravelTime">小时
                                </td>*@
                            <td class="data" valign="top"><a href="javascript:SubmitDeleteFlight('0')">删除</a></td>
                        </tr>
                    </tbody>

                </table>

            </div>

        </div>
    </section>
</div>

@section PageScripts
{
    <script type="text/javascript">

        var selectdt = Array();
        var selectEl = Array();

    $(function () {

        $('#selectAll').attr("disabled", "disabled");
        //选择整个星期 事件
        $("#selectAll").bind("change", function () {
        });

        //限定输入内容为数字
        $('form input[contentlimit="number"]').keypress(function () {
            InputLimitNumber();
        });

        //计划名额输入后失去焦点事件
        $("input[name='Quota.PlanQuota']").bind("keyup", function () {
            var planVal = $(this).val();
            var plan = planVal.length > 0 ? Number(planVal) : 0;
            var holdVal = $("input[name='Quota.HoldQuota']").val();
            var hold = holdVal.length > 0 ? Number(holdVal) : 0;
            var usedVal = $("#UsedQuota").text();
            var used = usedVal.length > 0 ? Number(usedVal) : 0;
            $("#UseQuota").text(plan - hold - used);
        });
        //预留名额输入后失去焦点事件
        $("input[name='Quota.HoldQuota']").bind("keyup", function () {
            var planVal = $("input[name='Quota.PlanQuota']").val();
            var plan = planVal.length > 0 ? Number(planVal) : 0;
            var holdVal = $(this).val();
            var hold = holdVal.length > 0 ? Number(holdVal) : 0;
            var usedVal = $("#UsedQuota").text();
            var used = usedVal.length > 0 ? Number(usedVal) : 0;
            $("#UseQuota").text(plan - hold - used);
        });
        //显示车位
        $("#showBusSeat").bind("click", function () {
            var plan = $("input[name='Quota.PlanQuota']").val();
            if (Number(plan) > 0) {
                CreateBusSeat(plan);
            }
            else {
                Utils.alert('总库存须大于零！');
            }
        });

        $('select[name="TourPlan.TuiJianType"]').change(function () {
            if ($(this).val() == 1) {
                $('input[name="TeJiaFanLi"]').removeAttr('disabled');
            } else {
                $('input[name="TeJiaFanLi"]').attr('disabled', 'disabled');
            }
        });

        //提交
        $('#submitBtn').bind('click', function () {
            if (selectdt.length == 0) {
                Utils.alert('请选择出发日期！');
                return false;
            } else {
                $("#SelectedDays").val(selectdt);
            }

            var $plan = $('#Quota_PlanQuota');
            if(Number($plan.val())<=0) {
                Utils.alert('库存须大于零');
                $plan.focus().select();
                return false;
            }

            var trafficType = @Model.Line.TrafficType;
            //if ( trafficType == 1) {
            //    if($('#busSeatContainer').children().length == 0) {
            //        Utils.alert('请选择座位表!');
            //        return false;
            //    }
            //    else {
            //        //当前预留库存
            //        var curHold = Number($('#planQuota').val());
            //        //预留座位数
            //        var holdCount = $(".seat_box .blue").length;
            //        if (holdCount != curHold) {
            //            Utils.alert('请确认预留座位是否一致。');
            //            return false;
            //        }
            //    }
            //}

            var priceCheck = true;
            var $priceTypes = $('#priceList td[name="priceTypeTd"]');
            $priceTypes.each(function() {
                var $priceTypeDpl = $(this).children('select');
                if(!$priceTypeDpl.val()>0) {
                    Utils.alert('价格类型不能为空');
                    $priceTypeDpl.focus().select();
                    priceCheck = false;
                    return false;
                }
            });
            if(priceCheck) {
                var load_iii = Utils.layerLoad();
                $("#theForm").submit();
                //return true;
            }
            return false;
        });

        var calendarEl = document.getElementById('calendar');
        var calendar = new FullCalendar.Calendar(calendarEl, {
            header: {left: 'prev',center: 'title',right: 'next'},
            locale: 'zh-cn',
            height: 'auto',
            defaultView: 'dayGridMonth',//默认视图
            buttonText: {today: '今天',dayGridMonth: '月',dayGridWeek: '周', },
            //navLinks: true, // can click day/week names to navigate views
            dateClick: function (info) {
                //alert('Clicked on: ' + info.dateStr);
                //alert('Coordinates: ' + info.jsEvent.pageX + ',' + info.jsEvent.pageY);
                //alert('Current view: ' + info.view.type);
                var pid = selectdt.indexOf(info.dateStr);
                if (pid > -1) {
                    // change the day's background color just for fun
                    info.dayEl.style.backgroundColor = 'white';
                    selectdt.splice(pid, 1);
                    selectEl.splice(pid, 1);
                }
                else {
                    // change the day's background color just for fun
                    info.dayEl.style.backgroundColor = '#C8DFF3';
                    selectdt.push(info.dateStr);
                    selectEl.push(info.dayEl);
                }
                RenderList();
            },
            events: function(info, successCallback, failureCallback){
                    $.ajax({
                        type : "post",
                        url : '/LineAdmin/GetCalendar/@Model.LineId',
                        data: {},
                        dataType: "json",
                        success : function(result) {
                            successCallback(result);
                        }
                    });
            },
            customButtons: {
                prev: {
                    text: 'Prev',
                    click: function () {
                        selectEl = Array();  // clear Array.
                        selectdt = selectdt.sort();
                        calendar.prev();
                    }
                },
                next: {
                    text: 'Next',
                    click: function () {
                        selectEl = Array();  // clear Array.
                        selectdt = selectdt.sort();
                        calendar.next();
                    }
                },
            },
            dayCellDidMount: function (info) {
                var item = moment(info.date).format('YYYY-MM-DD');
                if (selectdt.indexOf(item) > -1) {
                    // change the day's background color just for fun
                    info.el.style.backgroundColor = '#C8DFF3';
                    selectEl.push(info.el);
                    console.log("selectEl.length:" +selectEl.length);
                }
            }
        });
        calendar.render();
    });

    function RenderList() {
        var cl = $("#dateList").html('');
        selectdt.forEach(function (item) {
            cl.append(' <li><span class="handle"><i class="fas fa-ellipsis-v"></i><i class="fas fa-ellipsis-v"></i></span><span class="text">' + item + '</span><span class="tools"><i class="fas fa-trash" onclick="DelCal(this);" data-cal="' + item + '"></i></span></li >');
        });
    }

    function DelCal(item) {
        var dateStr = $(item).attr("data-cal");
        var pid = selectdt.indexOf(dateStr);
        if (pid > -1) {
            selectdt.splice(pid, 1);
            selectEl[pid].style.backgroundColor = 'white';
            selectEl.splice(pid, 1);
            RenderList();
        }
    }

    //创建车位
    function CreateBusSeat(seatNum) {
        $.post("/LineAdmin/CreateBusSeat?seatNum=" + seatNum,
            function (data) {
                $("#busSeatContainer").html(data);
            });
        }

        function SubmitDeleteFlight(rowidx) {

            $("#rowidx_" + rowidx).remove();
            var rowCount = $("#flightTable tbody").eq(1).find("tr").length;
            $("#flightTable tbody").eq(1).find("tr").each(function (index, item) {

                //改变行的index
                $(this).attr("id", $(this).attr("id").replace(/\d+/, index));

                var ctr = $(this).find("input[type='text'],input[type='hidden'],select,label[name='lblIndex'],a");//$("#flightTable tr")[index].find("input[type='text']");//$(item).find("td").children("input[type='text'],select,label[name='lblIndex']");
                ctr.each(function () {
                    if ($(this).prop("tagName") == "A") {
                        $(this).attr("href", $(this).attr("href").replace(/\d+/, index));
                    } else {
                        $(this).attr("id", $(this).attr("id").replace(/\d+/, index));
                        $(this).attr("name", $(this).attr("name").replace(/\d+/, index));
                        if ($(this).prop("tagName") == "LABEL") {

                            $(this).text(index + 1);
                        }
                    }
                });
            });
        } 

    function AddTourFlightRow() {

        var tr = $("#tempTb tr").clone();
        $("#flightTable tbody").eq(0).append(tr)
        var rowCount = $("#flightTable tbody").eq(1).find("tr").length;
        $("#flightTable tbody").eq(1).find("tr").each(function (index, item) {

            //改变行的index
            $(this).attr("id", $(this).attr("id").replace(/\d+/, index));

            var ctr = $(this).find("input[type='text'],input[type='hidden'],select,label[name='lblIndex'],a");//$("#flightTable tr")[index].find("input[type='text']");//$(item).find("td").children("input[type='text'],select,label[name='lblIndex']");
            ctr.each(function () {
                if ($(this).prop("tagName") == "A") {
                    $(this).attr("href", $(this).attr("href").replace(/\d+/, index));
                } else {
                    $(this).attr("id", $(this).attr("id").replace(/\d+/, index));
                    $(this).attr("name", $(this).attr("name").replace(/\d+/, index));
                    if ($(this).prop("tagName") == "LABEL") {

                        $(this).text(index + 1);
                    }
                }
            });
        });
    }
    </script>
}
