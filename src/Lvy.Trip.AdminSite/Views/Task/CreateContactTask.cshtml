@model Lvy.VModels.Base.TaskVModel
@{
    ViewBag.Title = "添加任务";
    Layout = "~/Views/Shared/_Single.cshtml";
}

<section class="content">
    <form id="theForm" method="POST">
        @Html.HiddenFor(t => t.Task.TeamID)
        @Html.HiddenFor(t => t.Task.WorkFlowID)
        @Html.HiddenFor(t => t.Task.WorkmanTeam)
        @Html.HiddenFor(t => t.Task.Workman)

        @Html.HiddenFor(t => t.JsonModel.ContactCode)
        @Html.HiddenFor(t => t.JsonModel.ContactName)
        @Html.HiddenFor(t => t.JsonModel.CustomerCode)
        @Html.HiddenFor(t => t.JsonModel.CustomerName)
        @Html.HiddenFor(t => t.JsonModel.WorkmanTeam)
        @Html.HiddenFor(t => t.JsonModel.Workman)
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">添加任务</h3>
            </div>
            <div class="card-body">
                <div class="form-group row">
                    <label class="col-2 col-form-label"><span class="point">*</span>申请事项：</label>
                    <div class="col-10">@Model.Note</div>
                </div>
                <div class="form-group row">
                    <label class="col-2 col-form-label"><span class="point">*</span>申请原因：</label>
                    <div class="col-10">
                        @Html.TextAreaFor(a => a.Task.Contents, new { @class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <input class="btn btn-info" id="btnSave" type="button" value="提交" />
            </div>
        </div>
    </form>
</section>
<script type="text/javascript">
    $(function () {

        $("#btnSave").click(function () {
            var param = decodeURIComponent($("#theForm").formSerialize());
            $.post("/Task/Add/", param, function (data) {
                if (data.Code == "1") {
                    parent.Utils.alert("已提交领用！");
                    var index = parent.layer.getFrameIndex(window.name); //获取窗口索引
                    parent.layer.close(index);
                }
            });
        });

    });

</script>
