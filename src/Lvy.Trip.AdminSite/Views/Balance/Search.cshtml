@model Lvy.VModels.Tour.TourBalanceVModel
@{
    ViewBag.Title = "报团管理";
    Layout = "~/Views/Shared/_Single.cshtml";
    string CDNServerUrl = Arch.Common.AppSetting.Get("CDNServerUrl");
}
@section AdditionalResources
{
    <script src="~/WebRes/Scripts/My97DatePicker/WdatePicker.js" type="text/javascript"></script>
}

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<section class="content">
    <form id="theForm">
        <input type="hidden" name="Condition.Type" value="9" />
        <div class="card">
            <div class="card-body p-2">
                <div class="form-row">
                    <div class="col-auto">
                        @Html.DropDownListFor(m => m.Condition.TeamId, ViewBag.Teams as List<SelectListItem>, new { @class = "form-control form-control-sm" })
                    </div>
                    <div class="col-auto">
                        @Html.DropDownListFor(m => m.Condition.TeamId, ViewBag.Branchs as List<SelectListItem>, new { @class = "form-control form-control-sm" })
                    </div>
                    <div class="col-auto">
                        @Html.DropDownListFor(a => a.Condition.ProductType, ViewBag.ProductTypes as IEnumerable<SelectListItem>, new { @class = "form-control form-control-sm" })
                    </div>
                    <div>
                        @Html.TextBoxFor(a => a.Condition.ProductName, new { @class = "form-control form-control-sm", @placeholder = "产品名称" })
                    </div>
                    <div>
                        <input type="text" name="Condition.StartOutDate" id="d4311" class="form-control form-control-sm" placeholder="出发日期" />
                    </div>
                    <div class="col-auto">
                        @Html.TextBoxFor(a => a.Condition.TourNo, new { @Class = "form-control form-control-sm", @placeholder = "团号" })
                    </div>
                    <div class="col-auto">
                        @Html.DropDownListFor(a => a.Condition.TourAuditState, DictionaryTools.GetEnumsBy(Enums.AuditStateEnum).ToSelectListFor(Model.Condition.TourAuditState), new { @class = "form-control form-control-sm" })
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <button class="btn btn-default " id="btnSearch" type="button">搜索</button>
                <a class="btn btn-success float-right" href="/Balance/Create"><i class="fa fa-plus"></i> 添加单团核算</a>
            </div>
        </div>
        <div id="divTourAccountList" class="card">
            @Html.Partial("UCSearch", Model)
        </div>
    </form>
</section>
@section PageScripts
{
    <script src="@CDNServerUrl/moment/moment.min.js"></script>
    <!-- date-range-picker -->
    <script src="@CDNServerUrl/daterangepicker/daterangepicker.js"></script>

    <script type="text/javascript">
        $(function () {

            //搜索
            $("#btnSearch").click(function () {
                pageselectCallback(0);
            });

        });
    </script>
}