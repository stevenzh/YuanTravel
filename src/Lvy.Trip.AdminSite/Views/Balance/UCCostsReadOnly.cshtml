@using Lvy.Models
@model Lvy.VModels.Tour.TourBalanceVModel
<div class="sotable_tit">
    <label>成本</label>
</div>
<table class="table table-sm" id="shourutable">
    <thead>
        <tr>
            <th>项目</th>
            <th>供应商</th>
            <th>单价(金额)</th>
            <th>份数</th>
            <th>总收入</th>
            <th>备注</th>
            <th>付款方式</th>
            <th>付款状态</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.CostList.Count(); i++)
        {
            <tr>
                <td>
                    @DictionaryTools.GetEnumValue(Enums.SupplierCostItemsEnum, Model.CostList[i].Item.ToString())
                </td>
                <td>
                    @{
                        var Suppliers = (ViewBag.Suppliers as IEnumerable<KeyValueBean>).Where(a => a.Key == Model.CostList[i].SupplierId.ToString()).FirstOrDefault();
                    }
                    @Suppliers.Value
                </td>
                <td>
                    @Model.CostList[i].Cost
                </td>
                <td>
                    @Model.CostList[i].Num
                </td>
                <td>
                    @{
                        var itemcost = Model.CostList[i].Cost * Model.CostList[i].Num;
                    }@itemcost
                </td>
                <td title="@Model.CostList[i].Remark">
                    @Model.CostList[i].Remark.TrimWithElipsis(10)
                </td>
                <td>
                    @{
                        var payment = (ViewBag.Suppliers as IEnumerable<KeyValueBean>).Where(a => a.Key == Model.CostList[i].SupplierId.ToString()).FirstOrDefault().Help1;
                    }
                    @payment
                </td>
                <td>
                    @if (Model.CostList[i].Status < 2)
                    {
                        <input type="checkbox" data-content="@Model.CostList[i].Id" />
                    }
                    else
                    {
                        <input type="checkbox" data-content="@Model.CostList[i].Id" checked />
                    }
                </td>
            </tr>
        }
    </tbody>

    <tfoot>
        <tr>
            <td colspan="8" style="text-align: right; padding-right: 15px">
                现结：@Model.SumCost.XianShou 签单：@Model.SumCost.Qiandan  总计：@Model.SumCost.SumTolCost
            </td>
        </tr>
    </tfoot>
</table>
