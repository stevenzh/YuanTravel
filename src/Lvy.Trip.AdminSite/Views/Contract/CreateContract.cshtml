                                                </td>
                                                <td class="ta-c">
                                                    <label class="mt-checkbox mt-checkbox-outline ml-10 mt-5">
                                                        <input type="checkbox" value="0" name="isChildren">
                                                        <span></span>
                                                    </label>
                                                </td>
                                                <td>
                                                    <select name="passType" class="form-control required" nullmsg="请选择证件类型" placeholder="证件类型">
                                                        <option value="1">身份证</option>
                                                        <option value="2" selected="selected">护照</option>
                                                        <option value="4">港澳通行证</option>
                                                        <option value="5">军官证</option>
                                                        <option value="8">港澳回乡证</option>
                                                        <option value="9">台胞证</option>
                                                        <option value="10">香港身份证</option>
                                                        <option value="11">其他</option>
                                                    </select>
                                                </td>
                                                <td>
                                                    <input name="passNo" class="form-control" readonly="readonly" style="text-transform:uppercase;" value="@item.PassNo" nullmsg="游客证件号码" placeholder="证件号码">
                                                </td>
                                                <td>
                                                    <input name="phone" class="form-control" readonly="readonly" value="@item.Phone" placeholder="联系电话" errormsg="手机号码格式不正确">
                                                </td>
                                                <td>
                                                    <input name="health" class="form-control" value="健康" placeholder="个人健康信息">
                                                </td>
                                                <td class="line-height-30 font-size-14 ta-c">
                                                    <label class="mt-checkbox mt-checkbox-outline ml-10 mt-5">
                                                        <input name="isSign" type="checkbox" value="0" data-index="0">
                                                        <span></span>
                                                    </label>
                                                </td>
                                                @*<td class="ta-c vertical-align-middle">
                                                    <button type="button" class="btn btn-success btn-sm saveTourist" data-index="0">保存</button>
                                                    <button type="button" class="btn btn-danger btn-sm removeTourist" data-index="0">删除</button>
                                                </td>*@
                                            </tr>
                                            count++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="form-group ta-c">
                    <a href="#1" class="btn step-btn mr-10 prev-btn">上一步</a>
                    <a href="#3" class="btn step-btn ml-10 next-btn">下一步</a>
                </div>

            </div>

            <div id="step3" class="step-wrapper dn">
                <div class="contract-box">
                    <div class="title">
                        旅游者保险
                    </div>
                    <div class="content">
                        <div class="form-group mt-20">
                            <label class="fl form-lable font-size-14 line-height-30 required">乙方提示甲方购买旅游意外险。经乙方推荐，甲方</label>
                            <div class="col-md-1">
                                <select id="agreeToBuy" class="form-control required">
                                    <option value="true" @Html.Raw(contractVModel.Contract.agreeToBuy == true ? "selected=selected" : "")>同意</option>
                                    <option value="false" @Html.Raw(contractVModel.Contract.agreeToBuy == false ? "selected=selected" : "")>不同意</option>
                                </select>
                            </div>
                            <label class="fl form-lable font-size-14 line-height-30 required">委托乙方办理个人投保的旅游意外保险。</label>
                        </div>
                        <div class="form-group mt-20">
                            <label class="col-md-6 form-lable font-size-14 line-height-30">保险公司名称:</label>
                            <label class="col-md-6 form-lable font-size-14 line-height-30">产品名称:</label>
                        </div>
                        <div class="form-group mt-20">
                            <div class="col-md-6">
                                <input id="company" name="company" value="@contractVModel.Contract.company" class="form-control btn-circle input-icon" nullmsg="请输入保险公司名称" placeholder="保险公司名称" type="text">
                            </div>
                            <div class="col-md-6">
                                <input id="productName" name="productName" value="@contractVModel.Contract.productName" class="form-control btn-circle input-icon" nullmsg="请输入保险产品名称" placeholder="保险产品名称" type="text">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 form-lable font-size-14 line-height-30">保险费:</label>
                            <label class="col-md-6 form-lable font-size-14 line-height-30">保险金额:</label>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6">
                                <div class="input-group">
                                    <input id="premium" name="premium" value="@contractVModel.Contract.premium" class="form-control btn-circle input-icon" onblur="if(isNaN(value))execCommand('undo')" onkeyup="if(isNaN(value))execCommand('undo')" onafterpaste="if(isNaN(value))execCommand('undo')" nullmsg="请输入保险费" placeholder="保险费" type="text">
                                    <div class="input-group-addon">元</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-group">
                                    <input id="coverage" name="coverage" value="@contractVModel.Contract.coverage" class="form-control btn-circle input-icon" onblur="if(isNaN(value))execCommand('undo')" onkeyup="if(isNaN(value))execCommand('undo')" onafterpaste="if(isNaN(value))execCommand('undo')" nullmsg="请输入保险金额" placeholder="保险金额" type="text">
                                    <div class="input-group-addon">元</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="contract-box">
                    <div class="title">成团人数与不成团的约定</div>
                    <div class="content">
                        <div class="form-group mt-20">
                            <label class="fl form-lable font-size-14 line-height-30">成团人数与不成团的约定（二选一）</label>
                            <div class="col-md-1">
                                <select id="groupAgreementResolution" name="groupAgreementResolution" class="form-control required">
                                    <option value="1" selected="selected">选择(1)</option>
                                    <option value="2" )>选择(2)</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group mt-20">
                            <label class="fl form-lable font-size-14 line-height-30 ">（1）最低成团人数</label>
                            <div class="col-md-1">
                                <input id="leastCustomerNumber" name="leastCustomerNumber" value="@Model.TourPlan.MixedNum" class="form-control input-icon" type="text" onblur="if(isNaN(value))execCommand('undo')" onkeyup="if(isNaN(value))execCommand('undo')" onafterpaste="if(isNaN(value))execCommand('undo')" nullmsg="请输入最低成团人数" placeholder="请输入最低成团人数">
                            </div>
                            <label class="fl form-lable font-size-14 line-height-30 ">人。低于此人数不能成团时，乙方应当提前30日通知甲方，本合同解除，向甲方退还已收取的全部费用。</label>
                        </div>
                        <div class="form-group mt-20">
                            <label class="fl form-lable font-size-14">（2）本团成团不受最低人数限制。</label>
                        </div>
                    </div>
                </div>

                <!-- 成团人数与不成团的约定 -->
                <div class="contract-box">
                    <div class="title">
                        甲方解除合同及承担必要费用
                    </div>
                    <div class="content">
                        <div class="form-group">
                            <label class="fl form-lable font-size-14 line-height-30">因甲方自身原因导致合同解除，乙方按下列标准扣除必要费用后，将余款退还甲方（二选一）</label>
                            <div class="col-md-1">
                                <select id="solutionA" name="solutionA" class="form-control required">
                                    <option value="1" @Html.Raw(contractVModel.Contract.solutionA == "1" ? "selected=selected" : "")>选择(一)</option>
                                    <option value="2" @Html.Raw(contractVModel.Contract.solutionA == "2" ? "selected=selected" : "")>选择(二)</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="fl form-lable font-size-14 line-height-30">
                                (一)双方可以进行约定并从其约定：
                            </label>
                        </div>
                        <div class="form-group">
                            <label class="fl form-lable font-size-14 line-height-30 pl-30">
                                1．在行程前解除合同的，必要的费用扣除标准为：
                            </label>
                        </div>
                        @{
                            string deductStandardA = contractVModel.Contract.deductStandardA;
                            string[] arry = deductStandardA.Split('|');
                            if (arry.Length > 0)
                            {
                                for (int i = 0; i < arry.Length; i++)
                                {
                                    string partAStartId = "partAStart" + i;
                                    string partAEndId = "partAEnd" + i;
                                    string partARatioId = "partARatio" + i;
                                    string partAStartValue = arry[i].Split(',')[0];
                                    string partAEndValue = arry[i].Split(',')[1];
                                    string partARatioValue = arry[i].Split(',')[2];
                                    int no = i + 1;
                                    if (i == arry.Length - 1)
                                    {
                                        <div class="form-group">
                                            <label class="fl form-lable font-size-14 line-height-30 pl-60">
                                                （@no）行程开始当日，旅游费用
                                            </label>
                                            <div class="col-md-1">
                                                <input id="@partARatioId" value="@partARatioValue" class="form-control input-icon" type="text" onblur="if(isNaN(value))execCommand('undo')" onkeyup="if(isNaN(value))execCommand('undo')" onafterpaste="if(isNaN(value))execCommand('undo')">
                                            </div>
                                            <label class="fl form-lable font-size-14 line-height-30">
                                                %
                                            </label>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="form-group">
                                            <label class="fl form-lable font-size-14 line-height-30 pl-60">
                                                （@no）行程前
                                            </label>
                                            <div class="col-md-1">
                                                <input id="@partAStartId" value="@partAStartValue" class="form-control input-icon" type="text" onblur="if(isNaN(value))execCommand('undo')" onkeyup="if(isNaN(value))execCommand('undo')" onafterpaste="if(isNaN(value))execCommand('undo')">
                                            </div>
                                            <label class="fl form-lable font-size-14 line-height-30">
                                                日至
                                            </label>
                                            <div class="col-md-1">
                                                <input id="@partAEndId" value="@partAEndValue" class="form-control input-icon" type="text" onblur="if(isNaN(value))execCommand('undo')" onkeyup="if(isNaN(value))execCommand('undo')" onafterpaste="if(isNaN(value))execCommand('undo')">
                                            </div>
                                            <label class="fl form-lable font-size-14 line-height-30">
                                                日，旅游费用
