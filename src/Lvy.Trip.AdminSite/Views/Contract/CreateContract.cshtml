                        自愿付费项目补充协议(选填项)
                    </div>
                    <div class="content">
                        <div class="form-group  ">
                            <div class="col-md-12 pos-relative">
                                <table id="avoluntaryCostTemplate" border="0" class="form-table">
                                    <thead>
                                        <tr>
                                            <th>具体时间</th>
                                            <th>地点</th>
                                            <th>项目名称和内容</th>
