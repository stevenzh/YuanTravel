        pageOption.Contract.signingPassNo = $("#signingPassNo").val();//代表证件号
        pageOption.Contract.signingTouristType = $("input[name=signingTouristType]:checked").val();//游客类别
        pageOption.Contract.signingCompanyName = $("#signingCompanyName").val(); //单位
        pageOption.Contract.signingLicenseNo = $("#signingLicenseNo").val();//企业统一信用代码
        pageOption.Contract.signingAddress = $("#signingAddress").val();//地址
        pageOption.Contract.signingEmail = $("#signingEmail").val();//邮箱
        pageOption.Contract.signingIsJoin = $("input[name=signingIsJoin]:checked").val();//是否参团
        pageOption.Contract.signingSex = $("input[name=signingSex]:checked").val();//性别
        pageOption.Contract.agreeToBuy = $("#agreeToBuy option:selected").val();//是否购买保险
        pageOption.Contract.company = $("#company").val();//保险公司名称
        pageOption.Contract.productName = $("#productName").val();//产品名称
        pageOption.Contract.coverage = $("#coverage").val();//保险费
        pageOption.Contract.premium = $("#premium").val(); //保险金额

        pageOption.Contract.groupAgreementResolution = $("#groupAgreementResolution option:selected").val();//成团人数约定
