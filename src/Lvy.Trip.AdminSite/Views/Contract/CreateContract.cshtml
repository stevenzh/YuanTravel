                                                        <option value="5" @Html.Raw(item.passType == 5 ? "selected=selected" : "")>军官证</option>
                                                        <option value="8" @Html.Raw(item.passType == 8 ? "selected=selected" : "")>港澳回乡证</option>
                                                        <option value="9" @Html.Raw(item.passType == 9 ? "selected=selected" : "")>台胞证</option>
