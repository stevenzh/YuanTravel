        apiContractObj.signatory.fax = "";
        apiContractObj.signatory.mode = 1;//默认短信签约
        apiContractObj.signatory.signingPlace = "";

        //「游客名单」部分
        apiContractObj.touristsInfo = {};
        apiContractObj.touristsInfo.totalNumber = contractObj.TouristList.length;

        apiContractObj.touristsInfo.tourists = [];
        var childNumber = 0;
        if (contractObj.TouristList.length > 0) {
            contractObj.TouristList.map(function (o, index) {
                var touristInfo = {};
                touristInfo.number = index;
                touristInfo.isSigner = o.isSign;
                touristInfo.name = o.name;
                touristInfo.gender = o.gender;
                touristInfo.age = 0;
                touristInfo.isChild = o.isChildren;
                touristInfo.phone = o.phone;
                touristInfo.health = o.health;
                touristInfo.address = o.address;
                touristInfo.ID = {};
                touristInfo.ID.IDType = o.passType;
                touristInfo.ID.IDNumber = o.passNo;
                if (touristInfo.isChild) {
                    childNumber = childNumber + 1;
                }
                apiContractObj.touristsInfo.tourists.push(touristInfo);
            });
        }

        apiContractObj.touristsInfo.adultNumber = contractObj.TouristList.length - childNumber;
        apiContractObj.touristsInfo.childNumber = childNumber;

        //「委托社」部分
        apiContractObj.entrustedTravelAgency = {};
        apiContractObj.entrustedTravelAgency.agencyName = contractObj.Contract.entrustAgency;

        //「费用」部分
        apiContractObj.cost = {};
        apiContractObj.cost.guideServiceCost = contractObj.Contract.guideServiceCost;
        apiContractObj.cost.totalGuideServiceCost = contractObj.Contract.totalGuideServiceCost;
        apiContractObj.cost.totalCost = contractObj.Contract.totalCost;
        apiContractObj.cost.deadline = contractObj.Contract.deadline;
        apiContractObj.cost.paymentMethodDescription = contractObj.Contract.paymentMethod;
        apiContractObj.cost.overduePenaltyDayRatio = contractObj.Contract.overduePenaltyDayRatio;
        //「地接社」部分
        apiContractObj.localTravelAgencies = [];
        var localTripInfo = {};
        localTripInfo.description = "";
        localTripInfo.agencyName = contractObj.Contract.localAgencyName;
        localTripInfo.agencyAddress = {};
        localTripInfo.agencyAddress.description = contractObj.Contract.localAgencyAddress;
        localTripInfo.contactName = contractObj.Contract.localAgencyContact;
        localTripInfo.contactPhone = contractObj.Contract.localAgencyPhone;
        //「保险」部分
        apiContractObj.insurance = {};
        apiContractObj.insurance.agreeToBuy = contractObj.Contract.agreeToBuy;
        apiContractObj.insurance.productName = contractObj.Contract.productName;
        apiContractObj.insurance.company = contractObj.Contract.company;
        apiContractObj.insurance.coverage = contractObj.Contract.coverage;
        apiContractObj.insurance.premium = contractObj.Contract.premium;

        //「争议解决」部分
        apiContractObj.dispute = {};
        apiContractObj.dispute.resolution = contractObj.Contract.disputeResolution;
        apiContractObj.dispute.tribunalName = "";

        //「自费项目」部分
        apiContractObj.activities = [];
        if (contractObj.PayItemList.length > 0) {
            contractObj.PayItemList.map(function (o) {
                var payItemInfo = {};
                payItemInfo.date = o.date;
                payItemInfo.place = o.place;
                payItemInfo.item = o.item;
                payItemInfo.fee = o.fee;
                payItemInfo.stayDuration = o.stayDuration;
                payItemInfo.memo = o.memo;
                apiContractObj.activities.push(payItemInfo);
            });
        }

        //「购物」部分
        apiContractObj.hasShopping = contractObj.ShoppingList.length > 0 ? true : false;
        apiContractObj.shoppingViewSpot = contractObj.Contract.shoppingViewSpot;
        apiContractObj.shoppings = [];
        if (contractObj.ShoppingList.length > 0) {
            contractObj.ShoppingList.map(function (o) {
                var shoppingInfo = {};
                shoppingInfo.date = o.date;
                shoppingInfo.place = o.place;
                shoppingInfo.shoppingPlace = o.shoppingPlace;
                shoppingInfo.goods = o.goods;
                shoppingInfo.stayDuration = o.stayDuration;
                shoppingInfo.memo = o.memo;
                apiContractObj.shoppings.push(shoppingInfo);
            });
        }
        //「成团约定」部分
        apiContractObj.groupAgreement = {};
        apiContractObj.groupAgreement.resolution = 4;
        apiContractObj.groupAgreement.leastCustomerNumber = contractObj.Contract.leastCustomerNumber;
        apiContractObj.groupAgreement.agreeToChangeLine = false;
        apiContractObj.groupAgreement.mergeToCompanyName = contractObj.Contract.otherAgency;
        apiContractObj.groupAgreement.partAPenalty = {};
        apiContractObj.groupAgreement.partAPenalty.solution = contractObj.Contract.solutionA;
        apiContractObj.groupAgreement.partAPenalty.overdueDaysA = contractObj.Contract.overdueDaysA;
        apiContractObj.groupAgreement.partAPenalty.overdueDaysB = contractObj.Contract.overdueDaysA2;
        apiContractObj.groupAgreement.partAPenalty.cancel = {};
        apiContractObj.groupAgreement.partAPenalty.cancel.timeLimit = contractObj.Contract.timeLimitA;
        apiContractObj.groupAgreement.partAPenalty.cancel.interrupt = {};
        apiContractObj.groupAgreement.partAPenalty.cancel.interrupt.timeLimit = contractObj.Contract.timeLimitA2;
        apiContractObj.groupAgreement.partAPenalty.cancel.interrupt.formula = contractObj.Contract.formulaA.split('|');
        apiContractObj.groupAgreement.partAPenalty.cancel.standards = [];
        if (contractObj.Contract.deductStandardA != "" && contractObj.Contract.deductStandardA.split('|').length > 0) {
            var arry = contractObj.Contract.deductStandardA.split('|');
            console.log(arry);
            if (arry.length > 0) {
                arry.map(function (o) {
                    var standardInfo = {};
                    standardInfo.start = o.split(',')[0];
                    standardInfo.end = o.split(',')[1];
                    standardInfo.ratio = o.split(',')[2];
                    apiContractObj.groupAgreement.partAPenalty.cancel.standards.push(standardInfo);
                });
            }
        }
        apiContractObj.groupAgreement.partBPenalty = {};
        apiContractObj.groupAgreement.partBPenalty.solution = contractObj.Contract.solutionB;
        apiContractObj.groupAgreement.partBPenalty.overdueDaysA = contractObj.Contract.overdueDaysB;
        apiContractObj.groupAgreement.partBPenalty.overdueDaysB = contractObj.Contract.overdueDaysB2;
        apiContractObj.groupAgreement.partBPenalty.cancel = {};
        apiContractObj.groupAgreement.partBPenalty.cancel.timeLimit = contractObj.Contract.timeLimitB;
        apiContractObj.groupAgreement.partBPenalty.cancel.interrupt = {};
        apiContractObj.groupAgreement.partBPenalty.cancel.interrupt.timeLimit = contractObj.Contract.timeLimitB2;
        apiContractObj.groupAgreement.partBPenalty.cancel.interrupt.formula = "";
        apiContractObj.groupAgreement.partBPenalty.cancel.standards = [];
        if (contractObj.Contract.deductStandardB != "" && contractObj.Contract.deductStandardB.split('|').length > 0) {
            var arry = contractObj.Contract.deductStandardB.split('|');
            if (arry.length > 0) {
                arry.map(function (o) {
                    var standardInfo = {};
                    standardInfo.start = o.split(',')[0];
                    standardInfo.end = o.split(',')[1];
                    standardInfo.ratio = o.split(',')[2];
                    apiContractObj.groupAgreement.partBPenalty.cancel.standards.push(standardInfo);
                });
            }
        }
        apiContractObj.compensationPeriod = contractObj.Contract.compensationPeriod;
        apiContractObj.seriousCompensateRatio = contractObj.Contract.seriousCompensateRatio;
        apiContractObj.otherLiability = contractObj.Contract.otherLiability;
        return apiContractObj;
    }


</script>
