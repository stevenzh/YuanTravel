</div>

<script type="text/javascript">

    var editor, step = 1, signNum = 0;

    var ajaxConfig = {
        saveContractUrl: "@Url.Action("SaveContract")",
        applyContractUrl: "@Url.Action("ApplyContract")",
        fileUploadUrl: "@Url.Action("UploadContractFile")",
        updateContractUrl: "@Url.Action("UpdateContract")"
    };

    var contractTemplate = {
        outTrip: "C310000",
        domesticTrip: "A310000"
    }

    $(document).ready(function () {
        editor = new wangEditor('#travelItinerary');
        editor.create();
        initEvent();
        editor.txt.html($("#travelItineraryhidden").val());
    });

    function initEvent() {
        $('body').on('click', '#addBuyTemplate', function () {
            createBuyTemplate();
        });

        $('body').on('click', '.delBuyTemplate', function () {
            var _this = this;
            $(this).parents('tr').remove();
        });

        $('body').on('click', '#addCostTemplate', function () {
            createCostTemplate();
        });

        $('body').on('click', '.delBuyTemplate', function () {
            var _this = this;
            $(this).parents('tr').remove();
        });

        $('body').on('click', '.next-btn', function (e) {
            // e.preventDefault();
            step++;
            showStepWrapper();
        })

        $('body').on('click', '.prev-btn', function (e) {
            // e.preventDefault();
            step--;
            showStepWrapper();
        })

        $('body').on('click', '.create-btn', function (e) {
            e.preventDefault();
            var _thisLink = this;
            var contractNumber = $("#contractNumber").val();
            if (contractNumber != "") {
                layer.confirm('该订单已生成合同，是否更改？', {
                    btn: ['是', '否'],
                }, function (index, layero) {
                    layer.close(index);
                    saveCreateContract();
                }, function (index, layero) {
                    layer.close(index);
                });
            } else {
                saveCreateContract();
            }
        });

        $("#btnUpload").click(function () {
            if ($('.upload-image li').length >= 3) {
                layer.msg("只允许上传三个附件");
                return;
            }
            if ($.trim($("[name='ContractFileName']").val()) == "") {
                Utils.alert("请选择要上传的文件！");
                return;
            }
            var formData = new FormData();
            var name = $("[name='ContractFileName']").val();
            formData.append("ContractFileName", $("[name='ContractFileName']")[0].files[0]);
            //formData.append("name", name);
            formData.append("orderCode", orderCode);
            $.ajax({
                url: ajaxConfig.fileUploadUrl,
                type: 'POST',
                data: formData,
                // 告诉jQuery不要去处理发送的数据
                processData: false,
                // 告诉jQuery不要去设置Content-Type请求头
                contentType: false,
                success: function (data) {
                    if (data.code == "0") {
                        createFileTemplate(data.data);
                        $("#manager-recode-btn").val();
                    } else {
                        layer.msg(data.msg);
                    }
                }
            });
        });

        //返回提醒
        $('body').on("click", "#backBtn", function (e) {
            e.preventDefault();
            var _thisLink = this;
            var contractNumber = $("#contractNumber").val();
            if (contractNumber != "") {
                layer.confirm('确认返回并放弃本次操作吗？', {
                    btn: ['取消', '立即返回'],
                }, function (index, layero) {
                    layer.close(index);
                }, function (indx, layero) {
                    window.location.href = "/Contract/Index";
                });

            } else {
                layer.confirm('是否要保存合同数据后再返回?', {
                    btn: ['保存', '立即返回'],
                }, function (index, layero) {
                    layer.close(index);
                    saveCreateContract();
                }, function (indx, layero) {
                    window.location.href = $(_thisLink).attr('href');
                });
            }
        });

        additionContentList();

    }

    //其他约定事项请求函数
    function additionContentList() {
        var param = { content: $('#content').val() };
        $.ajax({
            url: '/Contract/UCAdditions',
            "type": 'post',
            data: { content: $('#content').val() },
            dataType: 'html',
            success: function (data) {
                $("#additionContentList").html(data);
                $("#additionContentList li").on("click", function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    if ($(this).find("span").hasClass("additionContentListClick")) {
                        $(this).find("span").removeClass("additionContentListClick")
                    } else {
                        $(this).find("span").addClass("additionContentListClick")
                        var additionContent = $(this).parents().find("#additionContent").val();
                        if (additionContent == "") {
                            var val = additionContent + $(this).attr("title");
                        } else {
                            var val = additionContent + "\n" + $(this).attr("title");
                        }
                        $("#additionContent").val(val);
                    }

                });
                $('#content').unbind();
                $('#content').bind("input propertychange", function () {
                    additionContentList();
                });

                $("#clearnAddition").unbind();
                $("#clearnAddition").on("click", function (e) {
                    $("#additionContent").val("")
                })
            },
            error: function (jqXHR) {
                layer.msg('登录异常，请重新登录。');
            }
        })
    };

    function createBuyTemplate() {
        var element = $('.addBuyTemplate');
        var html = "<tr>";
        html += ' <td><input name="date" datatype="d" onfocus="WdatePicker({isShowClear:false,readOnly:true})" style="display: inline-block!important;width: 60%!important;" class="form-control" nullmsg="请填写自愿购物时间" placeholder="时间" /></td> ';
        html += ' <td><input name="place" datatype="*" class="form-control" value="" nullmsg="请填写自愿购物地点" placeholder="地点"></td>';
        html += ' <td><input name="shoppingPlace" datatype="*" class="form-control" value="" nullmsg="请填写自愿购物场所名称" placeholder="名称"></td>';
        html += ' <td><input name="goods" datatype="*" class="form-control" value="" nullmsg="请填写自愿购物商品信息" placeholder="商品信息"></td>';
        html += ' <td><input name="stayDuration" datatype="n" class="form-control" value="" nullmsg="请填写自愿购物停留时间" placeholder="停留时间"></td>';
        html += ' <td><input name="memo" datatype="*" class="form-control" value="" nullmsg="请填写自愿购物其他说明" placeholder="其他说明"></td>';
        html += ' <td> <a href="javascript:void(0);" class="delBuyTemplate">删除</a></td>';
        html += "</tr>";
        element.append(html);
    }

    function createCostTemplate() {
        var element = $('.addCostTemplate');
        var html = "<tr>";
        html += ' <td><input name="date" datatype="d" onfocus="WdatePicker({isShowClear:false,readOnly:true})" style="display: inline-block!important;width: 60%!important;" class="form-control" nullmsg="请填写自愿付费项目时间" placeholder="时间" /></td> ';
        html += '  <td><input datatype="*" class="form-control" name="place" value="" nullmsg="请填写自愿付费项目地点" placeholder="地点"></td>';
        html += '  <td><input datatype="*" class="form-control" name="item" value="" nullmsg="请填写自愿购付费项目名称" placeholder="名称"></td>';
        html += '  <td><input datatype="*" class="form-control" name="fee" value="" nullmsg="请填写自愿付费项目费用" placeholder="费用"></td>';
        html += '  <td><input datatype="n" class="form-control" name="stayDuration" value="" nullmsg="请填写自愿付费项目时长" placeholder="项目时长"></td>';
        html += '  <td><input class="form-control" name="memo" value="" nullmsg="请填写自愿付费项目其他说明" placeholder="其他说明"></td>';
        html += '  <td> <a href="javascript:void(0);" class="delBuyTemplate">删除</a>  </td>';
        html += "</tr>";
        element.append(html);
    }

    function createFileTemplate(jsonData) {
        console.log(jsonData);
        var element = $('.upload-image');
        var filePath = $("#picroot").val() + jsonData.filePath;
        var html = "";
        html += " <li> ";
        html += "      <div class=\"data-image\" data-path=\"" + filePath + "\" data-name='" + jsonData.fileName + "' >";
        html += "          <a href='" + filePath + "' class=\"file-name\">" + jsonData.fileName + "</a>";
        html += "          <a href=\"javascript:void(0);\" class=\"del-img-btn\">删除</a>";
        html += "      </div>";
        html += "  </li>";
        element.append(html);
        $(".del-img-btn").click(function () {
            var _this = this;
            $(_this).parents('li').remove();
        });
    }

    function showStepWrapper() {
        var _this = this;
        $('.step-wrapper').addClass('dn');
        $('#step' + _this.step).removeClass('dn');

        $('.stepIco').removeClass('active');
        $('.stepIco:eq(' + (_this.step - 1) + ')').addClass('active');
    }

    function initPageOption() {
        var pageOption = {};
        pageOption.Contract = {};
        pageOption.Contract.contractNumber = $("#contractNumber").val();
        pageOption.Contract.templateId = contractTemplate.outTrip;
        pageOption.Contract.orderCode = $("#orderCode").val();
        pageOption.Contract.agencyName = $("#agencyName").val();//旅行社名称
        pageOption.Contract.agencyAddress = $("#agencyAddress").val();//联系地址
        pageOption.Contract.licenseCode = $("#licenseCode").val();//许可证书
        pageOption.Contract.creditCode = $("#creditCode").val();
        pageOption.Contract.transactorName = $("#transactorName").val();//联系人
        pageOption.Contract.transactorPhone = $("#transactorPhone").val();//联系人电话
        pageOption.Contract.routeName = $("#routeName").val();//旅游产品名称
        pageOption.Contract.groupId = $("#groupId").val();//团号
        pageOption.Contract.groupMode = $("input[name=groupMode]:checked").attr('data-mode');//组团方式
        pageOption.Contract.entrustAgency = $("#entrustAgency").val();//委托社名称
        pageOption.Contract.otherAgency = $("#otherAgency").val();//其他社名称
        pageOption.Contract.startDate = $("#startDate").val();//出发日期
        pageOption.Contract.departureCity = $("#departureCity").val();//出发地点
        pageOption.Contract.passCity = $("#passCity").val();//途径地点
        pageOption.Contract.arrivalCity = $("#arrivalCity").val();//目的地
        pageOption.Contract.endDate = $("#endDate").val();//结束日期
        pageOption.Contract.endCity = $("#endCity").val();//结束地点
        pageOption.Contract.attraction = $("#attraction").val();//游览景点
        pageOption.Contract.longTransport = $("#longTransport").val();//往返交通
        pageOption.Contract.longStandard = $("#longStandard").val();//往返交通标准
        pageOption.Contract.localTransport = $("#localTransport").val();//浏览交通
        pageOption.Contract.localStandard = $("#localStandard").val();//浏览交通标准
        pageOption.Contract.freeTime = $("#freeTime").val();//自由活动时间
        pageOption.Contract.freeNumber = $("#freeNumber").val();//自由活动次数
        pageOption.Contract.hotelDesc = $("#hotelDesc").val();//住宿安排
        pageOption.Contract.mealNumber = $("#mealNumber").val();//用餐次数
        pageOption.Contract.mealStandard = $("#mealStandard").val();//用餐标准
        pageOption.Contract.localAgencyName = $("#localAgencyName").val();//地接社名称
        pageOption.Contract.localAgencyAddress = $("#localAgencyAddress").val();//地接社地址
        pageOption.Contract.localAgencyContact = $("#localAgencyContact").val();//地接社联系人
        pageOption.Contract.localAgencyPhone = $("#localAgencyPhone").val();//地地接社联系电话
        pageOption.Contract.travelItinerary = editor.txt.html();//行程信息
        pageOption.Contract.totalCost = $("#totalCost").val();//旅游费用
        pageOption.Contract.guideServiceCost = $("#guideServiceCost").val();//导游服务费（元）/每人
        pageOption.Contract.totalGuideServiceCost = $("#totalGuideServiceCost").val();//导游服务费总费用（元）
        pageOption.Contract.deadline = $("#deadline").val();//费用缴纳期限
        pageOption.Contract.paymentMethod = $("#paymentMethod option:selected").val();//支付方式
        pageOption.Contract.otherPaymethod = $("#otherPaymethod").val();//其他支付方式描述
        pageOption.Contract.signingName = $("#signingName").val();//代表名称
        pageOption.Contract.signingPhone = $("#signingPhone").val();//代表电话
