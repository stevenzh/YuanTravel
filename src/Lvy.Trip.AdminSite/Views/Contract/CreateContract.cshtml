@model Lvy.VModels.Order.OrderEditVModel
@using Lvy.VModels.Contract
@{
    ViewBag.Title = "";
    var picroot = Arch.Common.AppSetting.Get("UploadFileRoot");
    string CDNServerUrl = Arch.Common.AppSetting.Get("CDNServerUrl");
    ContractVModel contractVModel = ViewBag.Contract;
    if (contractVModel == null)
    {
        contractVModel = new ContractVModel();
    }
}

@section AdditionalResources{
    <link href="@CDNServerUrl/bootstrap-3.3.7/css/bootstrap.min.css" rel="stylesheet" />
    <link href="@CDNServerUrl/select2/css/select2.min.css" rel="stylesheet" />
    <link href="~/WebRes/contract/simple-line-icons.css" rel="stylesheet" />
    <link href="~/WebRes/contract/layout.css" rel="stylesheet" />
    <link href="~/WebRes/contract/components.css" rel="stylesheet" />
    <link href="~/WebRes/contract/style.css" rel="stylesheet" />
    <link href="~/WebRes/contract/default.css" rel="stylesheet" />
    <link href="~/WebRes/contract/dropload.css" rel="stylesheet" />
    <link href="~/WebRes/contract/edslider.css" rel="stylesheet" />
    <link href="~/WebRes/contract/inform.css" rel="stylesheet" />
    <link href="~/WebRes/contract/jquery.mCustomScrollbar.css" rel="stylesheet" />
    @*<link href="~/WebRes/contract/laydate.css" rel="stylesheet" />*@
    <link href="~/WebRes/contract/css/layer.css" rel="stylesheet" />
    <link href="~/WebRes/contract/main.css" rel="stylesheet" />
    <link href="~/WebRes/contract/wangEditor-3.1.1/wangEditor.min.css" rel="stylesheet" />

    <script src="~/WebRes/contract/datepicker.js"></script>
    <script src="~/WebRes/Scripts/My97DatePicker/WdatePicker.js" type="text/javascript"></script>
    <script src="~/WebRes/contract/wangEditor-3.1.1/wangEditor.min.js"></script>
    <script src="~/WebRes/contract/layer/layer.js"></script>
    <style type="text/css">
        body { overflow: auto; background-color: #808080; }
        .content-wrapper { margin: 0; }
    </style>
}

<div class="contract-wrapper">
    <div class="fixed-header">
        <div class="title">上海出境游合同</div>
        <div class="btns">
            <div class="clear-20"></div>
            <a class="btn btn1" id="backBtn" href="@Url.Action("Index","Contract")">&nbsp;&nbsp;&nbsp;返回&nbsp;&nbsp;&nbsp;</a>
        </div>
        <div class="stepInfo">
            <ul>
                <li></li>
                <li></li>
            </ul>
            <div class="stepIco stepIco1 active">
                <span>1</span>
                <div class="stepText">产品信息和费用</div>
            </div>
            <div class="stepIco stepIco2">
                <span>2</span>
                <div class="stepText">游客代表和游客信息</div>
            </div>
            <div class="stepIco stepIco3">
                <span>3</span>
                <div class="stepText">其他约定信息</div>
            </div>
        </div>
    </div>

    <div class="clear-200"></div>

    @if (Model != null)
    {
        <form id="contractForm">

            <input id="orderCode" type="hidden" name="orderCode" value="@ViewBag.OrderCode" />
            <input id="contractNumber" type="hidden" name="contractNumber" value="@contractVModel.Contract.contractNumber" />
            <input id="picroot" type="hidden" name="picroot" value="@picroot" />
            <input id="travelItineraryhidden" type="hidden" name="travelItineraryhidden" value="@contractVModel.Contract.travelItinerary" />

            <div id="step1" class="step-wrapper">
                <!-- 合同主体 -->
                <div class="contract-box">
                    <div class="title">
                        合同主体
                    </div>
                    <div class="content">
                        <div class="form-group">
                            <label class="col-md-6 form-lable font-size-14 line-height-30 required">旅行社名称:</label>
                        </div>
                        <div class="form-group">
                            <div class="col-md-12">
                                <input id="agencyName" name="agencyName" class="form-control btn-circle input-icon" value="上海新康辉国际旅行社有限责任公司" type="text" readonly="readonly">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 form-lable font-size-14 line-height-30 required">旅行社地址:</label>
                            <label class="col-md-6 form-lable font-size-14 line-height-30 required">经营许可证号:</label>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6">
                                <input id="agencyAddress" name="agencyAddress" class="form-control btn-circle input-icon" value="上海市杨浦区国和路36号15幢3598室" type="text" readonly="readonly">
                            </div>
                            <div class="col-md-6">
                                <input id="licenseCode" name="licenseCode" class="form-control btn-circle input-icon" value="L-SH-CJ00042" type="text" readonly="readonly">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 form-lable font-size-14 line-height-30 required">统一社会信用代码:</label>
                        </div>
                        <div class="form-group">
                            <div class="col-md-12">
                                <input id="creditCode" name="creditCode" class="form-control btn-circle input-icon" value="913101107345589190" type="text" readonly="readonly">
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-md-6 form-lable font-size-14 line-height-30 required">旅行社经办人:</label>
                            <label class="col-md-6 form-lable font-size-14 line-height-30 required">经办人电话:</label>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6">
                                <input id="transactorName" name="transactorName" value="@Html.Raw(string.IsNullOrEmpty(contractVModel.Contract.transactorName)?"安琪":contractVModel.Contract.transactorName)" class="form-control btn-circle input-icon" nullmsg="请输入经办人" type="text">
                            </div>
                            <div class="col-md-6">
                                <input id="transactorPhone" name="transactorPhone" value="@Html.Raw(string.IsNullOrEmpty(contractVModel.Contract.transactorPhone)?"18964072143":contractVModel.Contract.transactorPhone)" class="form-control btn-circle input-icon" errormsg="请输入经办人联系电话" type="text">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 线路行程时间 -->
                <div class="contract-box">
                    <div class="title">
                        线路行程时间
                    </div>
                    <div class="content">
                        <div class="form-group">
                            <label class="col-md-12 form-lable font-size-14 line-height-30 required">旅游产品名称:</label>
                        </div>
                        <div class="form-group">
                            <div class="col-md-10">
                                <input id="routeName" name="routeName" class="form-control btn-circle input-icon" autocomplete="off" value="@Model.Order.Line.LineName" datatype="*" nullmsg="请输入线路名称" placeholder="请输入线路名称" type="text">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 form-lable font-size-14 line-height-30">团号:</label>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6">
                                <input id="groupId" name="groupId" class="form-control btn-circle input-icon" value="@Model.TourPlan.TourNo" nullmsg="请输入团号" placeholder="请输入团号" type="text">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-12 form-lable font-size-14 line-height-30 required">组团方式:</label>
                        </div>
                        <div class="form-group">
                            <div class="col-md-12">
                                <label class="fl form-lable font-size-14 line-height-30">
                                    <input class="fl m-10" type="radio" data-mode="1" name="groupMode" @Html.Raw(contractVModel.Contract.groupMode == 1 ? "checked=checked" : "")>
                                    <span class="fl pl-20">自行组团</span>
                                </label>
                            </div>
                            <div class="col-md-12">
                                <label class="fl form-lable font-size-14 line-height-30">
                                    <input class="fl m-10" type="radio" data-mode="2" name="groupMode" @Html.Raw(contractVModel.Contract.groupMode == 2 ? "checked=checked" : "")>
                                    <span class="fl pl-20">委托组团</span>

                                </label>
                                <label class="fl form-lable font-size-14 line-height-30">（委托社名称</label>
                                <div class="col-md-3">
                                    <input id="entrustAgency" name="entrustAgency" class="form-control btn-circle input-icon" nullmsg="请输入委托社名称" placeholder="请输入委托社名称" type="text" value="@contractVModel.Contract.entrustAgency">
                                </div>
                                <label class="fl form-lable font-size-14 line-height-30">）</label>
                            </div>
                            <div class="col-md-12">
                                <label class="fl form-lable font-size-14 line-height-30">
                                    <input class="fl m-10" type="radio" data-mode="3" name="groupMode" @Html.Raw(contractVModel.Contract.groupMode == 3 ? "checked=checked" : "")>
                                    <span class="fl pl-20">拼团</span>
                                </label>
                                <label class="fl form-lable font-size-14 line-height-30">（其他社全称</label>
                                <div class="col-md-3">
                                    <input id="otherAgency" name="otherAgency" class="form-control btn-circle input-icon" nullmsg="请输入其他社全称" placeholder="请输入其他社全称" type="text" value="@contractVModel.Contract.otherAgency">
                                </div>
                                <label class="fl form-lable font-size-14 line-height-30">）</label>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 form-lable font-size-14 line-height-30 required">出发日期:</label>
                            <label class="col-md-6 form-lable font-size-14 line-height-30 required">出发地点:</label>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6">
                                <input id="startDate" name="startDate" class="form-control btn-circle input-icon input-readonly" readonly="" value="@Model.Order.OutDate.ToDateFormat()" datatype="*" onfocus="WdatePicker({isShowClear:false,readOnly:true})" nullmsg="请选择出发日期" placeholder="请选择出发日期" type="text" lay-key="1">
                            </div>

                            <div class="col-md-6">
                                <input id="departureCity" name="departureCity" value="@(contractVModel.Contract.departureCity.IsNullOrEmpty()? DictionaryTools.GetDestNameStr(@Model.Order.Line.DepartDest):contractVModel.Contract.departureCity)" class="form-control btn-circle input-icon" datatype="*" nullmsg="请输入出发地点" placeholder="请输入出发地点" type="text">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 form-lable font-size-14 line-height-30">途径地点（经停地点）:</label>
                            <label class="col-md-6 form-lable font-size-14 line-height-30 required">目的地:</label>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6">
                                <input id="passCity" name="passCity" value="见行程" class="form-control btn-circle input-icon" autocomplete="off" placeholder="途径地点（经停地点）" type="text">
                            </div>
                            <div class="col-md-6">
                                <input id="arrivalCity" name="arrivalCity" value="@(contractVModel.Contract.arrivalCity.IsNullOrEmpty()? DictionaryTools.GetDestNameStr(@Model.Order.Line.ArriveDest):contractVModel.Contract.arrivalCity)" class="form-control btn-circle input-icon" datatype="*" nullmsg="请输入目的地" placeholder="请输入目的地" type="text">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 form-lable font-size-14 line-height-30 required">结束日期:</label>
                            <label class="col-md-6 form-lable font-size-14 line-height-30 required">返回地点:</label>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6">
                                <input id="endDate" name="endDate" value="@Model.Order.OutDate.AddDays(Model.Order.Line.TravelDays).ToString("yyyy-MM-dd")" class="form-control btn-circle input-icon input-readonly" readonly="" datatype="*" onfocus="WdatePicker({isShowClear:false,readOnly:true})" nullmsg="请选择结束日期" placeholder="请选择结束日期" type="text" lay-key="2">
                            </div>

                            <div class="col-md-6">
                                <input id="endCity" name="endCity" value="@(contractVModel.Contract.endCity.IsNullOrEmpty()? DictionaryTools.GetDestName(Model.TourPlan.PortOfExit.ToString()):contractVModel.Contract.endCity)" class="form-control btn-circle input-icon" datatype="*" nullmsg="请输入返回地点" placeholder="请输入返回地点" type="text">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-12 form-lable font-size-14 line-height-30 required">景点名称和浏览时间:</label>
                        </div>
                        <div class="form-group">
                            <div class="col-md-10">
                                <input id="attraction" name="attraction" value="见行程" class="form-control btn-circle input-icon" autocomplete="off" placeholder="景点名称和浏览时间" datatype="*" type="text">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 form-lable font-size-14 line-height-30 ">往返交通:</label>
                            <label class="col-md-6 form-lable font-size-14 line-height-30 ">标准:</label>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6">
                                <input id="longTransport" name="longTransport" value="见行程" class="form-control btn-circle input-icon" placeholder="请输入往返交通" type="text">
                            </div>
                            <div class="col-md-6">
                                <input id="longStandard" name="longStandard" value="见行程" class="form-control btn-circle input-icon" placeholder="请输入标准" type="text">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 form-lable font-size-14 line-height-30 ">浏览交通:</label>
                            <label class="col-md-6 form-lable font-size-14 line-height-30 ">标准:</label>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6">
                                <input id="localTransport" name="localTransport" value="见行程" class="form-control btn-circle input-icon" placeholder="请输入浏览交通" type="text">
                            </div>
                            <div class="col-md-6">
                                <input id="localStandard" name="localStandard" value="见行程" class="form-control btn-circle input-icon" placeholder="请输入标准" type="text">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 form-lable font-size-14 line-height-30 ">旅游者自由活动时间:</label>
                            <label class="col-md-6 form-lable font-size-14 line-height-30 ">次数:</label>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6">
                                <input id="freeTime" name="freeTime" class="form-control btn-circle input-icon" placeholder="请输入旅游者自由活动时间" type="text" value="见行程">
                            </div>
                            <div class="col-md-6">
                                <input id="freeNumber" name="freeNumber" class="form-control btn-circle input-icon" placeholder="请输入次数" type="text" value="见行程">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-12 form-lable font-size-14 line-height-30 ">住宿安排（名称）及标准和住宿天数：:</label>
                        </div>
                        <div class="form-group">
                            <div class="col-md-10">
                                <input id="hotelDesc" name="hotelDesc" class="form-control btn-circle input-icon" autocomplete="off" placeholder="住宿安排（名称）及标准和住宿天数：" value="见行程" type="text">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 form-lable font-size-14 line-height-30 ">用餐次数:</label>
                            <label class="col-md-6 form-lable font-size-14 line-height-30 ">标准:</label>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6">
                                <input id="mealNumber" name="mealNumber" class="form-control btn-circle input-icon" placeholder="请输入用餐次数" type="text" value="见行程">
                            </div>
                            <div class="col-md-6">
                                <input id="mealStandard" name="mealStandard" class="form-control btn-circle input-icon" placeholder="请输入标准" type="text" value="见行程">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 form-lable font-size-14 line-height-30 ">地接社名称:</label>
                            <label class="col-md-6 form-lable font-size-14 line-height-30 ">地址:</label>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6">
                                <input id="localAgencyName" name="localAgencyName" value="见行程" class="form-control btn-circle input-icon" placeholder="请输入地接社名称" type="text">
                            </div>
                            <div class="col-md-6">
                                <input id="localAgencyAddress" name="localAgencyAddress" value="见行程" class="form-control btn-circle input-icon" placeholder="请输入地址" type="text">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 form-lable font-size-14 line-height-30 ">地接社联系人:</label>
                            <label class="col-md-6 form-lable font-size-14 line-height-30 ">联系电话:</label>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6">
                                <input id="localAgencyContact" name="localAgencyContact" value="见行程" class="form-control btn-circle input-icon" placeholder="请输入地接社联系人" type="text">
                            </div>
                            <div class="col-md-6">
                                <input id="localAgencyPhone" name="localAgencyPhone" value="见行程" class="form-control btn-circle input-icon" errormsg="请输入联系电话" placeholder="请输入联系电话" type="text">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 form-lable font-size-14 line-height-30 ">行程信息:</label>
                        </div>
                        <div class="form-group">
                            <div style="width:100%">
                                <span id="travelItinerary" name="travelItinerary" nullmsg="请填写行程信息"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 旅游费用及支付 -->
                <div class="contract-box">
                    <div class="title">
                        旅游费用及支付
                    </div>
                    <div class="content">
                        <div class="form-group mt-20">
                            <label class="fl form-lable font-size-14 line-height-30 required">甲方应交纳旅游费用:</label>
                            <div class="col-md-2">
                                <input id="totalCost" name="totalCost" class="form-control btn-circle input-icon" value="@Model.Order.TolYsPrice" datatype="money" errormsg="请正确输入金额格式(小数点后两位)" nullmsg="请输入甲方应交纳旅游费" placeholder="甲方应交纳旅游费" type="text">
                            </div>
                            <label class="fl form-lable font-size-14 line-height-30">元（含领队、导游服务费用</label>
                            <div class="col-md-2">
                                <input id="guideServiceCost" name="guideServiceCost" onblur="if(isNaN(value))execCommand('undo')" onkeyup="if(isNaN(value))execCommand('undo')" onafterpaste="if(isNaN(value))execCommand('undo')" class="form-control btn-circle input-icon" value="@contractVModel.Contract.guideServiceCost" datatype="money" errormsg="请正确输入金额格式(小数点后两位)" nullmsg="请输入领队、导游服务费" placeholder="领队、导游服务费" type="text">
                            </div>
                            <label class="fl form-lable font-size-14 line-height-30">元/人，合计</label>
                            <div class="col-md-2">
                                <input id="totalGuideServiceCost" name="totalGuideServiceCost" onblur="if(isNaN(value))execCommand('undo')" onkeyup="if(isNaN(value))execCommand('undo')" onafterpaste="if(isNaN(value))execCommand('undo')" class="form-control btn-circle input-icon" value="@contractVModel.Contract.totalGuideServiceCost" datatype="money" errormsg="请正确输入金额格式(小数点后两位)" nullmsg="请输入合计金额" placeholder="合计金额" type="text">
                            </div>
                            <label class="fl form-lable font-size-14 line-height-30">元）</label>
                        </div>
                        <div class="form-group">
                            <label class="col-md-6 form-lable font-size-14 line-height-30 required">旅游费用交纳期限:</label>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6">
                                <input id="deadline" name="deadline" class="form-control btn-circle input-icon" datatype="*" placeholder="请输入旅游费用交纳期限" type="text" value="@contractVModel.Contract.deadline" onfocus="WdatePicker({isShowClear:false,readOnly:true})" lay-key="3">
                            </div>
                        </div>
                        <div class="form-group mt-20">
                            <label class="fl form-lable font-size-14 line-height-30 required">旅游费用支付方式:</label>
                            <div class="col-md-1">
                                <select id="paymentMethod" name="paymentMethod" class="form-control required" nullmsg="请选择支付方式" placeholder="旅游费用支付方式">
                                    <option value="现金" @Html.Raw(contractVModel.Contract.payMethod == "现金" ? "selected=selected" : "")>1</option>
                                    <option value="支票" @Html.Raw(contractVModel.Contract.payMethod == "支票" ? "selected=selected" : "")>2</option>
                                    <option value="信用卡" @Html.Raw(contractVModel.Contract.payMethod == "信用卡" ? "selected=selected" : "")>3</option>
                                    <option value="其他" @Html.Raw(contractVModel.Contract.payMethod == "其他" ? "selected=selected" : "")>4</option>
                                </select>
                            </div>
                            <label class="fl form-lable font-size-14 line-height-30">种方式缴纳费用:</label>
                        </div>
                        <div class="form-group mt-20">
                            <label class="fl form-lable font-size-14">（1）现金；</label>
                        </div>
                        <div class="form-group mt-20">
                            <label class="fl form-lable font-size-14">（2）支票；</label>
                        </div>
                        <div class="form-group mt-20">
                            <label class="fl form-lable font-size-14">（3）信用卡；</label>
                        </div>
                        <div class="form-group mt-20">
                            <label class="fl form-lable font-size-14">（4）其他；</label>
                            <div class="col-md-2">
                                <input id="otherPaymethod" name="otherPaymethod" class="form-control btn-circle input-icon" type="text" nullmsg="请输入其他缴纳费用方式" placeholder="请输入其他缴纳费用方式" value="@contractVModel.Contract.otherPaymethod">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group ta-c">
                    <a href="#2" class="btn step-btn next-btn">下一步</a>
                </div>
            </div>

            <div id="step2" class="step-wrapper dn">
                <!-- 游客代表和游客信息 -->
                <div class="contract-box">
                    <div class="title" style="position: relative;">游客信息</div>
                    <div class="content">
                        <div id="btour">
                            <div class="behalf-tourist-box">
                                <div class="behalf-tourist-title">
                                    签署人/游客代表信息
                                </div>
                                <div class="content">
                                    <div class="form-group">
                                        <div class="col-md-4">
