                                    </label>
                                    <label class="fl form-lable font-size-14 line-height-30">（委托社名称</label>
                                    <div class="col-md-3">
                                        <input class="form-control btn-circle input-icon" nullmsg="请输入委托社名称" placeholder="请输入委托社名称" type="text" id="entrustedTravelAgencyAgencyName" value="">
                                    </div>
                                    <label class="fl form-lable font-size-14 line-height-30">）</label>
                                </div>
                                <div class="col-md-12">
                                    <label class="fl form-lable font-size-14 line-height-30">
                                        <input class="fl m-10" type="radio" data-mode="3" name="groupAgreementMode">
                                        <span class="fl pl-20">拼团</span>

                                    </label>
                                    <label class="fl form-lable font-size-14 line-height-30">（其他社全称</label>
                                    <div class="col-md-3">
                                        <input class="form-control btn-circle input-icon" nullmsg="请输入其他社全称" placeholder="请输入其他社全称" type="text" id="groupAgreementMergeToCompanyName" value="">
                                    </div>
                                    <label class="fl form-lable font-size-14 line-height-30">）</label>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-md-6 form-lable font-size-14 line-height-30 required">出发日期:</label>
                                <label class="col-md-6 form-lable font-size-14 line-height-30 required">出发地点:</label>
                            </div>
                            <div class="form-group">
                                <div class="col-md-6">
                                    <input class=" form-control btn-circle input-icon input-readonly" readonly="" id="startDate" name="startDate" value="" datatype="*" nullmsg="请选择出发日期" placeholder="请选择出发日期" type="text" lay-key="1">
                                </div>

                                <div class="col-md-6">
                                    <input class="form-control btn-circle input-icon" id="departureCityDescription" datatype="*" nullmsg="请输入出发地点" placeholder="请输入出发地点" type="text" value="">
                                </div>
                            </div>
                            <div class="form-group">
