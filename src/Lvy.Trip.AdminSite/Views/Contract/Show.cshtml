    <script type="text/javascript">

        var cardTypeList = [];
        var showMessage = 0;
        var nationalsArray = [];

        function saveTourist(data) {
            var tourist = {
                name: verdict($('#name')),
                gender: verdict($('#gender')),
                age: "",
                race: "",
                memo: "",
                isRep: false,
                ID: {
                    IDType: verdict($('#IDType')),
                    IDNumber: verdict($('#IDNumber')),
                },
                phone: verdict($('#phone')),
                health: verdict($('#health')),
            };
            tourist.isSigner = $('#isSigner').prop('checked') ? 1 : 0;
            tourist.isChild = $('#isChild').prop('checked') ? 1 : 0;
            var travel_flag = 0;
            var travel_index = $('#isSigner').data("index");
            if ($('#isSigner').prop('checked')) {
                if (data.tourists.length > 0) {
                    for (var i = 0; i < data.tourists.length; i++) {
                        if (i != travel_index) {
                            if (data.tourists[i].isSigner == 1 && data.tourists[i].phone == tourist.phone) {
                                travel_flag++;
                            }
                        }
                    }
                }
            }

            if (tourist.name == "") {
                layer.msg('请输入游客姓名!');
                $('#name').focus();
                $('#name').addClass("redBorder")
                $('#name').blur(function () {
                    $('#name').removeClass("redBorder")
                });
                return false;
            }

            if (tourist.name.length > 30) {
                layer.msg("游客姓名不能超过30个字符，请重新输入。");
                $('#name').focus();
                $('#name').addClass("redBorder")
                $('#name').blur(function () {
                    $('#name').removeClass("redBorder")
                });
                return false;
            }

            if (tourist.isChild == 0 && tourist.ID.IDNumber == "") {
                layer.msg('请输入游客证件号码!');
                $('#IDNumber').focus();
                $('#IDNumber').addClass("redBorder")
                $('#IDNumber').blur(function () {
                    $('#IDNumber').removeClass("redBorder")
                });
                return false;
            }

            if (tourist.isChild == 0 && tourist.phone == "") {
                layer.msg('请输入游客联系电话!');
                $('#phone').focus();
                $('#phone').addClass("redBorder")
                $('#IDNumber').blur(function () {
                    $('#IDNumber').removeClass("redBorder")
                });
                return false;
            }

            if (verdict($('#beIDType')) == tourist.ID.IDType && verdict($('#beIDNumber')).toUpperCase() == tourist.ID.IDNumber.toUpperCase()) {
                layer.msg('游客代表和游客证件号重复!');
                $('#beIDType').focus();
                $('#beIDType').addClass("redBorder")
                $('#beIDType').blur(function () {
                    $('#beIDType').removeClass("redBorder")
                });
                return false;
            }

            if (tourist.phone == $("#bePhone").val().trim() && tourist.isSigner == 1) {
                layer.msg('签署游客手机号与游客代表手机号码不得重复!');
                $('#bePhone').focus();
                $('#bePhone').addClass("redBorder")
                $('#bePhone').blur(function () {
                    $('#bePhone').removeClass("redBorder")
                });
                return false;
            }

            if (tourist.ID.IDNumber != "" && tourist.ID.IDType == 1) {
                var cardReg = /^[1-9]\d{7}((0\d)|(1[0-2]))(([0|1|2]\d)|3[0-1])\d{3}$|^[1-9]\d{5}[1-9]\d{3}((0\d)|(1[0-2]))(([0|1|2]\d)|3[0-1])\d{3}([0-9]|X|x)$/;
                if (!idCardVerify(tourist.ID.IDNumber)) {
                    layer.msg('身份证号码错误');
                    $('#IDNumber').focus();
                    $('#IDNumber').addClass("redBorder")
                    $('#IDNumber').blur(function () {
                        $('#IDNumber').removeClass("redBorder")
                    });
                    return false;
                }
            }

            if (tourist.ID.IDNumber != "" && tourist.ID.IDType == 2) {

                var re1 = /^([a-zA-Z0-9-]*)$/

                if (!re1.test(tourist.ID.IDNumber)) {
                    layer.msg('护照号码格式错误');
                    $('#IDNumber').focus();
                    $('#IDNumber').addClass("redBorder")
                    $('#IDNumber').blur(function () {
                        $('#IDNumber').removeClass("redBorder")
                    });
                    return false;
                }
            }


            if (tourist.phone != "") {
                var myreg = /^1[3-9][0-9]{9}$/;
                if (!myreg.test(tourist.phone)) {
                    layer.msg($("#phone").attr("errormsg"));
                    $('#phone').focus();
                    $('#phone').addClass("redBorder")
                    $('#phone').blur(function () {
                        $('#phone').removeClass("redBorder")
                    });
                    return false;
                }
            }

            if (travel_flag > 0) {
                layer.msg("选择签署的游客中不能存在相同的手机号");
                $('#phone').focus();
                $('#phone').addClass("redBorder")
                $('#phone').blur(function () {
                    $('#mobile').removeClass("redBorder")
                });
                return false;
            }

            var _state = $('#name').data('state');
            var _index = $('#name').data('index');
            var isRepeat = false;
            $.each(data.tourists, function (i, o) {
                if (_state == 'save' && tourist.ID.IDType == o.ID.IDType && tourist.ID.IDNumber.toUpperCase() == o.ID.IDNumber.toString().toUpperCase()) {
                    layer.msg('游客证件号重复!');
                    $('#IDNumber').focus();
                    $('#IDNumber').addClass("redBorder")
                    $('#IDNumber').blur(function () {
                        $('#IDNumber').removeClass("redBorder")
                    });
                    isRepeat = true;
                    return;
                } else if (_state == 'edit' && tourist.ID.IDType == o.ID.IDType && tourist.ID.IDNumber.toUpperCase() == o.ID.IDNumber.toString().toUpperCase() && _index != i) {
                    layer.msg('游客证件号重复!!');
                    $('#IDNumber').focus();
                    $('#IDNumber').addClass("redBorder")
                    $('#IDNumber').blur(function () {
                        $('#IDNumber').removeClass("redBorder")
                    });
                    isRepeat = true;
                    return;
                }
            })

            if (isRepeat) {
                return false;
            }


            if (_state == 'save') {
                data.tourists.push(tourist);
            } else {
                data.tourists[_index] = tourist;
            }


            data.cardType = cardTypeList;

            renderTravellerList(data);
            delete data.cardType;
            return true;
        }


        function initImport(cardTypeList, data) {
            var uploader = new plupload.Uploader({
                runtimes: 'html4,html5,flash,silverlight',
                browse_button: 'uploadBtn',
                url: '/tourists/upload',
                unique_names: true,
                filters: {
                    max_file_size: '10mb',
                    mime_types: [{
                        title: "files",
                        extensions: "xlsx,xlsm,xltx,xltm,xlsb,xlam"
                    },]
                },
                init: {
                    FilesAdded: function (up, files) {
                        uploader.start();
                        return false;
                    },
                    FileUploaded: function (up, file, info) {
                        importData(file.target_name, cardTypeList);
                    },
                    Error: function (up, err) {
                        layer.msg('上传失败！' + '<br>错误信息：' + err.message);
                    }

                }
            });
            uploader.init();

            function importData(filename) {
                $('.loader-box').show();

                $.ajax({
                    url: "/tourists/getTouristXlsx",
                    method: "post",
                    dataType: "json",
                    data: {
                        'filename': filename,
                        'mold': 1
                    },
                    success: function (result) {
                        if (result.errorCode != 0) {
                            layer.msg('操作失败!错误信息:' + result.errorMessage);
                            $('.loader-box').hide();
                            return;
                        }
                        if (result.data.code == 0) {
                            data.tourists = [];
                            data.tourist_edit_index = -1;
                            $('.loader-box').hide();
                            var _tourist_list = result.data.data;
                            for (var i in _tourist_list) {
                                //普通游客
                                var _tourist = {
                                    name: _tourist_list[i].name,
                                    gender: _tourist_list[i].sex,
                                    age: "",
                                    race: "",
                                    memo: "",
                                    isRep: false,
                                    ID: {
                                        IDType: _tourist_list[i].type,
                                        IDNumber: _tourist_list[i].code,
                                    },
                                    phone: _tourist_list[i].phone,
                                    health: '',
                                    isSigner: 0,
                                    isChild: 0,
                                }
                                data.tourists.push(_tourist);
                            }
                            layer.msg('导入成功');
                            renderTravellerList(data);
                        } else {
                            layer.alert(result.data.msg, { title: '导入失败', skin: 'layui-width-650' });
                            $('.loader-box').hide();
                        }

                    }
                });
            }
        }

        function initTouristListModel(data) {
            if (data.tourists == undefined) {
                data.tourist_edit_index = 0;
                data.tourists = [{
                    name: "",
                    gender: 0,
                    age: "",
                    ID: {
                        IDType: "",
                        IDNumber: "",
                    },
                    race: "",
                    phone: "",
                    health: "",
                    isSigner: "",
                    memo: "",
                    isChild: 0,
                    isRep: false,
                }]
            } else {
                data.tourist_edit_index = -1;
                data.tourists.map(function (o, i) {
                    if (o.isRep) {
                        data.tourists.splice(i, 1);
                    }
                })
            }

            nationalsArray = data.nationalarray;
            if (data.cardType) {
                cardTypeList = data.cardType
            }

            template.helper('findWhere', function (arr, _id) {
                return _.findWhere(arr, {
                    'id': parseInt(_id)
                });
            });
            var _btns = '游客信息 <a class="btn ml-10" href="javascript:;" id="clearAll">清空列表</a><a class="btn btn1" href="/econtract/example/download/1">游客模板下载</a> <a class="btn mr-10" href="" id="uploadBtn">+游客导入</a>';
            $('#step2 .title').html(_btns);
            renderTravellerList(data);


            initImport(cardTypeList, data);



            //添加游客信息
            $('body').on('click', '#addNewTourist', function (e) {
                e.preventDefault();
                e.stopPropagation();
                if ($('.saveTourist').length > 0) {
                    if (saveTourist(data, $('.saveTourist').data('index'))) {
                        data.tourist_edit_index = -2;
                        data.cardType = cardTypeList;
                        if ($("input[name='isComp']:checked").val() == 1) {
                            data.editSigner = true;
                        } else {
                            data.editSigner = false;
                        }
                        renderTravellerList(data);
                    }
                } else {
                    //                data.needSign = $('#dbneedSign').prop('checked') ? 0 : 1;
                    data.tourist_edit_index = -2;
                    if ($("input[name='isComp']:checked").val() == 1) {
                        data.editSigner = true;
                    } else {
                        data.editSigner = false;
                    }
                    renderTravellerList(data);
                }
            });


            //删除游客信息
            $('body').on('click', '.removeTourist', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var _index = $(this).data('index');
                if (_index >= 0) {
                    data.tourists.splice(_index, 1);
                } else {
                    data.tourist_edit_index = -1;
                }

                //            data.needSign = $('#needSign').prop('checked') ? 0 : 1;
                renderTravellerList(data);
            });

            //修改游客信息
            $('body').on('click', '.editTourist', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var _index = $(this).data('index');
                data.tourist_edit_index = _index;
                //            data.needSign = $('#needSign').prop('checked') ? 0 : 1;
                console.log($("input[name='isComp']:checked").val());
                if ($("input[name='isComp']:checked").val() == 1) {
                    data.editSigner = true;
                } else {
                    data.editSigner = false;
                }

                renderTravellerList(data);
            })

            //保存游客信息
            $('body').on('click', '.saveTourist', function (e) {
                e.preventDefault();
                e.stopPropagation();
                if (saveTourist(data)) {
                    data.tourist_edit_index = -1;
                    data.cardType = cardTypeList;
                    renderTravellerList(data);
                }
            });
            /**
             * tip提示
             **/
            var tipsMessage = '<p>设置多人签署后，需要<font color="#fb8d50">所有被选中的游客</font>签署合同才能生效，作废时也需要同时确认。</p>' +
                '<p>如何设置多人签署：在上面游客名单里的“<font color="#fb8d50">签署</font>”项目里，勾选上就代表此游客必须签署。</p>';
            $("#showtips").on("mouseenter mouseleave", function (e) {
                e.preventDefault(),
                    "mouseleave" == e.type ? layer.close(index) : index =
                        layer.tips(tipsMessage, $(this), {
                            tips: [3, "#878D99"],
                            time: 99999999,
                            area: ['500px', 'auto'],
                        }
                        )
            });

            $('body').on('change', 'input[name=IDNumber], select[name=IDType]', function (e) {
                var _cardNumber = $('input[name=IDNumber]').val();
                var _cardType = $('select[name=IDType]').val();
                if (_cardNumber.length == 18 && _cardType == 1) {
                    var _sexCode = _cardNumber.substring(16, 17);
                    var _birthday = _cardNumber.substring(6, 10) + '-' + _cardNumber.substring(10, 12) + '-' + _cardNumber.substring(12, 14);
                    if (_sexCode % 2) {
                        $('select[name=gender]').val(0);
                    } else {
                        $('select[name=gender]').val(1);
                    }
                    $('input[name=beBirthday]').val(_birthday);
                }
            });

            $("body").on("click", "input[name=isChild]", function () {
                if ($(this).prop("checked")) {
                    $("input[name=isSigner]").attr("disabled", true);
                    if ($("input[name=isSigner]").prop("checked")) {
                        $("input[name=isSigner]").removeProp("checked");
                    }
                } else {
                    $("input[name=isSigner]").removeAttr("disabled")
                }
            });

            /**
             * 点击checkbox弹出提示框
             **/
            var showMessageContent = '<div style="padding:20px;color: #393D49; font-weight: 300;text-align:center;"><h4 style="padding-bottom:30px;">注意</h4><p>设置多人签署后，需要所有被选中的游客签署合同才能生效，作废时也需要同时确认。</p></div>'

            $("body").on("click", "input[name=isSigner]", function () {
                if (!$(this).prop("checked")) {
                    return;
                }
                var _this = this;
                var isRepeat = false;
                var phone = $(_this).parent().parent().parent().find("input[name=phone]").val().trim();
                var travellerPhone = $("#bePhone").val().trim();
                var isSigner = $(_this).prop("checked") ? 1 : 0;
                var index = $(_this).data("index");

                if (phone === "") {
                    layer.msg("请填写游客的手机号码或联系方式");
                    $(_this).parent().parent().parent().find("input[name=phone]").focus();
                    $(_this).parent().parent().parent().find("input[name=phone]").addClass("redBorder")
                    $(_this).parent().parent().parent().find("input[name=phone]").blur(function () {
                        $(_this).parent().parent().parent().find("input[name=phone]").removeClass("redBorder")
                    });
                    return false;
                }
                if (phone === travellerPhone) {
                    layer.msg('游客手机号与游客代表手机号码不得重复!');
                    $(_this).parent().parent().parent().find("input[name=phone]").focus();
                    $(_this).parent().parent().parent().find("input[name=phone]").addClass("redBorder")
                    $(_this).parent().parent().parent().find("input[name=phone]").blur(function () {
                        $(_this).parent().parent().parent().find("input[name=phone]").removeClass("redBorder")
                    });
                    return false;
                }
                $.each(data.tourists, function (i, o) {
                    if (i !== index && phone == o.mobile && (isSigner == 1 == o.isSigner)) {
                        isRepeat = true;
                        return;
                    }
                })
                if (isRepeat) {
                    layer.msg('游客手机号码不得重复!');
                    $(_this).parent().parent().parent().find("input[name=phone]").focus();
                    $(_this).parent().parent().parent().find("input[name=phone]").addClass("redBorder")
                    $(_this).parent().parent().parent().find("input[name=phone]").blur(function () {
                        $(_this).parent().parent().parent().find("input[name=phone]").removeClass("redBorder")
                    });
                    return false;
                }
                if ($(this).prop("checked") && showMessage === 0) {
                    showMessage += 1; //全局变量记录是否已经点击过需要签署
                    layer.open({
                        type: 1
                        , title: false //不显示标题栏
                        , closeBtn: false
                        , area: '350px;'
                        , shade: [0.3, '#878D99']
                        , id: 'LAY_layuipro' //设定一个id，防止重复弹出
                        , resize: false
                        , btn: ['知道了']
                        , btnAlign: 'c'
                        , moveType: 1 //拖拽模式，0或者1
                        , content: showMessageContent
                        , success: function (layero) {
                        }
                    });
                }

            })

            /**
             * 请空列表
             */
            $("body").on("click", "#clearAll", function () {
                $("#departmentTable tbody").find("tr").each(function (_i, _o) {
                    $(_o).remove();
                });
                data.tourists = [];
            })
        }

        function renderTravellerList(data) {
            var _html = template('touristListTemplate', data);
            $('#table_list_tourist').html(_html);
            var tipsMessage = '<p>设置多人签署后，需要<font color="#fb8d50">所有被选中的游客</font>签署合同才能生效，作废时也需要同时确认。</p>';
            $("#showtips").on("mouseenter mouseleave", function (e) {
                e.preventDefault(),
                    "mouseleave" == e.type ? layer.close(index) : index =
                        layer.tips(tipsMessage, $(this), {
                            tips: [3, "#878D99"],
                            time: 99999999,
                            area: ['500px', 'auto'],
                        }
                        )
            });
        }

        function changeTouristsModel(data) {
            data.tourists.map(function (o) {
                if (o.isSigner == 1) {
                    o.isSigner = 0;
                }

            })
            data.tourist_edit_index = -1;
            renderTravellerList(data);
        }

    </script>
