                            redirect: redirect,
                            maxFileSize: 2000000,
                            start: function (e) {
                                $('.loader-box').show();
                            },
                            add: function (e, data) {
                                if ($("#signatoryLoadedFile").val() != "" && $("#signatoryLoadedFileName").val() != "") {
                                    layer.msg('只能上传1个文件');
                                    return false;
                                }
                                var file = data.files[0];
                                if (!/(\.|\/)(jpg|JPG|jpeg|JPEG|pdf|PDF)$/i.test(file.name)) {
                                    layer.msg('只能上传jpg,jpeg后缀图片或PDF文件');
                                    return
                                } else if (file.size > 10485760) {
                                    layer.msg('上传的文件太大了，请上传10m以下的文件');
                                    return
                                }
                                if ($("#license").hasClass("redBorder")) {
                                    $('#license').removeClass("redBorder")
                                }
                                data.formData = { token: token };
                                data.submit();
                            },
                            done: function (e, data) {
                                $('.loader-box').fadeOut();
                                var uploadResult = data && data.result;
                                var file = uploadResult[0];
                                var renderData = {
                                    signatory: {
                                        loa: {
                                            url: file.url,
                                            fileName: file.name
                                        }
                                    }
                                }
                                $("#signatoryLoadedFile").val(file.url);
                                $("#signatoryLoadedFileName").val(file.name);
                                var _html = template('authorizationFile', renderData);
                                $("#licenseFils").html(_html);
                            },
                            fail: function (e, data) {
                                $("#signatoryLoadedFile").val("");
                                $("#signatoryLoadedFileName").val("");
                            }
                        }).prop('disabled', !$.support.fileInput)
                            .parent().addClass($.support.fileInput ? undefined : 'disabled');

                        //删除附件
                        $('body').on('click', '#delLicenseFile', function () {
                            $("#licenseFils").html("");
                            $("#signatoryLoadedFile").val('');
                            $("#signatoryLoadedFileName").val('');
                        });
                    } else {
                        layer.msg('操作失败!错误信息:' + data.errorMessage);
                    }
                }
            });
        }
        function init_behakf_of_tourist(data) {

            var signatory = {
                isComp: 0,
                name: "",
                ID: {
                    IDType: data.cardType[0].id,
                    IDNumber: ""
                },
                phone: "",
                email: "",
                mode: "",
                companyName: "",
                businessLicenseNumber: "",
                address: {
                    zip: "",
                    description: ""
                },
                gender: 0,
                race: "汉族",
                isJoin: 1,
                loa: {
                    url: "",
                    fileName: "",
                },
            }
            data.viewId = _viewId;
            data.signatory = $.extend(true, signatory, data.signatory);
            var _html = template('behalfOfTourist', data)
            $('#btour').html(_html);
            if (data.signatory.isComp == 1 && data.signatory.fileName != "" && data.signatory.loa.url != "") {
                var _html = template('authorizationFile', data);
                $("#licenseFils").html(_html);
            }

            initLicenseFileUpload();
            $("input[name='isComp']").on('click', function () {
                if ($("input[name='isComp']:checked").val() == 1) {
                    $("#beCompanyName").attr("datatype", "*");
                    //                $("#beEmail").attr("datatype","e");
                    $("#license").show(300);
                    if (data.tourists.length == 1 && $('.saveTourist').length > 0) {
                        if ($("input[name=isSigner]").prop("checked")) {
                            $("input[name=isSigner]").removeProp("checked");
                        }
                        $("input[name=isSigner]").attr("disabled", true);
                    } else {
                        changeTouristsModel(data);
                    }
                } else {
                    $("#beCompanyName").removeAttr("datatype");
                    $("#beEmail").removeAttr("datatype");
                    $("#license").hide(300)
                    $("#licenseFils").html("");
                    $("#signatoryLoadedFile").val('');
                    $("#signatoryLoadedFileName").val('');
                    if ($("input[name=isSigner]")) {
                        $("input[name=isSigner]").removeAttr("disabled");
                    }
                }
            });

            $('body').on('change', 'input[name=beIDNumber], select[name=beIDType]', function (e) {
                var _cardNumber = $('input[name=beIDNumber]').val();
                var _cardType = $('select[name=beIDType]').val();
                if (_cardNumber.length == 18 && _cardType == 1) {
                    var _sexCode = _cardNumber.substring(16, 17);
                    var _birthday = _cardNumber.substring(6, 10) + '/' + _cardNumber.substring(10, 12) + '/' + _cardNumber.substring(12, 14)
                    if (_sexCode % 2) {
                        $('input[name=beGender]')[0].checked = true;
                    } else {
                        $('input[name=beGender]')[1].checked = true;
                    }
                    $('input[name=beBirthday]').val(_birthday);
                }
            });

        }

    </script><!-- 游客代表和游客信息模板 -->
