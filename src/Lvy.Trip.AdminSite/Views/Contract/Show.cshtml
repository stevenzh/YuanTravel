                                    <label class="fl form-lable font-size-14 line-height-30">
                                        <input class="fl m-10" type="radio" data-mode="1" name="groupAgreementMode" checked="">
                                        <span class="fl pl-20">自行组团</span>
                                    </label>
                                </div>
                                <div class="col-md-12">
                                    <label class="fl form-lable font-size-14 line-height-30">
