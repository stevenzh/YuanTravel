    <script type="text/javascript">

        function renderItinerarys(route) {
            var _html = template('dayListTemplate', route);
            $('.route').html(_html);
            createEditor();
        }

        //保存站点
        function saveSite(del) {
            if (editor.txt) {
                var _description = editor.txt.html();
                var _city = $('select[name=city]').parent().find('.select2-selection__rendered').text();
                var _prov = verdict($('#prov'));

                var _site = {
                    cityName: _city,
                    provName: _prov,
                    description: _description
                }
                if (_site.description != '' && _site.cityName == '前往城市' && del == undefined) {
                    $('select[name=city]').focus();
                    layer.msg('前往城市不能为空');
                    return false;
                } else if (_site.description == '' && route.editSite >= 0) {
                    route.dayList[route.editDay].siteList.splice(route.editSite, 1);

                    return true;
                } else {

                    if (route.editDay >= 0 && route.editSite >= 0) {
                        route.dayList[route.editDay].siteList[route.editSite] = _site;
                    }
                    return true;
                }
            } else {
                return true;
            }
        }


        //废弃的方法
        function clearEmptySite() {
            for (var i = 0; i < route.dayList.length; i++) {
                for (var j = 0; j < route.dayList[i].siteList.length; j++) {
                    if (route.dayList[i].siteList[j].cityName == '' && route.dayList[i].siteList[j].provName == '' && route.dayList[i].siteList[j].description == '') {
                        // route.dayList[i].siteList.splice(j, 1);
                    }
                }
            }
        }

        //初始化城市搜索
        function initCitySelect() {
            if (isExit == 1) {
                $('.js-data-city-ajax').select2({
                    width: '100%',
                    language: "zh-CN",
                    placeholder: "前往城市",
                    ajax: {
                        url: function (params) {
                            return "/econtract/contract/abroads?name=" + encodeURI(params.term)
                        },
                        async: false,
                        dataType: 'json',
                        delay: 500,
                        data: function (params) {
                            return '';
                        },
                        processResults: function (data, params) {
                            if (data.errorCode == '4000') {
                                layer.msg("登录超时或此账号在其他位置登录，请重新登录。");
                                setTimeout(function () {
                                    window.location.reload();
                                }, 2000)
                            } else {
                                return {
                                    results: data.data,
                                };
                            }
                        },
                        cache: true
                    },
                    escapeMarkup: function (markup) {
                        return markup;
                    },
                    minimumInputLength: 1,
                    templateResult: function (repo) {
                        if (repo.loading) return repo.text;
                        var markup = "<div class='select2-result-repository clearfix'>" + repo.name + " 【" + repo.nation + "】</div>";
                        return markup;
                    },
                    templateSelection: function (repo) {
                        $('#prov').val(repo.nation);
                        return '<span>' + repo.name + '</span>' || repo.nation;
                    }
                });
            } else {
                $('.js-data-city-ajax').select2({
                    placeholder: "前往城市",
                    language: "zh-CN",
                    ajax: {
                        url: function (params) {
                            return "/econtract/contract/areas?name=" + encodeURI(params.term)
                        },
                        async: false,
                        dataType: 'json',
                        delay: 500,
                        data: function (params) {
                            return '';
                        },
                        processResults: function (data, params) {
                            if (data.errorCode == '4000') {
                                layer.msg("登录超时或此账号在其他位置登录，请重新登录。");
                                setTimeout(function () {
                                    window.location.reload();
                                }, 2000)
                            } else {
                                return {
                                    results: data.data,
                                };
                            }
                        },
                        cache: true
                    },
                    escapeMarkup: function (markup) {
                        return markup;
                    },
                    minimumInputLength: 1,
                    templateResult: function (repo) {
                        if (repo.loading) return repo.text;
                        var markup = "<div class='select2-result-repository clearfix'>" + repo.area + " 【" + repo.prov + "】</div>";
                        return markup;
                    },
                    templateSelection: function (repo) {
                        $('#prov').val(repo.prov);
                        return '<span>' + repo.area + '</span>' || repo.text;
                    }
                });
            }

            $('.js-data-city-ajax').parent().find('.select2-selection__placeholder').html('前往城市');
            $('.js-data-city-ajax').each(function (_i, _o) {
                if ($(_o).data('text') != '') {
                    $(_o).parent().find('.select2-selection__rendered').html($(_o).data('text'));
                }
            });
        }


        function createEditor() {
            if ($('#container').length) {
                editor.create()
                if (route.mode == 1 && route.dayList.length) {
                    editor.txt.html(route.dayList[0].siteList[0].description);
                }
                initCitySelect();
            }
        }

        function initItineraryListModel(type, number, pageOption) {
            template.config("escape", false);
            //从旅游产品取行程描述赋值
            if (type == "expId") {
                route = {
                    mode: 0,
                    editDay: -1,
                    editSite: -1,
                    dayList: []
                }
            } else {
                route = {
                    mode: pageOption.itinerary.inputType,
                    editDay: -1,
                    editSite: -1,
                    dayList: pageOption.itinerarys
                }
            }
            renderItinerarys(route);
            //切换行程模式
            $('body').on('click', '.changeMode', function (e) {
                e.preventDefault();
                if (route.mode == 1) {
                    route.mode = 0;
                    $(this).text('切换到简易行程录入');
                    $('.route').removeClass('margin-0');

                } else {
                    route.mode = 1;
                    $(this).text('切换到标准行程录入');
                    $('.route').addClass('margin-0');
                }
                if (changeProduct) {
                    route.dayList = [];
                    changeProduct = false;
                }
                renderItinerarys(route);
            })

            //添加天数
            $('body').on('click', '.addDay', function (e) {
                e.preventDefault();
                var _newDay = {
                    siteList: [
                        {
                            cityName: '',
                            provName: '',
                            description: ''
                        }
                    ]
                }

                if (route.dayList.length == 0 || saveSite()) {
                    route.editDay = route.dayList.length;
                    route.editSite = 0;
                    route.dayList.push(_newDay);
                    renderItinerarys(route);
                }

            })

            //删除天数
            $('body').on('click', '.removeDay', function (e) {
                e.preventDefault();
                if (saveSite("del")) {
                    var _day = $(this).data('day');
                    route.dayList.splice(_day, 1);
                    route.editDay = route.dayList.length - 1;
                    route.editSite = -1;
                    renderItinerarys(route);
                }
            })

            //添加站点
            $('body').on('click', '.addSite', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var _newSite = {
                    cityName: '',
                    provName: '',
                    description: ''
                }

                if (saveSite()) {
                    var _day = $(this).data('day');
                    route.editDay = _day;
                    route.editSite = route.dayList[_day].siteList.length;
                    route.dayList[_day].siteList.push(_newSite);
                    renderItinerarys(route);
                }
            })

            //删除站点
            $('body').on('click', '.removeSite', function (e) {
                console.log(1)
                e.preventDefault();
                e.stopPropagation();
                if (saveSite("del")) {
                    var _day = $(this).data('day');
                    var _site = $(this).data('site');
                    route.dayList[_day].siteList.splice(_site, 1);
                    route.editSite = -1;
                    renderItinerarys(route);
                }
            })

            //修改站点
            $('body').on('click', '.editSite', function (e) {
                e.preventDefault();
                e.stopPropagation();
                if (saveSite()) {
                    var _day = $(this).data('day');
                    var _site = $(this).data('site');
                    route.editDay = _day;
                    route.editSite = _site;
                    renderItinerarys(route);
                    editor.txt.html(route.dayList[_day].siteList[_site].description);
                }
            })

            //保存站点
            $('body').on('click', '.saveSite', function (e) {
                e.preventDefault();
                e.stopPropagation();

                if (editor.txt) {
                    var _description = editor.txt.html();
                    var _text = $('select[name=city]').parent().find('.select2-selection__rendered').text();
                    var _prov = verdict($('#prov'));

                    if (_text == '前往城市') {
                        $('select[name=city]').focus();
                        layer.msg('前往城市不能为空');
                        return false;
                    }

                    if (_description == '') {

                        editor.txt.append('');
                        layer.msg('行程描述不能为空');
                        return false;
                    }


                    var _day = $(this).data('day');
                    var _site = $(this).data('site');
                    if (_day == 0 && _site == 0) {
                        route.dayList[0].siteList[0] = {
                            cityName: _text,
                            provName: _prov,
                            description: _description
                        }
                    } else {
                        route.dayList[_day].siteList[_site] = {
                            cityName: _text,
                            provName: _prov,
                            description: _description
                        }
                    }
                    route.editDay = _day;
                    route.editSite = -1;
                    renderItinerarys(route);
                }
            });
        }


    </script>
