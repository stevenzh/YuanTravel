    <script type="text/javascript">



        function initEnclosureModel(maxUploadNum) {
            $.ajax({
                url: "/econtract/file/token",
                type: 'get',
                cache: false,
                dataType: 'json',
                success: function (data) {
                    if (data.errorCode == 0) {
                        var baseURL = "https://fileupload.12301.cn";
                        var token = data.data;
                        var redirect = location.protocol + "//" + location.host + "/html/cors/result.html";
                        var url = "/upload";
                        $('#manager-recode-btn').fileupload({
                            url: UPLOADURL + url,
                            autoUpload: false,
                            dataType: 'json',
                            acceptFileTypes: /(\.|\/)(doc|docx|jpg|jpeg|pdf)$/i,
                            redirect: redirect,
                            maxFileSize: 2000000,
                            start: function (e) {
                                $('.loader-box').show();
                            },
                            add: function (e, data) {
                                if (maxUploadNum <= 0) {
                                    layer.msg('只能上传3个文件');
                                    return false;
                                }
                                var extcount = 0, sizecount = 0;
                                data.files.map(function (o, index) {
                                    if (!/(\.|\/)(doc|docx|jpg|jpeg|pdf)$/i.test(o.name)) {
                                        extcount++;
                                    } else if (o.size > 10485760) {
                                        sizecount++;
                                    }
                                })

                                if (extcount > 0) {
                                    layer.msg('只能上传Word,PDF和图片文件');
                                    return
                                } else if (sizecount > 0) {
                                    layer.msg('上传的文件太大了，请上传10m以下的文件');
                                    return;
                                }
                                maxUploadNum--;
                                data.formData = { token: token };
                                data.submit();
                            },
                            done: function (e, data) {
                                $('.loader-box').fadeOut();
                                var uploadResult = data && data.result;
                                var list = [];
                                var file = uploadResult[0];
                                var isImg = false;
                                if (file.type.indexOf('image') > -1) {
                                    isImg = true;
                                }
                                list.push({
                                    src: file.url,
                                    isImg: isImg,
                                    filename: file.name
                                });
                                var renderData = {
                                    list: list
                                };

                                var _html = template('fileList', renderData);
                                $('#manager_recode_url .upload-image').append(_html);
                            },
                            fail: function (e, data) {

                            }
                        }).prop('disabled', !$.support.fileInput)
                            .parent().addClass($.support.fileInput ? undefined : 'disabled');

                        //删除附件
                        $('body').on('click', '.del-img-btn', function (value) {
                            var _this = $(this);
                            _this.parents("li").remove();
                            maxUploadNum++;
                        });
                    } else {
                        layer.msg('操作失败!错误信息:' + data.errorMessage);
                    }
                }
            });
        }

        // function bindEventa(maxUploadNum, browsebtn,rednerbox,callback) {

        // }
    </script>
