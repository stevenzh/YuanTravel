    <script type="text/javascript">

        function idCardVerify(idCard) {
            if (idCard.charAt(idCard.length - 1) == "x") {
                idCard = idCard.replace(idCard[idCard.length - 1], "X")
            }
            var reg = /^\d{17}(X|\d)$/;
            if (!reg.test(idCard)) {
                return false;
            }
            var actCheckBit = idCard.substr(17, 1);
            idCard = idCard.substr(0, 17);
            var checkBit = ['1', '0', 'X', '9', '8', '7', '6', '5', '4', '3', '2'];
            var v = [2, 4, 8, 5, 10, 9, 7, 3, 6, 1, 2, 4, 8, 5, 10, 9, 7];
            var n = 0;
            for (var i = 0; i < idCard.length; i++) {
                var num = +idCard[16 - i];
                n = n + num * v[i]
            }
            var r = n % 11;
            var t = checkBit[r];
            return t === actCheckBit;
        };

