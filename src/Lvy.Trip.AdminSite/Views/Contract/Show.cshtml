<body style="overflow:auto;">
    <div>
        <div class="contract-wrapper">


            <div class="fixed-header" style="display: block; width: 1334px;">
                <div class="title">上海出境游合同</div>
                <div class="btns">
                    <a class="btn save-contract-btn" href="">保存草稿</a>
                    <br>
                    <div class="clear-20"></div>
                    <a class="btn btn1" id="backBtn" href="/travel/electronicContract/1">&nbsp;&nbsp;&nbsp;返回&nbsp;&nbsp;&nbsp;</a>
                </div>

                <div class="stepInfo">
                    <ul>
                        <li></li>
                        <li></li>
                    </ul>
                    <div class="stepIco stepIco1 active">
                        <span>1</span>
                        <div class="stepText">产品信息和费用</div>
                    </div>
                    <div class="stepIco stepIco2">
                        <span>2</span>
                        <div class="stepText">游客代表和游客信息</div>
                    </div>
                    <div class="stepIco stepIco3">
                        <span>3</span>
                        <div class="stepText">其他约定信息</div>
                    </div>
                </div>
            </div>

            <div class="clear-200"></div>

            <form id="contractForm">
                <div id="step1" class="step-wrapper">
                    <input value="" name="creditCode" id="creditCode" type="hidden">
                    <input value="" name="cloudId" id="cloudId" type="hidden">
                    <input value="" name="ecNumber" id="ecNumber" type="hidden">
                    <input value="" name="expId" id="expId" type="hidden">
                    <input value="" name="viewId" id="viewId" type="hidden">
                    <input value="" name="contractName" id="contractName" type="hidden">
                    <input value="" name="businessType" id="businessType" type="hidden">
                    <input value="" name="sourceEcNumber" id="sourceEcNumber" type="hidden">

                    <!-- 合同主体 -->
                    <div class="contract-box">
                        <div class="title">
                            合同主体
                        </div>
                        <div class="content">
                            <div class="form-group">
                                <label class="col-md-6 form-lable font-size-14 line-height-30 required">旅行社名称:</label>
                            </div>
                            <div class="form-group">
                                <div class="col-md-12">
                                    <input class="form-control btn-circle input-icon" value="上海新康辉国际旅行社有限责任公司" type="text" readonly="readonly">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-md-6 form-lable font-size-14 line-height-30 required">旅行社地址:</label>
                                <label class="col-md-6 form-lable font-size-14 line-height-30 required">经营许可证号:</label>
                            </div>
                            <div class="form-group">
                                <div class="col-md-6">
                                    <input class="form-control btn-circle input-icon" value="上海市杨浦区国和路36号15幢3598室" type="text" readonly="readonly">
                                </div>
                                <div class="col-md-6">
                                    <input class="form-control btn-circle input-icon" value="L-SH-CJ00042" type="text" readonly="readonly">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-md-6 form-lable font-size-14 line-height-30 required">旅行社经办人:</label>
                                <label class="col-md-6 form-lable font-size-14 line-height-30 required">经办人电话:</label>
                            </div>
                            <div class="form-group">
                                <div class="col-md-6">
                                    <input class="form-control btn-circle input-icon" value="安琪" type="text" readonly="readonly">
                                </div>

                                <div class="col-md-6">
                                    <input class="form-control btn-circle input-icon" value="18964072143" type="text" readonly="readonly">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 线路行程时间 -->
                    <div class="contract-box">
                        <div class="title">
                            线路行程时间
                        </div>
                        <div class="content">
                            <div class="form-group">
                                <label class="col-md-12 form-lable font-size-14 line-height-30 required">旅游产品名称:</label>
                            </div>
                            <div class="form-group">
                                <div class="col-md-10">
                                    <input class="form-control btn-circle input-icon" id="routeName" name="routeName" autocomplete="off" value="" datatype="*" nullmsg="请输入线路名称" placeholder="请输入线路名称" type="text">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-md-6 form-lable font-size-14 line-height-30">团号:</label>
                            </div>
                            <div class="form-group">
                                <div class="col-md-6">
                                    <input class="form-control btn-circle input-icon" id="groupId" name="groupId" value="" nullmsg="请输入团号" placeholder="请输入团号" type="text">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-md-12 form-lable font-size-14 line-height-30 required">组团方式:</label>
                            </div>
