@model Lvy.VModels.Finance.BusPointCountVModel
@{
    ViewBag.Title = "BusPointCount";
}
@section AdditionalResources
{
    <script src="~/WebRes/Scripts/My97DatePicker/WdatePicker.js" type="text/javascript"></script>
    <script src="~/WebRes/scripts/jquery.fileDownload.1.3.3.js" type="text/javascript"></script>
}
<form id="theForm" method="POST" action="">
<div class="xbox">
    <div align="center" class="xboxcontent clear">
        <div class="sotable_tit">
            上车点统计
        </div>
        <table id="searchTable" width="100%" class="edittbl"
            style="border-bottom: 0px;">
            <tr>
                <td class="label">
                    上车点：
                </td>
                <td>
                    <input type="text" id="BusPointName" name="BusPointName" class="text220" />
                </td>
                <td class="label">
                    接送类型：
                </td>
                <td>
                    @Html.DropDownListFor(m => m.JieSongType, Model.JieSongTypes.ToSelectListFor(Model.JieSongType.ToString(), "0", "全部"), new { @class = "text150" })
                </td>
            </tr>
            <tr>
                <td class="label">
                    出发日期：
                </td>
                <td colspan="3">
                    <input type="text" name="BeginOutDate" value="@Model.BeginOutDate" id="d4311" class="Wdate" onfocus="WdatePicker({isShowClear:true,readOnly:true,maxDate:'#F{$dp.$D(\'d4312\')||\'2020-10-01\'}',onpicked:function(){$('#d4312')[0].focus();}})" />
                    &nbsp;--&nbsp;
                    <input type="text" name="EndOutDate" value="@Model.EndOutDate" id="d4312" class="Wdate" onfocus="WdatePicker({isShowClear:true,readOnly:true,onpicked:function(){},minDate:'#F{$dp.$D(\'d4311\')}'})" />
                </td>
            </tr>
            <tr>
                <td colspan="4" style="text-align: center;">
                    <input class="btn btn1" id="searchBtn" type="button" value="搜索" />
                    <input class="btn btn1" id="resetBtn" type="button" value="重置" />
                </td>
            </tr>
        </table>
    </div>
</div>
</form>
<div id="divItemList">
    @Html.Partial("BusPointCount/UCList", Model)
</div>
<script type="text/javascript">
    $(function () {
        //搜索
        $("#searchBtn").click(function () {
            var $b = $("#d4311"), $e = $("#d4312");
            if ($b.val().length == 0 || $e.val().length == 0) {
                Utils.alert('请选择出发日期范围');
                $b.focus();
            }

            var load_iii = Utils.layerLoad();
            var params = $("#theForm").formSerialize();
            $.post(
            '@Url.Action("BusPointCount")',
            params,
            function (data) {
                $('#divItemList').html(data);
                hoverChangeStyle();
                Utils.layerClose(load_iii);
            });
        });

        //重置
        $("#resetBtn").click(function () {
            $("input:text").val("");
            
            $("#searchTable td select").each(function () {
                $(this).children('option:first').attr('selected', 'selected');
            });
            
        });


    });

</script>
