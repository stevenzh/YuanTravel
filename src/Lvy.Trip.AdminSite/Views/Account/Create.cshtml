@model Lvy.VModels.Crm.AccountEditVModel
@{
    ViewBag.Title = "创建账号";
}
@section AdditionalResources
{
}
<form id="theForm" action="@Url.Action("Add", "Account")" method="POST">
    @Html.HiddenFor(m => m.Account.CustomerCode)
    <div class="station">
        创建账号
    </div>
    <div class="inform">
        <div class="in_box">
            <table style="width:100%" class="edittbl">
                <tr>
                    <td class="label" width="90px">
                        <span class="point">*</span>登陆名：
                    </td>
                    <td>
                        @Html.TextBoxFor(a => a.Account.LoginName, new { @class = "text150", @onblur = "ValidLoginName(this);" })
                    </td>
                </tr>
                <tr>
                    <td class="label">
                        <span class="point">*</span>密码：
                    </td>
                    <td>
                        @Html.PasswordFor(a => a.Account.Pwd, new { @class = "text150" })
                    </td>
                </tr>
                <tr>
                    <td class="label">
                        <span class="point">*</span>确认密码：
                    </td>
                    <td>
                        <input type="password" id="confirmPwd" class="text150" />
                    </td>
                </tr>
                <tr>
                    <td class="label">
                        <span class="point">*</span>姓名：
                    </td>
                    <td>
                        @Html.TextBoxFor(a => a.Account.Name, new { @class = "text150" })
                    </td>
                </tr>
                <tr>
                    <td class="label">
                        <span class="point">*</span>性别：
                    </td>
                    <td>
                        @Html.RadioGroup("Sex", Model.SexBeans, "1")
                    </td>
                </tr>
                <tr>
                    <td class="label">联系手机：</td>
                    <td>
                        @Html.TextBoxFor(a => a.Account.Mobile, new { @class = "text150" })
                    </td>
                </tr>
                <tr>
                    <td class="label">Email：</td>
                    <td>
                        @Html.TextBoxFor(a => a.Account.Email, new { @class = "text150" })
                    </td>
                </tr>
                <tr>
                    <td class="label">座机：</td>
                    <td>
                        @Html.TextBoxFor(a => a.Account.Phone, new { @class = "text150" })
                    </td>
                </tr>
                <tr style="display:none;">
                    <td class="label">QQ：</td>
                    <td>
                        @Html.TextBoxFor(a => a.Account.QQ, new { @class = "text150" })
                    </td>
                </tr>
                <tr>
                    <td class="label">
                        <span class="point">*</span>部门：
                    </td>
                    <td>
                        <select id="SelectedTeamIds" name="SelectedTeamIds" multiple="multiple" class="form-control" style="width:90%">
                            @foreach (var item in Model.AccountTeamBeans)
                            {
                                <option value="@item.Key">@item.Value</option>
                            }
                        </select>
                    </td>
                </tr>


                <tr style="height:5px"><td colspan="2"></td></tr>
                <tr>
                    <td class="label">
                        对应角色：
                    </td>
                    <td>
                        <select id="SelectedRoleIds" name="SelectedRoleIds" multiple="multiple" class="form-control" style="width:90%">
                            @foreach (var item in Model.RoleBeans)
                            {
                                <option value="@item.Key">@item.Value</option>
                            }
                        </select>

                        @*@Html.CheckboxGroup("SelectedRoleIds", Model.RoleBeans)*@
                    </td>
                </tr>
                @*@if (GlobalContext.Current.UserInfo.CustomerCode == GlobalContext.Current.OwnerCode)
                    {
                        <tr>
                            <td class="label">
                                目的地：
                            </td>
                            <td>
                                @Html.CheckboxGroup("SelectedDestIds", Model.DestinationBeans)
                            </td>
                        </tr>
                    }*@
                <tr>
                    <td></td>
                    <td>
                        <input class="btn btn1" id="btnSave" type="submit" value="保存" onclick="return CheckControls();" />
                        <input class="btn btn1" id="btnBack" type="button" value="返回列表" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
</form>
<script type="text/javascript">

    $(function () {

        //组多选
        $("#SelectedTeamIds").select2({
            tags: true,
            allowClear: true, //是否允许清空选中
            placeholder: "请选择", //
            closeOnSelect: false, // 选择后下拉框不会关闭（单选-不建议使用）
            language: "zh-CN"
        });
        //角色下拉框
        $("#SelectedRoleIds").select2({
            tags: true,
            allowClear: true, //是否允许清空选中
            placeholder: "请选择", //
            closeOnSelect: false, // 选择后下拉框不会关闭（单选-不建议使用）
            language: "zh-CN"
        });

        $("#btnBack").click(function () {
            window.location.href = '@Url.Action("Search")'
            //window.location.href = '@Url.Action("Search","Customer")'
        })
    });

    function CheckControls() {
        if (Utils.Trim($("#Account_LoginName").val()) == "") {
            Utils.alert("登录名不能为空！");
            $("#Account_LoginName").select().focus();
            return false;
        }
        if (Utils.Trim($("#Account_Pwd").val()) == "") {
            Utils.alert("密码不能为空！");
            $("#Account_Pwd").select().focus();
            return false;
        }
        if (Utils.Trim($("#confirmPwd").val()) == "") {
            Utils.alert("确认密码不能为空！");
            $("#confirmPwd").select().focus();
            return false;
        }
        if (Utils.Trim($("#confirmPwd").val()) != Utils.Trim($("#Account_Pwd").val())) {
            Utils.alert("密码与确认密码不相同，请重新输入！");
            $("#confirmPwd").select().focus();
            return false;
        }
        if (Utils.Trim($("#Account_Name").val()) == "") {
            Utils.alert("姓名不能为空！");
            $("#Account_Name").select().focus();
            return false;
        }
        if (Utils.Trim($("#Account_Mobile").val()) != "") {
            if ($.isMobile($("#Account_Mobile").val())== false) {
                Utils.alert("手机号格式有误！");
                $("#Account_Mobile").select().focus();
                return false;
            }
        }
        if (Utils.Trim($("#Account_Email").val()) != "") {
            if ($.isMail($("#Account_Email").val()) == false) {
                Utils.alert("Emmail格式有误！");
                $("#Account_Email").select().focus();
                return false;
            }
        }

        if (Utils.Trim($("#SelectedTeamIds").val()) == "") {
            Utils.alert("部门不能为空！");
            $("#SelectedTeamIds").select().focus();
            return false;
        }

        return true;
    }

    //验证登陆名是否存在
    function ValidLoginName(obj) {
        var loginName = $.trim($(obj).val());
        $.post('/Account/CheckLoginName?loginName=' + encodeURIComponent(loginName), function (result) {
            if (result == "1") {
                Utils.alert("登陆名已存在!", 2000);
                $(obj).focus().select();
            }
        });
    }
</script>
