@model Lvy.VModels.Base.ArticleVModel
@{
    ViewData["Title"] = "文章管理";
    Layout = "~/Views/Shared/_Single.cshtml";
}
@section AdditionalResources { }

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<section class="content">
    <form id="theForm" method="POST" action="@Url.Action("Search")">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"> 文章列表</h3>
                <div class="card-tools">
                    <div class="input-group input-group-sm" style="width: 250px;">
                        @Html.TextBoxFor(a => a.Article.Title, new { @class = "form-control pull-right", @placeholder = "标题" })
                        <div class="input-group-append">
                            <button id="btnSave" type="submit" class="btn btn-default"><i class="fa fa-search"></i></button>
                            <a href="@Url.Action("Create")" class="btn btn-success"> <i class="fa fa-plus"></i> </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body" id="divNotices">
                @Html.Partial("UCSearch", Model)
            </div>
        </div>
    </form>
</section>
