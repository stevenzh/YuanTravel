@model Lvy.Models.BaseDB.BaseArticleModel
@using Lvy.Models.BaseDB
@using Arch.Common
@{
    ViewData["Title"] = "编辑文章";
    Layout = "~/Views/Shared/_Single.cshtml";
    string picroot = AppSetting.Get("UploadFileRoot");
    string CDNServerUrl = Arch.Common.AppSetting.Get("CDNServerUrl");
}
@section AdditionalResources
{
    <script src="~/WebRes/Scripts/My97DatePicker/WdatePicker.js" type="text/javascript"></script>
    <script src="@CDNServerUrl/summernote-ext-elfinder.js"></script>
    <script src="@CDNServerUrl/summernote-ext-linefinder.js"></script>

    <link href="@CDNServerUrl/elfinder/css/elfinder.full.css" rel="stylesheet" />
    <script src="@CDNServerUrl/elfinder/js/elfinder.min.js"></script>
    <script src="@CDNServerUrl/elfinder/js/i18n/elfinder.zh_CN.js"></script>
}

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item"><a href="/Article/Search">文章管理</a></li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<section class="content">
    <form id="theForm" action="@Url.Action("Update")" method="POST">
        @Html.HiddenFor(a => a.Id)
        <div class="card">
            <div class="card-header">
            </div>
            <div class="card-body">
                <div class="form-group row">
                    <label class="col-2 col-form-label"><span class="point">*</span>类型：</label>
                    <div class="col-10">
                        @Html.DropDownListFor(a => a.NoticeType, ViewBag.NoticeTypes as IEnumerable<SelectListItem>, new { @Class = "form-control" })
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-2 col-form-label"><span class="point">*</span>是否有效：</label>
                    <div class="col-3">
                        @Html.TextBoxFor(m => m.IsValid, new { @class = "form-control" })
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-2 col-form-label">置顶</label>
                    <div class="col-3">
                        @Html.TextBoxFor(m => m.IsTop, new { @class = "form-control" })
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-2 col-form-label">标题：</label>
                    <div class="col-10">
                        @Html.TextBoxFor(a => a.Title, new { @Class = "form-control" })
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-2 col-form-label">网址：</label>
                    <div class="col-10">
                        @Html.TextBoxFor(a => a.Url, new { @class = "form-control" })
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-2 col-form-label">
                        <span class="point">*</span>内容：<br />
                        <span style="color:crimson; font-size:small;">（小图可以粘贴，大图选择“File Manager”）</span>
                    </label>
                    <div class="col-10">
                        @Html.TextAreaFor(a => a.Contents, new { @class = "summernote form-control", @row = "5" })
                    </div>
                </div>
                <div class="form-group row">
                    @Html.LabelFor(model => model.ImgUrl, new { @class = "control-label col-md-2" })
                    <div class="col-md-9">
                        @Html.TextBoxFor(m => m.ImgUrl, new { @class = "form-control" })
                    </div>
                    <div class="col-md-1">
                        <button type="button" class="btn btn-info" onclick="imageSelectDialog();">选择图片</button>
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-2 col-form-label">标签：</label>
                    <div class="col-10">
                        <select id="mySelect5" name="SelectedMutliTags" multiple="multiple" class="form-control form-control-sm">
                            @{
                                string[] ll = (Model.Tags.IsNullOrEmpty() ? new string[] { } : Model.Tags.Split('|'));
                                foreach (var item in ViewBag.TagList as List<BaseTagModel>)
                                {
                                    if (ll.Contains(item.TagName))
                                    {
                                        <option value="@item.TagName" selected="selected">@item.TagName</option>
                                    }
                                    else
                                    {
                                        <option value="@item.TagName">@item.TagName</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="card-footer">
                    <input class="btn btn-info" id="btnSave" type="submit" value="提交" />
                    <input class="btn btn-info" id="btnBack" onclick="location.href='@Url.Action("Search")';" type="button" value="返回列表" />
                </div>
            </div>

        </div>
    </form>
</section>

<div class="modal fade" id="line-modal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">旅游线路选择</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form role="form">
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label for="outcity">口岸</label>
                            <select id="outcity" class="form-control">
                                <option value="31">上海</option>
                                <option value="3201">南京</option>
                                <option value="3401">合肥</option>
                                <option value="3202">无锡</option>
                                <option value="3204">常州</option>
                                <option value="3203">徐州</option>
                                <option value="3208">淮安</option>
                            </select>
                        </div>
                        <div class="form-group col-md-6">
                            <label for="inputPassword4">目的地</label>
                            @Html.DropDownList("DestCode", (List<SelectListItem>)ViewBag.DestList, new { @class = "form-control", @id = "inputPassword4" })
                        </div>
                    </div>
                    <div class="form-group">
                        <label>线路名称</label>
                        <select id="sel_line" class="form-control js-data-example-ajax"></select>
                    </div>
                    <div class="form-group">
                        <label>线路行程说明</label>
                        <textarea id="editor2" name="editor2" rows="5" class="form-control" cols="80"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button id="btn_add" type="button" class="btn btn-primary">添加链接到页面内容</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<!-- /.modal -->

<script type="text/javascript">
    $(function () {

        $('.summernote').summernote({
            lang : 'zh-CN',
            height: 300,
            tabsize: 2,
            toolbar: [
                ['style', ['style']],
                ['font', ['bold', 'underline', 'clear']],
                ['color', ['color']],
                ['para', ['ul', 'ol', 'paragraph']],
                ['table', ['table']],
               // ['insert', ['link', 'picture', 'video', 'elfinder']],
                ['insert', ['link', 'elfinder', 'linefinder']],
                ['view', ['fullscreen', 'codeview', 'help']]
            ]
        });

        $("#theForm").submit(function () {
            if (!CheckControls()) {
                return false;
            }
        });

        $('#mySelect5').select2({
            language: "zh-CN"
        });


        $('.js-data-example-ajax').select2({
            language: "zh-CN",
            ajax: {
                url: '/Article/LineSearch',
                dataType: 'json',
                data: function (params) {
                    var query = {
                        q: params.term,
                        type: 'public',
                        group: $("#DestCode").val(),
                        outcity: $("#outcity").val()
                    }

                    // Query parameters will be ?search=[term]&type=public
                    return query;
                },
                processResults: function (data) {
                    // Tranforms the top-level key of the response object from 'items' to 'results'
                    return {
                        results: data.items
                    };
                }
            }
        });
    });

    //验证用户输入
    function CheckControls() {

        if (Utils.Trim($("#NoticeType").val()) == "") {
            Utils.alert("请选择类型！");
            $("#NoticeType").focus().select();
            return false;
        }

        if (Utils.Trim($("#Contents").val()) == "") {
            Utils.alert("内容不得为空！");
            $("#Contents").focus().select();
            return false;
        }

        return true;
    }

    function elfinderDialog(editor) {
        var myCommands = elFinder.prototype._options.commands;
        var disabled = ['extract', 'archive', 'resize', 'help', 'select', 'upload']; // Not yet implemented commands in ElFinder.Net
        $.each(disabled, function (i, cmd)
        {
            (idx = $.inArray(cmd, myCommands)) !== -1 && myCommands.splice(idx, 1);
        });

        var fm = $('<div/>').dialogelfinder({
            url: '@(picroot+"connector")', // change with the url of your connector
            customData: { folder: 'Files/article/@Model.Id', subFolder: '' }, // customData passed in every request to the connector as query strings. These values are used in FileController's Index method.
            commands: myCommands,
            rememberLastDir: false,
            lang: 'zh_CN',
            uiOptions: { // UI buttons available to the user
                toolbar: [
                    ['back', 'forward'],
                    ['reload'],
                    ['home', 'up'],
                   // ['mkdir', 'mkfile', 'upload'],
                    ['open', 'download'],
                    ['info'],
                    ['quicklook'],
                    ['copy', 'cut', 'paste'],
                    ['rm'],
                    ['duplicate', 'rename', 'edit'],
                    ['view', 'sort']
                ],
                navbar: {
                    minWidth: 150,
                    maxWidth: 500
                }
            },
            width: 840,
            height: 450,
            destroyOnClose: true,
            getFileCallback: function (files, fm) {
                console.log(files);
                $(editor).summernote('editor.insertImage', files.url, function ($image) {
                    $image.addClass("img-fluid");
                });
            },
            commandsOptions: {
                getfile: {
                    oncomplete: 'close',
                    folders: false
                }
            }
        }).dialogelfinder('instance');
    }

    function linefinderDialog(editor) {
        $('#line-modal').modal('show');
        $("#btn_add").click(function () {
            var line = $('#sel_line').val();
            var line_obj = $("#sel_line").select2("data");
            $(editor).summernote('createLink', { text: line_obj[0].text, url: 'http://yuanwx.sh-cct.cn/product/index/' + line +"?tourId=0",newWindow: true});
            $('#line-modal').modal('hide');
        });
    }



    function imageSelectDialog() {
        var myCommands = elFinder.prototype._options.commands;
        var disabled = ['extract', 'archive', 'resize', 'help', 'select', 'upload']; // Not yet implemented commands in ElFinder.Net
        $.each(disabled, function (i, cmd) {
            (idx = $.inArray(cmd, myCommands)) !== -1 && myCommands.splice(idx, 1);
        });

        var fm = $('<div/>').dialogelfinder({
            url: '@(picroot+"connector")', // change with the url of your connector
            customData: { folder: 'Files/article/@Model.Id', subFolder: '' }, // customData passed in every request to the connector as query strings. These values are used in FileController's Index method.
            commands: myCommands,
            rememberLastDir: false,
            lang: 'zh_CN',
            uiOptions: { // UI buttons available to the user
                toolbar: [
                    ['back', 'forward'],
                    ['reload'],
                    ['home', 'up'],
                    // ['mkdir', 'mkfile', 'upload'],
                    ['open', 'download'],
                    ['info'],
                    ['quicklook'],
                    ['copy', 'cut', 'paste'],
                    ['rm'],
                    ['duplicate', 'rename', 'edit'],
                    ['view', 'sort']
                ],
                navbar: {
                    minWidth: 150,
                    maxWidth: 500
                }
            },
            width: 840,
            height: 450,
            destroyOnClose: true,
            getFileCallback: function (files, fm) {
                $("#ImgUrl").val(files.url);
            },
            commandsOptions: {
                getfile: {
                    oncomplete: 'close',
                    folders: false
                }
            }
        }).dialogelfinder('instance');

    }
</script>
