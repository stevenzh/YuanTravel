@using Lvy.Web.Common
@model Lvy.VModels.Crm.CustomerVModel
<div class="xbox clear">
    <div class="btnlist">
        <div class="fl">
            排序方式：@Html.DropDownListFor(m => m.SortKey, Model.SortKeyValueBean.ToSelectListFor(Model.SortKey.ToString()))
        </div>
        <img src="~/WebRes/images/customer_status.png" style="height:25px; border:1px solid #b3a4a4; margin-left:5px;" />
        <div class="fr">
            <a href="@Url.Action("Create")" class="btn btn1">添加供应商</a>
        </div>
    </div>
    @if (Model.Customers.Items.Count > 0)
    {
        <table class="listtbl" style="width:100%;">
            <thead>
                <tr>
                    <td>客户编号</td>
                    <td>客户名称</td>
                    @*<td>联系电话</td>*@
                    <td>信用额度</td>
                    <td>结算方式</td>
                    <td>等级</td>
                    @*<td>对应销售</td>*@
                    <td>审核状态</td>
                    <td>客户状态</td>
                    <td align="center">操作</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Customers.Items)
                {
                    string color = "#fff";
                    if (item.IsValid == 0)
                    {
                         color = "#f3f3f4";
                    } else if (item.CustomerState == 1)
                    {
                        color = "#e0f9e4";
                    }
                    else if (item.CustomerState == 2)
                    {
                        color = "#fdfab6";
                    }
                    <tr style="background-color: @color">
                        <td style="text-align:center;">@item.Code</td>
                        <td style="text-align:left;">@item.Name</td>
                        @* <td style="text-align: center;">@item.Phone</td>*@
                        <td style="text-align:right;">@item.CreditLine</td>
                        <td style="text-align: center;">@DictionaryTools.GetEnumValue(Enums.PaymentTypeEnum, item.PaymentType.ToString())</td>
                        <td style="text-align: center;">@DictionaryTools.GetEnumValue(Enums.CustomerRankEnum, item.Rank.ToString())</td>
                        @*<td style="text-align: center;">@item.SalerName</td>*@
                        <td style="text-align: center;">
                            @DictionaryTools.GetEnumValue(Enums.CustomerStateEnum, item.CustomerState.ToString(), false)
                        </td>
                        <td style="text-align: center;">
                            @DictionaryTools.GetEnumValue(Enums.CustomerActivityEnum, item.ActiveState.ToString(), false)
                        </td>

                        <td align="center" style="width:80px;">
                            <table class="toolbar">
                                <tr>
                                    <td>@Html.IconActionLink("编辑", "Edit", "Supplier", "fa fa-edit", new { code = item.Code })</td>
                                    <td>@Html.IconDeleteActionLink("SetValidState", "Supplier", item.IsValid, new { code = item.Code })</td>
                                    <td>
                                        @if (item.Code == item.OwnerCode)
                                        {
                                            <a href="@Url.Action("Create", "Account", new { customerCode = item.Code })" title="添加账户">
                                                <i class="fa fa-user-plus"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("UCCreateContactInfo", new { Code = item.Code })" title="添加联系人">
                                                <i class="fa fa-user-plus"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @Html.HiddenFor(a => a.Customers.PageIndex)
        <div id="Pagination" class="digg"></div>
    }
    else
    {
        <div style="color: red; text-align: center; font-weight: bold; font-size: 14px;">
            <br />
            对不起，没有查找到数据！请重新输入查询条件 ！
        </div>
    }
</div>
<script type="text/javascript">

    //分页控件 begin
    $(function () {
        $("#Pagination").pagination(
            Number('@Model.Customers.TotalCount'), {
                callback: pageselectCallback,
                items_per_page: Number('@Model.Customers.PageSize'),
                current_page: @Model.Customers.PageIndex-1
            });
    });


    //回调方法
    function pageselectCallback(page_id, jq) {
        var load_iii = Utils.layerLoad();
        $("#Customers_PageIndex").val(page_id + 1);
        var params = $("#theForm").formSerialize();

        $.post('@Url.Action("Search")', params, function (data) {
            if (data.length < 1) {
                Utils.alert("查询出错，请稍后查询！");
                return false;
            }
            $('#divSearch').html(data);
            hoverChangeStyle();
            Utils.layerClose(load_iii);
        });
    }

    $(function () {
        $('select[name="SortKey"]').change(function () {
            pageselectCallback(0);
        });
    });
</script>
