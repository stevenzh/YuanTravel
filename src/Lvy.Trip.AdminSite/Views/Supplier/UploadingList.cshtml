@model  Lvy.VModels.Crm.CustomerFileVModel
<div class="xbox clear">
    <div class="btnlist">
        <div class="fr">
            <a href="/Customer/FileCreate?CustCode=@Model.CustomerFile.CustomerCode" class="btn btn1">添加合同</a>
        </div>
    </div>
    @if (Model.FilePageList.Items.Count > 0)
    {
        <table class="listtbl" style="width:100%">
            <thead>
                <tr>
                    <td>合同名称</td>
                    <td>合同有效期开始</td>
                    <td>合同有效期结束</td>
                    <td>文件名称</td>
                    <td>合同备注</td>
                    <td align="center">操作</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.FilePageList.Items)
                {
                    <tr>
                        <td style="text-align: center;">@item.Subject</td>
                        <td style="text-align: center;">@item.StratDate.ToDateFormat()</td>
                        <td style="text-align: center;">@item.EndDate.ToDateFormat() </td>
                        <td style="text-align: center;">@item.FileName</td>
                        <td style="text-align: center;">@item.Remark</td>
                        <td align="center" style="width:10%">
                            <table>
                                <tr>
                                    <td>@Html.EditActionLink("UploadingEdit", "Customer", new { Id = item.Id, CustCode = item.CustomerCode })</td>
                                    @*<td><a href="#" class="edit" name="editContactInfo" title="删除" bindId="@item.Id" code="@item.CustCode">删除</a></td>*@
                                    <td>@Html.Update("DeleteUploadfile", "Customer", new { Id = item.Id, code = item.CustomerCode })</td>
                                    <td>@Html.download("DownLoadFile", "Customer", new { Id = item.Id })</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @Html.HiddenFor(a => a.FilePageList.PageIndex)
        <div id="Pagination" class="digg">
        </div>
    }
    else
    {
        <div style="color: red; text-align: center; font-weight: bold; font-size: 14px;">
            <br />
            对不起，没有查找到数据！请重新输入查询条件 ！
        </div>
    }
</div>
<script type="text/javascript">
    //$("a[name='editContactInfo']").each(function () {
    //    $(this).click(function () {
    //        if (!confirm("确定删除？")) {
    //            return;
    //        }
    //        var load_iii = Utils.layerLoad();
    //        var url = "/Customer/DeleteUploadfile";
    //        $.get(url, { Id: $(this).attr("bindId"), code: $(this).attr("code") }, function (data) {
    //            if (data.length > 0) {
    //                $("#divUploadingListt").html(data);
    //            }
    //            Utils.layerClose(load_iii);
    //        });
    //    });
    //});

    //分页控件 begin
    $(function () {
        $("#Pagination").pagination(
            Number('@Model.FilePageList.TotalCount'), {
                callback: pageselectCallback,
                items_per_page: Number('@Model.FilePageList.PageSize'),
                current_page: @Model.FilePageList.PageIndex-1
            });
    });


    //回调方法
    function pageselectCallback(page_id, jq) {

        var load_iii = Utils.layerLoad();

        $("#FilePageList_PageIndex").val(page_id + 1);
        var params = $("#theForm").formSerialize();

        $.post('@Url.Action("Uploading")', params, function (data) {
            if (data.length < 1) {
                Utils.alert("查询出错，请稍后查询！");
                return false;
            }
            $('#divUploadingListt').html(data);
            hoverChangeStyle();
            Utils.layerClose(load_iii);
        });
    }

    $(function () {
        $('select[name="SortKey"]').change(function () {
            pageselectCallback(0);
        });
    });
</script>
