@model  Lvy.VModels.Crm.CustomerFileVModel

<form id="theForm" method="POST">
    <div class="xbox clear">
        <div align="center" class="xboxcontent clear">
            <div class="sotable_tit">
                合同附件查询
            </div>
            <table style="width:90%" class="sotable">
                <tr>
                    <td class="label">文件名称：</td>
                    <td>
                        @Html.TextBoxFor(a => a.CustomerFile.FileName, new { @class = "text150" })
                    </td>
                    <td class="label">合同名称：</td>
                    <td>
                        @Html.TextBoxFor(a => a.CustomerFile.Subject, new { @class = "text150" })
                    </td>

                    @*
                        <td class="label">合同有效期开始：</td>
                        <td>
                            @Html.TextBoxFor(a => a.CustomerFile.StratDate, new { @class = "Wdate text150", @onfocus = "WdatePicker({isShowClear:true,readOnly:true})" })
                        </td>
                        @Html.TextBoxFor(a => a.CustomerFile.EndDate, new { @class = "Wdate text150", @onfocus = "WdatePicker({isShowClear:true,readOnly:true})" })
                    *@
                    <td align="center">
                        <input class="btn btn1" id="btnSearch" type="submit" value="搜索" />
                        <input class="btn btn1" name="btnClear" type="button" value="返回列表" onclick="location.href='@Url.Action("Search")'" />
                    </td>
                </tr>
            </table>
        </div>
    </div>

</form>

