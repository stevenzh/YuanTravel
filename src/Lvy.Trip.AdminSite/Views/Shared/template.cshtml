                    <select class="text70" name=""></select>
                    <select class="text70" name=""></select>
                </div>
                <div class="fr ">
                    <a href="#" class="btn btn1" title="添加"></a>
                </div>
            </div>

            <table class="listtbl" width="100%">
                <thead>
                    <tr>
                        <td>&nbsp;</td>
                        <td>产品编号</td>
                        <td>产品名称</td>
                        <td>出团日期</td>
                        <td align="center">行程<br />天数</td>
                        <td align="center">产品<br />类型</td>
                        <td align="center">目的地</td>
                        <td align="center">供应商</td>
                        <td align="center">支付<br />类型</td>
                        <td align="center">操作</td>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><input name="" type="checkbox" value="" /></td>
                        <td>SZ10120410125</td>
                        <td><a href=""><span>[纯玩]</span>大连 旅顺 黄金海岸双方4日游</a></td>
                        <td>2012.04.12 - 2012.04.15</td>
                        <td align="center">4</td>
                        <td align="center">国内</td>
                        <td align="center">大连</td>
                        <td align="center">皇朝假期</td>
                        <td align="center">金额</td>
                        <td align="center">
                            <a class="search" title="查看"></a>
                            <a class="edit" title="编辑"></a>
                            <a class="delete" title="删除"></a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</form>


@*编辑*@
<form id="theForm" action="" method="POST">
    <div class="station">出团计划信息</div>

    <div class="inform">
        <div class="in_box">
            <table width="100%" class="edittbl">
                <tr>
                    <td class="label"><span class="point">*</span>团名：</td>
                    <td>
                        <a href="#">青岛三日游</a>
                        <input name="input" class="text220" type="text" />
                        <span class="alert malf20">填写需少于6个字符</span>
                    </td>
                </tr>
                <tr>
                    <td class="label">计划名额：</td>
                    <td>
                        <input name="input" class="text70" type="text" />
                        <span class="label malf20">预留名额： </span>
                        <input name="input" type="text" class="text70" />
                        <span style="display:inline-block" class="mark malf20"><span>已用库存&nbsp;40</span><span>剩余库存&nbsp;10</span></span>
                    </td>
                </tr>
                <tr>
                    <td class="label">
                        备注：
                    </td>
                    <td>  <textarea class="textarea440" name="textarea"></textarea></td>
                </tr>

                <tr>
                    <td></td>
                    <td>
                        <input class="btn btn1" id="btnSave" type="submit" value="保存" />
                        <input class="btn btn1" name="btnClear" type="button" value="返回列表" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
</form>




