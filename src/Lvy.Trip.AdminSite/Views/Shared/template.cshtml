            <input class="btn btn1" id="btnClear" type="button" value="取消" />
        </div>
    </div>


    @* 列表*@
    <div class="xbox">
        <div id="divSearch">
            <div class="btnlist">
                <div class="fl ">
                    <input class="btn btn2" name="" type="button" value="删除" />
