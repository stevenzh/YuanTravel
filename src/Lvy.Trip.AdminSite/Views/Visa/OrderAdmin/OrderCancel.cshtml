@{

}
<!DOCTYPE html>
<html>
<head>
    <title>取消订单</title>
    <script src="../../Scripts/jquery-1.4.1.min.js" type="text/javascript"></script>
</head>
<body>
    <div style="margin-top: 15px;">
        <table class="tableone" width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-top: 10px;">
            <tr>
                <td align="right">取消原因：
                    <input type="hidden" id="ordercode" name="ordercode" value='@ViewData["OrderCode"]' />
                    <input type="hidden" id="ssje" value='@ViewData["Je"]' />
                </td>
                <td>
                    <table>
                        <tr>
                            <td>
                                <select name="cancelreason" id="cancelreason" class="text150" onchange="ShowDetail(this.value)">
                                    <option value="0">--请选择--</option>
                                    <option value="1">客户取消</option>
                                    <option value="2">公司取消</option>
                                    <option value="3">其他</option>
                                </select>
                            </td>
                            <td id="showinfo"></td>
                        </tr>
                    </table>
                </td>
            </tr>
            <tr>
                <td align="right">取消备注：
                </td>
                <td>
                    <textarea id="note" name="note" rows="3" cols="5" class="textarea400"></textarea>
                </td>
            </tr>
            <tr>
                <td colspan="2" align="center" style="padding-top: 10px;">
                    <input type="button" id="cancelorder" value="立即取消" class="btn_2" onclick="ComitCancelOrder(this)" />
                    &nbsp;&nbsp;
                </td>
            </tr>
        </table>
    </div>
</body>
</html>
<script type="text/javascript">
    function ShowDetail(val) {
        $.post('/FitVisaOrder/ShowDetailInfo/', { "typeid": val }, function (data) {
            if (data != "") {
                var html = '<select name="canceltype" id="canceltype" class="text150">';
                for (var i = 0; i < data.length; i++) {
                    html = html + '<option value="' + data[i].Value + '">' + data[i].Text + '</option>';
                }
                $("#showinfo").html(html);
            }
            else { $("#showinfo").html(""); }
        });
    };
    var api = frameElement.api, W = api.opener, coDG;
    function ComitCancelOrder(aa) {
        if ($("#cancelreason").val() == "0") {
            alert("很抱歉，请先选择一个取消原因类别！");
            $("#cancelreason").focus();
            return;
        }
        var param = {
            "OrdersCode": $("#ordercode").val(),
            "CancelType": $("#cancelreason").val(),
            "CancelDetailType": $("#cancelreason").val() == "3" ? 3 : $("#canceltype").val(),
            "Remark": $("#note").val()
        };
        var url = "/FitVisaOrder/RequestRefund/?OrderCode=" + $("#ordercode").val() + "&je=" + $("#ssje").val() + "&type=1";
        $.post("/FitVisaOrder/SaveCancelOrder", param, function (data) {
            if (data == "0") {
                alert('抱歉，此订单已经取消！！');
                api.close();
                api.reload();
            } else if (data == "1") {
                alert('订单取消成功！订单流转结束');
                api.close();
                api.reload();
            } else if (data == "2") {
                alert('订单已取消！订单流转｛待发起退款｝');
                W.cancelOrderDG.title("发起退款请求");
                window.location.href = url;
            } else if (data == "3") {
                alert('订单取消成功！订单流转｛待退还材料｝');
                api.close();
                api.reload();
            }
            else {
                alert("出错了，操作失败，请稍后再试！！");
                api.close();
                api.reload();
            }
        });
    };

</script>

