@model Lvy.Visa.VModels.OrderQModel

<table class="table table-sm table-borderless" id="showlinkmanlist">
    <tr>
        <td>客户：</td>
        <td>
            <select id="mySelect2" class="form-control " name="Order.AgentCode">
                @if (!string.IsNullOrEmpty(Model.MasterOrder.AgentCode))
                {
                    <option value="@Model.MasterOrder.AgentCode" selected> @DictionaryTools.GetCachedCustomer(Model.MasterOrder.AgentCode).Name </option>
                }
            </select>
        </td>
    </tr>
    <tr>
        <td><span class="some_tips">*</span>销售部门：</td>
        <td>
            @Html.DropDownListFor(m => m.MasterOrder.SalesTeamId, ViewData["Teams"] as List<SelectListItem>, new { @class = "form-control form-control-sm" })
        </td>
        <td><span class="some_tips">*</span>销售员：</td>
        <td>
            @Html.DropDownListFor(m => m.MasterOrder.SalerCode, ViewData["Salers"] as IEnumerable<SelectListItem>, new { @class = "form-control form-control-sm" })
        </td>
    </tr>
    <tr>
        <td>联系人姓名：</td>
        <td>@Html.TextBox("xxx1", Model.MasterOrder.ContactName, new { @id = "mainlink", @class = "form-control form-control-sm" })</td>
        <td>联系电话：</td>
        <td>@Html.TextBox("xxx3", Model.MasterOrder.ContactPhone, new { @id = "mainphone", @class = "form-control form-control-sm" })</td>
    </tr>
    <tr>
        <td>联系邮箱：</td>
        <td>@Html.TextBox("xxx5", Model.MasterOrder.ContactEmail, new { @id = "mainemail", @class = "form-control form-control-sm" })</td>
        <td>邮编：</td>
        <td>@Html.TextBox("xxx6", Model.MasterOrder.PostCode, new { @id = "postnummber", @class = "form-control form-control-sm" })</td>
    </tr>
    <tr>
        <td>配送地址：</td>
        <td colspan="3">
            @Html.TextBox("xxx7", Model.MasterOrder.DeliveryAddress, new { @id = "adress", @class = "form-control form-control-sm" })
        </td>
    </tr>

</table>
@if (Model.OrderModel.TraceState < 7)
{
    <button type="button" id="mainupdate" class="btn btn-sm btn-success">保存</button>
}

<script src="../../Scripts/Validation.js" type="text/javascript"></script>
<script type="text/javascript">
    $(function () {
        ///联系人信息更新
        $("#mainupdate").click(function () {
            if ($("#mainlink").val() == "") { alert("联系人不能为空！"); return; }
            //if ($("#maintel").val() == "") { alert("联系手机不能为空！"); return; }
            //else if (!ValidationData('mobilephone', $("#maintel").val())) { alert("联系手机格式不正确！"); $("#maintel").val(""); return; }
            if ($("#mainphone").val() != "") { if (!ValidationData('phone', $("#mainphone").val())) { alert("联系电话格式不正确！"); $("#mainphone").val(""); return; } }
            if ($("#mainphone").val() != "" && !ValidationData('phone', $("#mainphone").val())) { alert("联系电话格式不正确！"); $("#mainphone").val(""); return; }
            if ($("#mainemail").val() == "") { alert("Email地址不能为空！"); return; }
            else if (!ValidationData('email', $("#mainemail").val())) { alert("Email格式不正确！"); $("#mainemail").val(""); return; }

            var param = {
                "AgentCode": $("#mySelect2").val(),
                "ContactName": $("#mainlink").val(),
                "ContactPhone": $("#mainphone").val(),
                "ContactEmail": $("#mainemail").val(),
                "PostCode": $("#postnummber").val(),
                "DeliveryAddress": $("#adress").val(),
                "MasterOrderCode": orderCode,
                "SalesTeamId": $("#MasterOrder_SalesTeamId").val(),
                "SalerCode": $("#MasterOrder_SalerCode").val()
            };
            $("#mainupdate").attr("value", "修改中..");
            $("#mainupdate").attr("disabled", "true");
            $.post("/OrderAdmin/ModifyOrderContactInfo/", param, function (data) {
                alert("修改成功！");
                $("#mainupdate").attr("value", "  修 改  ");
                $("#mainupdate").removeAttr("disabled");
            });
        });
    });
</script>
