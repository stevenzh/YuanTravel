@model Lvy.Visa.VModels.VisaOrderQModel
@{
    ViewData["Title"] = "签证订单管理";
    Layout = "~/Views/Shared/_Single.cshtml";
    string CDNServerUrl = Arch.Common.AppSetting.Get("CDNServerUrl");
}

@section AdditionalResources
{
    <!-- daterange picker -->
    <link rel="stylesheet" href="@CDNServerUrl/daterangepicker/daterangepicker.css">
    <script>
        var index2 = 1;
    </script>
}
<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Home/Index">Home</a></li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<!-- Main content -->
<section class="content">
    <div class="card">
        @*<div class="card-header">
                <h3 class="card-title">过滤条件</h3>
            </div>*@
        <div class="card-body p-2">
            <div class="form-row">
                <div class="col-auto">
                    <input name="" type="text" id="ordercode" class="form-control form-control-sm mt-2" placeholder="订单编号" />
                </div>
                <div class="col-auto">
                    <input name="" type="text" id="prodcutnames" class="form-control form-control-sm mt-2" placeholder="产品名称" />
                </div>
                @*<div class="col-auto">
                        <input name="" type="text" id="prodcutmanagers" class="form-control form-control-sm" placeholder="产品经理" />
                    </div>*@
                <div class="col-auto">
                    @Html.DropDownList("TeamID", ViewData["TeamList"] as IEnumerable<SelectListItem>, new { @id = "TeamID", @class = "form-control form-control-sm mt-2" })
                </div>
                <div class="col-auto">
                    <input name="TourNo" type="text" id="TourNo" class="form-control form-control-sm mt-2" placeholder="团号" />
                </div>
                <div class="col-auto">
                    <input name="" type="text" id="bookman" class="form-control form-control-sm mt-2" placeholder="预定人" />
                </div>
                <div class="col-auto">
                    @Html.DropDownList("ordersource", ViewData["OrderSourceList"] as IEnumerable<SelectListItem>, new { Class = "form-control form-control-sm mt-2", id = "ordersource" })
                </div>
                <div class="col-auto">
                    <input name="bookdt1" type="text" class="form-control form-control-sm mt-2" id="bookdt1" placeholder="预定日期" />
                </div>
                <div class="col-auto">
                    <input name="" type="text" id="name" class="form-control form-control-sm mt-2" placeholder="联系人姓名" />
                </div>
                <div class="col-auto">
                    <input name="" type="text" id="tel" class="form-control form-control-sm mt-2" placeholder="联系人手机" />
                </div>
                <div class="col-auto">
                    @Html.DropDownList("repaytype", ViewData["RepayTypeList"] as IEnumerable<SelectListItem>, new { @class = "form-control form-control-sm mt-2", @id = "repaytype", @placeholder = "支付方式" })
                </div>
                <div class="col-auto">
                    @Html.DropDownList("repaystatus", ViewData["RepayStatusList"] as IEnumerable<SelectListItem>, new { @class = "form-control form-control-sm mt-2", @id = "repaystatus", @placeholder = "支付状态" })
                </div>
                <div class="col-auto">
                    @Html.DropDownList("orderstatus", ViewData["OrderStatusList"] as IEnumerable<SelectListItem>, new { @class = "form-control form-control-sm mt-2", @id = "orderstatus" })
                </div>
                <div class="col-auto">
                    @Html.DropDownList("TraceState", ViewData["TraceStateList"] as IEnumerable<SelectListItem>, new { @class = "form-control form-control-sm mt-2", @id = "operstatus" })
                </div>
                <div class="col-auto">
                    <input name="" type="text" id="outman" class="form-control form-control-sm mt-2" placeholder="申请人姓名" />
                </div>
                <div class="col-auto">
                    <input name="sendt1" type="text" class="form-control form-control-sm mt-2" id="sendt1" placeholder="送签日期开始" />
                </div>
                <div class="col-auto">
                    <input name="" type="text" id="opname" placeholder="操作员" class="form-control form-control-sm mt-2" />
                </div>
            </div>
        </div>
        <!-- /.card-body -->
        <div class="card-footer">
            <button type="button" id="btnSearch" class="btn btn-default">查询</button>
        </div>
    </div>
    <!-- /.card -->
    <div class="card">
        <div id="ShowList" class="card-body">
            @Html.Partial("~/Views/Visa/OrderAdmin/List.cshtml", Model)
        </div>
    </div>
</section>

<div style="top: 355px; left: 20px;" id="tzldiv" class="tic"></div>
@section PageScripts
{
    <script src="@CDNServerUrl/moment/moment.min.js"></script>
    <!-- date-range-picker -->
    <script src="@CDNServerUrl/daterangepicker/daterangepicker.js"></script>
    <script type="text/javascript">
        $(function () {
            $('#bookdt1').daterangepicker({
                autoUpdateInput: true,
                ranges: {
                    '今天': [moment(), moment()],
                    '昨天': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                    '本周': [moment().startOf('week'), moment()],
                    '上周': [moment().subtract(6, 'days'), moment()],
                    '本月': [moment().startOf('month'), moment().endOf('month')],
                    '上月': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
                },
                locale: {
                    format: "YYYY/MM/DD", //设置显示格式
                    applyLabel: '确定', //确定按钮文本
                    cancelLabel: '清空', //取消按钮文本
                    daysOfWeek: ['日', '一', '二', '三', '四', '五', '六'],
                    monthNames: ['一月', '二月', '三月', '四月', '五月', '六月', '七月', '八月', '九月', '十月', '十一月', '十二月'],
                    customRangeLabel: "自定义",
                    firstDay: 1
                }
            }, function (start, end) {
                $('#bookdt1 input').val(start.format('Do MMM YYYY') + ' - ' + end.format('Do MMM YYYY'));
            });
            $('#bookdt1').on('cancel.daterangepicker', function (ev, picker) {
                //do something, like clearing an input
                $('#bookdt1').val('');
            });

            // 初始
            $('#bookdt1').val('');

            $('#sendt1').daterangepicker({
                autoUpdateInput: true,
                ranges: {
                    '今天': [moment(), moment()],
                    '昨天': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                    '本周': [moment().startOf('week'), moment()],
                    '上周': [moment().subtract(6, 'days'), moment()],
                    '本月': [moment().startOf('month'), moment().endOf('month')],
                    '上月': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
                },
                locale: {
                    format: "YYYY/MM/DD", //设置显示格式
                    applyLabel: '确定', //确定按钮文本
                    cancelLabel: '清空', //取消按钮文本
                    daysOfWeek: ['日', '一', '二', '三', '四', '五', '六'],
                    monthNames: ['一月', '二月', '三月', '四月', '五月', '六月', '七月', '八月', '九月', '十月', '十一月', '十二月'],
                    customRangeLabel: "自定义",
                    firstDay: 1
                }
            }, function (start, end) {
                $('#sendt1 input').val(start.format('Do MMM YYYY') + ' - ' + end.format('Do MMM YYYY'));
            });
            $('#sendt1').on('cancel.daterangepicker', function (ev, picker) {
                //do something, like clearing an input
                $('#sendt1').val('');
            });

            // 初始
            $('#sendt1').val('');


            //查询订单
            $("#btnSearch").click(function () {

                var param = {
                    "orderQueryModel.OrderCode": $("#ordercode").val(),
                    "orderQueryModel.ProductName": $("#prodcutnames").val(),
                    "orderQueryModel.ProduceManager": $("#prodcutmanagers").val(),
                    "orderQueryModel.TeamID": $("#TeamID").val(),
                    "orderQueryModel.TourNo": $("#TourNo").val(),
                    "orderQueryModel.BookMan": $("#bookman").val(),
                    "orderQueryModel.BookDate": $("#bookdt1").val(),
                    "orderQueryModel.OrderSource": $("#ordersource").val(),
                    "orderQueryModel.ContactName": $("#name").val(),
                    "orderQueryModel.ContactTel": $("#tel").val(),
                    "orderQueryModel.ApplicantName": $("#outman").val(),
                    "orderQueryModel.PaymentType": $("#repaytype").val(),
                    "orderQueryModel.PaymentStatus": $("#repaystatus").val(),
                    "orderQueryModel.OrderStatus": $("#orderstatus").val(),
                    //                "orderQueryModel.LaterPayDate": $("#repatdt1").val(),
                    //                "orderQueryModel.CancelDate": $("#canceldt1").val(),
                    "orderQueryModel.TraceState": $("#operstatus").val(),
                    "orderQueryModel.SendVisaDate": $("#sendt1").val(),
                    "orderQueryModel.MaterialDeadline": $("#deadt1").val(),
                    "orderQueryModel.OperateName": $("#opname").val(),
                    "orderQueryModel.IsPaymentApplication": $("#ispayapp").val(),
                    "orderQueryModel.InterviewDate": $("#iviewdt1").val(),
                    "orderQueryModel.FollowupDate": $("#followdt1").val(),
                    "visaOrderModelsList.PageIndex": 1,
                    "visaOrderModelsList.PageSize": 10
                }
                $.post("/OrderAdmin/List/", param, function (data) {
                    $("#search").attr("value", "查询");
                    $("#search").removeAttr("disabled");
                    $("#ShowList").html(data);
                });
            });

        });

        //处理订单
        function FunctionOperation(ordercode, show, type) {
            if (type == 1) {
                window.open("/OrderAdmin/OperIndex?OrderCode=" + ordercode + "&show=" + show);
            }
            else {
                window.open("/OrderAdmin/ModifyOrder?OrderCode=" + ordercode);
            }
        }
    </script>
}