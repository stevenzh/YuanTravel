@{
    Layout = null;
}
@if (ViewData["ShowBtn"] != null && ViewData["ShowBtn"] != "")
{
    <div class="layer01" id="divButtonOperateLayer">
        <table width="100%" cellpadding="0" cellspacing="0">
            <tr>
                <td>@ViewData["ShowBtn"]</td>
                <td style="width:100px;"><span style="float:right; margin:auto 10px; color:#666; cursor:pointer;" onclick="funSetFloatLayer(this)">︾固定停靠</span></td>
            </tr>
        </table>
    </div>
}
<script type="text/javascript" language="javascript">
    function funSetFloatLayer(obj) {
        if ($("#divButtonOperateLayer").attr("class") == "layer01") {
            $("#divButtonOperateLayer").attr("class", "layer02");
            $(obj).text("︽浮动停靠");
        } else {
            $("#divButtonOperateLayer").attr("class", "layer01");
            $(obj).text("︾固定停靠");
        }
    }
</script>
