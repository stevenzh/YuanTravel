@model Lvy.Visa.VModels.OrderQModel

<div id="divShowOrderHistorys">
    <table id="tabOrderHistorys" class="table table-sm">
        <tr>
            <td style="width:10%;">序号</td>
            <td style="width:15%;">操作人</td>
            <td style="width:15%;">操作人ip</td>
            <td style="width:15%;">操作时间</td>
            <td>动作</td>
        </tr>
        @foreach (var historyModel in Model.HistoryList)
        {
            <tr>
                <td>@historyModel.Id</td>
                <td>@historyModel.Name</td>
                <td>@historyModel.Ip</td>
                <td>@historyModel.OperateDate</td>
                <td>@historyModel.OperateContent</td>
            </tr>
        }
    </table>
</div>
