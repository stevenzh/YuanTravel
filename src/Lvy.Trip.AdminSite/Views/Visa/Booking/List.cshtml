@model Lvy.Visa.VModels.VisaBookingQModel
@{
    Layout = null;
}

<table class="table table-sm table-bordered">
    <tr>
        <td>产品名称</td>
        <td style="width: 80px;">办理地点</td>
        <td style="width: 180px;">签证有效期</td>
        <td>办理时长</td>
        <td style="width: 80px;">入境次数</td>
        <td>最长停留时间</td>
        <td style="width: 8%;">面试</td>
        <td style="width: 11%;">受理范围</td>
        <td style="width: 10%;">价格(含服务费)</td>
        <td style="width: 80px;">操作</td>
    </tr>
    @if (Model.VisaInformationList.Items.Count() != 0)
    {
        foreach (var item in Model.VisaInformationList.Items)
        {
            <tr>
                <td style="padding-left: 10px;">
                    <a href="#" onclick="ShowInfomation(@item.InformationCode,'@item.InformationName');">@item.InformationName</a>
                </td>
                <td style="text-align: center;">@item.VisaIssuePlaceName</td>
                <td class="alt" alt='@item.VisaExpiryDate'>@item.VisaExpiryDate.TrimWithElipsis(10)</td>
                <td class="alt" alt='@item.AcceptedTime'>@item.AcceptedTime.TrimWithElipsis(10)</td>
                <td class="alt" alt='@item.EnterCount'>@item.EnterCount.TrimWithElipsis(8)</td>
                <td class="alt" alt='@item.StayDays'>@item.StayDays.TrimWithElipsis(10)</td>
                <td>@item.InterviewTypeValue</td>
                <td class="alt" alt='@item.AcceptedRange'>@item.AcceptedRange.TrimWithElipsis(10)</td>
                <td><span style="color: #ff3300; font-size: 15px; line-height: 15px;">@Math.Round(item.SellPrice, 0)</span>&nbsp;元/人</td>
                <td>
                    <button type="button" class="btn btn-sm btn-info" onclick="FunctionOperation('@item.InformationCode');">预定</button>
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="10" align="center" style="color: Red;">抱歉，没有找到你所需要的数据！</td>
        </tr>
    }
</table>
<div id="Pagination" class="digg" />

<script type="text/javascript">
    $(function () {

    });
    //分页控件 begin
    $(function () {
        $("#Pagination").pagination(
            Number(@Model.VisaInformationList.TotalCount), {
                callback: pageselectCallback,
                prev_text: '前一页',
                next_text: '后一页',
                items_per_page: 10,
                num_display_entries: 5,
                num_edge_entries: 2,
                current_page: index
            });
    });
    //回调方法
    function pageselectCallback(page_id, jq) {
        jQuery.ajaxSetup({ cache: false });
        index = page_id;
        page_id = page_id + 1;
        var param = {
            "InformationCode": $("#InformationCode").val(),
            "InformationName": $("#InformationName").val(),
            "VisaType": $("#VisaType").val(),
            "VisaCountry": $.trim($("#VisaCountry").val()) == "中文/拼音" ? "" : $("#VisaCountry").val(),
            "VisaIssuePlace": $.trim($("#VisaIssuePlace").val()) == "中文/拼音" ? "" : $("#VisaIssuePlace").val(),
            "LinqQuValue": $("#LinqQuValue").val(),
            'VisaInformationList.PageIndex': page_id,
            'VisaInformationList.PageSize': 10
        };
        $.post('/Booking/ProductList/', param, function (data) {
            $('#ShowList').html(data);
        });
    }
    //分页控件 end
</script>

