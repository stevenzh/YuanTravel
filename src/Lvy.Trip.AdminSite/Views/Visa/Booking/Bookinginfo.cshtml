    //提交信息
    function CheckSubmit() {
        if (!ValidateFormData())
            return;
        //var url = "/Booking/BookingConfirm";
        //layer.open({ type: 2, title: '【签证】 - 确认订单', maxmin: true, shadeClose: true, area: ['1000px', '600px'], content: url });
        $("#frmorders").submit();
    }

    function ValidateFormData() {
        //订单联系人
        if ($.trim($("#LinkManName").val()) == "") {
            toastr.warning('联系人不能为空！');
            $("#LinkManName").focus();
            return false;
        }
        if ($.trim($("#LinkManMobile").val()) == "") {
            toastr.warning("手机号码不能为空！");
            $("#LinkManMobile").focus();
            return false;
        } else if (!ValidationData('mobilephone', $.trim($("#LinkManMobile").val()))) {
            toastr.warning("手机号码格式错误！");
            $("#LinkManMobile").focus();
            return false;
        }
        /*if ($.trim($("#LinkManNumber").val()) != "") {
            if (!ValidationData('phone', $("#LinkManNumber").val())) {
                toastr.warning("联系电话格式不正确！");
                $("#LinkManNumber").focus();
                return false;
            }
        }
        if ($.trim($("#LinkManEmail").val()) == "") {
            toastr.warning("邮件不能为空！");
            $("#LinkManEmail").focus();
            return false;
        }
        else if (!ValidationData('email', $("#LinkManEmail").val())) {
            toastr.warning("邮件格式不正确！");
            $("#LinkManEmail").focus();
            return false;
        }
        if ($.trim($("#txtInvoiceaddress").val()) == "") {
            toastr.warning("地址不能为空！");
            $("#txtInvoiceaddress").focus();
            return false;
        }
        */
        //出行日期
        if ($.trim($("#txtOutDate").val()) == "") {
            toastr.warning("预约出行日期不能为空！");
            $("#txtOutDate").focus();
            return false;
        }
        //人数
        if ($.trim($("#totPeopleCount").val()) == "" || !new RegExp("^[0-9]{1,3}$").test($("#totPeopleCount").val())) {
            $("#totPeopleCount").val("0");
        }
        if ($("#totPeopleCount").val() <= 0) {
            toastr.warning("请输入申请人数！");
            $("#totPeopleCount").focus();
            return false;
        }

        //申请人
        var _tempGuestFlag = true;
        $("#guestlists tr").not(":first").each(function (i) {
            if ($("#txtGuestName_" + i).val() == "") {
                $("#txtGuestName_" + i).css({ "background-color": "#ffffdf", "border": "1px solid #ff3300" });
                _tempGuestFlag = false;
            } else {
                $("#txtGuestName_" + i).css({ "background-color": "#fff", "border": "1px solid #ddd" })
            }
            /*if ($("#txtGuestCardNo_" + i).val() == "") {
                $("#txtGuestCardNo_" + i).css({ "background-color": "#ffffdf", "border": "1px solid #ff3300" });
                _tempGuestFlag = false;
            } else {
                $("#txtGuestCardNo_" + i).css({ "background-color": "#fff", "border": "1px solid #ddd" })
            }*/
        });
        if (!_tempGuestFlag) {
            toastr.warning("请检查申请人信息是否输入完整！");
            return false;
        }
        SetOrderTotalAmount();
        return true;
    }
    </script>

}