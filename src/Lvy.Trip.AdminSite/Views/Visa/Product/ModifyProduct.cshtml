@model Lvy.Visa.Models.VisaInformationModel
@{
    Layout = null;
}

@using (Html.BeginForm("SaveProduct", "VisaProduct", FormMethod.Post, new { id = "frmModify", enctype = "multipart/form-data" }))
{
    @Html.HiddenFor(a => a.InformationCode)
    @Html.HiddenFor(a => a.InformationId)
    @Html.HiddenFor(a => a.State)
    @Html.HiddenFor(a => a.CreateBy)
    @Html.HiddenFor(a => a.CreateByName)
    @Html.HiddenFor(a => a.Createtime)
    @Html.HiddenFor(a => a.PManageUser)
    @Html.HiddenFor(a => a.PManageUserName)
    @Html.HiddenFor(a => a.PManageDate)
    @Html.HiddenFor(a => a.OnlineUser)
    @Html.HiddenFor(a => a.OnlineUserName)
    @Html.HiddenFor(a => a.OnlineDate)
    @Html.HiddenFor(a => a.IsCategory)
    @Html.HiddenFor(a => a.IsValid)

    @Html.Partial("~/Views/Visa/Product/ProductPartial.cshtml")
    <div class="form-group">
        <input type="button" value="保存" class="btn btn-success" id="btnSave" onclick="funValidateProductForm()" />
        <input type="button" value="取消" class="btn btn-secondary" id="btnCancel" />
    </div>
    <div>
        @{ Html.RenderAction("ProductProcessManage", new { InformationCode = Model.InformationCode }); }
    </div>
}

<script type="text/javascript">
    function funValidateProductForm() {
        var pName = $('#InformationName').val();
        if (!ValidationData('none', pName)) {
            alert("产品名称不能为空，请输入！！");
            $('#InformationName').focus();
            return false;
        } else {
            var param = { "InformationName": $('#InformationName').val(), "InformationCode": $('#InformationCode').val() };
            $.post("/VisaProduct/CheckProductNameIsExists/", param, function (data) {
                if (data == "Y") {
                    $("#spanPname").html("产品名称已存在！！");
                    alert("产品名称已存在! !");
                    $('#InformationName').focus();
                    $("#spanPname").css("color", "red");
                } else {
                    $("#spanPname").html("");
                    if ($("#VType").val() == "-1") {
                        alert("请选择类型！！");
                        $("#VType").focus();
                        return false;
                    }

                    var visatype = $("#VisaType").val();
                    if (visatype == "-1") {
                        alert("请选择签证类型！！");
                        $("#VisaType").focus();
                        return false;
                    }

                    var interviewtype = $("#InterviewType").val();
                    if (interviewtype == "-1") {
                        alert("请选择面销类型！！");
                        $("#InterviewType").focus();
                        return false;
                    }

                    var continent = $("#Continent").val();
                    if (continent == "-1") {
                        alert("请选择版块！！");
                        $("#Continent").focus();
                        return false;
                    }

                    var visacountry = $("#VisaCountry").val();
                    var _hidparentStr = $("#VisaCountryParentStr").val();
                    if (!ValidationData('none', visacountry) || !ValidationData('none', _hidparentStr) || $.trim(visacountry) == "中文/拼音") {
                        alert("签证国家或地区不能为空，请输入！！");
                        $("#VisaCountry").focus();
                        $("#VisaCountry").val("中文/拼音");
                        $("#VisaCountryParentStr").val("");
                        return false;
                    }

                    var _visaArea = $("#VisaArea").val();
                    if (_visaArea == "-1") {
                        alert("请选择所属领区！！");
                        $("#VisaArea").focus();
                        return false;
                    }

                    var visaIssuePlace = $("#VisaIssuePlaceName").val();
                    var _hidIssueparentStr = $("#VisaIssuePlace").val();
                    if (!ValidationData('none', visaIssuePlace) || !ValidationData('none', _hidIssueparentStr) || $.trim(visaIssuePlace) == "中文/拼音") {
                        alert("签发地不能为空，请输入！！");
                        $("#VisaIssuePlaceName").focus();
                        $("#VisaIssuePlaceName").val("中文/拼音");
                        $("#VisaIssuePlace").val("");
                        return false;
                    }

                    //                    var visaarea = $("#VisaArea").val();
                    //                    if (visaarea == "-1") {
                    //                        alert("请选择所属领区！！");
                    //                        $("#VisaArea").focus();
                    //                        return false;
                    //                    }


                    newToCity = $("#LivePassportArea").val();

                    //                    if (newToCity == "") {
                    //                        alert("居住 / 护照签发地范围不能为空，请选择！！");
                    //                        $("#LivePassportArea").focus();
                    //                        return false;
                    //                    }


                    var tradeprice = $("#TradePrice").val();
                    if (!ValidationData('none', tradeprice)) {
                        alert("同业价格不能为空，请输入！！");
                        $("#TradePrice").focus();
                        return false;
                    }
                    else if (!ValidationData('positive_number', tradeprice)) {
                        alert("同业价格格式错误，必须是大于0的整数，请重新输入！！");
                        $('#TradePrice').focus();
                        return false;
                    }

                    var sellprice = $("#SellPrice").val();
                    if (!ValidationData('none', sellprice)) {
                        alert("销售价格不能为空，请输入！！");
                        $("#SellPrice").focus();
                        return false;
                    }
                    else if (!ValidationData('positive_number', sellprice)) {
                        alert("销售价格格式错误，必须是大于0的整数，请重新输入！！");
                        $('#SellPrice').focus();
                        return false;
                    }

                    var acceptedtime = $("#AcceptedTime").val();
                    if (!ValidationData('none', acceptedtime)) {
                        alert("办理时长不能为空，请输入！！");
                        $("#AcceptedTime").focus();
                        return false;
                    }

                    var isvalidtime = $("#IsValidTime").val();
                    if (!ValidationData('none', isvalidtime)) {
                        alert("签证有效期不能为空，请输入！！");
                        $("#IsValidTime").focus();
                        return false;
                    }

                    var staydays = $("#StayDays").val();
                    if (!ValidationData('none', staydays)) {
                        alert("最长停留时间不能为空，请输入！！");
                        $("#StayDays").focus();
                        return false;
                    }

                    var enterCount = $("#EnterCount").val();
                    if (!ValidationData('none', enterCount)) {
                        alert("入境次数不能为空，请输入！！");
                        $("#EnterCount").focus();
                        return false;
                    }

                    var paytimelimit = $("#PayTimeLimit").val();
                    if (!ValidationData('none', paytimelimit)) {
                        alert("付款时限不能为空，请输入！！");
                        $("#PayTimeLimit").focus();
                        return false;
                    }
                    else {
                        if (!ValidationData('integer', paytimelimit) || paytimelimit < 0) {
                            alert("付款时限格式错误，必须大于等于0，请重新输入！！");
                            $('#PayTimeLimit').focus();
                            return false;
                        }
                    }

                    var advanceDays = $("#AdvanceDays").val();
                    if (!ValidationData('none', advanceDays)) {
                        alert("提前预定天数不能为空，请输入！！");
                        $("#AdvanceDays").focus();
                        return false;
                    }

                    var enterCount = $("#IsDanBao").val();
                    if (enterCount == "-1") {
                        alert("请选择是否需要担保！！");
                        $("#IsDanBao").focus();
                        return false;
                    }


                    var acceptedRange = $("#AcceptedRange").val();
                    if (!ValidationData('none', acceptedRange)) {
                        alert("受理范围不能为空，请输入！！");
                        $("#AcceptedRange").focus();
                        return false;
                    }


                    //if (tinyMCE.get("BookingNodes").getContent() == "") {
                    if ($("#BookingNodes").val() == "") {
                        alert("预定须知不能为空，请输入！！");
                        $("#BookingNodes").focus();
                        return false;
                    }

                    //                    if ($("#WarmTips").val() == "") {
                    //                        alert("友情提示不能为空，请输入！！");
                    //                        $("#WarmTips").focus();
                    //                        return false;
                    //                    }

                    //图片
                    var imgurl = $("#ImgUrl").val();
                    if (!ValidationData('none', imgurl)) {
                        alert("请选择图片！");
                        return false;
                    }
                    //资源端判断

                    var hidSupplierCode = $("#SupplierCode").val();
                    if (!ValidationData('none', hidSupplierCode)) {
                        alert("请选择供应商资源！！");
                        $("#span_supplierName").focus();
                        return false;
                    }
                    //销售价必须大于成人结算价
                    var reservePrice = $("#ReservePrice").val();
                    if (parseFloat(sellprice) < parseFloat(reservePrice)) {
                        alert("销售价必须大于或等于成人结算价!!");
                        return false;
                    }

                    $("#divProductLoadingData").show();
                    $("#btnSave").attr("disabled", "disabled");
                    $("#frmModify").submit();
                }
            });
        }
    }
    //取消按钮事件
    $("#btnCancel").click(function () {
        $("#tbModifyProduct input[type=text]").val("");
        $("#tbModifyProduct textarea").text("");
        $("#tbModifyProduct select").val("-1");
        //$("#VisaCountry").val("中文/拼音");
        $("#VisaIssuePlaceName").val("中文/拼音");
        //$("#LivePassportAreaName").val("中文/拼音");
        $("#pToArea").html("");
    });
</script>

