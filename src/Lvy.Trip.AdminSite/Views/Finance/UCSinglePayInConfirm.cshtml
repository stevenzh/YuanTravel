@model Lvy.VModels.Finance.PayInConfirmVModel
<form id="singleShoKuan">
    <div class="xboxcontent clear" style="padding: 0 5px;">
        <table width="100%" class="edittbl" style="border-bottom: 0px;">
            <tr>
                <td style="text-align: right; width: 90px;">
                    订单号：
                </td>
                <td>
                    @Model.OrderId
                </td>
            </tr>
            <tr>
                <td style="text-align: right;">
                    应收账款：
                </td>
                <td>
                    @Model.TotalYs
                </td>
            </tr>
            <tr>
                <td style="text-align: right;">
                    已收账款：
                </td>
                <td>
                    @Model.TotalPaid
                </td>
            </tr>
            <tr>
                <td style="text-align: right;">
                    未收账款：
                </td>
                <td>
                    <span id="singleConfirmUnPaid">@Model.TotalUnPaid</span>
                </td>
            </tr>
            <tr>
                <td style="text-align: right;">
                    本次收款：
                </td>
                <td>
                    <input type="text" id="singleConfirmPayIn" name="CurrentPayment" class="text70" value="@Model.CurrentPayment" onkeypress="InputLimitNumber();" />
                </td>
            </tr>
        </table>
    </div>
</form>
