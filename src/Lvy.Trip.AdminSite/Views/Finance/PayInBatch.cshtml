@model Lvy.VModels.Finance.FinanceVModel
@{
    ViewBag.Title = "PayInBatch";
}
<form id="theForm" method="POST" action="@Url.Action("PayInBatch")">
    <div class="station">
        财务批量收款确认
    </div>
    @{
        string tipMsg = ViewBag.TipMsg == null ? string.Empty : ViewBag.TipMsg as string;
    }
    @if (tipMsg.Length > 0)
    {
        <div class="xbox">
            <div class="clear" style="font-weight: bold; color: red; text-align: center;">@Html.Raw(tipMsg)</div>
        </div>
    }
    <div class="xbox">
        <div class="xboxcontent clear">
            @{var effectiveOrder = @Model.OrderModels.Items.Where(p => p.OrderState == 2).ToList();}
            <table width="100%" class="edittbl" style="border-bottom: 0px;">
                <tr>
                    <td style="text-align: right;">
                        订单数：
                    </td>
                    <td style="color: red;">
                        @effectiveOrder.Count
                    </td>
                    <td style="text-align: right;">
                        应收总额：
                    </td>
                    <td>
                        @{var totolYs = effectiveOrder.Sum(p => p.TolYsPrice);}
                        ￥@totolYs
                    </td>
                </tr>
                <tr>
                    <td style="text-align: right;">
                        已收总额：
                    </td>
                    <td>
                        @{var totolPaid = effectiveOrder.Sum(p => p.TolPaid);}
                        ￥@totolPaid
                    </td>
                    <td style="text-align: right;">
                        未收总额：
                    </td>
                    <td>
                        ￥@(totolYs - totolPaid)
                    </td>
                    <td colspan="2" style="text-align: center;"></td>
                </tr>
            </table>
            <input id="submitBtn" type="button" class="btn btn1" value="确认提交" />
            <input id="backBtn" type="button" class="btn btn1" value="取消" />
        </div>
    </div>
    <div class="xbox clear">
        <table class="listtbl" width="100%">
            <thead>
                <tr style="text-align: center;">
                    <td style="width: 10px;">@*<input type="checkbox" id="chkAll" />*@</td>
                    <td>订单号</td>
                    <td>关联订单号</td>
                    <td>团名</td>
                    <td>出发<br />日期</td>
                    <td>分销商</td>
                    <td>分销商联系人</td>
                    <td>客人名称</td>
                    <td>人数</td>
                    <td>应收款</td>
                    <td>未收款</td>
                    <td>订单<br />状态</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderModels.Items)
                {
                    <tr style="text-align: center;">
                        <td>
                            @if (item.OrderState == 2)
                            {
                                <input type="checkbox" value='@item.OrderCode' name="orderCodes" checked="checked" />
                            }
                        </td>
                        <td>@item.Id</td>
                        <td>@item.JoinOrderCode</td>
                        <td style="text-align: left;">@item.LineName.TrimWithElipsis(16)</td>
                        <td>@item.OutDate.ToString("MM-dd")</td>
                        @{var customer = DictionaryTools.GetCachedCustomer(item.BookingCustomer);}
                        <td title="@customer.FastCode-@customer.Name">
                            @customer.Name.TrimWithElipsis(6)
                        </td>
                        <td>@item.Managers</td>
                        <td>@item.LinkMan</td>
                        <td>@item.TravellerCount</td>
                        <td>@item.TolYsPrice</td>
                        <td>@(item.TolYsPrice - item.TolPaid)</td>
                        <td>@Common.DisplayState(item.OrderState)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</form>
<script type="text/javascript">
    $(function () {
        $('#backBtn').click(function () {
            window.location.href = "/Finance/SearchFinance";
        });

        $('#submitBtn').click(function () {
            if ($(':checkbox[name="orderCodes"]:checked').length == 0) {
                Utils.alert('请选择需要提交的订单');
                return false;
            }
            var param = $('#theForm').formSerialize();
            $.post('/Finance/PayInBatchCheck', param, function (data) {
                if (data) {
                    layer.open({
                        type: 1, title: '导入销账单', maxmin: false
                        , shadeClose: false, area: ['400px', '300px']
                        , content: data
                        , btn: ["提交", "取消"]
                        , yes: function (index, layero) {
                            var load_iii = Utils.layerLoad();
                            $.post('/Finance/PayInBatch', param, function (result) {
                                if (result == "success") {
                                    Utils.alert('提交成功');
                                    window.location = "/Finance/SearchFinance";
                                }
                                else if (result == "null") {
                                    Utils.alert('未提交任何数据');
                                }
                                else {
                                    Utils.alert('提交失败');
                                }
                                Utils.layerClose(load_iii);
                            });
                        }
                        , btn2: function (index, layero) {
                            // 取消
                        }
                    });
                }
                else {
                    Utils.alert('请求发生异常');
                }
            });
            return false;
        });

    });

</script>
