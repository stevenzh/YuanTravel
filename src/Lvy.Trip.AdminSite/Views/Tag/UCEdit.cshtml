@model Lvy.VModels.Base.TagVModel
<form id="editForm">
    <div class="inform">
        <div class="in_box">
            @Html.HiddenFor(a => a.TagModel.Id)
            @Html.HiddenFor(a => a.TagModel.IsValid)
            @Html.HiddenFor(a => a.TagModel.ClickCnt)
            @Html.HiddenFor(a => a.TagModel.Hit)
            <table style="width:100%;">
                <tr>
                    <td class="label"><span class="point">*</span>标签名称：</td>
                    <td>
                        @Html.TextBoxFor(a => a.TagModel.TagName, new { @class = "text150" })
                    </td>
                </tr>
                <tr>
                    <td class="label">产品类型：</td>
                    <td>
                        @Html.DropDownListFor(a => a.TagModel.ProductType, (List<SelectListItem>)ViewBag.TagTypeBean)
                    </td>
                </tr>
                <tr>
                    <td colspan="2"></td>
                </tr>
                <tr>
                    <td colspan="2">
                        <input class="btn btn1" id="btnSave" type="button" value="保存" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
</form>
<script type="text/javascript">
    $(function () {

        $("#btnSave").click(function () {
            if (!checkControls()) {
                return;
            }
            var load_iii = Utils.layerLoad();
            var params = $("#editForm").formSerialize();
            $.post("/Tag/Edit", params, function (data) {
                if (data.code == '0') {
                    parent.pageselectCallback(0);
                    // 弹出框关闭
                    var index = parent.layer.getFrameIndex(window.name); //获取窗口索引
                    parent.layer.close(index);
                }
                Utils.layerClose(load_iii);
            });
        });

        // 焦点移出的场合，验证角色名称是否存在。
        $("#TagModel_TagName").focusout(function () {
            ajaxCheckRoleName();
        });
    });

    // 验证控件
    function checkControls() {
        if ($("#TagModel_TagName").val() == "") {
            Utils.alert("标签名称不能为空!");
            $("#Name").select().focus();
            return false;
        }

        if (ajaxCheckRoleName()) {
            return false;
        }
        return true;
    }

    function ajaxCheckRoleName() {
        var params = { name: $("#TagModel_TagName").val(), 'tagId': $("#TagModel_Id").val() };
        $.post("/Tag/CheckTagName", params, function (data) {
            if (data) {
                //如果存在，提示
                Utils.alert("标签名称已存在，请更改!");
                $("#TagModel_TagName").select().focus();
                return false;
            }
            return true;
        });
    }
</script>