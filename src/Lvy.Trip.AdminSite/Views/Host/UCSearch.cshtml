@using Lvy.Web.Common
@model Lvy.VModels.Crm.HostVModel

@if (Model.Customers.Items.Count > 0)
{
    <table class="table table-sm table-bordered ">
        <thead>
            <tr>
                <td>客户编号</td>
                <td>客户名称</td>
                <td>公司电话</td>
                <td>地址</td>
                <td></td>
                <td align="center" style="width:150px;">操作</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Customers.Items)
            {
                <tr>
                    <td>@item.CustomerCode</td>
                    <td>@item.Name</td>
                    <td>@item.Url</td>
                    <td></td>
                    <td></td>
                    <td class="project-actions">
                        <a href="@Url.Action("Create", "UserAdmin", new {customerCode = item.CustomerCode})" class="btn btn-sm btn-success" title="添加账户"><i class="fas fa-user"></i></a>
                        <a href="@Url.Action("Edit", "Host", new { code = item.CustomerCode })" class="btn btn-sm btn-info" title="编辑商户"><i class="fas fa-edit"></i> </a>
                        <a href="@Url.Action("SetValidState", "Host", new { code = item.CustomerCode })" class="btn btn-sm btn-danger" title="删除商户" onclick="return confirm('确定要删除嘛？')"> <i class="fas fa-trash"></i> </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @Html.HiddenFor(a => a.Customers.PageIndex)
    <div id="Pagination" class="digg"></div>
}
else
{
    <div style="color: red; text-align: center; font-weight: bold; font-size: 14px;">
        <br />
        对不起，没有查找到数据！请重新输入查询条件 ！
    </div>
}

<script src="~/WebRes/scripts/jquery.pagination.js" type="text/javascript"></script>
<script type="text/javascript">

    //分页控件 begin
    $(function () {
        $("#Pagination").pagination(
            Number('@Model.Customers.TotalCount'), {
                callback: pageselectCallback,
                items_per_page: Number('@Model.Customers.PageSize'),
                current_page: @Model.Customers.PageIndex-1
            });
    });


    //回调方法
    function pageselectCallback(page_id, jq) {

        var load_iii = Utils.layerLoad();

        $("#Customers_PageIndex").val(page_id + 1);
        var params = $("#theForm").formSerialize();

        $.post('@Url.Action("Search")', params, function (data) {
            if (data.length < 1) {
                Utils.alert("查询出错，请稍后查询！");
                return false;
            }
            $('#divSearch').html(data);
            Utils.layerClose(load_iii);
        });
    }
</script>
