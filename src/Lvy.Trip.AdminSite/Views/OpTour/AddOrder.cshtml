@model Lvy.VModels.Booking.BookingVModel
@{
    ViewData["Title"] = "OP补订单";
    Layout = "~/Views/Shared/_Single.cshtml";
}
@section AdditionalResources
{
    <script src="~/WebRes/Scripts/jQuery.Hz2Py-min.js" type="text/javascript"></script>
    <script>
        var defaultPolicy = {
            RebateType: 1,  // 1 固定金额； 2百分比
            Percent: 0,
            MaxAmount: 0,
            Amount: 0
        }
    </script>
}

<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>@ViewData["Title"] </h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item active">@ViewData["Title"] </li>
                    </ol>
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">

        <form id="theForm">
            <input type="hidden" name="tax" value="@Model.Tour.Tax">
            <input type="hidden" name="visaPrice" value="@Model.Tour.VisaPrice">
            <input type="hidden" id="TourId" name="TourId" value="@Model.Tour.Id" />
            <input type="hidden" id="BusPointId" name="BusPointId" value="0" />
            <input type="hidden" id="LineScope" name="LineScope" value="@Model.LineModel.LineScope" />
            <input type="hidden" id="LineType" name="LineType" value="@Model.LineModel.LineType" />
            @Html.HiddenFor(a => a.Remark2)

            <div class="row">

                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">线路信息</h3>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm table-borderless">
                                <tr>
                                    <td><strong>线路名称：</strong></td>
                                    <td>@Model.LineModel.LineName</td>
                                    <td><strong> 出发地：</strong>@(string.IsNullOrEmpty(Model.LineModel.DepartDest)?"多地": DictionaryTools.GetEnumValue(Enums.OutCityEnum, Model.LineModel.DepartDest)) </td>
                                    <td><strong>目的地：</strong>@DictionaryTools.GetDestNameStr(Model.LineModel.ArriveDest)    </td>
                                </tr>
                                <tr>
                                    <td><strong>团号：</strong> </td>
                                    <td>@Model.Tour.TourNo</td>
                                    <td><strong>出游时间：</strong></td>
                                    <td>@Model.Tour.OutDate.ToDateFormat()（@Model.Tour.OutDate.DayOfWeek.ToWeekCn()）</td>
                                </tr>
                                <tr>
                                    <td><strong>出游天数：</strong></td>
                                    <td>@Model.LineModel.TravelDays</td>
                                    <td><strong>剩余名额：</strong></td>
                                    <td>@Model.Quota.UseQuota<input type="hidden" id="hidUseQuota" value="@Model.Quota.UseQuota" /></td>
                                </tr>
                                <tr style="display:none;">
                                    <td height="45" align="left" colspan="2" class="select_div_tr">
                                        <div class="font_1">上车地点：</div>
                                        <div class="select_div_address" id="select_div_address">
                                            <div class="select_input_address" id="select_input_address">
                                                <div id="address_span">
                                                    <p style="background:#fff; color:#ccc ">   === 请选择 === </p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="select_option_address">
                                            @foreach (var item in Model.BusPoints.OrderBy(a => a.JsTime))
                                            {
                                                var jsPrice = item.JiePrice + item.SongPrice;
                                                string jsContent = "";
                                                if (item.JsType == 1)
                                                {
                                                    jsContent = "[{0}]{1}(只接不送) | 接价:{2}".With(item.JsTime, item.BusPoint, item.JiePrice);
                                                }
                                                else if (item.JsType == 2)
                                                {
                                                    jsContent = "[{0}]{1}(只送不接) | {1} | 送价:{2}".With(item.BusPoint, item.JsTime, item.SongPrice);
                                                }
                                                else
                                                {
                                                    jsContent = "[{0}]{1} | 接价:{2} | 送价:{3}".With(item.BusPoint, item.JsTime, item.JiePrice, item.SongPrice);
                                                }
                                                <p key="@item.Id" jsPrice="@jsPrice">@jsContent</p>
                                            }
                                        </div>
                                    </td>
                                    <td height="45" colspan="3" align="left">接送价格:￥ <label id="jsPrice">0</label> /人</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">报价类型</h3>
                        </div>
                        <div id="divPrices" class="card-body">
                            <table id="tblPrices" class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>价格类型</th>
                                        <th>市场价</th>
                                        <th>结算价</th>
                                        @if (Model.PriceModels[0].TeJiaFanLi > 0)
                                        {
                                            <th>特价</th>
                                        }
                                        <th>自费</th>
                                        <th>单房差</th>
                                        <th style="width:80px;">人数</th>
                                    </tr>
                                </thead>
                                @foreach (var item in Model.PriceModels)
                                {
                                    <tr>
                                        <td name="tdPriceContent" title="@item.PriceRemark">@item.PriceRemark.TrimWithElipsis(18)</td>
                                        @if (item.TeJiaFanLi > 0)
                                        {
                                            <td name="tdPrice" style="text-decoration:line-through;">@item.Price</td>
                                            <td name="tdSettlePrice" style="text-decoration:line-through;">@item.SettlePrice</td>
                                            <td>@Html.Raw(item.SettlePrice - item.TeJiaFanLi)</td>
                                        }
                                        else
                                        {
                                            <td name="tdPrice">@item.Price</td>
                                            <td name="tdSettlePrice">@item.SettlePrice</td>
                                        }
                                        <td name="tdZiFei">@item.ZiFei</td>
                                        <td name="tdSingleRoom">@item.SingleRoom</td>
                                        <td align="center"><input type="number" value="0" class="form-control form-control-sm" name="priceNum" input-limit="number" /></td>
                                        <td name="tdSuitNum" style="display: none">@item.SuitNum</td>
                                        <td name="tdPriceId" style="display: none">@item.Id</td>
                                        <td name="tdTeJiaFanLi" style="display: none">@item.TeJiaFanLi</td>
                                    </tr>
                                }
                            </table>
                        </div>
                    </div>

                </div>

                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">订单信息</h3>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm table-borderless">
                                <tr>
                                    <td>分销商:</td>
                                    <td>
                                        @Html.HiddenFor(a => a.BookingCustomerName)
                                        <select id="BookingCustomer" name="BookingCustomer" class="form-control form-control-sm"></select>
                                    </td>
                                    <td>结算人：</td>
                                    <td>
                                        <select id="BookingName" name="SettlePlatForm" class="form-control form-control-sm">
                                            <option value="1" selected>自行结算</option>
                                            <option value="2">平台结算</option>
                                            <option value="3">父公司结算</option>
                                        </select>
                                    </td>
                                </tr>
                                <tr>
                                    <td>结算客户：</td>
                                    <td>
                                        <select id="SettleCustomer" name="SettleCustomer" class="form-control form-control-sm"></select>
                                    </td>
                                    <td></td>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td><span class="some_tips">*</span> 联系人姓名:</td>
                                    <td>
                                        <select id="ContactCode" name="ContactCode" class="form-control form-control-sm">
                                            <option value=""></option>
                                        </select>
                                        <input type="hidden" id="Managers" name="Managers" />
                                    </td>
                                    <td><span class="some_tips">*</span> 联系电话:</td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm" id="ManagerPhone" name="ManagerPhone" />
                                    </td>
                                </tr>
                                <tr>
                                    <td><span class="point">*</span>销售部门：</td>
                                    <td>@Html.DropDownListFor(a => a.SalesTeamId, ViewBag.SalesOfTeam as IEnumerable<SelectListItem>, new { @Class = "form-control form-control-sm" })</td>
                                    <td>对应销售：</td>
                                    <td>
                                        @Html.DropDownListFor(a => a.SalerCode, ViewBag.Salers as IEnumerable<SelectListItem>, new { @class = "form-control form-control-sm" })
                                    </td>
                                </tr>
                                <tr>
                                    <td style="vertical-align:top; width:100px;">订单备注：</td>
                                    <td colspan="3">
                                        <textarea class="form-control form-control-sm" id="Remark" name="Remark"></textarea>
                                        @Html.HiddenFor(m => m.Managers)
                                    </td>
                                </tr>
                                <tr>
                                    <td>退改规则</td>
                                    <td colspan="3">
                                        <div class="some_tips">
                                            @Html.Raw(Model.LineModel.OpDesc)
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">游客名单</h3>
                        </div>
                        <div id="divTravellers" class="card-body">
                            @Html.Partial("Booking/UCTravllers", Model)
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <input type="button" id="post_button" class="btn btn-info" value="提交订单" />
                </div>
            </div>
        </form>

    </section>
</div>
@section PageScripts
{
    <script>
    $(function () {

        $('#BookingCustomer').select2({
            ajax: {
                url: '/Customer/GetCustomerSelect2',
                dataType: 'json',
                data: function (params) {
                    return {
                        keyword: params.term, // search term 请求参数 ， 请求框中输入的参数
                        page: params.page || 0,
                        size: 10,
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 0;
                    return {
                        results: data.rows,
                        pagination: {
                            more: (params.page * 10) < data.total
                        }
                    };
                },
                cache: true,
            },
            language: "zh-CN",
            placeholder: '请选择',//默认文字提示
            allowClear: true,
            //templateResult: formatState
        });

        $('#BookingCustomer').on('select2:select', function (evt) {
            var code = evt.params.data.id;
            var name = evt.params.data.text;
            if (code != "") {
                $("#BookingCustomerName").val(name);
                $("#BookingName").val("1");
                $("#BookingName").change();

                // 获取联系人列表
                if ($("#ContactCode") != null && $("#ContactCode") != undefined) {
                    // 获得客户折扣
                    SettlePolicy(code, '@Model.LineModel.ArriveDest', true);
                }
            }
        });

        $("#BookingName").change(function () {

            var selectVal = $(this).val();
            if (selectVal == "") {
                $("#SettleCustomer").empty();
            } else if (selectVal == "2") {
                //平台
                $("#SettleCustomer").empty();
                $.ajax({
                    type: 'post',
                    url: '@Url.Action("GetPinCompany", "Customer")',
                    data: '',
                    success: function (data) {
                        $("#SettleCustomer").append("<option value=''></option>");
                        $(data).each(function (index, item) {
                            $("#SettleCustomer").append("<option value='" + item.Code + "'>" + item.Name + "</option>");
                        });
                    }
                });
            } else if (selectVal == "3") {
                //父公司
                $("#SettleCustomer").empty();
                $.ajax({
                    type: 'post',
                    url: '@Url.Action("GetParentCompany","Online")',
                    data: { custCode: $("#BookingCustomer").val() },
                    success: function (data) {
                        $("#SettleCustomer").append("<option value='" + data.ParentCode + "'>" + data.ParentName + "</option>");
                    }
                });
            }
            else if (selectVal == "1") {
                //选择为 当前自己
                $("#SettleCustomer").empty();
                var code = $("#BookingCustomer").val();
                var text = $("#BookingCustomer").find("option:selected").text();
                $("#SettleCustomer").append("<option value='" + code + "'>" + text + "</option>");
            }
        });

        // 结算平台修改
        $("#SettleCustomer").change(function () {
            console.log("trigger SettleCustomer change ");

            var selectVal = $(this).val();
            if (selectVal != '') {
                // 取得平台折扣
                SettlePolicy(selectVal, '@Model.LineModel.ArriveDest',false);
            }
        });

        $("#ContactCode").change(function () {
            var option = $("#ContactCode").find("option:selected");
            $("#ManagerPhone").val($(option).attr("Phone"));
            $("#Managers").val($("#ContactCode").find("option:selected").text());
            $("#SalesTeamId").val($(option).attr("teamid"));
            $("#SalerCode").val($(option).attr("salercode"));
        });

        // 上车点选择
        SelectBusPoint();
        // 名片
        $("#showBusinessCard").powerFloat({
            targetMode: "ajax"
        });
        $("input[name='priceNum']").change(function () {
            // 如果已经有报价的场合，先删除同报价类型的游客
            $("#tbTravellers tr").remove();

            // 判断是否超过剩余库存 ，如超过，跳出。
            var maxnum = 0;
            $("input[name='priceNum']").each(function () {
                var suit = Number($(this).parents("tr").find("td[name='tdSuitNum']").html()); // 套餐
                maxnum += Number($(this).val()) * suit;
            });

            if (Utils.Trim($("#hidUseQuota").val()) < maxnum) {
                $(this).val(0);

            }
            var Tax = $("input[name='tax']").val();
            var VisaPrice = $("input[name='visaPrice']").val();

            $("input[name='priceNum']").each(function () {

                var obj = $(this).parents("tr");
                var model = new Object();
                model.PriceNum = Number(obj.find("input[name='priceNum']").val()); // 人数
                if (model.PriceNum <= 0) {
                    return;
                }
                model.PriceId = obj.find("td[name='tdPriceId']").html();               // 报价Id
                model.PriceContent = obj.find("td[name='tdPriceContent']").html();     // 报价类型
                model.Price = parseFloat(obj.find("td[name='tdSettlePrice']").html());      // 结算价
                model.TeJiaFanLi = parseFloat(obj.find("td[name='tdTeJiaFanLi']").html());  // 特价让利
                model.Tips = parseFloat(obj.find("td[name='tdTips']").html());         // 小费
                model.ZiFei = Number(obj.find("td[name='tdZiFei']").html());           // 自费
                model.SingleRoom = Number(obj.find("td[name='tdSingleRoom']").html()); // 单房差
                model.SuitNum = Number(obj.find("td[name='tdSuitNum']").html());       // 套餐
                model.JsPrice = Number(Utils.Trim($('#jsPrice').html()));              // 接送费
                model.YsPrice = model.Price - model.TeJiaFanLi;

                model.Tax = Tax;// Number(obj.find("td[name='kao1']").html());
                model.VisaPrice = VisaPrice;// Number(obj.find("td[name='kao2']").html());

                //-----根据人数，拼接游客html-------------------

                // 再追加游客
                var html = GetTravellersHtml(model);
                $("#tbTravellers").append(html);
                // 初始化 总价
                var totalPrice = 0;
                $("#tbTravellers").find("td[name='tdOnePrices']").each(function (i, o) {
                    totalPrice += Number(Utils.Trim($(o).html()));
                });
                $("#totalPrice").html(totalPrice);  // 总价
                //-----------------------------------------------

            });
            //汉字转化为拼音。
            $("input[name$='Name']").on("keyup keydown change blur", function () {

                var obj = $(this).parent("td").parent("tr");
                obj.find("input[name$='PinYin']").val($(this).toPinyin());

            });
        });

        // 预定提交
        $("#post_button").click(function () {
            if (!CheckControl()) {
                return false;
            }
            var params = decodeURIComponent($("#theForm").formSerialize());
            var load_iii = Utils.layerLoad();
            $.post('/OpTour/SaveOrder', params, function (data) {

                if (data.StateCode == 100) {
                    // 预定成功
                    Utils.alert("预定成功！");
                    $("#post_button").attr("disabled", "true");
                    document.location.href = "/Order/EditOrder?orderCode=" + data.OrderCode;
                    return;
                } else if (data.StateCode == 101) {
                    // 车位已经占了的场合，刷新车位数据，提示客户重新选择车位
                    Utils.alert("预定失败。已经有客人吧车位占了，请重新选择车位！");
                } else if (data.StateCode == 102) {
                    // 车位已经被锁定的场合，刷新车位数据，提示客户重新选择车位
                    Utils.alert("预定失败。车位已经被万恶的Op锁定了，请联系Op！");
                } else if (data.StateCode == 103) {
                    // 可用名额小于预定名额
                    Utils.alert("预定失败。你要预定的名额数超过了我们的可用名额，拿起你的电话，请与op协调！");
                } else {
                    Utils.alert("预定失败。这个错误我也不知道该怎么形容了！请联系技术支持！");
                }
                Utils.layerClose(load_iii);
            });
        });
    });

    function SettlePolicy(customerCode, arriveDest, loadContact) {
        console.log("trigger SettlePolicy(). ");

        // 取得规则
        $.ajax({
            type: 'post',
            url: '/Order/GetCustomerInfo',
            data: { custcode: customerCode, lineDest: arriveDest },
            async: false,
            success: function (data) {

                if (loadContact) {
                    $("#ContactCode").empty();
                    $("#ManagerPhone").val("");
                    $("#ContactCode").append("<option value='' Phone=''></option>");
                    $(data.contacts).each(function (index, item) {
                        $("#ContactCode").append("<option value='" + item.Code + "' phone='" + item.Mobile + "' teamid='" + item.TeamID+"' salercode='" + item.SalerCode + "'>" + item.Name + "</option>");
                    });
                }

                var tolYsPrice = Number($("#textInvoiceAmount").val());
                var pax = Number($("#Order_TravellerCount").val());

                // 协议折让规则
                if (data.policy != null) {
                    defaultPolicy.RebateType = data.policy.RebateType;
                    defaultPolicy.Amount = data.policy.Amount;
                    defaultPolicy.Percent = data.policy.Percent;
                    defaultPolicy.MaxAmount = data.policy.MaxAmount;

                    if (defaultPolicy.RebateType == 1) {
                        $("#tdPolicy").text("固定折让，每人" + defaultPolicy.Amount + "元");
                        tolYsPrice = tolYsPrice - pax * defaultPolicy.Amount;
                    } else {
                        $("#tdPolicy").text("百分比， " + defaultPolicy.Percent + "%");
                        tolYsPrice = tolYsPrice * (1 - (defaultPolicy.Percent / 100));
                    }
                } else {
                    defaultPolicy.RebateType = 0;
                    defaultPolicy.Amount = 0;
                    $("#tdPolicy").text("无协议折让");
                }

                // 重新计算
                $("#textTolYsPrice").val(tolYsPrice);
                $("#orderInfo tr td[name='TolYsPrice']").text(tolYsPrice);
            }
        });
    }

    // 验证入力数据
    function CheckControl() {
        var returnValue = true;
        //if ($('#BusPointId').val() == "0") {
        //    Utils.alert("请选择上车点！");
        //    $("html,body").animate({ scrollTop: $("#select_div_address").offset().top - 50 }, 500);
        //    return false;
        //}
        if ($("#BookingCustomer").val()== null || $("#BookingCustomer").val()=="") {
            Utils.alert("请选择下单客户！");
            return false;
        }

        if ($("#tbTravellers tr").length <= 0) // 游客信息的索引
        {
            Utils.alert("请添加游客信息！");
            $("#tblPrices tr:eq(1)").find("input[name='priceNum']").focus().select(); // 人数
            return false;
        }
        // 姓名不能为空
        var returnvalue = true;
        $("#tbTravellers").find("input[name$='Name']").each(function () {
            if (Utils.Trim($(this).val()) == "") {
                Utils.alert("请输入客人姓名！");
                $(this).focus().select();
                returnvalue = false;
                return false;
            }
        });
        if (!returnvalue) { return false; }

        if (Utils.Trim($("select[name$='SalerCode']").val()) == "") {
            Utils.alert("请选择对应销售！");
            $("select[name$='SalerCode']").focus().select();
            return false;
        }
        if ($("select[name$='SettlePlatForm']").val() == null || Utils.Trim($("select[name$='SettlePlatForm']").val()) == "") {
            Utils.alert("请选择结算人！");
            $("select[name$='SettlePlatForm']").focus().select();
            return false;
        }
        if (Utils.Trim($("select[name$='SettleCustomer']").val()) == "") {
            Utils.alert("请选择结算人！");
            $("select[name$='SettleCustomer']").focus().select();
            return false;
        }

        // 联系电话必须留一个
        if (Utils.Trim($("#tbTravellers").find("input[name$='Phone']:eq(0)").val()) == "") {
            Utils.alert("联系电话必须留一个！");
            $("#tbTravellers").find("input[name$='Phone']:eq(0)").focus().select();
            return false;
        }
        //出境  或者fit的场合 ，验证护照
        $("#tbTravellers").find("input[name$='PassNo']").each(function () {
            var type = $(this).parents('tr').find("select[name$='PassType']").val();
            switch (type) {
                case "1":
                    if (!Utils.Check.IsID($(this).val())) {
                        Utils.alert("请输入正确的身份证！");
                        $(this).focus().select();
                        returnvalue = false;
                        return false;
                    }
                    break;
                //  case 2:
                default:
                    if (Utils.Trim($(this).val()) == "") {
                        Utils.alert("请输入证件号码！");
                        $(this).focus().select();
                        returnvalue = false;
                        return false;
                    }
            }
        });
        if (!returnvalue) { return false; }
        //if (Utils.Trim($("#tbTravellers").find($("#Managers").val()) == "") {
        //    Utils.alert("请输入联系人姓名！");
        //    $("#tbTravellers").find("#Managers").focus().select();
        //    return false;
        //}
        //if (Utils.Trim($("#ManagerPhone").val()) == "") {
        //    Utils.alert("请输入联系人电话！");
        //    $("#ManagerPhone").focus().select();
        //    return false;
        //}

        return returnValue;
    }

    // 根据人数，拼接html
    function GetTravellersHtml(model) {
        var lineScope = "@Model.LineModel.LineScope";
        var trafficType = "@Model.LineModel.TrafficType";
        var html = "";
        var travllerIndex = $("#tbTravellers tr").length; // 游客信息的索引
        for (var i = travllerIndex; i < model.PriceNum + travllerIndex; i++) {
            html += "<tr name=\"trPriceId" + model.PriceId + "\" >";
            html += "  <td align=\"center\">" + model.PriceContent + " <input type=\"hidden\" name=\"Travellers[" + i + "].PriceId\" value=\"" + model.PriceId + "\" ></td>"; //报价类型
            html += "  <td align=\"center\"><input type=\"text\" name=\"Travellers[" + i + "].Name\" class=\"form-control form-control-sm\" style=\"width:60px;\" /></td>"; //姓名
