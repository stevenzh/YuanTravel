            }
            if (lineScope == "3" || lineScope == "4") {
                html += "  <td align=\"center\"><input type=\"checkbox\" id=\"VisaPrice" + i + "\" name=\"Travellers[" + i + "].VisaPrice\" group=\"visaPrice\"  onclick='CalcPrice(this);' /> <label for=\"VisaPrice" + i + "\" >" + model.VisaPrice + "</label></td>";  //签证费用
            }
            html += "  <td align=\"center\"><input type=\"checkbox\" id=\"zifei" + i + "\" name=\"Travellers[" + i + "].ZiFei\" group=\"chkAll\" onclick='CalcPrice(this);' /> <label for=\"zifei" + i + "\" >" + model.ZiFei + "</label></td>";  //自费
            html += "  <td align=\"center\"><input type=\"checkbox\" id=\"singleroom" + i + "\"  name=\"Travellers[" + i + "].SingleRoom\" group=\"chkAll2\" onclick='CalcPrice(this);' /> <label for=\"singleroom" + i + "\" >" + model.SingleRoom + "</label></td>";  //房差
            html += "  <td align=\"center\"><input type=\"text\" class=\"form-control form-control-sm fanli\" name=\"Travellers[" + i + "].FanLi\" onchange='CalcPrice(this);' style=\"width:70px;\"></td >";
            html += "  <td align=\"center\" name=\"tdOnePrices\" style=\"color:#FF8F27;\" >" + model.YsPrice + "</td>";  // 客人应收款
            html += "  <td align=\"center\" name=\"tdPrice\" style=\"display: none;\" >" + model.YsPrice + "</td>";        //销售价
            html += " <input type=\"hidden\"  name=\"Travellers[" + i + "].IsMianPiao\" value='0' >";
            html += "</tr>";
        }
        var travellerNum = model.PriceNum * (model.SuitNum - 1); // 实际人数
        for (var i = model.PriceNum + travllerIndex; i < travellerNum + model.PriceNum + travllerIndex; i++) {
            html += "<tr name=\"trPriceId" + model.PriceId + "\" >";
            html += "  <td align=\"center\">" + model.PriceContent + " <input type=\"hidden\"  name=\"Travellers[" + i + "].PriceId\" value=\"" + model.PriceId + "\" >  </td>"; //报价类型
            html += "  <td align=\"center\"><input type=\"text\" name=\"Travellers[" + i + "].Name\" class=\"form-control\"  style=\"width:70px;\" /></td>"; //姓名
            if (trafficType != "1") {
                html += SexHtml(i);//性别
            }
            html += "  <td><input type=\"text\" class=\"form-control\" name=\"Travellers[" + i + "].Phone\" style=\"width:90px;\" /></td>"; //联系电话
            html += GetPassportTypeHtml(i);//证件
            html += "  <td align=\"center\"> <input type=\"text\" class=\"form-control\"  name=\"Travellers[" + i + "].PassNo\" style=\"width:110px;\"> </td>"; //证件号
            if (trafficType != "1") {
                html += "  <td align=\"center\"><input type=\"checkbox\" id=\"Tax" + i + "\"  name=\"Travellers[" + i + "].Tax\" group=\"tax\" onclick='CalcPrice(this);' /> <label for=\"Tax" + i + "\" >" + model.Tax + "</label></td>"; //税
                html += "  <td align=\"center\"><input type=\"checkbox\" id=\"VisaPrice" + i + "\"  name=\"Travellers[" + i + "].VisaPrice\"  group=\"visaPrice\"  onclick='CalcPrice(this);' /> <label for=\"VisaPrice" + i + "\" >" + model.VisaPrice + "</label></td>";  //签证费用
            }
            html += "  <td align=\"center\"><input type=\"checkbox\" id=\"zifei" + i + "\" name=\"Travellers[" + i + "].ZiFei\" group=\"chkAll\" onclick='CalcPrice(this);' /> <label for=\"zifei" + i + "\" >" + model.ZiFei + "</label></td>";  //自费
            html += "  <td align=\"center\"><input type=\"checkbox\" id=\"singleroom" + i + "\"  name=\"Travellers[" + i + "].SingleRoom\" group=\"chkAll2\" onclick='CalcPrice(this);' /> <label for=\"singleroom" + i + "\" >" + model.SingleRoom + "</label></td>";  //房差
            html += "  <td align=\"center\"><input type=\"text\" class=\"form-control form-control-sm fanli\" name=\"Travellers[" + i + "].FanLi\" onchange='CalcPrice(this);' style=\"width:70px;\"></td >";
            html += "  <td align=\"center\" name=\"tdOnePrices\" style=\"color:#FF8F27;\" >" + model.YsPrice + "</td>";  // 客人应收款
            html += "  <td align=\"center\" name=\"tdPrice\" style=\"display: none;\" >" + 0 + "</td>";                  //销售价
            html += " <input type=\"hidden\"  name=\"Travellers[" + i + "].IsMianPiao\" value='1' >";
            html += "</tr>";
        }
        return html;
    }

    // 生成证件类型html
    function GetPassportTypeHtml(i) {
        var html = "<td align=\"center\"><select class=\"form-control form-control-sm\" name=\"Travellers[" + i + "].PassType\">";
        var lineScope = $("#LineScope").val();
        if (lineScope == "3") {
            html += "<option value=\"1\">身份证</option>";
            html += "<option value=\"2\">护照</option>";
            html += "<option value=\"3\" selected=\"selected\">港澳通行证</option>";
        } else if (lineScope == "4") {
            html += "<option value=\"1\" >身份证</option>";
            html += "<option value=\"2\" selected=\"selected\">护照</option>";
            html += "<option value=\"3\">港澳通行证</option>";
        } else {
            html += "<option value=\"1\" selected=\"selected\">身份证</option>";
            html += "<option value=\"2\">护照</option>";
            html += "<option value=\"3\">港澳通行证</option>";
        }
        html += "<option value=\"9\">其他</option>";
        html += "</select></td>";
        return html;
    }

