@model Lvy.VModels.Base.GuideVModel
<div>
    <table class="listtbl" width="100%">
        <thead>
            <tr>
                <td style="text-align: center;"></td>
                <td style="text-align: center;">NO.</td>
                <td style="text-align: center;">姓名</td>
                <td style="text-align: center;">性别</td>
                <td style="text-align: center;">部门</td>
                <td style="text-align: center;">电话</td>
                <td style="text-align: center;">手机</td>
                <td style="text-align: center;">Email</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.GuidePageList.Items)
            {
                <tr>
                    <td>
                        <input type="checkbox" name="GuideCheckBox" value="@item.Id" />
                    </td>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td style="text-align: center;">
                        @DictionaryTools.GetEnumValue(Enums.SexEnum, item.Sex.ToString())
                    </td>
                    <td style="text-align: center;">@item.TeamName</td>
                    <td style="text-align: center;">@item.Tel</td>
                    <td style="text-align: center;">@item.Mobile</td>
                    <td style="text-align: center;">@item.Email</td>
                </tr>
            }
        </tbody>
    </table>

    @Html.HiddenFor(a => a.GuidePageList.PageIndex)
    <div id="Pagination" class="digg"></div>
</div>
<div style="text-align: center;">
    <input type="button" class="btn btn1" id="btnOk" value="确 定" />
    <input type="button" class="btn btn1" id="btnCancel" value="取 消" />
</div>
<script type="text/javascript">
    $(function () {
        debugger;
        $("#btnOk").click(function () {
            var chk = $("input:checkbox:checked");
            if (chk == undefined || chk.length == 0) {
                Utils.alert("请选择领队！");
                return;
            }
            var guideId = $(chk).val();
            var tourId = $("#tourId").val();
            $.ajax({
                url: '@Url.Action("AddGuideId")',
                data: { tourId: tourId, guideId: guideId },
                type: 'post',
                success: function () {

                }
            })
            parent.location.href = '@Url.Action("EditTourists","OpTour")' + '?tourId=' + tourId;
            var index = parent.layer.getFrameIndex(window.name); //获取窗口索引
            parent.layer.close(index);
        });

        $("#btnCancel").click(function () {
            var index = parent.layer.getFrameIndex(window.name); //获取窗口索引
            parent.layer.close(index);
        });
    });

    //分页控件 begin
    $(function () {
        $("#Pagination").pagination(
            Number('@Model.GuidePageList.TotalCount'), {
                callback: pageselectCallback,
                items_per_page: Number('@Model.GuidePageList.PageSize'),
                current_page: @Model.GuidePageList.PageIndex-1
            });
    });
    //回调方法
    function pageselectCallback(page_id, jq) {

        var load_iii = Utils.layerLoad();

        $("#GuideInfos_PageIndex").val(page_id + 1);
        var tourId = $("#tourId").val();
        var params = $("#theForm").formSerialize() + "&tourId=" + tourId;

        $.post('@Url.Action("ChoinceGuide")', params, function (data) {
            if (data.length < 1) {
                Utils.alert("查询出错，请稍后查询！");
                return false;
            }
            $('#divUCGuideInfoist').html(data);
            hoverChangeStyle();
            Utils.layerClose(load_iii);
        });
    }


</script>
