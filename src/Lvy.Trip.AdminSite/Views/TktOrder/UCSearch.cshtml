@model Lvy.VModels.Ticket.TktOrderVModel


@if (Model.Orders.Items.Count > 0)
{
    <div class="card-body">
        <table class="table table-sm">
            <thead>
                <tr>
                    <td style="width: 15px;"><input type="checkbox" id="allOrderCkb" /></td>
                    <th>订单编号</th>
                    <th>产品名称</th>
                    <th>日期</th>
                    <th>价格类型</th>
                    <th>人数</th>
                    <th>购买方式</th>
                    <th>应收账款</th>
                    <th>联系人</th>
                    <th>分销商</th>
                    <th>订单状态</th>
                    <th style="width: 210px;">操作</th>
                </tr>
            </thead>
            <tbody>
                @{
                    foreach (var item in Model.Orders.Items)
                    {
                        <tr name="trOrderCode">
                            <td rowspan="@item.OrderDetails.Count">
                                @if (item.OrderState != 10)
                                {
                                    <input type="checkbox" name="CheckedOrder" value="@item.Id" />
                                }
                            </td>
                            <td rowspan="@item.OrderDetails.Count" onclick="checkOrder(this);">
                                <a href="/TktOrder/Details?orderCode=@item.MasterOrderCode">@item.MasterOrderCode</a>
                            </td>
                            <td title="@item.OrderDetails[0].ProductName">
                                @item.OrderDetails[0].ProductName.TrimWithElipsis(7)
                            </td>
                            <td>
                                @item.OrderDetails[0].OutDate.ToDateFormat().Substring(5)
                            </td>
                            <td title="@item.OrderDetails[0].PriceType">
                                @item.OrderDetails[0].PriceType.TrimWithElipsis(5)
                            </td>
                            <td>
                                @item.OrderDetails[0].PeopleNum
                            </td>
                            <td>
                                @DictionaryTools.GetEnumValue(Enums.TktTypeEnum, item.OrderDetails[0].TktType.ToString())
                            </td>
                            <td>
                                @item.OrderDetails[0].YsPrice
                            </td>
                            <td rowspan="@item.OrderDetails.Count">
                                @item.ContactName<br />@item.ContactPhone
                            </td>
                            @{
                                var customerName = (string.IsNullOrEmpty(item.AgentCode) ? "" : DictionaryTools.GetCachedCustomer(item.AgentCode).Name);
                            }
                            <td rowspan="@item.OrderDetails.Count" title="@customerName">
                                @customerName.TrimWithElipsis(8)
                            </td>
                            <td rowspan="@item.OrderDetails.Count">
                                @Common.DisplayTicketState(item.OrderState)
                            </td>
                            <td rowspan="@item.OrderDetails.Count" class="project-actions">
                                @if (item.IsCancel != 1)
                                {
                                    if (item.OrderState == 1)
                                    {
                                        <a title="确认" href="javascript:void(0);" class="btn btn-primary btn-sm mt-1 ok" bindId="@item.MasterOrderCode"><i class="fas fa-check"></i> 确认</a>
                                    }
                                    @*else if (item.OrderState == 2)
                                        {
                                            <a href="javascript:void(0);" class="btn btn-primary btn-sm mt-1" name="shoukuan" bindId='@item.MasterOrderCode'>收款</a>
                                        }*@

                                    <a title="编辑" href="@Url.Action("EditOrder", new { orderCode = item.MasterOrderCode })" class="btn btn-info btn-sm mt-1"><i class="fas fa-pencil-alt"></i> 编辑</a>
                                    <a title="删除" href="javascript:void(0);" bindId="@item.MasterOrderCode" class="btn btn-danger btn-sm mt-1 delete"><i class="fas fa-trash"></i> 删除</a>
                                    <a title="任务单" href="@Url.Action("EditTaskOrder", new { orderCode = item.MasterOrderCode })" class="btn btn-primary btn-sm mt-1">任务单</a>
                                    <button type="button" class="btn btn-sm btn-primary mt-1" onclick="javascript:parent.openTabPage('@Url.Action("EditTourBalance","Finance", new { orderCode = item.MasterOrderCode })','团单【@item.MasterOrderCode】')" title="团单详情">团单详情</button>
                                }
                            </td>
                        </tr>
                        for (int j = 1; j < item.OrderDetails.Count; j++)
                        {
                            <tr name="trOrderCode">
                                <td title="@item.OrderDetails[j].ProductName">
                                    @item.OrderDetails[j].ProductName.TrimWithElipsis(7)
                                </td>
                                <td>
                                    @item.OrderDetails[j].OutDate.ToDateFormat().Substring(5)
                                </td>
                                <td title="@item.OrderDetails[j].PriceType">
                                    @item.OrderDetails[j].PriceType.TrimWithElipsis(5)
                                </td>
                                <td>
                                    @item.OrderDetails[j].PeopleNum
                                </td>
                                <td>
                                    @DictionaryTools.GetEnumValue(Enums.TktTypeEnum, item.OrderDetails[j].TktType.ToString())
                                </td>
                                <td>
                                    @item.OrderDetails[j].YsPrice
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer">
        <div class="xbox">
            <div class="xboxcontent clear">
                <table width="100%" class="edittbl" style="border-bottom: 0px;">
                    <tr>
                        <td style="text-align: right;">销售数量：</td>
                        <td style="color: red;">@Model.TotalSaledNum</td>
                        <td style="text-align: right;">销售总额：</td>
                        <td>￥@Model.TotalSaledVolume</td>
                        <td style="text-align: right;">实收总额：</td>
                        <td>￥@Model.TotalPaid</td>
                        <td style="text-align: right;">剩余总额：</td>
                        <td>￥@Model.TotalDebt</td>
                        <td colspan="2" style="text-align: center;"></td>
                    </tr>
                </table>
            </div>
        </div>

        @Html.HiddenFor(a => a.Orders.PageIndex)
        <div id="Pagination" class="digg">
        </div>
    </div>
}
else
{

    <div class="card-body">
        <br />
        对不起，没有查找到数据！请重新输入查询条件 ！
    </div>
}

<script type="text/javascript">
    $(function () {

        $("table .ok").each(function (index, element) {
            $(element).click(function () {
                var params = {
                    orderId: $(this).attr("bindId")
                };

                layer.confirm('是否确认订单？', {
                    btn: ['确定', '取消'] //按钮
                }, function () {
                        var load_iii = Utils.layerLoad();
                        $.post('@Url.Action("Confirm")', params, function (data) {
                            if (data > 0) {
                                pageselectCallback(@Model.Orders.PageIndex-1);
                            } else if (data == "no") {
                                Utils.alert('权限不足！');
                            } else {
                                Utils.alert("确认失败！");
                            }
                            Utils.layerClose(load_iii);
                        });
                }, function () {
                });

            });
        });

        $("table .delete").each(function (index, element) {
            $(element).click(function () {
                if (!confirm("确定要删除吗？")) {
                    return false;
                }
                var params = {
                    orderId: $(this).attr("bindId")
                };
                $.get('@Url.Action("Delete")', params, function (data) {
                    if (data > 0) {
                        pageselectCallback(@Model.Orders.PageIndex-1);
                    } else if (data == "no") {
                        Utils.alert('权限不足！');
                    } else {
                        Utils.alert("删除失败！");
                    }

                });
            });
        });

        //分页控件 begin
        $("#Pagination").pagination(
            Number('@Model.Orders.TotalCount'), {
                callback: pageselectCallback,
                items_per_page: Number('@Model.Orders.PageSize'),
                current_page: @Model.Orders.PageIndex-1
        });

        $('#allOrderCkb').click(function () {
            var $this = $(this);
            var checked = $this.prop('checked');
            var $orderCkbs = $(':checkbox[name="CheckedOrder"]');
            if (checked == 'checked') {
                $orderCkbs.each(function () { $(this).prop('checked', true); });
            }
            else {
                $orderCkbs.each(function () { $(this).prop('checked', false); });
            }
        });

        $("#btnBatchShouKuan").click(function () {
            var selectedItems = new Array();
            $(':checkbox[name="CheckedOrder"]:checked').each(function () {
                selectedItems.push($(this).val());
            });
            if (selectedItems.length == 0) {
                Utils.alert("请勾选收款项目！");
                return false;
            }

            var url = '/TktOrder/ShouKuanDialogMulti?orderIds=' + selectedItems.join(',');
            layer.open({
                type: 2, title: '确认收款', maxmin: false,
                shadeClose: false, area: ['400px', '300px'],
                content: url,
                btn: ["确认", "关闭"],
                yes: function (index, layero) {
                    $.post('/TktOrder/ShouKuanMulti', params, function (result) {
                        if (result == "no") {
                            Utils.alert('权限不足！');
                        } else {
                            pageselectCallback(@Model.Orders.PageIndex -1);
                            layer.close(index);
                        }
                    });
                },
                btn2: function (index, layero) {
                    // 取消
                }
            });
        });

        $("table a[name='shoukuan']").each(function (index, element) {
            $(element).click(function () {
                var url = '/TktOrder/ShouKuanDialog?orderId=' + $(this).attr("bindId");
                layer.open({
                    type: 2, title: '确认收款', maxmin: false,
                    shadeClose: false, area: ['400px', '300px'],
                    content: url,
                    btn: ["确认", "关闭"],
                    yes: function (index, layero) {
                        var params = { orderId: orderId };
                        $.post('@Url.Action("ShouKuan", "TktOrder")', params, function (data) {
                            if (data == "no") {
                                Utils.alert('权限不足！');
                            } else {
                                pageselectCallback(@Model.Orders.PageIndex -1);
                                layer.close(index);
                            }
                        });
                    },
                    btn2: function (index, layero) {
                        // 取消
                    }
                });
            });
        });
    });

    //回调方法
    function pageselectCallback(page_id, jq) {
        var load_iii = Utils.layerLoad();
        $("#Orders_PageIndex").val(page_id + 1);
        var params = $("#theForm").formSerialize();
        $.post('@Url.Action("Search", "TktOrder")', params, function (data) {
            if (data.length < 1) {
                Utils.alert("查询出错，请稍后查询！");
            }
            else {
                $('#divOrderSearch').html(data);
            }
            Utils.layerClose(load_iii);
        });
    }

    function checkOrder(e) {
        var $this = $(e);
        var $checkBox = $this.prev().children(':checkbox[name="CheckedOrder"]');
        if ($checkBox && $checkBox.length > 0) {
            if ($checkBox.prop('checked')) {
                $checkBox.prop('checked', false);
            }
            else {
                $checkBox.prop('checked', true);
            }
        }
    }
</script>
