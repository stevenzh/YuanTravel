    <tr>
        <td class="label">订单编号：</td>
        <td style="text-align: left;">@Model.MasterOrderCode</td>
    </tr>
    <tr>
        <td class="label">出发日期：</td>
        <td style="text-align: left;">@Model.OutDate</td>
    </tr>
    <tr>
        <td class="label">导游：</td>
