@model Lvy.VModels.Crm.CustomerPolicyVModel

<style>
    .listtbl tbody td { text-align: center; }
</style>
<div class="xbox clear">
    <div class="btnlist">
        <div class="fr">
            <a href="@Url.Action("UCCreatePolicy",new { code=Model.CustomerCode,policyId=0})" class="btn btn1">添加规则</a>
        </div>
    </div>
    @if (Model.Items.Count > 0)
    {
        <table class="listtbl" style="width:100%;">
            <thead>
                <tr>
                    <td>产品类型</td>
                    <td>区域</td>
                    <td>折让方式</td>
                    <td>折让金额（每人）</td>
                    <td>百分比</td>
                    <td>最大限额（每人）</td>
                    <td>操作</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@DictionaryTools.GetEnumValue(Enums.LineTypeEnum, item.ProductType)</td>
                        <td>@item.RegionName</td>
                        <td>@(item.RebateType == 1 ? "固定金额" : "百分比")</td>
                        <td>@(item.RebateType == 1 ? item.Amount.ToString() : "")</td>
                        <td>@(item.RebateType == 2 ? item.Percent.ToString() : "")</td>
                        <td>@(item.RebateType == 2 ? item.MaxAmount.ToString() : "")</td>
                        <td style="width:10%">
                            <a href="@Url.Action("UCCreatePolicy", new { code = item.CustomerCode, policyId = item.Id })" class="edit" name="editPolicy" title="编辑">编辑</a>
                            <a href="#" class="edit" name="deletePolicy" title="删除" bindId="@item.Id" code="@item.CustomerCode">删除</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="color: red; text-align: center; font-weight: bold; font-size: 14px;">
            <br />
            对不起，没有查找到数据！请重新输入查询条件 ！
        </div>
    }
</div>

<script type="text/javascript">
    $(function () {
        $("a[name='editPolicy']").each(function () {
            $(this).click(function () {
                var load_iii = Utils.layerLoad();
                var url = "@Url.Action("UCCreatePolicy")";
            });
        });


        $("a[name='deletePolicy']").each(function () {
            $(this).click(function () {
                if (!confirm("确定删除？")) {
                    return;
                }
                var load_iii = Utils.layerLoad();
                var url = "@Url.Action("DeletePolicy")";
                $.get(url, { contactId: $(this).attr("bindId"), code: $(this).attr("code") }, function (data) {
                    if (data.length > 0) {
                        $("#divPolicyList").html(data);
                    }
                    Utils.layerClose(load_iii);
                });
            });
        });
    });

    //$(function() {
    //    $('select[name="SortKey"]').change(function() {
    //        pageselectCallback(0);
    //    });
    //});

</script>