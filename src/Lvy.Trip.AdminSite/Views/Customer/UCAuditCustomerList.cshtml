@using Lvy.Web.Common
@model Lvy.VModels.Crm.CustomerVModel
<div class="xbox clear">
    <div class="btnlist">
        <div class="fl">
            排序方式：@Html.DropDownListFor(m => m.SortKey, Model.SortKeyValueBean.ToSelectListFor(Model.SortKey.ToString()))
        </div>
        <div class="fr"></div>
    </div>
    @if (Model.Customers.Items.Count > 0)
    {
        <table class="listtbl" style="width:100%;">
            <thead>
                <tr>
                    <td>客户编号</td>
                    <td>客户名称</td>
                    @*<td>公司电话</td>*@
                    <td>信用额度</td>
                    <td>结算方式</td>
                    <td>等级</td>
                    <td>对应销售</td>
                    <td>审核状态</td>
                    <td>操作</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Customers.Items)
                {
                    <tr>
                        <td style="text-align:center;">@item.Code</td>
                        <td>@item.Name</td>
                        @*<td style="text-align: center;">@item.Phone</td>*@
                        <td style="text-align:center;">@item.CreditLine</td>
                        <td style="text-align: center;">@DictionaryTools.GetEnumValue(Enums.PaymentTypeEnum, item.PaymentType.ToString())</td>
                        <td style="text-align: center;">@DictionaryTools.GetEnumValue(Enums.CustomerRankEnum, item.Rank.ToString())</td>
                        <td style="text-align: center;">@item.SalerName</td>
                        <td style="text-align: center;">
                            @{
                                var state = DictionaryTools.GetEnumValue(Enums.CustomerStateEnum, item.CustomerState.ToString(), false);

                                switch (item.CustomerState)
                                {
                                    case 0:
                                        @:<span class="badge badge-secondary">@state</span>
                                        break;
                                    case 2:
                                        @:<span class="badge badge-warning">@state</span>
                                        break;
                                    default:
                                        break;
                                }
                            }
                        </td>
                        <td align="center" style="width:80px;">
                            <a href="#" title="客户详情" name="audit" code="@item.Code"><i class="fa fa-list"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @Html.HiddenFor(a => a.Customers.PageIndex)
        <div id="Pagination" class="digg"></div>
    }
    else
    {
        <div style="color: red; text-align: center; font-weight: bold; font-size: 14px;">
            <br />
            对不起，没有查找到数据！请重新输入查询条件 ！
        </div>
    }
</div>
<script type="text/javascript">

    //分页控件 begin
    $(function () {
        $("#Pagination").pagination(
            Number('@Model.Customers.TotalCount'), {
                callback: pageselectCallback,
                items_per_page: Number('@Model.Customers.PageSize'),
                current_page: @Model.Customers.PageIndex-1
            });
    });


    //回调方法
    function pageselectCallback(page_id, jq) {

        var load_iii = Utils.layerLoad();

        $("#Customers_PageIndex").val(page_id + 1);
        var params = $("#theForm").formSerialize();

        $.post('@Url.Action("AuditCustomer")', params, function (data) {
            if (data.length < 1) {
                Utils.alert("查询出错，请稍后查询！");
                return false;
            }
            $('#divSearch').html(data);
            hoverChangeStyle();
            Utils.layerClose(load_iii);
        });
    }

    $(function () {
        $('select[name="SortKey"]').change(function () {
            pageselectCallback(0);
        });

        $("a[name='audit']").each(function () {
            $(this).click(function () {
                location.href = "@Url.Action("UCAuditCustomerDetail")" + "?code=" + $(this).attr("code");
                @*if (!confirm("确定此客户通过审核？")) {

                    return;
                }
                var load_iii = Utils.layerLoad();
                var url = "@Url.Action("AuditCust")";
                $.get(url, { code: $(this).attr("code") }, function (data) {
                    if (data.length > 0) {
                        $("#divSearch").html(data);
                    }
                });
                Utils.layerClose(load_iii);*@
            });
        });
    });
</script>

