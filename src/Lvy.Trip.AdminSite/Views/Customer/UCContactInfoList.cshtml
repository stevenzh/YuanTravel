@model Lvy.VModels.Crm.AccountVModel

<style>
    .listtbl tbody td { text-align: center; }
</style>
<div class="xbox clear">
    <div class="btnlist">
        <div class="fr">
            <a href="@Url.Action("UCCreateContactInfo",new { code=Model.Account.CustomerCode})" class="btn btn1">添加联系人</a>
        </div>
    </div>
    @if (Model.Accounts.Items.Count > 0)
    {
        <table class="listtbl" style="width:100%;">
            <thead>
                <tr>
                    <td>编号</td>
                    <td>姓名</td>
                    <td>性别</td>
                    <td>手机号码</td>
                    @*<td>电子信箱</td>*@
                    <td>销售组</td>
                    <td>对应销售</td>
                    <td>状态</td>
                    <td>操作</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Accounts.Items)
                {
                    <tr>

                        <td>@item.Code</td>
                        <td>@item.Name</td>
                        <td>@DictionaryTools.GetEnumValue(Enums.SexEnum, item.Sex.ToString())</td>
                        <td>@item.Mobile</td>
                        @*<td>@item.Email</td>*@
                        <td>@DictionaryTools.GetCachedTeam(item.TeamID).TeamName</td>
                        <td>@item.SalerName</td>
                        <td> @DictionaryTools.GetEnumValue(Enums.CustomerStateEnum, item.SalerState.ToString(), false)</td>
                        <td style="width:10%">
                            @{
                                var inteam = GlobalContext.Current.LoginUserTeams.Any(t => t.TeamID == item.TeamID);
                                var inrole = GlobalContext.Current.LoginUserRoles.Any(role => role.Name == "销售组长");
                                if (GlobalContext.Current.UserInfo.Code == item.SalerCode || GlobalContext.Current.LoginUserRoles.Any(role => role.Name == "销售总监") || (inteam && inrole))
                                {
                                    <a href="@Url.Action("UCCreateContactInfo", new { contactId = item.Code })" class="edit" name="editContactInfo" title="编辑">编辑</a>
                                    <a href="#" class="edit" name="deleteContactInfo" title="删除" bindId="@item.Code" code="@item.CustomerCode">删除</a>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @Html.HiddenFor(a => a.Accounts.PageIndex)
        <div id="Pagination" class="digg"></div>
    }
    else
    {
        <div style="color: red; text-align: center; font-weight: bold; font-size: 14px;">
            <br />
            对不起，没有查找到数据！请重新输入查询条件 ！
        </div>
    }
</div>

<script type="text/javascript">
    $(function () {
        $("a[name='editContactInfo']").each(function () {
            $(this).click(function () {
                var load_iii = Utils.layerLoad();
                var url = "@Url.Action("UCCreateContactInfo")";
            });
        });


        $("a[name='deleteContactInfo']").each(function () {
            $(this).click(function () {
                if (!confirm("确定删除？")) {

                    return;
                }
                var load_iii = Utils.layerLoad();
                var url = "@Url.Action("DeleteContactInfo")";
                $.get(url, { contactId: $(this).attr("bindId"), code: $(this).attr("code") }, function (data) {
                    if (data.length > 0) {
                        $("#divContactInfoList").html(data);
                    }
                    Utils.layerClose(load_iii);
                });
            });
        });
    });

    //分页控件 begin
    $(function () {
        $("#Pagination").pagination(
            Number('@Model.Accounts.TotalCount'), {
                callback: pageselectCallback,
                items_per_page: Number('@Model.Accounts.PageSize'),
                current_page: @Model.Accounts.PageIndex-1
            });
    });


    //回调方法
    function pageselectCallback(page_id, jq) {

        var load_iii = Utils.layerLoad();

        $("#Accounts_PageIndex").val(page_id + 1);
        var params = $("#theForm").formSerialize();

        $.post('@Url.Action("ContactInfo")', params, function (data) {
            if (data.length < 1) {
                Utils.alert("查询出错，请稍后查询！");
                return false;
            }
            $('#divContactInfoList').html(data);
            hoverChangeStyle();
            Utils.layerClose(load_iii);
        });
    }

    //$(function() {
    //    $('select[name="SortKey"]').change(function() {
    //        pageselectCallback(0);
    //    });
    //});

</script>