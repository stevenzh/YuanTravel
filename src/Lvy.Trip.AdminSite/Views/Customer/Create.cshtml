@model Lvy.Models.CrmDB.CrmCustomerModel
@{
    ViewBag.Title = "创建客户";
    string CDNServerUrl = Arch.Common.AppSetting.Get("CDNServerUrl");
}
@section AdditionalResources
{
    <link href="~/WebRes/css/jquery.suggest.css" rel="stylesheet" type="text/css" />
    <script src="~/WebRes/Scripts/My97DatePicker/WdatePicker.js" type="text/javascript"></script>
    <script src="~/WebRes/scripts/suggest.customer2.js" type="text/javascript"></script>
    <!-- Bootstrap Switch -->
    <link rel="stylesheet" href="@CDNServerUrl/bootstrap-switch/css/bootstrap3/bootstrap-switch.min.css" />
    <script src="@CDNServerUrl/bootstrap-switch/js/bootstrap-switch.min.js"></script>
}
<form id="theForm" action="@Url.Action("Create")" method="post" enctype="multipart/form-data">
    <div class="station">
        @ViewBag.Title
    </div>
    <div class="inform">
        <div class="in_box">
            <table class="edittbl" style="width:auto">
                <tr>
                    <td class="label"><span class="point">*</span>客户名称：</td>
                    <td>
                        @Html.TextBoxFor(a => a.Name, new { @class = "text400" })
                        <div id='suggest1' class="ac_results" style="width: 250px; margin-left: 1.2em;"></div>
                    </td>
                </tr>
                <tr style="display:none;">
                    <td class="label"><span class="point">*</span>客户简称：</td>
                    <td>
                        @Html.TextBoxFor(a => a.ShortName, new { @class = "text220" })
                    </td>
                </tr>
                <tr style="display:none;">
                    <td class="label">快捷码：</td>
                    <td>
                        @Html.TextBoxFor(a => a.FastCode, new { @class = "text150" })
                    </td>
                </tr>
                <tr>
                    <td class="label">父公司：</td>
                    <td>
                        @Html.HiddenFor(m => m.ParentName, new { id = "ParentName" })
                        <select id="mySelect2" name="ParentCode" class="text300"></select>
                        <span style="color:crimson"> (有统一结算需求 请填写)</span>
                    </td>
                </tr>
                @*
        <tr>
            <td class="label">Logo：</td>
            <td>
                <input type="file" id="uploadLogo" name="logoFile" />
                @*<input type="text" class="text220" id="uploadLogoPath" disabled="disabled" />
                <input type="button" class="btn btn1" value="浏览" id="browserLogo" />
                <input type="button" class="btn btn1" value="保存" id="saveLogo" />
            </td>
        </tr>*@
                <tr style="display:none;">
                    <td class="label">联系人：</td>
                    <td>@Html.TextBoxFor(a => a.Head, new { @class = "text150" })</td>
                </tr>
                <tr style="display:none;">
                    <td class="label">公司电话：</td>
                    <td>@Html.TextBoxFor(a => a.Phone, new { @class = "text150" })</td>
                </tr>
                <tr>
                    <td class="label"><span class="point">*</span>地址：</td>
                    <td>
                        @Html.DropDownListFor(a => a.Province, ViewBag.ProvinceList as IEnumerable<SelectListItem>, new { @class = "select150", @onchange = "ProvinceChange()" })

                        <select id="City" name="City" class="select150" onchange="CityChange()">
                            <option value="">-- 请选择 --</option>
                        </select>
                        <select id="County" name="County" class="select150">
                            <option value="">-- 请选择 --</option>
                        </select>
                        <input type="text" name="Address" id="Address" class="text300" style="height:20px" />
                    </td>
                </tr>
                <tr>
                    <td class="label"> 税号：</td>
                    <td>
                        <input type="text" name="TaxNumber" id="TaxNumber" class="text220" maxlength="50" />
                    </td>
                </tr>
                <tr>
                    <td class="label"><span class="point">*</span>结算方式：</td>
                    <td>
                        @Html.DropDownListFor(a => a.PaymentType, ViewBag.PaymentTypes as IEnumerable<SelectListItem>, new { @class = "select150" })
                    </td>
                </tr>
                <tr>
                    <td class="label"><span class="point">*</span>信用额度：</td>
                    <td>
                        <input type="text" name="CreditLine" id="CreditLine" class="text150" value="0" input-limit="number" /> 0为没有限制
                    </td>
                </tr>
                <tr style="height:45px;">
                    <td class="label">是否分销商：</td>
                    <td>
                        @Html.CheckBoxFor(m => m.IsDistributors, new { @class = "js-switch" })
                    </td>
                </tr>
                <tr>
                    <td class="label"><span class="point">*</span>渠道来源：</td>
                    <td>
                        @Html.DropDownListFor(a => a.ChannelType, ViewBag.ChannelTypes as IEnumerable<SelectListItem>, new { @class = "select150" })
                    </td>
                </tr>
                <tr style="height:45px;">
                    <td class="label">是否下设门市或门店：</td>
                    <td>
                        @Html.CheckBoxFor(m => m.HasChild, new { @class = "js-switch" })
                    </td>
                </tr>
                <tr style="height:45px;">
                    <td class="label">账单是否显示折让：</td>
                    <td>
                        @Html.CheckBoxFor(m => m.RebateInBill, new { @class = "js-switch" })
                    </td>
                </tr>
                <tr>
                    <td class="label"><span class="point">*</span>销售组：</td>
                    <td>
                        @if (ViewBag.IsLeader == 0)
                        {
                            @Html.DropDownListFor(a => a.TeamID, ViewBag.Teams as IEnumerable<SelectListItem>, new { @class = "select150", @disabled = "disabled" })
                            @Html.HiddenFor(t => t.TeamID)
                        }
                        else
                        {
                            @Html.DropDownListFor(a => a.TeamID, ViewBag.Teams as IEnumerable<SelectListItem>, new { @class = "select150" })
                        }
                    </td>
                </tr>
                <tr>
                    <td class="label"><span class="point">*</span>对应销售：</td>
                    <td>
                        @if (ViewBag.IsLeader == 0)
                        {
                            @Html.DropDownListFor(a => a.SalerCode, ViewBag.Salers as IEnumerable<SelectListItem>, new { @class = "select150", @disabled = "disabled" })
                            @Html.HiddenFor(t => t.SalerCode)
                        }
                        else
                        {
                            @Html.DropDownListFor(a => a.SalerCode, ViewBag.Salers as IEnumerable<SelectListItem>, new { @class = "select150" })
                        }
                    </td>
                </tr>
                <tr style="background-color:gainsboro;">
                    <td colspan="2"><b>以下为供应商设置</b> </td>
                </tr>
                <tr style="height:45px;">
                    <td class="label">是否供应商：</td>
                    <td>
                        @Html.CheckBoxFor(m => m.IsSupplier, new { @class = "js-switch" })
                    </td>
                </tr>
                <tr style="height:45px;">
                    <td class="label">是否组团社：</td>
                    <td>
                        @Html.CheckBoxFor(m => m.IsGroupTour, new { @class = "js-switch" })
                    </td>
                </tr>
                <tr style="background-color:gainsboro;">
                    <td colspan="2"><b>以下为供应商上线产品设置</b> </td>
                </tr>
                <tr>
                    <td class="label">供应产品范围：</td>
                    <td>
                        @Html.CheckboxList("BusinessPermit", ViewBag.SupplyProdutType as IEnumerable<SelectListItem>, Model.BusinessPermit)
                    </td>
                </tr>
                <tr>
                    <td class="label">输入产品负责部门：</td>
                    <td>
                        @Html.DropDownListFor(a => a.ImportTeam, ViewBag.ImportTeams as IEnumerable<SelectListItem>, new { @class = "select150" })
                    </td>
                </tr>
                <tr>
                    <td class="label">备注：</td>
                    <td>
                        @Html.TextAreaFor(a => a.Remarks, new { @class = "textarea440" })
                    </td>
                </tr>
                <tr>
                    <td></td>
                    <td>
                        <input class="btn btn1" id="btnSave" type="button" value="保存" />
                        <input class="btn btn1" name="btnClear" type="button" value="返回列表" onclick="location.href='@Url.Action("Search")'" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
</form>
<script type="text/javascript">

    $(function () {

        // 单选框初始化
        $(".js-switch").each(function () {
            $(this).bootstrapSwitch({ 'state': $(this).prop('checked'), onText: "是", offText: "否" });
        });

        $("#TeamID").change(function () {
            var teamId = $(this).val();
            $("#SalerCode").empty();
            if (teamId == "") {
                $("#SalerCode").append("<option value=\"\">-- 请选择 --</option>");
                return;
            }
            $.ajax({
                url: '@Url.Action("GetTeamUserByTeamId", "Customer")',
                type: 'post',
                data: { teamId: teamId },
                success: function (data) {
                    $("#SalerCode").append("<option value=\"\">-- 请选择 --</option>");
                    $.each(data, function (i, item) {
                        $("#SalerCode").append("<option value=\"" + item.Code + "\">" + item.Name + "</option>");
                    });
                }
            });
        });

        $("#Name").suggestCustomer({
            dataContainer: null, anyInput: true,
            attachObject: '#suggest1', requestUrl: '/Customer/GetCustomersPopup', hasChild: true
        });

        $('#mySelect2').select2({
            ajax: {
                url: '/Customer/GetCustomerSelect2',
                dataType: 'json',
                data: function (params) {
                    return {
                        keyword: params.term, // search term 请求参数 ， 请求框中输入的参数
                        hasChild: true,
                        page: params.page || 0,
                        size: 10,
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 0;
                    return {
                        results: data.rows,
                        pagination: {
                            more: (params.page * 10) < data.total
                        }
                    };
                },
                cache: true,
            },
            language: "zh-CN",
            placeholder: '请选择',//默认文字提示
            allowClear: true,
        });
        $('#mySelect2').on('select2:select', function (e) {
            var data = e.params.data;
            $("#ParentName").val(data.text);
        });

        $("#theForm").submit(function () {
            if (!CheckControls()) {
                return false;
            }
            return true;
        });

        $("#btnSave").click(function () {

            if (!CheckControls()) {
                return false;
            }
            var load_iii = Utils.layerLoad();
            var params = $("#theForm").formSerialize();
            $.post($("#theForm").attr("action"), params,
              function (data) {
                  if (Number(data.Result) > 0) {
                      if (confirm('保存成功！是否需要添加联系人?')) {
                          window.location.href = "@Url.Action("UCCreateContactInfo")?Code=" + data.CustomerCode+"&teamId=" + $("#TeamID").val();
                      }
                      else {
                          window.location.href = "@Url.Action("Search")";
                      }
                  }
                  else {
                      Utils.alert('提交发生异常，请稍后再试！');
                  }
                  Utils.layerClose(load_iii);
              });
        });


        $("#Name").blur(function () {
            //$("#ShortName").val($("#Name").val());
            var str = $(this).val();
            idx = str.indexOf("营业部");
            idx1 = str.indexOf("分公司");
            if (idx > -1 || idx1 > -1) {
                var isChecked = $("#HasChild").is(':checked');
                if (isChecked == false) {
                    $('#HasChild').bootstrapSwitch("state", true);
                }
            }
        });
    });

    function CheckControls() {
        if (Utils.Trim($("#Name").val()) == "") {
            Utils.alert("客户名称不能为空！");
            $("#Name").select().focus();
            return false;
        }
        if (Utils.Trim($("#Address").val()) == "") {
            Utils.alert("请输入地址！");
            $("#Address").select().focus();
            return false;
        }
        if (Utils.Trim($("#ChannelType").val()) == "") {
            Utils.alert("请选择渠道来源！");
            $("#ChannelType").select().focus();
            return false;
        }
        if (!$("#IsDistributors").prop("checked") && !$("#IsSupplier").prop("checked")) {
            Utils.alert("请选择客户角色！");
            return false;
        }
        if ($("#PaymentType").val() == "") {
            Utils.alert("请选择结算方式！");
            $("#PaymentType").select().focus();
            return false;
        } else {
            var pt = $("#PaymentType").val();
            var cl = $("#CreditLine").val();
            if (pt != '1' && Number(cl) == 0) {
                Utils.alert("非现结客户，信用额度不能为零！");
                return false;
            }
        }
        if (Utils.Trim($("#CreditLine").val()) == "") {
            Utils.alert("信用额度不能为空！");
            $("#CreditLine").select().focus();
            return false;
        }

        if ($("#TeamID").val() == "") {
            Utils.alert("请选择销售组！");
            return false;
        }
        if ($("#SalerCode") == "") {
            Utils.alert("请选择对应销售！");
            return false;
        }

        var result = false;
        $.ajax({
            url: '/Customer/CheckCustomerName',
            data: { customerName: $.trim($("#Name").val()), code: "" },
            type: 'post',
            async: false,
            success: function (data) {
                if (data.Code == "1") {
                    result = true;
                }
            }
        });

        if (result) {
            layer.confirm('客户名称已存在，你可以直接添加联系人？', { btn: ['添加联系人','返回']
            }, function (index) {
                   parent.openTabPage('/Contact/Create?CustomerName='+ $("#Name").val(), '添加联系人');
                   layer.close(index);
            }, function(index){
                layer.close(index);
            });
            return false;
        }
        return true;
    }

    function ProvinceChange() {
        var provinceId = $("#Province").val();
        var cityOption = '<option value="">-- 请选择 --</option>';
        $("#City").empty();
        $.ajax({
            url: '@Url.Action("GetCityListByProvinceId")',
            data: { provinceId: provinceId },
            type: 'post',
            async: false,
            success: function (data) {
                $.each(data, function (index, item) {
                    cityOption += '<option value="' + item.Id + '">' + item.Name + '</option>';
                });
            }
        });

        $("#City").append(cityOption);
    }

    function CityChange() {
        var cityId = $("#City").val();
        var cityOption = '<option value="">-- 请选择 --</option>';
        $("#County").empty();
        $.ajax({
            url: '@Url.Action("GetCountyListByCityId")',
            data: { cityId: cityId },
            type: 'post',
            async: false,
            success: function (data) {
                $.each(data, function (index, item) {
                    cityOption += '<option value="' + item.Id + '">' + item.Name + '</option>';
                });
            }
        });

        $("#County").append(cityOption);
    }


</script>
