@using Lvy.Models
@using Lvy.VModels.Crm
@model Lvy.Models.CrmDB.CrmCustomerModel
@{
    var customerName = string.Empty;
    if (Model != null && !Model.ParentCode.IsNullOrEmpty())
    {
        customerName = DictionaryTools.GetCachedCustomer(Model.ParentCode).Name;
    }
}
@section AdditionalResources { }

<form id="theForm" method="POST">
    @Html.HiddenFor(a => a.Code)
    <div class="station">
        客户详情
    </div>
    <div class="in_box">
        <div align="center" class="xboxcontent">
            <div class="sotable_tit">客户基本信息</div>
            <table class="edittbl">
                <tbody>
                    <tr>
                        <td class="label">客户名称：</td>
                        <td>@Model.Name</td>
                    </tr>
                    <tr>
                        <td class="label">渠道来源：</td>
                        <td>@DictionaryTools.GetEnumValue(Enums.CustomerChannelEnum, Model.ChannelType.ToString())</td>
                    </tr>
                    <tr>
                        <td class="label">父公司：</td>
                        <td>@customerName</td>
                    </tr>
                    <tr style="display:none;">
                        <td class="label">公司电话：</td>
                        <td>@Model.Phone</td>
                    </tr>
                    <tr>
                        <td class="label">地址：</td>
                        <td>
                            @DictionaryTools.GetDestName(Model.Province) -
                            @DictionaryTools.GetDestName(Model.City) -
                            @DictionaryTools.GetDestName(Model.County)

                            @Model.Address
                        </td>
                    </tr>
                    <tr>
                        <td class="label"> 税号：</td>
                        <td>@Model.TaxNumber</td>
                    </tr>
                    <tr>
                        <td class="label">信用额度：</td>
                        <td>@Model.CreditLine</td>
                    </tr>
                    <tr>
                        <td class="label">结算方式：</td>
                        <td>@DictionaryTools.GetEnumValue(Enums.PaymentTypeEnum, Model.PaymentType.ToString())</td>
                    </tr>
                    <tr>
                        <td class="label">客户角色：</td>
                        <td>
                            <label> @Html.CheckBoxFor(m => m.IsDistributors, new { @class = "", @disabled = "disabled" }) 分销商  </label>
                            <label> @Html.CheckBoxFor(m => m.IsSupplier, new { @class = "", @disabled = "disabled" }) 供应商</label>
                            <label>@Html.CheckBoxFor(m => m.IsBranch, new { @class = "", @checked = "checked", @disabled = "disabled" }) 是否门店</label>
                        </td>
                    </tr>
                    <tr>
                        <td class="label">销售组：</td>
                        <td>@(Model.TeamID.IsNullOrEmpty() ? "" : DictionaryTools.GetCachedTeam(Model.TeamID).TeamName)</td>
                    </tr>
                    <tr>
                        <td class="label">对应销售：</td>
                        <td>@DictionaryTools.GetCachedAccount(Model.SalerCode).Name</td>
                    </tr>
                    <tr>
                        <td class="label">备注：</td>
                        <td>@Model.Remarks</td>
                    </tr>
                </tbody>
            </table>
            <div id="divContactInfoList">
                @Html.Partial("UCAuditCustContactInfo", ViewBag.Accounts as AccountVModel)
            </div>
            <table class="sotable">

                @if (ViewData["Alert"] != null)
                {
                    <tr>
                        <td style="color:orangered; font-size:large;">※  @ViewData["Alert"]</td>
                    </tr>
                }
                <tr>
                    <td align="center">
                        <input class="btn btn1" id="btnAudit" type="button" value="审核通过" />
                        <input class="btn btn1" id="btnAudit1" type="button" value="审核不通过" />
                        <input class="btn btn1" id="btnBack" type="button" value="返回列表" />
                    </td>
                </tr>
            </table>
        </div>
    </div>

    <div id="modal-no" style="display:none;">
        <table width="100%" class="edittbl">
            <tr>
                <td class="label">选择原因</td>
                <td>
                    <select id="remark">
                        <option value="信息不全" selected="selected">信息不全</option>
                        <option value="客户重复">客户重复</option>
                    </select>
                </td>
            </tr>
        </table>
    </div>

</form>


<script>
$(function () {
    $("#btnAudit1").click(function () {
        layer.open({
            type: 1, title: '客户审核', maxmin: false
            , shadeClose: false, area: ['400px', '300px']
            , content: $("#modal-no").html()
            , btn: ["确定", "取消"]
            , yes: function (index, layero) {
                var url = "@Url.Action("AuditCust")";
                $.get(url, { code: $("#Code").val(), state: 2 }, function (data) {
                    if (data.Code > 0) {
                        location.href = '@Url.Action("AuditCustomer")';
                    } else {
                        Utils.alert("审核失败！");
                    }
                });
            }
            , btn2: function (index, layero) {
                // 取消
            }
        });
    });

    $("#btnBack").click(function(){
        location.href = '@Url.Action("AuditCustomer")';
    });

    $("#btnAudit").click(function () {
        if (!confirm("确定此客户通过审核？")) {
            return;
        }

        var url = "@Url.Action("AuditCust")";
        $.get(url, { code: $("#Code").val(), state: 1 }, function (data) {
            if (data.Code > 0) {
                location.href = '@Url.Action("AuditCustomer")';
            } else {
                Utils.alert("审核失败！");
            }
        });
    });

    $("#btnAudit2").click(function () {
        var url = "@Url.Action("AuditCust")";
        $.get(url, { code: $("#Code").val(), state:2, remark:$("#remark").val()}, function (data) {
            if (data.Code > 0) {
                location.href = '@Url.Action("AuditCustomer")';
            } else {
                Utils.alert("客户审核设置失败！");
            }
        });

        $('#modal-no').modal('hide')
    })
})
</script>
