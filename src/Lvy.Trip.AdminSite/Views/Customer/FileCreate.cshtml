@model  Lvy.VModels.Crm.CustomerFileVModel
@{
    ViewBag.Title = "添加合同附件";
}
@section AdditionalResources
{
    <script src="~/WebRes/Scripts/My97DatePicker/WdatePicker.js" type="text/javascript"></script>
}
<form id="theForm" action="@Url.Action("Uploadfiles")" method="POST" enctype="multipart/form-data">
    <div class="station">
        添加合同附件
    </div>
    <div class="inform">
        <div class="in_box">
            <table class="edittbl" style="width:auto">
                <tr>
                    <td class="label">
                        <span class="point">*</span> 合同名称：
                    </td>
                    <td>
                        @Html.HiddenFor(a => a.CustomerFile.CustomerCode)
                        @Html.TextBoxFor(a => a.CustomerFile.Subject, new { @class = "text150" })
                    </td>
                </tr>
                <tr>
                    <td class="label">
                        <span class="point">*</span> 合同有效期开始：
                    </td>
                    <td>
                        @Html.TextBoxFor(a => a.CustomerFile.StratDate, new { @Value = Model.CustomerFile.StratDate.ToDateFormat(), @class = "Wdate text150", @onfocus = "WdatePicker({isShowClear:false,readOnly:true})" })
                    </td>
                </tr>
                <tr>
                    <td class="label">
                        <span class="point">*</span>合同有效期结束：
                    </td>
                    <td>
                        @Html.TextBoxFor(a => a.CustomerFile.EndDate, new { @Value = Model.CustomerFile.EndDate.ToDateFormat(), @class = "Wdate text150", @onfocus = "WdatePicker({isShowClear:false,readOnly:true})" })
                    </td>
                </tr>
                <tr>
                    <td class="label">合同文件：</td>
                    <td>
                        <input type="file" id="uploadLogo" name="logoFile" />
                    </td>
                </tr>
                <tr>
                    <td class="label">合同备注:</td>
                    <td>
                        @Html.TextAreaFor(a => a.CustomerFile.Remark, new { @class = "textarea440" })
                    </td>
                </tr>
                <tr>
                    <td></td>
                    <td>
                        <input class="btn btn1" id="btnSave" type="submit" value="保存" onclick="return CheckControls();" />
                        <input class="btn btn1" name="btnClear" type="button" value="返回" onclick="location.href='@Url.Action("Uploading",new { code=Model.CustomerFile.CustomerCode})'" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
</form>
<script type="text/javascript">
    function CheckControls() {
        if (Utils.Trim($("#CustomerFile_Subject").val()) == "") {
            Utils.alert("合同名称不能为空！");
            $("#CustomerFile_Subject").select().focus();
            return false;
        }
        if (Utils.Trim($("#CustomerFile_StratDate").val()) == "") {
            Utils.alert("合同有效期开始不能为空！");
            $("#CustomerFile_StratDate").select().focus();
            return false;
        }
        if (Utils.Trim($("#CustomerFile_EndDate").val()) == "") {
            Utils.alert("合同有效期结束不能为空！");
            $("#CustomerFile_EndDate").select().focus();
            return false;
        }
        return true;
    }

</script>

