@model Lvy.VModels.Finance.InvoiceVModel
@{
    ViewBag.Title = "发票列表查询";
}
@section AdditionalResources { }
<form id="theForm" action="@Url.Action("Search")">
    <div class="xbox">
        <div align="center" class="xboxcontent">
            <div class="sotable_tit">@ViewBag.Title</div>
            <table class="sotable" style="width:100%;">
                <tr>
                    <td class="label">销售部门：</td>
                    <td>
                        @Html.DropDownListFor(a => a.TeamCode, ViewBag.SalesTeams as IEnumerable<SelectListItem>, new { @Class = "text150" })
                    </td>
                    <td class="label">销售：</td>
                    <td>
                        @Html.DropDownListFor(a => a.SalerCode, ViewBag.Salers as IEnumerable<SelectListItem>)
                    </td>
                    <td class="label">出发日期：</td>
                    <td colspan="3">
                        <input type="text" name="StartDate" id="d4311" class="Wdate" onfocus="WdatePicker({isShowClear:true,readOnly:true,maxDate:'#F{$dp.$D(\'d4312\')||\'2020-10-01\'}'})" />
                        &nbsp;--&nbsp;
                        <input type="text" name="EndDate" id="d4312" class="Wdate" onfocus="WdatePicker({isShowClear:true,readOnly:true,onpicked:function(){},minDate:'#F{$dp.$D(\'d4311\')}'})" />
                    </td>
                </tr>
                <tr>
                    <td class="label">订单编号：</td>
                    <td>
                        @Html.TextBoxFor(a => a.OrderCode, new { @class = "text150" })
                    </td>
                    <td class="label">发票编号：</td>
                    <td>
                        @Html.TextBoxFor(a => a.InvoiceNo, new { @class = "text150" })
                    </td>
                    <td class="label">发票状态：</td>
                    <td>
                        @Html.DropDownListFor(a => a.State, ViewBag.InvoiceStateBean as IEnumerable<SelectListItem>, new { @Class = "text150" })
                    </td>
                </tr>
                <tr>
                    <td colspan="6" align="center">
                        <input class="btn btn1" type="submit" value="搜索" />
                        <input class="btn btn1" id="btnReset" name="" type="button" value="重置" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div id="divNotices">
        @Html.Partial("UCSearch", Model)
    </div>
</form>
<script type="text/javascript">
    $(function () {
        $("#btnReset").click(function () {
            $("#textContents").val("");
            $("#textContents").focus();
        });

        $("#TeamCode").change(function () {
            var teamId = $(this).val();
            $("#SalerCode").empty();
            if (teamId == "") {
                $("#SalerCode").append("<option value=\"\">-- 请选择 --</option>");
                return;
            }
            $.ajax({
                url: '@Url.Action("GetTeamUserByTeamId", "Customer")',
                type: 'post',
                data: { teamId: teamId },
                success: function (data) {
                    $("#SalerCode").append("<option value=\"\">-- 请选择 --</option>");
                    $.each(data, function (i, item) {
                        $("#SalerCode").append("<option value=\"" + item.Code + "\">" + item.Name + "</option>");
                    });
                }
            });
         });
    })

</script>
