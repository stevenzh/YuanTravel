@using Lvy.Web.Common.Mvc.HtmlHelpers
@model IEnumerable<Lvy.Models.BaseDB.BaseDictionaryModel>
<table class="table table-striped table-bordered table-sm">
    <thead>
        <tr>
            <td>字典类型名称</td>
            <td>表名</td>
            <td>字段名</td>
            <td>备注</td>
            <td>操作</td>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.TableName)</td>
                <td>@Html.DisplayFor(modelItem => item.FieldName)</td>
                <td>@Html.DisplayFor(modelItem => item.Remark)</td>
                <td class="project-actions">

                    <a href="@Url.Action("Edit", "Dictionary", new { id = item.Id})" class="btn btn-sm btn-info"><i class="fas fa-edit"></i> 编辑 </a>
                    <a href="@Url.Action("SearchDictionaryDetail", "Dictionary", new { dicId = item.Id})" class="btn btn-sm btn-info"><i class="fas fa-list"></i> 设置字典列表 </a>
                    @Html.VaildActionLink(item.IsValid, "SetValidStateByDictionary", new { id = item.Id }, true, new { @class = "btn btn-sm btn-info" })
                </td>
            </tr>
        }
    </tbody>
</table>
