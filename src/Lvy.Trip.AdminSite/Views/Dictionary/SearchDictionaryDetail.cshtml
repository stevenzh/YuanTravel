@using Lvy.Web.Common.Mvc.HtmlHelpers
@model Lvy.VModels.DictionaryVModel
@{
    ViewBag.Title = "设置字典属性";
    Layout = "~/Views/Shared/_Single.cshtml";
}

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">商户列表</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<section class="content">
    <div class="card">
        <div class="card-header" data-original-title>
            <h3 class="card-title"><i class="icon-edit"></i> 设置字典属性</h3>
        </div>
        <form role="form" id="theForm" method="POST" action="@Url.Action("SaveDictionaryDetail", "Dictionary")">
            <div class="card-body">
                @Html.HiddenFor(model => model.DetailModel.Id)
                @Html.HiddenFor(model => model.DetailModel.IsValid)
                <div class="form-group row">
                    <label class="col-sm-2 col-form-label" for="Key">键(Key)</label>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(model => model.DetailModel.Key, new { @class = "form-control" })
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-sm-2 col-form-label" for="Value">值(Value)</label>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(model => model.DetailModel.Value, new { @class = "form-control" })
                    </div>
                </div>
                @if (Model.DetailModel.Name == "OutCityEnum")
                {
                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label" for="Value">团号前缀</label>
                        <div class="col-sm-10">
                            @Html.TextBoxFor(model => model.DetailModel.JPinYin, new { @class = "form-control" })
                        </div>
                    </div>
                }
            </div>
            <div class="card-footer">
                <button id="btnSave" type="submit" class="btn btn-primary" onclick="return CheckControl();">保  存</button>
                <button id="btnClear" type="button" class="btn btn-primary" onclick="location.href='@Url.Action("Search")'">返回列表</button>
            </div>
        </form>
    </div>

    <div class="card">
        <div class="card-body">
            <table class="table table-striped table-bordered table-sm">
                <thead>
                    <tr>
                        <td>键(Key)</td>
                        <td>值(Value)</td>
                        <td>操作</td>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.DetailModels)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Key)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Value)
                            </td>
                            <td>
                                @Html.EditActionLink("EditDictionaryDetail", "Dictionary", new { id = item.Id })&nbsp;
                                @Html.VaildActionLink(item.IsValid, "SetValidStateByDictionaryDetail", new { id = item.Id, dicId = item.DicId })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<script type="text/javascript">
    //验证用户输入
    function CheckControl() {

        if ($.trim($("#DetailModel_Key").val()).length == 0) {
            Utils.alert("键不得为空！", 1500);
            $("#DetailModel_Key").select().focus();
            return false;
        }
        if ($.trim($("#DetailModel_Value").val()).length == 0) {
            Utils.alert("值不得为空！", 1500);
            $("#DetailModel_Value").select().focus();
            return false;
        }
        return true;
    }

</script>
