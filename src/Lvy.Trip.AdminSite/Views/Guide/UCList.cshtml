@model Lvy.VModels.Base.GuideVModel
<div class="xbox clear">
    <div class="btnlist">
        <div class="fr">
            <input type="button" style="width:73px;height:26px" value="新 增" onclick="Create()" />
        </div>
    </div>
    @if (Model.GuidePageList.Items.Count > 0)
    {
        <table class="listtbl" style="width:100%;">
            <thead>
                <tr>
                    <td>姓名</td>
                    <td>性别</td>
                    <td>出生日期</td>
                    <td>领队证ID</td>
                    <td>联系电话</td>
                    <td>手机</td>
                    <td>护照号码</td>
                    <td align="center">操作</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.GuidePageList.Items)
                {
                    <tr>
                        <td style="text-align: center;">@item.Name</td>
                        <td style="text-align: center;">
                            @if (item.Sex == "3")
                            {
                                @:不明
                            }
                            else if (item.Sex == "1")
                            {
                                @:男
                            }
                            else if (item.Sex == "2")
                            {
                                @:女
                            }
                        </td>
                        <td style="text-align: center;">@item.BirthDate.Value.ToShortDateString() </td>
                        <td style="text-align: center;">@item.LeadCard</td>
                        <td style="text-align: center;">@item.Tel</td>
                        <td style="text-align: center;">@item.Mobile</td>
                        <td style="text-align: center;">@item.Hzno</td>

                        <td align="center" style="width:10%">
                            @Html.EditActionLink("Edit", "Guide", new { Id = item.Id })
                            <a href="#" class="edit" name="editContactInfo" title="删除" bindId="@item.Id">删除</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @Html.HiddenFor(a => a.GuidePageList.PageIndex)
        <div id="Pagination" class="digg">
        </div>
    }
    else
    {
        <div style="color: red; text-align: center; font-weight: bold; font-size: 14px;">
            <br />
            对不起，没有查找到数据！请重新输入查询条件 ！
        </div>
    }
</div>
<script type="text/javascript">
    function Create() {
        location.href = "@Url.Action("Create")";
    }

    $("a[name='editContactInfo']").each(function () {
        $(this).click(function () {
            if (!confirm("确定删除？")) {
                return;
            }
            var load_iii = Utils.layerLoad();
            var url = "/Guide/DeleteGuide";
            $.get(url, { Id: $(this).attr("bindId") }, function (data) {
                if (data.length > 0) {
                    $("#divUCGuideInfoist").html(data);
                }
                Utils.layerClose(load_iii);
            });
        });
    });
    //分页控件 begin
    $(function () {
        $("#Pagination").pagination(
            Number('@Model.GuidePageList.TotalCount'), {
                callback: pageselectCallback,
                items_per_page: Number('@Model.GuidePageList.PageSize'),
                current_page: @Model.GuidePageList.PageIndex-1
            });
    });


    //回调方法
    function pageselectCallback(page_id, jq) {

        var load_iii = Utils.layerLoad();

        $("#GuideInfos_PageIndex").val(page_id + 1);
        var params = $("#theForm").formSerialize();

        $.post('@Url.Action("Search")', params, function (data) {
            if (data.length < 1) {
                Utils.alert("查询出错，请稍后查询！");
                return false;
            }
            $('#divUCGuideInfoist').html(data);
            hoverChangeStyle();
            Utils.layerClose(load_iii);
        });
    }

    $(function () {
        $('select[name="SortKey"]').change(function () {
            pageselectCallback(0);
        });
    });
</script>

