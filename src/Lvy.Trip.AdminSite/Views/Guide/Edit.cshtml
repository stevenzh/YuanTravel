@model Lvy.VModels.Base.GuideVModel
@{
    ViewBag.Title = "编辑领队信息";
}
@section AdditionalResources
{
    <script src="~/WebRes/Scripts/My97DatePicker/WdatePicker.js" type="text/javascript"></script>
    <script src="~/WebRes/Scripts/jQuery.Hz2Py-min.js" type="text/javascript"></script>
}
<form id="theForm" action="@Url.Action("Edit","Guide")" method="POST">
    @Html.HiddenFor(a => a.GuideModel.Id)
    <div class="station">
        编辑领队信息
    </div>
    <div class="inform">
        <div class="in_box">
            <table width="100%" class="edittbl">
                <tr>
                    <td class="label">
                        <span class="point">*</span>部门：
                    </td>
                    <td>
                        @Html.DropDownListFor(a => a.GuideModel.TeamID, ViewBag.AccountTeamBeans as IEnumerable<SelectListItem>, new { @Class = "text150" })
                    </td>
                </tr>
                <tr>
                    <td class="label">
                        <span class="point">*</span>姓名：
                    </td>
                    <td>
                        @Html.TextBoxFor(a => a.GuideModel.Name, new { @class = "text150" })
                    </td>
                    <td class="label">英文名:</td>
                    <td>
                        @Html.TextBoxFor(a => a.GuideModel.PinYin, new { @class = "text150" })
                    </td>
                    <td class="label">性 别:</td>
                    <td class="data">
                        @Html.DropDownListFor(a => a.GuideModel.Sex, new List<SelectListItem> { new SelectListItem { Text = "男", Value = "1", Selected = Model.GuideModel.Sex.ToBool() }, new SelectListItem { Text = "女", Value = "2", Selected = Model.GuideModel.Sex.ToBool() }, new SelectListItem { Text = "不明", Value = "3", Selected = Model.GuideModel.Sex.ToBool() } }, new { id = "Sex" })
                    </td>
                    <td></td>
                </tr>
                <tr>
                    <td class="label">出生日期：</td>
                    <td>
                        @Html.TextBoxFor(a => a.GuideModel.BirthDate, new { @class = "Wdate text150", @onfocus = "WdatePicker({isShowClear:true,readOnly:true})" })
                    </td>
                    <td class="label">出生地：</td>
                    <td>
                        @Html.TextBoxFor(a => a.GuideModel.BirthPlace, new { @class = "text150" })
                    </td>
                </tr>
                <tr>
                    <td class="label">身份证：</td>
                    <td>
                        @Html.TextBoxFor(a => a.GuideModel.Card, new { @class = "text150" })
                    </td>
                </tr>
                <tr>
                    <td class="label">手机：</td>
                    <td>
                        @Html.TextBoxFor(a => a.GuideModel.Mobile, new { @class = "text150" })
                    </td>
                    <td class="label">联系电话：</td>
                    <td>
                        @Html.TextBoxFor(a => a.GuideModel.Tel, new { @class = "text150" })
                    </td>
                </tr>
                <tr>
                    <td class="label">E_mail:</td>
                    <td>
                        @Html.TextBoxFor(a => a.GuideModel.Email, new { @class = "text150" })
                    </td>
                </tr>
                <tr>
                    <td class="label">地址：</td>
                    <td>
                        @Html.TextBoxFor(a => a.GuideModel.Address, new { @class = "text150" })
                    </td>
                </tr>
                <tr>
                    <td class="label">是否有导游证：</td>
                    <td class="data">
                        @Html.DropDownListFor(a => a.GuideModel.TourKey, new List<SelectListItem> { new SelectListItem { Text = "--请选择--", Value = "0", Selected = Model.GuideModel.TourKey.ToBool() }, new SelectListItem { Text = "有", Value = "1", Selected = Model.GuideModel.TourKey.ToBool() }, new SelectListItem { Text = "无", Value = "2", Selected = Model.GuideModel.TourKey.ToBool() } }, new { id = "TourKey" })
                    </td>
                    <td class="label">导游证号:</td>
                    <td>
                        @Html.TextBoxFor(a => a.GuideModel.TourCard, new { @class = "text150" })
                    </td>
                </tr>
                <tr>
                    <td class="label">年检时间：</td>
                    <td>
                        @Html.TextBoxFor(a => a.GuideModel.CheckDate, new { @class = "Wdate text150", @onfocus = "WdatePicker({isShowClear:false,readOnly:true})" })
                    </td>
                    <td class="label">IC卡登记号：</td>
                    <td>
                        @Html.TextBoxFor(a => a.GuideModel.ICCard, new { @class = "text150" })
                    </td>
                </tr>
                <tr>
                    <td class="label">是否有领队证：</td>
                    <td class="data">
                        @Html.DropDownListFor(a => a.GuideModel.LeadKey, new List<SelectListItem> { new SelectListItem { Text = "--请选择--", Value = "0", Selected = Model.GuideModel.LeadKey.ToBool() }, new SelectListItem { Text = "有", Value = "1", Selected = Model.GuideModel.LeadKey.ToBool() }, new SelectListItem { Text = "无", Value = "2", Selected = Model.GuideModel.LeadKey.ToBool() } }, new { id = "LeadKey" })
                    </td>
                    <td class="label">领队证号：</td>
                    <td>
                        @Html.TextBoxFor(a => a.GuideModel.LeadCard, new { @class = "text150" })
                    </td>
                </tr>
                <tr>
                    <td class="label">领队证有效期:</td>
                    <td>
                        @Html.TextBoxFor(a => a.GuideModel.DateStart, new { @class = "Wdate text150", @onfocus = "WdatePicker({isShowClear:false,readOnly:true})" })
                        至
                        @Html.TextBoxFor(a => a.GuideModel.DateEnd, new { @class = "Wdate text150", @onfocus = "WdatePicker({isShowClear:false,readOnly:true})" })
                    </td>
                </tr>
                <tr>
                    <td class="label">护照类型：</td>
                    <td class="data">
                        @Html.DropDownListFor(a => a.GuideModel.Hzzl, new List<SelectListItem> { new SelectListItem { Text = "--请选择--", Value = "0", Selected = Model.GuideModel.Hzzl.ToBool() }, new SelectListItem { Text = "因私旅游", Value = "1", Selected = Model.GuideModel.Hzzl.ToBool() }, new SelectListItem { Text = "因私护照", Value = "2", Selected = Model.GuideModel.Hzzl.ToBool() }, new SelectListItem { Text = "因公护照", Value = "3", Selected = Model.GuideModel.Hzzl.ToBool() }, new SelectListItem { Text = "通行证", Value = "4", Selected = Model.GuideModel.Hzzl.ToBool() }, new SelectListItem { Text = "外籍护照", Value = "5", Selected = Model.GuideModel.Hzzl.ToBool() } }, new { id = "Hzzl" })
                    </td>
                    <td class="label">护 照 号:</td>
                    <td>
                        @Html.TextBoxFor(a => a.GuideModel.Hzno, new { @class = "text150" })
                    </td>
                    <td class="label">护照签发地:</td>
                    <td>
                        @Html.TextBoxFor(a => a.GuideModel.HzAddress, new { @class = "text150" })
                    </td>
                </tr>
                <tr>
                    <td class="label">护照有效期:</td>
                    <td>
                        @Html.TextBoxFor(a => a.GuideModel.HzDate, new { @class = "Wdate text150", @onfocus = "WdatePicker({isShowClear:false,readOnly:true})" })
                        至
                        @Html.TextBoxFor(a => a.GuideModel.HzEndDate, new { @class = "Wdate text150", @onfocus = "WdatePicker({isShowClear:false,readOnly:true})" })
                    </td>
                </tr>
                <tr>
                    <td class="label">分类1:</td>
                    <td class="data">
                        @Html.DropDownListFor(a => a.GuideModel.LeadKey, new List<SelectListItem> { new SelectListItem { Text = "--请选择--", Value = "0", Selected = Model.GuideModel.WorkType1.ToBool() }, new SelectListItem { Text = "社内", Value = "1", Selected = Model.GuideModel.WorkType1.ToBool() }, new SelectListItem { Text = "社外", Value = "2", Selected = Model.GuideModel.WorkType1.ToBool() } }, new { id = "WorkType1" })
                    </td>
                    <td class="label">分类2:</td>
                    <td class="data">
                        @Html.DropDownListFor(a => a.GuideModel.LeadKey, new List<SelectListItem> { new SelectListItem { Text = "--请选择--", Value = "0", Selected = Model.GuideModel.WorkType2.ToBool() }, new SelectListItem { Text = "专职", Value = "1", Selected = Model.GuideModel.WorkType2.ToBool() }, new SelectListItem { Text = "兼职", Value = "2", Selected = Model.GuideModel.WorkType2.ToBool() } }, new { id = "WorkType2" })
                    </td>
                    <td class="label">可带团类型：</td>
                    <td>
                        @Html.TextBoxFor(a => a.GuideModel.Remarks, new { @class = "text150" })
                    </td>
                </tr>
                <tr style="display:none;">
                    <td class="label">工作经历(250字以内):</td>
                    <td>
                        @Html.TextAreaFor(a => a.GuideModel.WorkRemark, new { @class = "textarea440" })
                        @Html.HiddenFor(a => a.GuideModel.OwnerCode)
                    </td>
                </tr>

                <tr>
                    <td></td>
                    <td>
                        <input class="btn btn1" id="btnSave" type="submit" value="保存" onclick="confirmInfo();" />
                        <input class="btn btn1" name="btnClear" type="button" value="返回列表" onclick="location.href='@Url.Action("Search")'" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
</form>
<script type="text/javascript">

    $(function () {
        $("input[name$='Name']").on("keyup keydown change blur", function () {

            var obj = $(this).parent("td").parent("tr");
            obj.find("input[name$='PinYin']").val($(this).toPinyin());

        });
    })
</script>