    //验证输入数据
    function CheckControl() {

        if ($("[name='Order.BookingCustomer']").val()=="") {
            Utils.alert("请选择下单客户！");
            return false;
        }

        if($("[name='Order.SettlePlatForm']").val()=="") {
            Utils.alert("请选择结算人！");
            return false;
        }

        if($("[name='Order.SettleCustomer']").val()=="") {
            Utils.alert("请选择结算人！");
            return false;
        }

        // 姓名不能为空
        var returnvalue = true;
        var touristName = new Array()
        $("#tbTravellers").find("input[name$='Name']").each(function (index, item) {
            touristName[index] = $(this).val();
            if (Utils.Trim($(this).val()) == "") {
                Utils.alert("第"+(index+1)+"行游客姓名不能为空！");
                $(this).focus().select();
                returnvalue = false;
                return false;
            }
        });
        //$("#tbTravellers").find("select[name$='Sex']").each(function (index,item) {
        //    if (Utils.Trim($(this).val()) == "" && touristName[index] != "") {
        //        Utils.alert("第"+(index+1)+"行请选择性别！");
        //        $(this).focus().select();
        //        returnvalue = false;
        //        return false;
        //    }
        //});
        if (!returnvalue) {
            return returnvalue;
        }

        $("#tbTravellers").find("select[name$='PassType']").each(function (index, item) {
            if (Utils.Trim($(this).val()) == "" && touristName[index] != "") {
                Utils.alert("第" + (index + 1) + "行请选择证件类型！");
                $(this).focus().select();
                returnvalue = false;
                return false;
            }
        });
        if (!returnvalue) {
            return returnvalue;
        }

        //$("#tbTravellers").find("input[name$='PassNo']").each(function (index, item) {
        //    if (Utils.Trim($(this).val()) == "" && touristName[index] != "") {
        //        Utils.alert("第" + (index + 1) + "行证件号码不能为空！");
        //        $(this).focus().select();
        //        returnvalue = false;
        //        return false;
        //    }
        //});
        //if (!returnvalue) {
        //    return returnvalue;
        //}

        //$("#tbTravellers").find("input[name$='DateOfExpiry']").each(function (index, item) {
        //    if (Utils.Trim($(this).val()) == "" && touristName[index] != "") {
        //        Utils.alert("第" + (index + 1) + "行证件有效期不能为空！");
        //        // $(this).focus().select();
        //        returnvalue = false;
        //        return false;
        //    }
        //});
        //if (!returnvalue) {
        //    return returnvalue;
        //}

        var OutDate = new Date('@Model.Order.OutDate.AddDays(Model.LineModel.TravelDays)');
        $("#tbTravellers").find("input[name$='DateOfExpiry']").each(function (index, item) {
            if (touristName[index] != "") {
                var date2 = new Date($(this).val());
                var d = ((date2 - OutDate) / (1000 * 60 * 60 * 24))
                if (d < 180) {
                    Utils.alert("第" + (index + 1) + "行证件有效期应大于【团返回日期】+180天");
                    returnvalue = false;
                    return false;
                }
            }
        });

        if (!returnvalue) {
            return returnvalue;
        }

        return true;
    }

    // 添加游客
    function AddTravellersHtml() {
        var model = new Object();
        var trafficType = '@Model.LineModel.TrafficType';
        if ($("#trNodata").length > 0) {
            $("#trNodata").remove();
        }

        var IsEditPric = ($("#IsEditPric").val() == "False"? false:true) ;
        var selectHtml = "";
        var i = $("#tbTravellers tr[name='travellerTr']").length; // 游客信息的索引
        var html = "<tr name=\"newline\">";

        if (trafficType != '1') {
            html += " <td align=\"left\"><input type=\"text\" name=\"Travellers2[" + i + "].Name\" class=\"text50\" value=\"游客\" /></td>"; //姓名
            html += SexHtml(i);  //性别
            html += " <td align=\"left\"><input type=\"text\" name=\"Travellers2[" + i + "].PinYin\" class=\"text70\" value=\"You Ke\" /></td>"; //英文名
            html += " <td align=\"left\"><input type=\"text\" name=\"Travellers2[" + i + "].DateOfBirth\"  class=\"Wdate text100\" onfocus=\"WdatePicker({isShowClear:false,readOnly:true})\"> </td>";//出生日期
            html += " <td align=\"left\"><input type=\"text\" value=\"\" class=\"text70\" name=\"Travellers2[" + i + "].PlaceOfBirth\">  </td>";//出生地
            html += GetPassportTypeHtml(i);  //证件类型
            html += " <td align=\"left\"><input type=\"text\" name=\"Travellers2[" + i + "].PassNo\" class=\"text70\"> </td>"; //证件号
            html += " <td align=\"left\"><input type=\"text\" name=\"Travellers2[" + i + "].DateOfIssue\" value=\"\" class=\"Wdate text100\" onfocus=\"WdatePicker({isShowClear:false,readOnly:true})\"> </td>";//签发时间
            html += " <td align=\"left\"><input type=\"text\" class=\"text70\" name=\"Travellers2[" + i + "].PlaceOfIssue\">";//签发地
            html += " <td align=\"left\"><input type=\"text\" name=\"Travellers2[" + i + "].DateOfExpiry\" class=\"Wdate text100\" onfocus=\"WdatePicker({isShowClear:false,readOnly:true})\"> </td>";//证件有效期
            html += " <td align=\"left\"><input type=\"text\" class=\"text100\" name=\"Travellers2[" + i + "].Phone\" /></td>"; //联系电话
        } else {
            html += " <td align=\"center\"><input type=\"text\" name=\"Travellers2[" + i + "].Name\" class=\"text150\" value=\"游客\" /></td>"; //姓名
            html += " <td align=\"left\"><input type=\"text\" class=\"text100\" name=\"Travellers2[" + i + "].Phone\" /></td>"; //联系电话
            html += "<td align=\"center\"><input type=\"text\" class=\"text50\" name=\"Travellers2["+i+"].SeatNum\"></td>";
        }

        html += " <td align=\"left\" name=\"gpOtherPrice\">"; //报价类型
        selectHtml = " <select name=\"Travellers2[" + i + "].PriceId\" class=\"text150\" onchange=\"PriceTypeChange(this)\">" + $("#optionStr").html() + "</select> ";

        var select = $(selectHtml).find("option:selected");
        if (select != null && select != undefined) {
            model.Price = Number($(select).attr("price"));
            model.TeJiaFanLi = Number($(select).attr("tejia"));
        }
        html += selectHtml;
        html += "<input type=\"hidden\" value=\"@Model.TourPlan.ZiFei\" name=\"Travellers2[" + i + "].ZiFei\" />";
        html += "<input type=\"hidden\" value=\"@Model.TourPlan.SingleRoom\" name=\"Travellers2[" + i + "].SingleRoom\" />";
        html += "<input type=\"hidden\" value=\"" + model.TeJiaFanLi + "\" name=\"Travellers2[" + i + "].TeJiaFanLi\" />";
        html += "<input type=\"hidden\" value=\"@Model.TourPlan.Tax\" name=\"Travellers2[" + i + "].Tax\" />";
        html += "<input type=\"hidden\" value=\"@Model.TourPlan.VisaPrice\" name=\"Travellers2[" + i + "].VisaPrice\" />  ";

        if (IsEditPric) {
            html += "</td>";
            html += " <td align=\"left\" name=\"gpOtherPrice\"><input type=\"text\" class=\"text50 fanli\" name=\"Travellers2[" + i + "].FanLi\" onkeypress=\"InputLimitMoney();\"></td >";
            if (trafficType != '1') {
                html += " <td align=\"center\"><input type=\"checkbox\" name=\"chkTax\" /> <label>@Model.TourPlan.Tax</label></td>";                //税
                html += " <td align=\"center\"><input type=\"checkbox\" name=\"chkVisaPrice\" /> <label>@Model.TourPlan.VisaPrice</label></td>";    //签证费用
            }
            html += " <td align=\"center\"><input type=\"checkbox\" name=\"chkZiFei\" /> <label>@Model.TourPlan.ZiFei</label></td>";            //保证自费
            html += " <td align=\"center\"><input type=\"checkbox\" name=\"chkSingleRoom\" /> <label>@Model.TourPlan.SingleRoom</label></td>";  //房差
            if (trafficType != '1') {
                html += " <td align=\"center\"></td>";
            }
            html += " <td align=\"center\" name=\"YsPrice\">";
            html += "<input type=\"text\" class=\"text50\" value=\"" + (model.Price - model.TeJiaFanLi) + "\" data-cancel=\"false\" name=\"Travellers2[" + i + "].YsPrice\" onblur=\"SetYsPrice(this);\" />"; // 客人应收款
        } else {
            html += "<input type=\"hidden\" class=\"fanli\" name=\"Travellers2[" + i + "].FanLi\"> ";
            html += "<input type=\"hidden\" class=\"text50\" value=\"" + (model.Price - model.TeJiaFanLi) + "\" data-cancel=\"false\" name=\"Travellers2[" + i + "].YsPrice\" />"; // 客人应收款
            html += "</td>";
            html += " <td align=\"center\">0.00 </td >";
            html += " <td align=\"center\" name=\"YsPrice\">" + (model.Price - model.TeJiaFanLi);
        }
        html += " </td><td align=\"center\"></td>";
        html += "</tr>";

        return html;
    }

    // 生成证件类型html
    function GetPassportTypeHtml(i) {
        var html = "<td align=\"left\"><select class=\"txt_input\"  name=\"Travellers2[" + i + "].PassType\">";
        var linescope = $("#LineModel_LineType").val();
        if (linescope == "3") {
            html += "<option value=\"1\">身份证</option>";
            html += "<option value=\"2\">护照</option>";
            html += "<option value=\"3\" selected=\"selected\">港澳通行证</option>";
        } else if (linescope == "4") {
            html += "<option value=\"1\">身份证</option>";
            html += "<option value=\"2\" selected=\"selected\">护照</option>";
            html += "<option value=\"3\">港澳通行证</option>";
        }  else {
            html += "<option value=\"1\" selected=\"selected\">身份证</option>";
            html += "<option value=\"2\">护照</option>";
            html += "<option value=\"3\">港澳通行证</option>";
        }

        html += "<option value=\"9\">其他</option>";
        html += "</select></td>";
        return html;
    }

    //性别
    function SexHtml(i) {
        var html = "<td align=\"left\"><select class=\"text70\" name=\"Travellers2[" + i + "].Sex\" ";
        html += "<option value=\"1\">男</option>";
        html += "<option value=\"2\">女</option>";
        //html += "<option value=\"3\">其他</option>";
        html += "</select></td>";
        return html;
    }
</script>

@if (Model.Order.SalerCode == GlobalContext.Current.UserInfo.Code)
{
    <script type="text/javascript">

    $(function () {

        //Initialize Select2 Elements
        $('#BookingCustomer').select2({ language: "zh-CN"})

        $('#BookingCustomer').on("select2:select", function (evt) {
            //console.log(evt.params.data);
            var code = evt.params.data.id;
            var name = evt.params.data.text;
            if (code != "") {
                $("#BookingCustomerName").val(name);
                $("#BookingName").val("1");
                $("#BookingName").change();

                // 获取联系人列表
                if ($("#ContactCode") != null && $("#ContactCode") != undefined) {
                    // 获得客户折扣
                    SettlePolicy(code, '@Model.Order.Line.ArriveDest', true);
                }
            }
        });

        // 付款单位修改
        $("#BookingName").change(function () {
            console.log("trigger BookingName change ");
            var selectVal = $(this).val();
            if (selectVal == "1") {
                $("#SettleCustomer").empty();
                var BookingName = $("#BookingCustomer").val();
                var text = $("#BookingCustomerName").val();
                $("#SettleCustomer").append("<option selected='selected' value='" + BookingName + "'>" + text + "</option>");

                // 取得父客户折扣
                SettlePolicy(BookingName, '@Model.Order.Line.ArriveDest', false);
            }
            else if (selectVal == "2") {
                //平台
                $("#SettleCustomer").empty();
                $.ajax({
                    type: 'post',
                    url: '@Url.Action("GetPinCompany", "Customer")',
                    async:false,
                    success: function (data) {
                        $("#SettleCustomer").append("<option value=''></option>");
                        $(data).each(function (index,item) {
                            if (@Model.Order.SettlePlatForm == 2 && item.Code=="@Model.Order.SettleCustomer") {
                                $("#SettleCustomer").append("<option selected='selected' value='" + item.Code + "'>" + item.Name + "</option>");
                            } else {
                                $("#SettleCustomer").append("<option value='" + item.Code + "'>" + item.Name + "</option>");
                            }
                        });
                        $("#SettleCustomer").change();
                    }
                });
            } else if (selectVal == "3") {
                //父公司
                $("#SettleCustomer").empty();
                $("#SettleCustomer").append("<option value=''></option>");
                $.ajax({
                    type: 'post',
                    url: '@Url.Action("GetParentCompany", "Online")',
                    data: { custCode: $("#BookingCustomer").val() },
                    success: function (data) {
                        if (data!=null) {
                            $("#SettleCustomer").append("<option selected='selected' value='" + data.ParentCode + "'>" + data.ParentName + "</option>");

                            // 取得父客户折扣
                            SettlePolicy(data.ParentCode, '@Model.Order.Line.ArriveDest', false);
                        }
                    }
                });

            }else {
                $("#SettleCustomer").empty();
            }
        });

        //
        $("#BookingName").val("@Model.Order.SettlePlatForm");
        $("#BookingName").change();
    });

    // 结算平台修改
    $("#SettleCustomer").change(function () {
        console.log("trigger SettleCustomer change ");

        var selectVal = $(this).val();
        if (selectVal != '') {
            // 取得平台折扣
            SettlePolicy(selectVal, '@Model.Order.Line.ArriveDest',false);
        }
    });

    $("#ContactCode").change(function(){
        var option = $("#ContactCode").find("option:selected");
        $("#ManagerPhone").val($(option).attr("Phone"));
        $("#Order_Managers").val($("#ContactCode").find("option:selected").text());
    });
    </script>
}
else
{
