    function CancelChidOrder(id) {
        if (!confirm("确定取消此订单？")) {
            return;
        }
        $.ajax({
            url: '@Url.Action("CancelChidOrder")',
            data: { id: id, orderCode:'@Model.Order.OrderCode' },
            type: 'post',
            success: function () {
                window.location.reload();
            }
        });
    }

    function RecoverChidOrder(id) {
        if (!confirm("确定恢复此订单？")) {
            return;
        }
        $.ajax({
            url: '@Url.Action("RecoverChidOrder")',
            data: { id: id, orderCode:'@Model.Order.OrderCode' },
            type: 'post',
            success: function () {
                window.location.reload();
            }
        });
    }
</script>