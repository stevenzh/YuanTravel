@model Lvy.VModels.Base.BusPointVModel
<div class="xbox">
    <table class="table table-sm">
        <thead>
            <tr>
                @*<td>编号</td>
                <td>出发城市</td>*@
                <td>标签名称</td>
                <td style="width: 120px;"></td>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.GroupList)
            {
                <tr>
                    @*<td>@item.Id</td>
                    <td>@item.OutCityName</td>*@
                    <td>@item.GroupName</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-info edit" title="编辑" onclick="EditGroup(@item.Id);">编辑</button>
                        <button type="button" class="btn btn-sm btn-danger delete" title="删除" onclick="DeleteGroup(@item.Id);">删除</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
