@model Lvy.Models.HotelDB.HotelModel
@if (Model.RoomList.Count > 0)
{
    <table class="table table-striped table-bordered table-sm">
        <thead>
            <tr>
                <td>#</td>
                <td>房型名称</td>
                <td>可住人数</td>
                <td>床型</td>
                <td>早餐</td>
                <td align="center" style="width:220px;" >操作</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.RoomList)
            {
                <tr>
                    <td>@item.RoomID</td>
                    <td>@item.RoomName</td>
                    <td>@item.Pax</td>
                    <td>
                        @if (item.BedList.Count > 0)
                        {
                            foreach (var bed in item.BedList)
                            {
                                @(DictionaryTools.GetEnumValue(Enums.BedTypeEnum, bed.BedType.ToString()) +" * " + bed.BedNum)
                                <br />
                            }
                        }
                    </td>
                    <td>@item.Breakfast</td>
                    <td class="project-actions">
                        <button onclick="RoomEdit(@item.RoomID);" class="btn btn-primary btn-sm"><i class="fas fa-edit"></i>修改</button>
                        <button onclick="RoomStock(@item.RoomID);" class="btn btn-info btn-sm"><i class="fas fa-calendar"></i>库存</button>
                        <button onclick="return confirm('确定要删除嘛？')" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i>删除</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div style="color: red; text-align: center; font-weight: bold; font-size: 14px;">
        <br />
        对不起，没有查找到数据！请重新输入查询条件 ！
    </div>
}
