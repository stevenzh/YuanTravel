@model Lvy.VModels.Crm.FunctionVModel
@{
    ViewBag.Title = "添加模块";
    Layout = "~/Views/Shared/_Single.cshtml";
}

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Home/Destop">Home</a></li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<section class="content">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">模块信息</h3>
        </div>
        <form id="theForm" action="@Url.Action("Add", "Module")" method="POST" class="form-horizontal">
            <div class="card-body">
                <div class="form-group row">
                    <div class="col-sm-2 col-form-label"><span class="point">*</span>模块名称：</div>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(a => a.Function.Name, new { @Class = "form-control" })
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-2 col-form-label"><span class="point">*</span>排序：</div>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(a => a.Function.Sort, new { @Class = "form-control" })
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-2 col-form-label"><span class="point">*</span>平台模块：</div>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(a => a.Function.IsSuper, new { @Class = "form-control" })
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-2 col-form-label">内容：</div>
                    <div class="col-sm-10">
                        @Html.TextAreaFor(a => a.Function.Description, new { @Class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="card-body">
                <input class="btn btn-info" id="btnSave" name="" type="submit" value="保存" />
                <input class="btn btn-info" id="btnBack" type="button" value="返回列表" onclick="location.href='@Url.Action("Search")';" />
            </div>
        </form>
    </div>
</section>
<script type="text/javascript">
    $(function () {
        $("#theForm").submit(function () {
            if (!CheckControls()) {
                return false;
            }
        });
    });

    //验证用户输入
    function CheckControls() {
        if (Utils.Trim($("#Function_Name").val()) == "") {
            Utils.alert("模块名称不得为空！");
            $("#Function_Name").focus().select();
            return false;
        }
        if (Utils.Trim($("#Function_Sort").val()) == "") {
            Utils.alert("排序不得为空！");
            $("#Function_Sort").focus().select();
            return false;
        }
        if (Utils.Check.IsInt($("#Function_Sort").val()) == "") {
            Utils.alert("排序只能为整数！");
            $("#Function_Sort").focus().select();
            return false;
        }
        return true;

    }
</script>
