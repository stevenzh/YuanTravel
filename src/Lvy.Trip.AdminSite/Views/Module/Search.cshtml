@model Lvy.VModels.Crm.FunctionVModel
@{
    ViewBag.Title = "模块管理";
    Layout = "~/Views/Shared/_Single.cshtml";
}
@section AdditionalResources { }

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<section class="content">
    <form id="theForm" method="POST" action="@Url.Action("Search")">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">模块列表</h3>
                <div class="card-tools">
                    <div class="input-group input-group-sm" style="width:500px;">
                        @Html.DropDownListFor(a => a.Function.ParentId, ViewBag.ModuleBeans as IEnumerable<SelectListItem>, new { @class = "form-control pull-right", @style = "width:100px;" })
                        @Html.DropDownListFor(a => a.Type, ViewBag.FuncType as IEnumerable<SelectListItem>, new { @class = "form-control pull-right", @style = "width:100px;" })
                        <div class="input-group-append">
                            <button id="btnSave" type="submit" class="btn btn-default">查 询</button>
                            <a href="@Url.Action("Create")" title="添加模块" class="btn btn-info ">添加模块</a>
                        </div>
                    </div>
                </div>
            </div>
            <div id="divSearch" class="card-body">
                @Html.Partial("UCSearch", Model)
            </div>
            <div class="card-footer">
                <div id="Pagination" class="digg"></div>
            </div>
        </div>
    </form>
</section>