@model Lvy.Models.BaseDB.VTProceedsModel
@{
    Layout = null;
    string CDNServerUrl = Arch.Common.AppSetting.Get("CDNServerUrl");
}
<html>
<head>
    <script src="~/WebRes/scripts/jquery-1.12.4.min.js"></script>
    <script src="@CDNServerUrl/jquery-sumoselect/jquery.sumoselect.min.js"></script>
    <link href="@CDNServerUrl/jquery-sumoselect/sumoselect.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="@CDNServerUrl/select2/css/select2.min.css" />
    <script src="@CDNServerUrl/select2/js/select2.full.min.js"></script>
    <script src="@CDNServerUrl/select2/js/i18n/zh-CN.js"></script>

    <link href="@CDNServerUrl/layer/theme/default/layer.css" rel="stylesheet" />
    <script src="@CDNServerUrl/layer/layer.min.js"></script>
    <script src="~/WebRes/scripts/common.js"></script>
    <style>
        .ac_results { background: #fff; border: 1px solid #b4b4b4; position: absolute; z-index: 10000; display: none; }
            .ac_results ul { margin: 0; padding: 0; list-style: none; }
            .ac_results li a { text-decoration: none; display: block; color: #005ea7; padding: 1px 1px; clear: both; display: inline; }
            .ac_results li { border: 1px solid #fff; line-height: 1.8em; cursor: pointer; }
                .ac_over, .ac_results li a:hover { background: #f3f3f3; }
                .ac_results li a span.py { float: right; width: 40%; text-align: right; overflow: hidden; white-space: nowrap; color: Gray; font-size: 12px; font-family: Simsun,sans-serif; }
                .ac_results li a span.id { font-size: 12px; font-family: Simsun,sans-serif; color: Red; }
        .ac_result_tip { padding: 3px; background-color: #deeefd; color: #ec6d51; height: 18px; }
        .ac_result_tip_no { background-color: #deeefd; }
    </style>
</head>
<body>
    <table class="edittbl" width="100%">
        <tr>
            <td class="label">缴款单位名称或个人：</td>
            <td>&nbsp;@Html.TextBoxFor(t => t.ChargerHost, new { @class = "text400" })</td>
        </tr>
        <tr>
            <td class="label">缴款部门（业务部门）</td>
            <td>&nbsp;@Html.DropDownListFor(t => t.ChargerDept, (List<SelectListItem>)ViewBag.Teams, new { @id = "QChargerDept" })</td>
        </tr>
        <tr style="height:50px;">
            <td class="label">缴款人（业务员）</td>
            <td>
                @*@Html.DropDownListFor(t => t.ChargerName,(List<SelectListItem>)ViewBag.CustomerList,  new { @class = " text400" })*@
                @Html.TextBoxFor(t => t.ChargerName, new { @class = " text400" })
            </td>
        </tr>
        <tr>
            <td class="label">收款方式：</td>
            <td>&nbsp;@Html.DropDownList("CollectionType", (List<SelectListItem>)ViewData["CollectionType"], new { @id = "CollectionType", @class = " text150", multiple = "multiple" })</td>
        </tr>
        <tr>
            <td class="label">总应收：</td>
            <td style="color: #e02d31; font-weight: bold">&nbsp;￥<input type="text" id="TotalAccounts" class="text150" value="" /></td>
        </tr>
        <tr>
            <td class="label">收款事由：</td>
            <td>&nbsp;<textarea rows="2" id="Purpose" name="Purpose" class="textarea550" style="display: inline; width: 500px; height: 40px;"></textarea></td>
        </tr>
        <tr>
            <td class="label">备注：</td>
            <td>&nbsp;<textarea name="Remark" id="Remark" class="textarea550" style="display: inline; width: 500px; height: 40px;"></textarea></td>
        </tr>
    </table>

    <table width="100%" align="center">
        <tbody>
            <tr>
                <td align="center">
                    <input type="checkbox" checked="checked" id="PrintCollection" />打印收款单&nbsp;&nbsp;&nbsp;
                    <input type="button" class="btn_2" id="CollectionBtn" value="确认收款" />
                    <input type="hidden" id="ProceedsChannelNew" name="ProceedsChannelNew" value="2" />
                    <input type="hidden" id="IsReceiveNew" name="IsReceiveNew" value="0" />
                    <input type="hidden" id="freeTourType" name="freeTourType" value="@Request.QueryString["freeTourType"]" />
                    &nbsp;&nbsp;&nbsp;
                    <input type="button" onclick="parent.ClosePlan()" class="btn_2" value="取消" />

                </td>
            </tr>
        </tbody>
    </table>

    <script type="text/javascript">

        $(document).ready(function () {

            $("#CollectionType").SumoSelect({ placeholder: '请选择' });

            $("#CollectionBtn").click(function () {
                var collectType = $("#CollectionType").val();
                var amount = $("#TotalAccounts").val();
                if (amount == "" || amount == null) {
                    Utils.alert("收款金额不允许为空");
                    return false;
                }

                if (isNaN(amount)) {
                    Utils.alert("收款金额必须为数字");
                    return false;
                }

                if (collectType == "") {
                    Utils.alert("请选择收款方式");
                    return false;
                }

                $("#CollectionBtn").attr("disabled", "disabled");
                var muti = "";
                $("#CollectionType option:selected").each(function () {
                    muti += $(this).attr("value") + ",";
                });

                var params = {
                    "ChargerHost": $("#ChargerHost").val(),
                    "MultiType": muti,
                    "ReceiveSum": amount,
                    "Purpose": $("#Purpose").val(),
                    "Remark": $("#Remark").val(),
                    "ChargerId": $("#ChargerId").val(),
                    "ChargerName": $("#ChargerName").val(),
                    "ChargerDept": $("#ChargerDept").val()
                }

                $.post('/Proceeds/AddCollectionInfo', params, function (data) {
                    var result = data.split('|');
                    if (result[0] == "1") {
                        Utils.alert("收款成功!");
                        var currIndex = $("#pageIndex", parent.document).val();
                        parent.loadData(currIndex);

                        if ($("#PrintCollection").prop("checked")) {
                            parent.CollectionPrint(result[1]);
                            // 弹出框关闭
                            var index = parent.layer.getFrameIndex(window.name); //获取窗口索引
                            parent.layer.close(index); 
                        }
                        else {
                            // 弹出框关闭
                            var index = parent.layer.getFrameIndex(window.name); //获取窗口索引
                            parent.layer.close(index); 
                        }
                    }
                    else if (result[0] == "2") {
                        Utils.alert("不允许重复提交数据!");
                        // 弹出框关闭
                        var index = parent.layer.getFrameIndex(window.name); //获取窗口索引
                        parent.layer.close(index); 
                    }
                    else {
                        Utils.alert("收款出错，请联系网络信息部！");
                        // 弹出框关闭
                        var index = parent.layer.getFrameIndex(window.name); //获取窗口索引
                        parent.layer.close(index); 
                    }
                });
            });
        });

    </script>

</body>
</html>