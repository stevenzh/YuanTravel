@using System.Web.Mvc
@using Lvy.Web.Common

@helper DisplayTicketState(int state)
{
string className = "";
switch (state)
{
    case 1:
        className = "badge badge-1";
        break;
    case 2:
        className = "badge badge-2";
        break;
    case 8:
        className = "badge badge-8";
        break;
    case 10:
        className = "badge badge-10";
        break;
    default:
        className = "badge badge-1";
        break;
}

    <span class="@className">
        @DictionaryTools.GetEnumValue(Enums.VisaOrderStatusEnum, state.ToString())
    </span>
}

