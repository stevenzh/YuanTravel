@using Lvy.Web.Common
@model Lvy.VModels.Base.TaskVModel

<table class="table table-sm table-striped text-nowrap" style="min-width:650px;">
    <thead>
        <tr>
            <td align="center">编号</td>
            <td align="left">提出部门</td>
            <td align="left">提出人</td>
            <td align="center">提出时间</td>
            <td align="left">流程名称</td>
            <td align="left">状态</td>
            <td align="left">审核部门</td>
            <td align="left">审核人</td>
            <td align="center">操作时间</td>
            <td align="center" style="width: 70px;">操作</td>
        </tr>
    </thead>
    <tbody>
        @if (Model.TaskPageList.Items.Count > 0)
        {
            foreach (var item in Model.TaskPageList.Items)
            {

                <tr>
                    <td align="center">@item.TaskID</td>
                    <td align="left">@DictionaryTools.GetCachedTeam(item.TeamID).TeamName</td>
                    <td align="left">@DictionaryTools.GetCachedAccount(item.Originator).Name</td>
                    <td align="center">@item.CreatedTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td align="left">@DictionaryTools.GetEnumValue(Enums.WorkFlowEnum, item.WorkFlowID.ToString())</td>
                    <td align="left">@DictionaryTools.GetEnumValue(Enums.TaskStatusEnum, item.Status.ToString(), false)</td>
                    <td align="left">@(item.WorkmanTeam == null ? "" : DictionaryTools.GetCachedTeam(item.WorkmanTeam).TeamName)</td>
                    <td align="left">@(item.Workman == null ? "" : DictionaryTools.GetCachedAccount(item.Workman).Name)</td>
                    <td align="center">@(item.OperateTime == null ? "" : item.OperateTime.Value.ToString("yyyy-MM-dd HH:mm:ss"))</td>
                    <td align="center">
                        <div class="btn-group btn-group-sm">
                            <a type="button" class="btn" href="/Task/Details/@item.TaskID" title="详情"><i class="fa fa-list"></i></a>
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="10" align="center" style="color: red;">
                    当前没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>
