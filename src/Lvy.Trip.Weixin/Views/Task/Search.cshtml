@model Lvy.VModels.Base.TaskVModel
@{
    ViewData["Title"] = "任务列表";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section HeaderContent
{
    <script>
        var page_id = 0;
    </script>
}

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<section class="content">
    <form id="theForm" method="POST" action="@Url.Action("Search")">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"> 任务列表</h3>
                <div class="card-tools">
                    <div class="input-group input-group-sm" style="width: 350px;">
                        @if (Model.IsLeader == 1)
                        {
                            @Html.DropDownListFor(a => a.Task.TeamID, ViewBag.AccountTeamBeans as IEnumerable<SelectListItem>, new { @Class = "form-control pull-right" })
                        }
                        else
                        {
                            @Html.DropDownListFor(a => a.Task.TeamID, ViewBag.AccountTeamBeans as IEnumerable<SelectListItem>, new { @Class = "form-control pull-right", @disabled = "disabled" })
                            @Html.HiddenFor(m => m.Task.TeamID)
                        }
                        @if (Model.IsLeader == 1)
                        {
                            @Html.DropDownListFor(a => a.Task.Originator, ViewBag.SalesOfTeam as IEnumerable<SelectListItem>, new { @Class = "form-control pull-right" })
                        }
                        else
                        {
                            @Html.DropDownListFor(a => a.Task.Originator, ViewBag.SalesOfTeam as IEnumerable<SelectListItem>, new { @Class = "form-control pull-right", @disabled = "disabled" })
                            @Html.HiddenFor(m => m.Task.Originator)
                        }
                        <div class="input-group-append">
                            <button type="submit" class="btn btn-default"><i class="fa fa-search"></i></button>
                            <a href="@Url.Action("Create")" class="btn btn-success"> <i class="fa fa-plus"></i> </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body table-responsive p-0" id="divNotices">
                @Html.Partial("UCSearch", Model)
            </div>
            <div class="card-footer">
                <ul id="pagination-demo" class="pagination-sm"></ul>
            </div>
        </div>
    </form>
</section>

<script>
    $(function () {

        $('#pagination-demo').twbsPagination({
            totalPages: Number('@Math.Ceiling((decimal)Model.TaskPageList.TotalCount /(decimal) Model.TaskPageList.PageSize) '),
            visiblePages: 3,
            first: "首页",
            prev: "上一页",
            next: "下一页",
            last: "末页",
            onPageClick: function (event, page) {
                page_id = page;
                var param = {
                    'Task.TeamID': $("#Task_TeamID").val(),
                    'Task.Originator': $("#Task_Originator").val(),
                    'TaskPageList.PageIndex': page_id,
                    'TaskPageList.PageSize': @Model.TaskPageList.PageSize
                };
                var load_iii = Utils.layerLoad();
                $.post('/Task/Search/', param, function (data) {
                    $('#divNotices').html(data);
                       Utils.layerClose(load_iii);
                });
            }
        });
    });

</script>
