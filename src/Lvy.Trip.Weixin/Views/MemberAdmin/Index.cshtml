@model Lvy.VModels.Weixin.MemberQModel
@{
    ViewBag.Title = "用户管理";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    string CDNServerUrl = Arch.Common.AppSetting.Get("CDNServerUrl");
}
@section HeaderContent
{
    <script src="@CDNServerUrl/twbs-pagination/jquery.twbsPagination.js"></script>
    <script>
        var page_id = 0;
    </script>
}
<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Admin/Index">首页</a></li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<section class="content">
    <div class="card">
        @using (Html.BeginForm("Index", "Member", FormMethod.Post, new { role = "form" }))
        {
            <div class="card-header">
                <h3 class="card-title"></h3>
                <div class="card-tools">
                    <div class="input-group input-group-sm" style="width:380px;">
                        <input id="Name" name="Name" class="form-control float-right" placeholder="姓名" />
                        @Html.DropDownListFor(t => t.Sales, (List<SelectListItem>)ViewBag.SalesList, new { @class = "form-control", @placeholder = "销售" })
                        @Html.TextBoxFor(t => t.CustomerName, new { @class = "form-control", @placeholder = "企业名称" })
                        @*@Html.DropDownListFor(t => t.Subscribe, (List<SelectListItem>)ViewBag.SubscribeList, new { @class = "form-control" })*@
                        @Html.DropDownListFor(t => t.Employee, (List<SelectListItem>)ViewBag.EmployeeList, new { @class = "form-control" })
                        <div class="input-group-append">
                            <button type="submit" class="btn btn-default"><i class="fas fa-search"></i> </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body table-responsive p-0" id="questionListsDiv">
                @Html.Partial("PageList", Model)
            </div>
        }
        <div class="card-footer">
            <ul id="pagination-demo" class="pagination-sm"></ul>
            <input type="button" id="usersyn" value="微信用户获取（严重）" class="btn btn-default" />
        </div>
    </div>
</section>

<script>
    $(function () {

        $("#usersyn").click(function () {
            $.ajax({
                url: '/Member/SyncUser',
                type: 'post',
                dataType: 'json',
                success: function (data) {
                    if (data.Success) {
                        Utils.alert("提示", "同步成功");
                    }
                    else {
                        Utils.alert("提示", "同步失败:" + data.ErrorMessage);
                    }
                },
                data: ''
            });
        });

        $('#pagination-demo').twbsPagination({
            totalPages: Number('@Math.Ceiling((decimal)Model.MemberPageList.TotalCount/(decimal)Model.MemberPageList.PageSize)'),
            visiblePages: 4,
            first: "首页",
            prev: "上一页",
            next: "下一页",
            last: "末页",
            onPageClick: function (event, page) {
                page_id = page;
                var param = {
                    'Sales': $("#Sales").val(),
                    'Approved': $("#Approved").val(),
                    'Binding': $("#Binding").val(),
                    'OpenID': $("#OpenID").val(),
                    'Subscribe': $("#Subscribe").val(),
                    'Employee': $("#Employee").val(),
                    'CustomerName': $("#CustomerName").val(),
                    'MemberPageList.PageIndex': page_id,
                    'MemberPageList.PageSize': @Model.MemberPageList.PageSize
                };
                $.post('/Member/PageList/', param, function (data) {
                    $('#questionListsDiv').html(data);
                });
            }
        });
    });

    function updateuser(openid) {
        $.ajax({
            url: '/Member/SyncOneUser',
            type: 'post',
            data: { 'openid': openid },
            dataType: 'json',
            success: function (data) {
                if (data.Success) {
                    Utils.alert("提示", "同步成功");

                    var param = {
                        'Name': $("#Name").val(),
                        'Sales': $("#Sales").val(),
                        'Approved': $("#Approved").val(),
                        'Binding': $("#Binding").val(),
                        'OpenID': $("#OpenID").val(),
                        'Subscribe': $("#Subscribe").val(),
                        'Employee': $("#Employee").val(),
                        'CustomerName': $("#CustomerName").val(),
                        'MemberPageList.PageIndex': page_id,
                        'MemberPageList.PageSize': @Model.MemberPageList.PageSize
                    };
                    $.post('/Member/PageList/', param, function (data) {
                        $('#questionListsDiv').html(data);
                    });

                }
                else {
                    Utils.alert("提示", "同步失败:" + data.ErrorMessage);
                }
            }
        });
    }

</script>