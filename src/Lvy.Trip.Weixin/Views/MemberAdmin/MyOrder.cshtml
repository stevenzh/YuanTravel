@model TopWeb.QModel.OrderQModel
@{
    ViewBag.Title = "微信_我的订单";
    Layout = null;
    string CDNServerUrl = Arch.Common.AppSetting.Get("CDNServerUrl");
}
@using CCT.Travel.Model
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <script src="@CDNServerUrl/jquery/jquery.min.js"></script>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Scripts/bootstrap.min.js"></script>
</head>
<body>
    <div class="panel panel-default">
        <div class="panel-heading">我的订单</div>
        <div class="panel-body">
            <ul class="list-group">
                @foreach (OrderModel item in Model.OrderList)
                {
                    <li class="list-group-item">
                        <h4>订单号：@item.Tid</h4>
                        <p><b>总价：</b>@item.Payment</p>
                        <p><b>宝贝：</b>@item.Title</p>
                        <p><b>宝贝属性：</b>@item.SkuPropertiesName</p>
                        <p><b>数量：</b>@item.Num</p>
                        <p><b>订单状态：</b>@item.StatusValue</p>
                        <p><b>付款时间：</b>@item.PayTime</p>
                        <p><b>操作状态：</b>@item.OpStatusValue</p>
                        @if (item.OrderLogs.Count() > 0)
                        {
                            <h5>操作历史</h5>
                            foreach (OrderLogModel log in item.OrderLogs)
                            {
                                <p>@log.Created : @log.StatusValue - @log.Description </p>
                            }
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
</body>
</html>
