@model Lvy.VModels.Product.SearchTourVModel
@{
    ViewBag.Title = "微信公众号";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var dt = Model.TourList.Items.Select(t => t.OutDate).Distinct();
    Layout = null;
}
@using Lvy.VModels.Product

<div class="timeline">

    @foreach (var ot in dt)
    {
        var llp = Model.TourList.Items.Where(t => t.OutDate == ot).ToList();

        <div class="time-label">
            <span class="bg-red">
                @ot.ToDateFormat()
            </span>
        </div>

        <div>
            <!-- timeline icon -->
            <i class="fa fa-envelope bg-blue"></i>
            <div class="timeline-item">
                @*<span class="time"><i class="fa fa-clock-o"></i> 12:05</span>*@

                @*<h3 class="timeline-header"><a href="#"> @ot.</a>...</h3>*@

                <div class="timeline-body">
                    <table class="table table-condensed">
                        <tr>
                            @*<th style="width: 40px">#</th>*@
                            <th>品牌/名称</th>
                            <th style="width: 90px;">进度</th>
                            <th style="width:40px;">总位</th>
                        </tr>
                        @foreach (var tt in llp)
                        {
                            <tr>
                                @*<td>@tt.OutDate.ToString("M/dd")</td>*@
                                <td>
                                    <a href="/Op/PlanDetails/@tt.TourId"><p class="title">@(tt.ProductBrand.IsNullOrEmpty() ? tt.LineName.TrimWithElipsis(9) : tt.ProductBrand )</p></a>
                                </td>
                                <td>
                                    @{
                                        var ttt = Math.Ceiling((tt.UsedQuota * 100D) / tt.PlanQuota);
                                        var unlock = Math.Ceiling((tt.UnlockQuota * 100D) / tt.PlanQuota);
                                    }
                                    <div class="progress progress-xs">
                                        <div class="progress-bar progress-bar-success" style="width: @( ttt + "%")"></div>
                                        <div class="progress-bar progress-bar-warning" style="width: @( unlock + "%")"></div>
                                    </div>

                                </td>
                                <td>
                                    <span class="badge bg-green">@tt.PlanQuota</span>
                                </td>
                            </tr>
                        }
                    </table>
                </div>
            </div>
        </div>

        @*<li>
                <i class="fa fa-user bg-aqua"></i>

                <div class="timeline-item">
                    <span class="time"><i class="fa fa-clock-o"></i> 5 mins ago</span>

                    <h3 class="timeline-header no-border"><a href="#">Sarah Young</a> accepted your friend request</h3>
                </div>
            </li>*@
    }
    </div>
