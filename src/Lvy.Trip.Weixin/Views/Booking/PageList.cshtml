@model Lvy.VModels.Order.TpOrderVModel
@{
    Layout = null;
}
<table id="tbllist" class="table table-sm text-nowrap" style="min-width:800px;">
    <thead>
        <tr>
            <th align="center">订单号</th>
            <th align="left">线路名称</th>
            <th align="center">出发日期</th>
            <th align="center">联系人</th>
            <th align="center">人数</th>
            <th align="center">订单状态</th>
            <th align="center">金额</th>
            <th align="center">销售</th>
            <th align="center">分销商</th>
            <th align="center">游客</th>
            <th align="center" style="width: 70px;">操作</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.PagedList.TotalCount > 0)
        {
            foreach (var item in Model.PagedList.Items)
            {
                <tr style="background-color:@(item.OrderState==2?"#ccffcc":"#fff")">
                    <td name="orderCode" align="center" orderCode='@item.OrderCode'>
                        @item.OrderCode
                    </td>
                    <td align="left" title="@item.LineName">
                        @item.LineName.TrimWithElipsis(17)
                    </td>
                    <td align="center">
                        @item.OutDate.ToDateFormat()
                    </td>
                    <td align="center">
                        @item.Managers
                    </td>
                    <td align="center">
                        @item.TravellerCount
                    </td>
                    <td name="orderState" align="center">
                        @DictionaryTools.GetEnumValue("OrderStateEnum", item.OrderState.ToString())
                    </td>
                    <td align="center">
                        @item.TolYsPrice
                    </td>
                    <td align="center">
                        @DictionaryTools.GetCachedAccount(item.SalerCode).Name
                    </td>
                    <td align="left">
                        @(item.BookingCustomer == null ? "" : DictionaryTools.GetCachedCustomer(item.BookingCustomer).Name)
                    </td>
                    <td align="center">
                        @item.LinkMan
                    </td>
                    <td align="left">
                        <a title="查看订单" href="@Url.Action("Details", new { id = item.OrderCode })">详情</a>
                    </td>
                </tr>
            }

            if (Model.TotalModel != null)
            {
                <tr style="background-color:darkgrey;font-weight:bold;">
                    <td>合计</td>
                    <td colspan="10">
                        人数：@Model.TotalModel.PaxSum &nbsp;&nbsp;
                        团款：@Model.TotalModel.AmountSum &nbsp;&nbsp;
                        未收款：@Model.TotalModel.PaidSum  &nbsp;&nbsp;
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="10" align="center" style="color: red; font-weight: bold;">
                    当前没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

