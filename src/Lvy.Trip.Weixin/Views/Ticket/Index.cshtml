<!-- end banner -->
<!-- product -->
<section class="product segments divider">
    <div class="ui container">
        <div class="section-title">
            <h3>热卖商品</h3>
            <div class="line"></div>
        </div>
        <div class="ui grid">
            @for (int i = 0; i < hostline.Count; i++)
            {
                var item = hostline[i];
                <div class="eight wide column @(i%2==0?"pr":"pl")">
                    <div class="content">
                        <img src="@(picroot + item.ImgUrl)" alt="">
                        <a href="/ticket/details/@item.ProductId">
                            <p>@item.ProductName</p>
                        </a>
                        <h5>￥ @Math.Round(item.MarketPrice)</h5>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- end product -->
