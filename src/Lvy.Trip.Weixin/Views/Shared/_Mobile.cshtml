@{ 
    string CDNServerUrl = Arch.Common.AppSetting.Get("CDNServerUrl");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="@CDNServerUrl/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="@CDNServerUrl/semanticUI/semantic.min.css">
    @RenderSection("HeaderContent", false)
</head>
<body>
    @RenderBody()
    <script src="@CDNServerUrl/jquery/jquery.min.js"></script>
    <!-- Used with Tab History !-->
    <!-- <script src="http://cdnjs.cloudflare.com/ajax/libs/jquery.address/1.6/jquery.address.min.js"></script> -->
    <script src="http://res.wx.qq.com/open/js/jweixin-1.0.0.js"></script>
    <script src="@CDNServerUrl/semanticUI/semantic.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>