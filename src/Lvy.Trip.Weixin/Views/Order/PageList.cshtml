@model TopWeb.QModel.OrderQModel
@{
    Layout = null;
}
<table class="table table-bordered table-striped ">
    <tr>
        <th style="width: 50px;">订单号</th>
        <th>商品名称</th>
        <th>宝贝属性</th>
        <th style="width: 50px;">数量</th>
        <th style="width: 80px;">价格</th>
        <th style="width: 110px;">实付金额</th>
        <th style="width: 110px;">支付时间</th>
        <th style="width: 110px;">交易状态</th>
        <th style="width: 110px;">买家昵称</th>
        <th style="width: 110px;">操作员</th>
        <th style="width: 130px;">操作状态</th>
        <th style="width: 130px;">操作</th>
    </tr>

    @if (Model.OrderPageList != null && Model.OrderPageList.Count > 0)
    {
        foreach (var chatmodel in Model.OrderPageList)
        {
            <tr style="background-color:@(chatmodel.State==1?"#ccffcc":"#fff")">
                <td>@chatmodel.Tid</td>
                <td>@chatmodel.Title</td>
                <td>@chatmodel.SkuPropertiesName</td>
                <td>@chatmodel.Num</td>
                <td>@chatmodel.Price</td>
                <td>@chatmodel.Payment</td>
                <td>@chatmodel.PayTime</td>
                <td>@chatmodel.StatusValue</td>
                <td>@chatmodel.BuyerNick</td>
                <td>@chatmodel.Operator</td>
                <td>@chatmodel.OpStatusValue</td>
                <td>
                    <a href="/Order/Details/@chatmodel.OrderId">详细</a>
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="8" style="text-align: center; font-size: 14px; color: Red;">对不起！没有找到您要的数据！ </td>
        </tr>
    }
</table>
<div id="Pagination" class="digg" />
<script type="text/javascript">
    //分页控件 begin
    $(function () {
        $("#Pagination").pagination(
            Number('@Model.OrderPageList.TotalCount'), {
                callback: pageselectCallback1,
                prev_text: '前一页',
                next_text: '后一页',
                items_per_page: 10,
                num_display_entries: 5,
                num_edge_entries: 2,
                current_page: pageIndex
            });
    });
    //回调方法
    function pageselectCallback1(page_id, jq) {
        jQuery.ajaxSetup({ cache: false });
        pageIndex = page_id;
        page_id = page_id + 1;
        var param = {
            'BuyerNick': $("#selcountryName").val(),
            'RealName': '',
            'StartDate': 'StartDate',
            'EndDate':'EndDate',
            'PagedSetting.PagedIndex': page_id,
            'PagedSetting.PagedSize': 10
        };
        $.post('/Order/PageList/', param, function (data) {
            $('#questionListsDiv').html(data);
        });
    }
    //分页控件 end

    //编辑问题
    function EditQuestion(questioncode) {
        window.location = "/WeChat/AddChat/" + questioncode;
    }

    //删除问题
    function DeleteQuestion(questioncode) {
        if (confirm("确定要删除数据吗？")) {
            $.post("/Order/DeleteChat/", { "ID": questioncode }, function () {
                window.location.href = "/WeChat/SearchChat/";
            });
        }
    }
</script>
