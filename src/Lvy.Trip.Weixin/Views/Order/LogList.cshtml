@model TopWeb.Model.OrderModel
@{
    Layout = null;
}
<table class="table table-bordered table-striped ">
    <tr>
        <th style="width: 150px;">状态</th>
        <th>内容</th>
        <th style="width: 80px;">客服</th>
        <th style="width: 50px;">发送微信</th>
        <th style="width: 150px;">创建时间</th>
    </tr>

    @if (Model.OrderLogs != null && Model.OrderLogs.Count > 0)
    {
        foreach (var chatmodel in Model.OrderLogs)
        {
            <tr>
                <td>@chatmodel.StatusValue</td>
                <td>@chatmodel.Description</td>
                <td>@chatmodel.CreatedBy</td>
                <td>@chatmodel.SendMessage</td>
                <td>@chatmodel.Created</td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="8" style="text-align: center; font-size: 14px; color: Red;">对不起！没有找到您要的数据！ </td>
        </tr>
    }
</table>
<div id="Pagination" class="digg" />
<script type="text/javascript">
    //分页控件 begin
    $(function () {
        $("#Pagination").pagination(
            Number('@Model.OrderLogs.Count'), {
                callback: pageselectCallback1,
                prev_text: '前一页',
                next_text: '后一页',
                items_per_page: 10,
                num_display_entries: 5,
                num_edge_entries: 2,
                current_page: pageIndex
            });
    });
    //回调方法
    function pageselectCallback1(page_id, jq) {
        jQuery.ajaxSetup({ cache: false });
        pageIndex = page_id;
        page_id = page_id + 1;
        var param = {
            'Tid':  @Model.Tid,
            'PagedSetting.PagedIndex': page_id,
            'PagedSetting.PagedSize': 10
        };
        $.post('/Order/LogList/', param, function (data) {
            $('#questionListsDiv').html(data);
        });
    }
    //分页控件 end

</script>
