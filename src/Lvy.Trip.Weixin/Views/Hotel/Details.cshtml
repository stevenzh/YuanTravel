@model Lvy.Models.HotelDB.HotelModel
@{
    Layout = "~/Views/Shared/_Mobile.cshtml";
    ViewBag.Title = Model.HotelName;
    Member cuser = (Member)HttpContext.Current.Session["WeixinUser"]; //当前用户
    var weixinUser = ViewBag.WeixinUser as Member; //上家
    string userkey = (cuser != null) ? cuser.MemberID.ToString() : "";
    string employeekey = (cuser != null && !string.IsNullOrEmpty(cuser.EmployeeID)) ? cuser.EmployeeID : "";
    string binding = (cuser != null) ? cuser.Approved.ToString() : "0";

    var picroot = Arch.Common.AppSetting.Get("UploadFileRoot");
    string CDNServerUrl = Arch.Common.AppSetting.Get("CDNServerUrl");
}
@using Lvy.Models.WeixinDB;
@section HeaderContent
{
    <link rel="stylesheet" href="@CDNServerUrl/owl-carousel/assets/owl.carousel.css" />
    <link rel="stylesheet" href="@CDNServerUrl/owl-carousel/assets/owl.theme.default.css" />
    <link rel="stylesheet" href="~/css/style.css">
    <link href="@CDNServerUrl/fullcalendar/main.min.css" rel="stylesheet" />
    <link href="~/Content/calendarchange.css" rel="stylesheet" />
    <style>
        .ui.items > .item .extra > * { margin: .25rem .25rem .25rem 0; padding: 0.5em 0.68em; }
        .ui.items > .item .extra { color: rgba(0,0,0,.6); }
    </style>
}

<!-- wrap content -->
<div class="wrap-content pusher">

    <!-- product details -->
    <div class="product-details segments-page" style="margin-top:0;">
        <div class="ui container">
            <div class="slide-product owl-carousel owl-theme">
                @foreach (var item in Model.FileList.Where(t => t.Type == "31"))
                {
                    <div class="slide-content"><img src="@(picroot + item.FilePath)" alt=""></div>
                }
            </div>

            <div class="desc-short">
                <p class="title">@Model.HotelName</p>
                @if (Model.SalePrice > 0)
                {
                    <h5>@Math.Round(Model.SalePrice) 元 <span style="font-size:14px;">起</span></h5>
                }

                <p> 交通 </p>
                <button class="button"><i class="fa fa-shopping-cart"></i>预订旅游线路</button>
            </div>
            @*<div class="desc-long">
                <h5>产品经理推荐</h5>
                <p>
                    推荐
                </p>
            </div>*@

            <div class="ui vertical segment">
                @if (@ViewData["Message"] != null)
                {
                    <div class="ui info message">
                        <div class="header">提示信息</div>
                        <p>@ViewData["Message"]</p>
                    </div>
                }
            </div>


            <div class="ui bottom active  segment">
                <div class="ui unstackable  items">
                    @foreach (var route in Model.RoomList)
                    {
                        var imgs = Model.FileList.Where(m => m.KeyId == route.RoomID).FirstOrDefault();
                        <div class="item">
                            <div class="image">
                                <img src="@(imgs==null?"": picroot + imgs.FilePath)">
                            </div>
                            <div class="content">
                                <div class="header" style="color:#0094ff">@route.RoomName</div>
                                <div class="description">
                                    @foreach (var item in route.BedList)
                                    {
                                        <p>@DictionaryTools.GetEnumValue(Enums.BedTypeEnum, item.BedType.ToString())  @item.BedNum </p>
                                    }
                                </div>
                                <div class="extra">
                                    <div class="well well-sm">
                                        <i class="building icon"></i>设施：@route.RoomFacility <br />
                                        <i class="orange food icon"></i>早餐:@Html.Raw(route.Breakfast)
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="ui bottom  segment">
                <h4>酒店介绍</h4>
                @Html.Raw(Model.Introduction.Replace("\r", "<br />"))
            </div>

        </div>
    </div>
</div><!-- end product details	 -->



<div class="ui modal">
    <i class="close icon"></i>
    <div class="header">
        产品预订
    </div>
    <div class="content">
        <div class="image">
            @Model.HotelName
        </div>
        <div class="description">
            <div class="ui form">
                <div class="field">
                    <label>联系人</label>
                    <input type="text" value="@(cuser != null? cuser.RealName : "")">
                </div>
                <div class="field">
                    <label>联系电话</label>
                    <input type="text">
                </div>
                <div class="field">
                    <label>预订人数</label>
                    <input type="text">
                </div>
                <div class="field">
                    <label>其它要求</label>
                    <textarea></textarea>
                </div>
            </div>
        </div>
    </div>
    <div class="actions">
        <div class="ui button cancel">取消</div>
        <div class="ui button ok">预订</div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/lunar_demo.js"></script>
    <script src="@CDNServerUrl/moment/moment.min.js"></script>
    <script src="@CDNServerUrl/fullcalendar/main.min.js"></script>
    <script src="@CDNServerUrl/fullcalendar/locales/zh-cn.js"></script>
    <script src="@CDNServerUrl/owl-carousel/owl.carousel.js"></script>
    <script src="~/js/main.js"></script>
    <script>
        var flag = /MicroMessenger/i.test(navigator.userAgent);
        if (flag == false)
            $("#wxshare").hide();
    </script>
    <script>
    $(document).ready(function () {

        var calendarEl = document.getElementById('calendar');
        var calendar = new FullCalendar.Calendar(calendarEl, {
            header: {
                left: 'prev',
                center: 'title',
                right: 'next'
            },
            locale: 'zh-cn',
            height: 'auto',
            editable: false,
            defaultView: 'dayGridMonth',//默认视图
            buttonText: {
                today: '今天',
                dayGridMonth: '月',
                dayGridWeek: '周',
            },
            events: function(info, successCallback, failureCallback){
                $.ajax({
                    type : "post",
                    url : '/Hotel/GetCalendar/@Model.HotelCode',
                    data: {},
                    dataType: "json",
                    success : function(result) {
                        successCallback(result);
                    }
                });
            },
        });

        $('#route_header').sticky({ context: '#route_tab' });

        $('#btn_plans').click(function() {
            $('#context1.modal').modal('setting', 'closable', true).modal('show');
            $("#context1").css("margin-top","14px").css("top","200px");
            calendar.render();
        });
    });
    </script>
}
