@model Lvy.Trip.Weixin.Models.WapModel
@using Arch.Common
@using Lvy.Models.SiteDB
@using Lvy.Models.HotelDB
@{
    ViewBag.Title = "酒店";
    //var userInfo = HttpContext.Current.Session["WeixinUser"] as MemberModel;
    string picroot = AppSetting.Get("UploadFileRoot");
    var banners = ViewData["SiteBanner"] as List<SiteBannerModel>;
    var hosthotel = ViewData["W001H1"] as List<HotelModel>;        // 热门酒店
}
@section HeaderContent{}
<!-- slider -->
<div class="slider">
    <div class="slider-show owl-carousel owl-theme">
        @foreach (var ban in banners)
        {
            <div class="slider-content">
                <div class="mask2"></div>
                <img src="@(picroot + ban.PicturePath)" alt="">
                <div class="caption text-center">
                    <h2>@ban.Subject</h2>
                    <p>The Best eCommerce</p>
                    <a class="button" href="@ban.LinkUrl">详情</a>
                </div>
            </div>
        }
    </div>
</div>
<!-- end slider -->
<!-- banner -->
@*<div class="banner">
        <div class="ui grid">
            <div class="sixteen wide column banner-pb">
