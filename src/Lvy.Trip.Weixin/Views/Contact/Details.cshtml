@model Lvy.VModels.Crm.AccountEditVModel
@{
    ViewBag.Title = "联系人详情";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    string CDNServerUrl = Arch.Common.AppSetting.Get("CDNServerUrl");
}
@section HeaderContent{
    <!-- Bootstrap Switch -->
    <link rel="stylesheet" href="@CDNServerUrl/bootstrap-switch/css/bootstrap3/bootstrap-switch.min.css" />
    <script src="@CDNServerUrl/bootstrap-switch/js/bootstrap-switch.min.js"></script>
}
<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Admin/Index">首页</a></li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">@ViewBag.Title</h3>
                    </div>
                    <div class="card-body">
                        <table class="table">
                            <tr style="display:none;">
                                <td>密码：</td>
                                <td>
                                    @Html.HiddenFor(a => a.Account.Pwd)
                                    <input type="button" class="btn btn1" value="重置密码" id="resetPwdBtn" />
                                    <span style="color: gray">&nbsp;&nbsp; 重置后密码默认为：888888 </span>
                                </td>
                            </tr>
                            <tr>
                                <td>姓名：</td>
                                <td>@Model.Account.Name</td>
                            </tr>
                            <tr>
                                <td>性别：</td>
                                <td>@Model.Account.Sex.ToString()</td>
                            </tr>
                            <tr>
                                <td>
                                    <span class="point"></span>微信是否绑定：
                                </td>
                                <td>@(string.IsNullOrEmpty(Model.Account.OpenID) ? "未绑定" : "已绑定")</td>
                            </tr>
                            <tr>
                                <td>联系手机：</td>
                                <td>@Model.Account.Mobile</td>
                            </tr>
                            <tr>
                                <td>电子信箱：</td>
                                <td>@Model.Account.Email</td>
                            </tr>
                            <tr style="display:none;">
                                <td>联系电话：</td>
                                <td>@Model.Account.Phone</td>
                            </tr>
                            <tr>
                                <td>所属客户：</td>
                                <td>@DictionaryTools.GetCachedCustomer(Model.Account.CustomerCode).Name</td>
                            </tr>
                            <tr>
                                <td>销售组：</td>
                                <td>@DictionaryTools.GetCachedTeam(Model.Account.TeamID).TeamName</td>
                            </tr>
                            <tr>
                                <td>对应销售：</td>
                                <td>@DictionaryTools.GetCachedAccount(Model.Account.SalerCode).Name</td>
                            </tr>
                            <tr>
                                <td>备注说明：</td>
                                <td>@Model.Account.Remarks</td>
                            </tr>
                        </table>
                    </div>
                    <div class="card-footer">
                        <div class="btn-group">
                            @if (Model.Account.SalerState != 1)
                            {
                                if (GlobalContext.Current.LoginUserRoles.Any(role => role.Name == "销售组长"))
                                {
                                    <input class="btn btn-success" id="btnAudit" type="button" value="审核通过" />
                                    <input class="btn btn-warning" type="button" data-toggle="modal" data-target="#modal-no" value="审核不通过" />
                                }
                            }
                            <input class="btn btn-primary" name="btnClear" type="button" value="返回列表" onclick="location.href='@Url.Action("Search")'" />
                        </div>
                    </div>

                </div>
            </div>

            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">客户信息</h3>
                    </div>
                    <div class="card-body p-0">
                        <table class="table">
                            <tr>
                                <td>客户名称：</td>
                                <td>@Model.Customer.Name</td>
                            </tr>
                            <tr style="display:none;">
                                <td>客户简称：</td>
                                <td>@Model.Customer.ShortName</td>
                            </tr>
                            <tr style="display:none;">
                                <td>快捷码：</td>
                                <td>@Model.Customer.FastCode</td>
                            </tr>
                            <tr>
                                <td>渠道来源：</td>
                                <td>@DictionaryTools.GetEnumValue(Enums.CustomerChannelEnum, Model.Customer.ChannelType.ToString(), false)</td>
                            </tr>
                            <tr>
                                <td>父公司：</td>
                                <td>@Model.Customer.ParentName</td>
                            </tr>
                            <tr style="display:none;">
                                <td>负责人：</td>
                                <td>@Model.Customer.Head</td>
                            </tr>
                            <tr style="display:none;">
                                <td>联系手机：</td>
                                <td>@Model.Customer.Mobile</td>
                            </tr>
                            <tr>
                                <td>公司电话：</td>
                                <td>@Model.Customer.Phone</td>
                            </tr>
                            <tr>
                                <td>地址：</td>
                                <td>
                                    @DictionaryTools.GetDestName(Model.Customer.Province)
                                    @DictionaryTools.GetDestName(Model.Customer.City)
                                    @DictionaryTools.GetDestName(Model.Customer.County)
                                    <br />
                                    @Model.Customer.Address
                                </td>
                            </tr>
                            <tr>
                                <td> 税号：</td>
                                <td>@Model.Customer.TaxNumber</td>
                            </tr>
                            <tr>
                                <td>信用额度：</td>
                                <td>@Model.Customer.CreditLine (0为没有限制)</td>
                            </tr>
                            <tr>
                                <td>结算方式：</td>
                                <td>@DictionaryTools.GetEnumValue(Enums.PaymentTypeEnum, Model.Customer.PaymentType.ToString(), false)</td>
                            </tr>
                            <tr>
                                <td>是否分销商：</td>
                                <td>@Html.CheckBoxFor(m => m.Customer.IsDistributors, new { @class = "js-switch", @disabled = "disabled" })</td>
                            </tr>
                            <tr>
                                <td>是否有子机构<br />（是否是总社总部，<br />下设门市和门店）：</td>
                                <td>@Html.CheckBoxFor(m => m.Customer.HasChild, new { @class = "js-switch", @disabled = "disabled" })</td>
                            </tr>
                            <tr>
                                <td>是否供应商：</td>
                                <td>@Html.CheckBoxFor(m => m.Customer.IsSupplier, new { @class = "js-switch", @disabled = "disabled" })</td>
                            </tr>
                            <tr>
                                <td>是否组团社：</td>
                                <td>@Html.CheckBoxFor(m => m.Customer.IsGroupTour, new { @class = "js-switch", @disabled = "disabled" })</td>
                            </tr>
                            <tr>
                                <td>账单是否显示折让：</td>
                                <td>@Html.CheckBoxFor(m => m.Customer.RebateInBill, new { @class = "js-switch", @disabled = "disabled" })</td>
                            </tr>
                            <tr>
                                <td>是否自家门店：</td>
                                <td>@Html.CheckBoxFor(m => m.Customer.IsBranch, new { @class = "js-switch", @disabled = "disabled" })</td>
                            </tr>
                            <tr>
                                <td>销售组：</td>
                                <td>@DictionaryTools.GetCachedTeam(Model.Customer.TeamID).TeamName</td>
                            </tr>
                            <tr>
                                <td>对应销售：</td>
                                <td>@DictionaryTools.GetCachedAccount(Model.Customer.SalerCode).Name</td>
                            </tr>
                            <tr>
                                <td>备注：</td>
                                <td>@Model.Customer.Remarks</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="modal-no" style="display: none;">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title">审核不通过</h4>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">×</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <select id="remark">
                            <option value="信息不全" selected="selected">信息不全</option>
                            <option value="客户重复">客户重复</option>
                        </select>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary pull-left" data-dismiss="modal">关闭</button>
                        <button type="button" class="btn btn-primary" id="btnAudit2">提交</button>
                    </div>
                </div>
                <!-- /.modal-content -->
            </div>
            <!-- /.modal-dialog -->
        </div>

    </div>
</section>
<script type="text/javascript">

    $(function () {

        $("#resetPwdBtn").click(function () {
            var params = {
                accontCode: '@Model.Account.Code'
            };
            $.post("@Url.Action("ResetPwd")", params, function (flag) {

                if (flag > 0) {
                    Utils.alert("重置密码成功");
                } else {
                    Utils.alert("重置密码失败！");
                }
            });
        });

        // 单选框初始化
        $(".js-switch").each(function () {
            $(this).bootstrapSwitch({ 'state': $(this).prop('checked'), onText: "是", offText: "否" });
        });

        $("#btnAudit").click(function () {
            if (!confirm("确定此客户通过审核？")) {
                return;
            }

            var url = "@Url.Action("AuditContact")";
            $.get(url, { code: '@Model.Account.Code', state: 1 }, function (data) {
                if (data.Code > 0) {
                    location.href = '@Url.Action("ContactIndex")';
                } else {
                    Utils.alert("审核失败！");
                }
            });
        });

        $("#btnAudit2").click(function () {
            var url = "@Url.Action("AuditContact")";
            $.get(url, { code:'@Model.Account.Code', state:2, remark:$("#remark").val()}, function (data) {
                if (data.Code > 0) {
                    location.href = '@Url.Action("ContactIndex")';
                } else {
                    Utils.alert("客户审核设置失败！");
                }
            });

            $('#modal-no').modal('hide')
        })
    });

</script>
