@model Lvy.VModels.Crm.AccountVModel

@if (Model.Accounts.Items.Count > 0)
{
    <table class="table table-sm table-striped text-nowrap " style="min-width:750px;">
        <thead>
            <tr>
                <td>姓名</td>
                <td>手机</td>
                <td>电子邮箱</td>
                <td>销售</td>
                <td>状态</td>
                <td>客户名称</td>
                <td style="width:160px;">操作</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Accounts.Items)
            {
            <tr>
                <td> <a href="@Url.Action("Details", new{id = item.Code })">@item.Name</a> </td>
                <td>@item.Mobile</td>
                <td>@item.Email</td>
                <td>@item.SalerName </td>
                <td>@DictionaryTools.GetEnumValue(Enums.CustomerStateEnum, item.SalerState.ToString(), false)</td>
                <td style="text-align:left;">@item.CustomerName</td>
                <td>
                    @if (item.SalerState != 1 && item.SalerCode == GlobalContext.Current.UserInfo.Code)
                    {
                        <a class="sendMsg btn btn-info btn-sm" href="javascript:void(0)" data-code="@item.Code">提交审核</a>
                        <a class="btn btn-info btn-sm" href="@Url.Action("Edit", new{id = item.Code })">编辑</a>
                    }
                </td>
            </tr>
            }
        </tbody>
    </table>

    @Html.HiddenFor(a => a.Accounts.PageIndex)
    <div id="Pagination" class="digg"></div>
}
else
{
    <div style="color: red; text-align: center; font-weight: bold; font-size: 14px;">
        <br />
        对不起，没有查找到数据！请重新输入查询条件 ！
    </div>
}
<script type="text/javascript">
    //分页控件 begin
    $(function () {
        $('select[name="SortKey"]').change(function () {
            pageselectCallback(0);
        });
    });

</script>
