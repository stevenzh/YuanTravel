@model  Lvy.VModels.Crm.CustomerVModel
@{
    ViewBag.Title = "客户管理";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section HeaderContent
{
    <script type="text/javascript">
        var page_id = 0;
    </script>
}

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Admin/Index">首页</a></li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<section class="content">
    <div class="card">
        <div class="card-header">
            @*<h3 class="card-title">客户列表</h3>*@
            <div class="card-tools">
                @using (Html.BeginForm("Index", "Customer", FormMethod.Post, new { role = "form" }))
                {
                    <div class="input-group input-group-sm" style="width:380px">
                        @if (GlobalContext.Current.LoginUserRoles.Any(role => role.Name == "销售组长"))
                        {
                            @Html.DropDownListFor(t => t.Customer.TeamID, (List<SelectListItem>)ViewBag.Teams, new { @id = "CutomerTeamId", @class = "form-control pull-right" })
                            @Html.DropDownListFor(t => t.Customer.SalerCode, (List<SelectListItem>)ViewBag.Salers, new { @id = "CutomerSalerCode", @class = "form-control pull-right" })
                        }
                        else
                        {
                            @Html.DropDownListFor(t => t.Customer.TeamID, (List<SelectListItem>)ViewBag.Teams, new { @id = "CutomerTeamId", @disabled = "disabled", @class = "form-control pull-right" })
                            @Html.DropDownListFor(t => t.Customer.SalerCode, (List<SelectListItem>)ViewBag.Salers, new { @id = "CutomerSalerCode", @disabled = "disabled", @class = "form-control pull-right" })

                            @Html.HiddenFor(t => t.Customer.SalerCode)
                            @Html.HiddenFor(t => t.Customer.TeamID)
                        }
                        @Html.TextBoxFor(t => t.Customer.Name, new { @id = "CustomerName", @class = "form-control pull-right", @placeholder = "客户名称" })
                        <div class="input-group-append">
                            <button type="submit" class="btn btn-default pull-right"><i class="fas fa-search"></i> </button>
                            <a href="/Customer/Create" class="btn btn-success pull-right"><i class="fas fa-plus"></i></a>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="card-body table-responsive p-0" id="questionListsDiv">
            @Html.Partial("UCSearch", Model)
        </div>
        <div class="card-footer">
            <ul id="pagination-demo" class="pagination-sm"></ul>
        </div>
    </div>
</section>

<script>
    $(function () {

        $('#pagination-demo').twbsPagination({
            totalPages: Number('@Math.Ceiling((decimal)Model.Customers.TotalCount/(decimal)Model.Customers.PageSize)'),
            visiblePages: 3,
            first: "首页",
            prev: "上一页",
            next: "下一页",
            last: "末页",
            onPageClick: function (event, page) {
                page_id = page;
                var param = {
                    'Customer.Name': $("#CustomerName").val(),
                    'Customer.TeamID': $("#CutomerTeamId").val(),
                    'Customer.SalerCode': $("#CutomerSalerCode").val(),
                    'Customers.PageIndex': page_id,
                    'Customers.PageSize': @Model.Customers.PageSize
                };
                $.post('/Customer/Search/', param, function (data) {
                    $('#questionListsDiv').html(data);
                });
            }
        });
    });


</script>