@model Lvy.VModels.Base.LoginVModel
@{
    Layout = null;
    ViewBag.Title = "登录";
    string CDNServerUrl = Arch.Common.AppSetting.Get("CDNServerUrl");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>后台管理 | 登陆</title>
    <meta content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no' name='viewport'>
    <script src="@CDNServerUrl/adminlte/js/adminlte.min.js"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="@CDNServerUrl/fontawesome-free/css/all.min.css" />
    <!-- Ionicons -->
    <link rel="stylesheet" href="https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css">
    <!-- icheck bootstrap -->
    <link rel="stylesheet" href="@CDNServerUrl/icheck-bootstrap/icheck-bootstrap.min.css" />
    <!-- Theme style -->
    <link rel="stylesheet" href="@CDNServerUrl/adminlte/css/adminlte.min.css" />
</head>
<body class="hold-transition login-page">
    <div class="login-box">
        <div class="login-logo">
            <a href="../../index2.html"><b>后台管理</b></a>
        </div><!-- /.login-logo -->
        <div class="card">
            <div class="card-body login-card-body">
                <p class="login-box-msg">Sign in to start your session</p>
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.Account.OwnerCode)
                    <div class="input-group mb-3">
                        @Html.TextBoxFor(model => model.Account.LoginName, new { @class = "form-control", @placeholder = "用户名" })
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fas fa-user"></span>
                            </div>
                        </div>
                    </div>
                    <div class="input-group mb-3">
                        @Html.PasswordFor(model => model.Account.Pwd, new { @class = "form-control", @placeholder = "密码" })
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fas fa-lock"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-8">
                            <div class="icheck-primary">
                                <input type="checkbox" id="remember">
                                <label for="remember">
                                    Remember Me
                                </label>
                            </div>
                        </div><!-- /.col -->
                        <div class="col-4">
                            <button type="submit" class="btn btn-primary btn-block">登录</button>
                        </div><!-- /.col -->
                    </div>
                }

                <a href="#">忘记密码</a>
                <!--
                <br>
                <a href="register.html" class="text-center">Register a new membership</a>
                 -->
            </div><!-- /.login-box-body -->
        </div>
    </div><!-- /.login-box -->
    <!-- jQuery -->
    <script src="@CDNServerUrl/jquery/jquery.min.js"></script>
    <!-- Bootstrap 4 -->
    <script src="@CDNServerUrl/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE App -->
    <script src="@CDNServerUrl/adminlte/js/adminlte.min.js"></script>
</body>
</html>
