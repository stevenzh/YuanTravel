  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="UploadSoap" />
        <binding name="LinkServiceSoap" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://yuanfile.sh-cct.cn/upload.asmx" binding="basicHttpBinding" bindingConfiguration="UploadSoap" contract="FileUpload.IUploadService" name="UploadSoap" />
      <endpoint address="http://manage.sh-cct.cn/LinkService.asmx" binding="basicHttpBinding" bindingConfiguration="LinkServiceSoap" contract="LinkService.LinkServiceSoap" name="LinkServiceSoap" />
    </client>
    <behaviors>
      <serviceBehaviors>
        <behavior name="">
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true" />
  </system.serviceModel>
</configuration>