@model List<Lvy.Models.TicketDB.TktPriceRuleModel>

@foreach (var rule in Model)
{
    <span style="font-weight: bold;  padding-left: 5px;">
        @rule.RuleName ( @rule.StartDate.ToDateFormat() -- @rule.EndDate.ToDateFormat() )
    </span>

    <table style=" padding: 5px; font-size: 12px;">
        @foreach (var price in rule.Prices)
        {
            <tr>
                <td style="text-align: left;" title="@price.PriceType">
                    <span>@price.PriceType</span>
                </td>
                <td style="color: red; text-align: center;">
                    @price.MarketPrice.ToInt()
                </td>
                <td>
                    &nbsp;
                </td>
                <td style="color: green; text-align: center;">
                    @price.SettlePrice.ToInt()
                </td>
                <td>
                    &nbsp;
                </td>
                <td style="color: green; text-align: center;">
                    @if (price.TktType == 1 || price.TktType == 2)
                    {
                        <label>签单价：@price.SysPrice</label>
                    }
                    else
                    {
                        <label>返利：@price.SysPrice</label>
                    }
                </td>
            </tr>
        }
    </table>
}