@model IEnumerable<Lvy.Models.BaseDB.BaseArticleModel>
<ul>
    @foreach (var item in Model)
    {
        <li>
            <strong style="float:left;width:90px;">
                @item.ModifiedTime.ToDateFormat()
            </strong>
            @if (item.Url.IsNullOrEmpty())
            {
                <span class="notice_span">@item.Title</span>
            }
            else
            {
                <span class="notice_span"><a href="http://@item.Url" target="_blank">@item.Title</a></span>
            }
        </li>
    }
</ul>