@section PageScripts {
    <script src="@CDNServerUrl/select2/js/select2.full.min.js"></script>
    <script src="@CDNServerUrl/select2/js/i18n/zh-CN.js"></script>
    <script src="@CDNServerUrl/jquery-ui/jquery-ui.min.js"></script>
    <script src="~/lib/slick-1.8.0/slick.js"></script>
    <script src="~/lib/powerFloat/jquery-powerFloat-min.js"></script>
    <script src="~/js/home.js"></script>
    <script type="text/javascript">

        $(function () {

            LoadHotDest();  // 加载热门目的地and景区

            $("table td[name='thbookingdesc']").powerFloat({ width: 250 });

            SearchProduct(); // 查询产品

        });

        function SearchProduct() {
            $("#btnSearch").click(function () {
                if (Utils.Trim($("#txtSearchDest").val()) === "") {
                    $("#txtSearchDest").focus();
                    return false;
                }

                $.post('/Ticket/Search', { keyword: $("#searchKeyword").val() }, function (html) {
                    $("#rightContent").html(html);
                    AddPriceLink(".line_list");
                });
            });
        }

        // 添加价格链接
        function AddPriceLink(className) {
            $('' + className + ' a[name="priceLink"]').click(function () {
                var $priceWin = $('#showPriceWin');
                if ($priceWin.css("display") !== "none") {
                    $priceWin.hide();
                    return false;
                }
                var _this = this;
                var productId = $(_this).attr('productId');
                var x = $(this).position().left;
                var y = $(this).position().top + $(this).height();
                $.get("/Ticket/ShowPrice?productId=" + productId, function (data) {
                    $('#showPriceWin').html(data);
                    $('#showPriceWin').show();
                    $('#showPriceWin').css("left", x).css("top", y);
                });
                return false;
            });
        }

        function LoadHotDest() {
            $.post('/Ticket/LoadHotDest', null, function (html) {
                $("#divHotDest").html(html);
            });
        }

        // 热门目的地
        function HotDestLink(obj) {
            var url = '/Ticket/Search';
            var params = { keyword: "0-" + $(obj).attr("destId") };

            $.post(url, params, function (html) {
                $("#rightContent").html(html);
                AddPriceLink(".line_list");
            });
        }
    </script>
}
