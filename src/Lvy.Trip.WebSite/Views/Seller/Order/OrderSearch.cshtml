@*我的订单->预定统计*@
@model Lvy.VModels.Saler.OrderStatisticVModel
@{
    ViewBag.Title = "分销商订单统计";
    Layout = "~/Views/Shared/_SellerLayout.cshtml";
    string CDNServerUrl = Arch.Common.AppSetting.Get("CDNServerUrl");
}
@section AdditionalResources
{
    <link rel="stylesheet" href="@CDNServerUrl/pagination.css" />
    <script src="@CDNServerUrl/jquery.pagination.js" type="text/javascript"></script>
    <script src="~/js/jquery.fileDownload.1.3.3.js" type="text/javascript"></script>
    <!-- daterange picker -->
    <link rel="stylesheet" href="@CDNServerUrl/daterangepicker/daterangepicker.css">
}
<form id="theForm">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">订单查询</h3>
        </div>
        <div class="card-body">
            <table id="searchTable" class="table table-sm table-borderless">
                <tr>
                    <td>产品名称：</td>
                    <td style="width:160px;">
                        @Html.TextBoxFor(a => a.Condition.LineName, new { @class = "form-control form-control-sm" })
                    </td>
                    <td>产品类型：</td>
                    <td style="width:160px;">
                        @Html.DropDownListFor(a => a.Condition.LineType, DictionaryTools.GetEnumsBy(Enums.LineTypeEnum).ToSelectListFor(), new { @class = "form-control form-control-sm" })
                    </td>
                    <td>产品类型：</td>
                    <td style="width:160px;">
                        @Html.DropDownListFor(a => a.Condition.LineScope, DictionaryTools.GetEnumsBy(Enums.LineScopeEnum).ToSelectListFor(), new { @class = "form-control form-control-sm" })
                    </td>
                </tr>
                <tr>
                    <td>订单编号：</td>
                    <td>
                        @Html.TextBoxFor(a => a.Condition.OrderId, new { @class = "form-control form-control-sm" })
                    </td>
                    <td>团号：</td>
                    <td>
                        @Html.TextBoxFor(a => a.Condition.TourNo, new { @class = "form-control form-control-sm" })
                    </td>
                    <td>出发日期：</td>
                    <td>
                        @Html.TextBoxFor(a => a.Condition.OutDateRange, new { @id = "OutDateRange", @class = "form-control form-control-sm" })
                    </td>
                </tr>
                <tr>
                    <td>订单状态：</td>
                    <td>
                        @Html.DropDownListFor(a => a.Condition.OrderState, DictionaryTools.GetEnumsBy(Enums.OrderStateEnum).ToSelectListFor(), new { @class = "form-control form-control-sm" })
                    </td>
                    <td>结算状态：</td>
                    <td>
                        @Html.DropDownListFor(a => a.Condition.SettlementState, ViewBag.SettlementStateBean as IEnumerable<SelectListItem>, new { @class = "form-control form-control-sm" })
                    </td>
                    <td>预定日期：</td>
                    <td>
                        @Html.TextBoxFor(a => a.Condition.CreatedTimeRange, new { @id = "CreatedTimeRange", @class = "form-control form-control-sm" })
                    </td>
                </tr>
            </table>
        </div>
        <div class="card-footer">
            <input class="btn btn-default" id="btnSearch" type="button" value="搜索" />
        </div>
    </div>

    <div class="card">
        <div id="listContent" class="card-body">
            @Html.Partial("Order/UCOrderList", Model)
        </div>
    </div>
</form>

@section PageScripts
{
    <script src="@CDNServerUrl/moment/moment.min.js"></script>
    <!-- date-range-picker -->
    <script src="@CDNServerUrl/daterangepicker/daterangepicker.js"></script>
    <script type="text/javascript">
        $(function () {

            $('#OutDateRange').daterangepicker({
                autoUpdateInput: true,
                ranges: {
                    '今天': [moment(), moment()],
                    '昨天': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                    '本周': [moment().startOf('week'), moment()],
                    '上周': [moment().subtract(6, 'days'), moment()],
                    '本月': [moment().startOf('month'), moment().endOf('month')],
                    '上月': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
                },
                locale: {
                    format: "YYYY/MM/DD", //设置显示格式
                    applyLabel: '确定', //确定按钮文本
                    cancelLabel: '清空', //取消按钮文本
                    daysOfWeek: ['日', '一', '二', '三', '四', '五', '六'],
                    monthNames: ['一月', '二月', '三月', '四月', '五月', '六月', '七月', '八月', '九月', '十月', '十一月', '十二月'],
                    customRangeLabel: "自定义",
                    firstDay: 1
                }
            }, function (start, end) {
                $('#OutDateRange input').val(start.format('Do MMM YYYY') + ' - ' + end.format('Do MMM YYYY'));
            });
            $('#OutDateRange').on('cancel.daterangepicker', function (ev, picker) {
                //do something, like clearing an input
                $('#OutDateRange').val('');
            });


            $('#CreatedTimeRange').daterangepicker({
                autoUpdateInput: true,
                ranges: {
                    '今天': [moment(), moment()],
                    '昨天': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                    '本周': [moment().startOf('week'), moment()],
                    '上周': [moment().subtract(6, 'days'), moment()],
                    '本月': [moment().startOf('month'), moment().endOf('month')],
                    '上月': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
                },
                locale: {
                    format: "YYYY/MM/DD", //设置显示格式
                    applyLabel: '确定', //确定按钮文本
                    cancelLabel: '清空', //取消按钮文本
                    daysOfWeek: ['日', '一', '二', '三', '四', '五', '六'],
                    monthNames: ['一月', '二月', '三月', '四月', '五月', '六月', '七月', '八月', '九月', '十月', '十一月', '十二月'],
                    customRangeLabel: "自定义",
                    firstDay: 1
                }
            }, function (start, end) {
                $('#CreatedTimeRange input').val(start.format('Do MMM YYYY') + ' - ' + end.format('Do MMM YYYY'));
            });
            $('#CreatedTimeRange').on('cancel.daterangepicker', function (ev, picker) {
                //do something, like clearing an input
                $('#CreatedTimeRange').val('');
            });

            // 初始
            $('#OutDateRange').val('');
            $('#CreatedTimeRange').val('');

            //搜索
            $("#btnSearch").click(function () {
                pageselectCallback(0);
            });

        });
    </script>
}