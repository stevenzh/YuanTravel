@model Lvy.VModels.Booking.BookingVModel
@{
    ViewBag.Title = "预定页";
    string CDNServerUrl = Arch.Common.AppSetting.Get("CDNServerUrl");
}
@section AdditionalResources
{
    <link href="~/lib/powerFloat/powerFloat.css" rel="stylesheet" />
}

<div class="deals_featured">
    <div class="container">
        <div class="now_position">
            <span>当前位置：产品预定</span> <span class="sport">
                <a href="javascript:void(0);" id="showBusinessCard" rel="/Order/BusinessCard?lineId=@Model.Tour.LineId">
                    <strong>
                        @DictionaryTools.GetCachedCustomer(@Model.LineModel.CustomerCode).ShortName
                        <img style="vertical-align: bottom" src="~/images/icon_phone.png" alt="联系我" />
                    </strong>
                </a>
            </span>
        </div>
        <div class="scenic_info">
            @Html.Partial("UCTourInfo", Model) @*团信息*@
        </div>
        <form id="theForm">
            <div class="scenic_info">
                <p>
                    <b class="title_b">报价类型</b>
                </p>
                <div id="divPrices" class="info_con_money">
                    @Html.Partial("UCPrices", Model.PriceModels)
                </div>
            </div>
            <div class="mingdan">
                <div class="md_content">
                    <p>
                        <b class="title_b">游客名单</b>
                    </p>
                    <div id="divTravellers" class="mem_list">
                        @Html.Partial("UCTravllers", Model)
                    </div>
                </div>
            </div>
            <input type="hidden" id="TourId" name="TourId" value="@Model.Tour.Id" />
            <input type="hidden" id="BusPointId" name="BusPointId" value="0" />
            <input type="hidden" id="LineType" name="LineType" value="@Model.LineModel.LineType" />
        </form>
    </div>
</div>
@section PageScripts {
    <script src="~/js/jQuery.Hz2Py-min.js" type="text/javascript"></script>
    <script src="~/lib/powerFloat/jquery-powerFloat-min.js"></script>
    <script src="@CDNServerUrl/jquery-form/jquery.form.min.js"></script>
    <script type="text/javascript">
    $(function () {

        // 上车点选择
        SelectBusPoint();
        // 名片
        $("#showBusinessCard").powerFloat({
            targetMode: "ajax"
        });
        $("input[name='priceNum']").change(function () {
            // 如果已经有报价的场合，先删除同报价类型的游客
            $("#tbTravellers tr").remove();

            // 判断是否超过剩余库存 ，如超过，跳出。
            var maxnum = 0;
            $("input[name='priceNum']").each(function () {
                var suit = Number($(this).parents("tr").find("td[name='tdSuitNum']").html()); // 套餐
                maxnum += Number($(this).val()) * suit;
            });

            if (Utils.Trim($("#hidUseQuota").val()) < maxnum) {
                $(this).val(0);

            }
            var Tax = $("input[name='tax']").val();
            var VisaPrice = $("input[name='visaPrice']").val();

            $("input[name='priceNum']").each(function () {

                var obj = $(this).parents("tr");
                var model = new Object();
                model.PriceNum = Number(obj.find("input[name='priceNum']").val()); // 人数
                if (model.PriceNum <= 0) {
                    return;
                }
                model.PriceId = obj.find("td[name='tdPriceId']").html();               // 报价Id
                model.PriceContent = obj.find("td[name='tdPriceContent']").html();     // 报价类型
                model.Price = parseFloat(obj.find("td[name='tdSettlePrice']").html()); // 结算价
                model.TeJiaFanLi = parseFloat(obj.find("td[name='tdTeJiaFanLi']").html());  // 特价让利
                model.Tips = parseFloat(obj.find("td[name='tdTips']").html());         // 小费
                model.ZiFei = Number(obj.find("td[name='tdZiFei']").html());           // 自费
                model.SingleRoom = Number(obj.find("td[name='tdSingleRoom']").html()); // 单房差
                model.SuitNum = Number(obj.find("td[name='tdSuitNum']").html());       // 套餐
                model.JsPrice = Number(Utils.Trim($('#jsPrice').html()));              // 接送费
                model.YsPrice = model.Price - model.TeJiaFanLi;

                model.Tax = Tax;// Number(obj.find("td[name='kao1']").html());
                model.VisaPrice = VisaPrice;// Number(obj.find("td[name='kao2']").html());

                //-----根据人数，拼接游客html-------------------

                // 再追加游客
                var html = GetTravellersHtml(model);
                $("#tbTravellers").append(html);
                // 初始化 总价
                var totalPrice = 0;
                $("#tbTravellers").find("td[name='tdOnePrices']").each(function (i, o) {
                    totalPrice += Number(Utils.Trim($(o).html()));
                });
                $("#totalPrice").html(totalPrice);  // 总价
                //-----------------------------------------------

            });
            //汉字转化为拼音。
            $("input[name$='Name']").on("keyup keydown change blur", function () {
                var obj = $(this).parent("td").parent("tr");
                obj.find("input[name$='PinYin']").val($(this).toPinyin());
            });
        });

        // 预定提交
        $("#post_button").click(function () {
            if (!CheckControl()) {
                return false;
            }
            var params = decodeURIComponent($("#theForm").formSerialize());
            var load_iii = Utils.layerLoad();
            $.post('/Order/SaveOrder', params, function (data) {

                if (data.StateCode == 100) {
                    // 预定成功
                    Utils.alert("预定成功！");
                    $("#post_button").attr("disabled", "true");
                    document.location.href = "/Order/EditOrder?orderCode=" + data.OrderCode;
                    return;
                } else if (data.StateCode == 101) {
                    // 车位已经占了的场合，刷新车位数据，提示客户重新选择车位
                    Utils.alert("预定失败。已经有客人吧车位占了，请重新选择车位！");
                } else if (data.StateCode == 102) {
                    // 车位已经被锁定的场合，刷新车位数据，提示客户重新选择车位
                    Utils.alert("预定失败。车位已经被万恶的Op锁定了，请联系Op！");
                } else if (data.StateCode == 103) {
                    // 可用名额小于预定名额
                    Utils.alert("预定失败。你要预定的名额数超过了我们的可用名额，拿起你的电话，请与op协调！");
                } else {
                    Utils.alert("预定失败。这个错误我也不知道该怎么形容了！请联系技术支持！");
                }
                Utils.layerClose(load_iii);
            });
        });

        $("#lnkAnsyInfo").click(function () {
            if (Utils.Trim($("#Managers").val()) == "") {
                $("#ContactCode").val('@GlobalContext.Current.UserInfo.Code');
                $("#Managers").val('@GlobalContext.Current.UserInfo.Name');
                $("#ManagerPhone").val('@GlobalContext.Current.UserInfo.Mobile');
            }else {
                $("#Managers").val('');
                $("#ManagerPhone").val('');
            }
        });
    });
    // 验证入力数据
    function CheckControl() {
        var returnValue = true;
        //if ($('#BusPointId').val() == "0") {
        //    Utils.alert("请选择上车点！");
        //    $("html,body").animate({ scrollTop: $("#select_div_address").offset().top - 50 }, 500);
        //    return false;
        //}

        if ($("#tbTravellers tr").length <= 0) // 游客信息的索引
        {
            Utils.alert("请添加游客信息！");
            $("#tblPrices tr:eq(1)").find("input[name='priceNum']").focus().select(); // 人数
            return false;
        }
        // 姓名不能为空
        var returnvalue = true;
        $("#tbTravellers").find("input[name$='Name']").each(function () {
            if (Utils.Trim($(this).val()) == "") {
                Utils.alert("请输入客人姓名！");
                $(this).focus().select();
                returnvalue = false;
                return false;
            }
        });
        if (!returnvalue) { return false; }

        if (Utils.Trim($("select[name$='SalerCode']").val()) == "") {
            Utils.alert("请选择对应销售！");
            $("select[name$='SalerCode']").focus().select();
            return false;
        }

        // 联系电话必须留一个
        if (Utils.Trim($("#tbTravellers").find("input[name$='Phone']:eq(0)").val()) == "") {
            Utils.alert("联系电话必须留一个！");
            $("#tbTravellers").find("input[name$='Phone']:eq(0)").focus().select();
            return false;
        }
        //出境  或者fit的场合 ，验证护照
        $("#tbTravellers").find("input[name$='PassNo']").each(function () {
            var type = $(this).parents('tr').find("select[name$='PassType']").val();
            switch (type) {
                case "1":
                    if (!Utils.Check.IsID($(this).val())) {
                        Utils.alert("请输入正确的身份证！");
                        $(this).focus().select();
                        returnvalue = false;
                        return false;
                    }
                    break;
                //  case 2:
                default:
                    if (Utils.Trim($(this).val()) == "") {
                        Utils.alert("请输入证件号码！");
                        $(this).focus().select();
                        returnvalue = false;
                        return false;
                    }
            }
        });
        if (!returnvalue) { return false; }
        //if (Utils.Trim($("#tbTravellers").find($("#Managers").val()) == "") {
        //    Utils.alert("请输入联系人姓名！");
        //    $("#tbTravellers").find("#Managers").focus().select();
        //    return false;
        //}
        //if (Utils.Trim($("#ManagerPhone").val()) == "") {
        //    Utils.alert("请输入联系人的电话！");
        //    $("#ManagerPhone").focus().select();
        //    return false;
        //}
        if (document.getElementById("JoinOrderCode")) {
            if (Utils.Trim($("#JoinOrderCode").val()) == "") {
                return true;
            }
            var params = { joinOrderCode: Utils.Trim($("#JoinOrderCode").val()) };
            $.ajax({
                url: "/Order/CheckJoinOrderCode",
                type: "GET",
                async: false,
                data: params,
                success: function (flag, textStatus) {
                    if (flag == "1") {
                        // exist
                        Utils.alert("关联订单号已经存在！");
                        $("#JoinOrderCode").focus().select();
                        returnValue = false;
                    }
                }
            });
        }
        return returnValue;
    }
    // 根据人数，拼接html0
    function GetTravellersHtml(model) {

        var html = "";
        var travllerIndex = $("#tbTravellers tr").length; // 游客信息的索引
        for (var i = travllerIndex; i < model.PriceNum + travllerIndex; i++) {
            html += "<tr height=\"30\" name=\"trPriceId" + model.PriceId + "\" >"; html += "  <td align=\"center\">" + model.PriceContent + " <input type=\"hidden\"  name=\"Travellers[" + i + "].PriceId\" value=\"" + model.PriceId + "\" >  </td>"; //报价类型
            html += "  <td align=\"center\"><input type=\"text\" name=\"Travellers[" + i + "].Name\" class=\"form-control form-control-sm\" style=\"width:60px;\" /></td>"; //姓名
            html += "  <td align=\"center\"><input type=\"text\" name=\"Travellers[" + i + "].PinYin\" class=\"form-control form-control-sm\" style=\"width:100%;\" /></td>"; //拼音
            html += SexHtml(i);//性别
            html += "  <td><input type=\"text\" class=\"txt_input\" name=\"Travellers[" + i + "].Phone\" style=\"width:90px;\" /></td>"; //联系电话
            html += GetPassportTypeHtml(i);//证件
            html += "  <td align=\"center\"> <input type=\"text\" class=\"form-control form-control-sm\" name=\"Travellers[" + i + "].PassNo\" style=\"width:110px;\"> </td>"; //证件号
            html += "  <td align=\"center\"><input type=\"checkbox\" id=\"singleroom" + i + "\"  name=\"Travellers[" + i + "].SingleRoom\" group=\"chkAll2\" onclick='CalcPrice(this);' /> <label for=\"singleroom" + i + "\" >" + model.SingleRoom + "</label></td>";  //房差
            html += "  <td align=\"center\" name=\"tdOnePrices\" style=\"color:#FF8F27;\" >" + model.YsPrice + "</td>";  // 客人应收款
            html += "  <td align=\"center\" name=\"tdPrice\" style=\"display: none;\" >" + model.YsPrice + "</td>";        // 销售价
            html += " <input type=\"hidden\"  name=\"Travellers[" + i + "].IsMianPiao\" value='0' >";
            html += "</tr>";
        }
        var travellerNum = model.PriceNum * (model.SuitNum - 1); // 实际人数
        for (var i = model.PriceNum + travllerIndex; i < travellerNum + model.PriceNum + travllerIndex; i++) {
            html += "<tr height=\"30\" name=\"trPriceId" + model.PriceId + "\" >"; html += "  <td align=\"center\">" + model.PriceContent + " <input type=\"hidden\"  name=\"Travellers[" + i + "].PriceId\" value=\"" + model.PriceId + "\" >  </td>"; //报价类型
            html += "  <td align=\"center\"><input type=\"text\" name=\"Travellers[" + i + "].Name\" class=\"form-control form-control-sm\" style=\"width:70px;\" /></td>"; //姓名
            html += SexHtml(i);//性别
            html += "  <td><input type=\"text\" class=\"form-control form-control-sm\" name=\"Travellers[" + i + "].Phone\" style=\"width:90px;\"  /></td>"; //联系电话
            html += GetPassportTypeHtml(i);//证件
            html += "  <td align=\"center\"> <input type=\"text\" class=\"form-control form-control-sm\" name=\"Travellers[" + i + "].PassNo\" style=\"width:110px;\"> </td>"; //证件号
            html += "  <td align=\"center\"><input type=\"checkbox\" id=\"singleroom" + i + "\" name=\"Travellers[" + i + "].SingleRoom\" group=\"chkAll2\" onclick='CalcPrice(this);' /> <label for=\"singleroom" + i + "\" >" + model.SingleRoom + "</label></td>";  //房差
            html += "  <td align=\"center\" name=\"tdOnePrices\" style=\"color:#FF8F27;\" >" + model.YsPrice + "</td>";  // 客人应收款
            html += "  <td align=\"center\" name=\"tdPrice\" style=\"display: none;\" >" + 0 + "</td>";   //销售价
            html += " <input type=\"hidden\"  name=\"Travellers[" + i + "].IsMianPiao\" value='1' >";
            html += "</tr>";
        }
        return html;
    }
    // 生成证件类型html
    function GetPassportTypeHtml(i) {
        var html = "<td align=\"center\"><select class=\"form-control form-control-sm\"  name=\"Travellers[" + i + "].PassType\">";
        var linescope = $("#LineType").val();
        if (linescope == "3") {
            html += "<option value=\"1\">身份证</option>";
            html += "<option value=\"2\">护照</option>";
            html += "<option value=\"3\" selected=\"selected\">港澳通行证</option>";
        } else if (linescope == "4") {
            html += "<option value=\"1\" >身份证</option>";
            html += "<option value=\"2\" selected=\"selected\">护照</option>";
            html += "<option value=\"3\">港澳通行证</option>";
        } else {
            html += "<option value=\"1\" selected=\"selected\">身份证</option>";
            html += "<option value=\"2\">护照</option>";
            html += "<option value=\"3\">港澳通行证</option>";
        }
        
        html += "<option value=\"9\">其他</option>";
        html += "</select></td>";
        return html;
    }

    //性别
    function SexHtml(i) {
        var html = "<td align=\"center\"><select class=\"form-control form-control-sm\" name=\"Travellers[" + i + "].Sex\" onchange=\"CalcPrice(this)\">";
        html += "<option value=\"1\">男</option>";
        html += "<option value=\"2\">女</option>";
        html += "<option value=\"3\">其他</option>";
        html += "</select></td>";
        return html;
    }
    // 上车点选择
    function SelectBusPoint() {
        $("#select_div_address").click(function () {
            window.int0 = diffTime();
            var className = $(this).attr('id');
            $(this).attr('class', className + '_1');
            $('#select_input_address').attr('class', 'select_input_address_1');

            if ($(".select_option_address").css('display') == 'none') {
                $(".select_option_address").show();
            } else {
                $(".select_option_address").hide();
                $(this).attr('class', className);
                $('#select_input_address').attr('class', 'select_input_address');
            }
        });

        $(".select_option_address p").hover(function () {
            $(".select_option_address p").each(function () {
                $(this).attr('class', '');
            });
            $(this).attr('class', 'option_bac');
        }, function () {
            $(this).attr('class', 'option_bac');
        }
        );
        $(".select_option_address p").click(function () {
            var oldjiesong = Number(Utils.Trim($('#jsPrice').html()));
            $('#BusPointId').val(Utils.Trim($(this).attr("key")));
            $('#input_address').val($(this).text());
            $('#jsPrice').html(Utils.Trim($(this).attr("jsPrice")));
            $('#address_span').html(Utils.Trim($(this).text()));
            $(".select_option_address").hide();

            // 计算价格
            var jiesong = Number(Utils.Trim($('#jsPrice').html()));
            var totalPrice = 0;
            $("#tbTravellers").find("td[name='tdOnePrices']").each(function (i, o) {
                var temp = Number(Utils.Trim($(o).html()));
                $(o).html(temp - oldjiesong + jiesong);
                totalPrice += Number(Utils.Trim($(o).html()));
            });

            $("#totalPrice").html(totalPrice);
        });
    }
    // 计算游客价格
    function CalcPrice(_this) {
        var obj = $(_this).parents("tr");
        var model = new Object();
        model.Price = Number(obj.find("td[name='tdPrice']").html());                      // 结算价
        model.IsTax = obj.find("input[name$='Tax']").prop('checked')                      //判断税是否被选中
        model.IsVisaPrice = obj.find("input[name$='VisaPrice']").prop('checked')          //判断签证费用是否被选中
        model.Tax = Number(obj.find("input[name$='Tax']").parent().find('label').html());               //税
        model.VisaPrice = Number(obj.find("input[name$='VisaPrice']").parent().find('label').html());   //签证费用
        model.IsZiFei = obj.find("input[name$='ZiFei']").prop('checked');                               //判断保证自费是否被选中
        model.ZiFei = Number(obj.find("input[name$='ZiFei']").parent().find('label').html());           // 保证自费
        model.SingleRoom = Number(obj.find("input[name$='SingleRoom']").parent().find('label').html()); //单房差
        model.IsSingleRoom = obj.find("input[name$='SingleRoom']").prop('checked');                     //判断单房差是否被选中
        model.JsPrice = Number(Utils.Trim($('#jsPrice').html()));                           //接送费
        model.FanLi = Number(obj.find("input[name$='FanLi']").val());
        model.IsMianPiao = Number(obj.find("input[name$='IsMianPiao']").val());
        model.Sex = Number(obj.find("select[name$='Sex']").val());               //性别

        var oneprice = model.Price + model.FanLi;
        if (model.IsTax) {
            oneprice += model.Tax;
        }
        if (model.IsVisaPrice) {
            oneprice += model.VisaPrice;
        }
        if (model.IsZiFei) {
            oneprice += model.ZiFei;
        }
        if (model.IsSingleRoom) {
            oneprice += model.SingleRoom;
        }

        obj.find("td[name='tdOnePrices']").html(oneprice);  // 显示报价类型的总计
        // 价格总价
        model.TotalPrice = 0;
        $(_this).parents("table").find("td[name='tdOnePrices']").each(function (i, o) {
            model.TotalPrice += parseFloat($(o).html());
        });
        $("#totalPrice").html(model.TotalPrice);  // 总价
        showDetails();
    }
    function showDetails() {
        //------------自费-----------------------------------
        var zifeiNum = 0;
        var zifei = 0;
        $("table input[name$='ZiFei']").each(function () {
            if ($(this).prop('checked')) {
                zifeiNum++;
                zifei = zifei + Number($(this).parent().find('label').html());
            }
        });
        //------------单房差-----------------------------------
        var singleRoomNum = 0;
        var singleRoom = 0;
        $("table input[name$='SingleRoom']").each(function () {
            if ($(this).prop('checked')) {
                singleRoomNum++;
                singleRoom = singleRoom + Number($(this).parent().find('label').html());
            }
        });

        ////------------签证费-----------------------------------
        //var visaPrice = 0;
        //$("table input[name$='VisaPrice']").each(function () {
        //    visaPrice += Number($(this).val());
        //});
        //$("#totaltax").html(taxNum);
        //$("#totalvisaPrice").html(visaPrice);
        $("#totalZifei").html(zifeiNum);
        $("#totalSingleRoom").html(singleRoomNum);
    }
    </script>
}