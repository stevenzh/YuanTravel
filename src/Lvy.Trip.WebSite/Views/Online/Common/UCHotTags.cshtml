@model List<Lvy.Models.BaseDB.BaseTagModel>

<p class="left_title">热门主题</p>
<div style="word-break:keep-all;padding-left: 10px; padding-top: 15px; padding-bottom: 5px;  font-size: 18px;">
    @foreach (var item in Model)
    {
        <a style="padding-left: 5px;" href="@Url.Action("GoToByTag",new{tagId=item.Id,tagName=item.TagName})">@item.TagName</a>
    }
    <p style="height:10px;"></p>
</div>