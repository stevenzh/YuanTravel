@model Lvy.Models.BaseDB.BaseArticleModel
@{
    ViewData["Title"] = Model.Title;
}
@section AdditionalResources{}

<!-- Home -->
<div class="home">
    <div class="home_background parallax-window" data-parallax="scroll" data-image-src="@Model.ImgUrl" data-speed="0.8"></div>
</div>

<!-- Single Blog Post -->
<div class="single_post">
