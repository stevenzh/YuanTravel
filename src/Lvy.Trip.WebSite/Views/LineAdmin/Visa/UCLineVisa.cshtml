@model Lvy.VModels.Product.AddLineVModel
@{
    Layout = null;
}

@if (Model.TpLine.Id > 0)
{
    <div class="card">
        <div class="card-header">
            <div class="card-tools">
                <button class="btn btn-info" type="button" id="addLineVisa">添加签证</button>
                <a class="btn btn-info" href="/LineAdmin/SearchLine">返回列表</a>
            </div>
        </div>
        <div class="card-body">
            @Html.HiddenFor(m => m.TpLine.LineId)
            <table class="table table-bordered table-sm">
                <thead>
                    <tr>
                        <th>编号</th>
                        <th>国家</th>
                        <th>签证产品</th>
                        <th>成本</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.TpLineVisaList)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.CountryName</td>
                            <td>@item.ProductName</td>
                            <td>@item.Cost</td>
                            <td>
                                <a href="###" onclick="deleteLineVisa(@item.Id)">删除</a>
                                <a href="###" onclick="editLineVisa(this , '@item.Id')">编辑</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <p style="text-align:center;padding-top: 100px;background: #fff;text-align: center;color: #121212; font-size: 14px;">
        保存<strong> 基本信息</strong>后，可填写更多内容！
    </p>
}
<script type="text/javascript">
    $(function () {

        $("#addLineVisa").click(function () {
            layer.open({ type: 2, title: '添加签证', maxmin: true, shadeClose: false, area: ['500px', '300px'], content: '@Url.Action("AddLineVisa", new { LineId=Model.TpLine.LineId})' });
        });

    })

    function editLineVisa(obj, id) {
        layer.open({ type: 2, title: '编辑签证', maxmin: true, shadeClose: false, area: ['500px', '300px'], content: '/LineAdmin/EditLineVisa/' + id });
    }

    function deleteLineVisa(id) {
        if (!confirm("确定删除？")) {
            return;
        }
        $.ajax({
            url: '@Url.Action("deleteLineVisa")',
            data: { id: id },
            type: 'post',
            success: function (data) {
                ReloadUcLineVisa();
            }
        });
    }

    function ReloadUcLineVisa() {
        var getTimestamp = new Date().getTime();
        var url = "@Url.Action("UCLineVisa")" + "?id=" + @Model.TpLine.LineId + "&timestamp=" + getTimestamp;
        $("#tab-1 .ibox-content").remove();
        $("#tab-1").load(url);
    }

</script>
